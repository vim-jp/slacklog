109.461400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"KLj"}]},{"client_msg_id":"0ee23569-3339-46a3-b2c1-647a1620f78b","type":"message","user":"UDDCM376D","text":"命を削ってプラグインを作っているって言葉はすごく響きました","ts":"1637760097.461000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Na5X"}]},{"client_msg_id":"a9e45e5d-b9c8-485e-aa97-7a72ceed2526","type":"message","user":"U7JL1UKKL","text":"自分の強みを生かすのは当然のことです","ts":"1637760092.460700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"p0kQ5"}]},{"client_msg_id":"fe73d55b-adf9-461c-b383-49c078e5eccf","type":"message","user":"U7JL1UKKL","text":"それだけしか取り柄と呼べるものがないですから。他は平凡","ts":"1637760071.459800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4BoVh"}]},{"client_msg_id":"0dbd43cc-df91-40ec-b34a-3faeced6575e","type":"message","user":"UDDCM376D","text":"Shougoさんはある意味良い例ですね\n完全に振り切っている","ts":"1637760047.459000","team":"T03C4RC8V","reactions":[{"name":"sorena","count":1,"users":["U9S4G0LJW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fxXy"}]},{"client_msg_id":"b50ad363-d8cd-4a58-8efe-46f491182d45","type":"message","user":"U7JL1UKKL","text":"有事の時のためにテキストエディタ力は鍛えておいて損はないですよ","ts":"1637760046.458900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"NgX"}]},{"client_msg_id":"f21fdfbb-e41c-4a00-a977-efdc32ff1ea2","type":"message","user":"U7JL1UKKL","text":"何かあったらテキストエディタの力で解決することにしている","ts":"1637760025.457800","team":"T03C4RC8V","reactions":[{"name":"gativim","count":4,"users":["U9S4G0LJW","U01U44T1FK2","U02G79NJMLY","U016GRZN0GJ"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"tlSMS"}]},{"client_msg_id":"67de59f0-c27b-4436-95a3-c15e94c8a175","type":"message","user":"U01D44KSY9Z","text":"ちょうどタスクが一気に消化されたのも一因かなと\n今月は本当にスケジュールがスカスカだったので、先月は過密すぎて何も考えられなかった","ts":"1637759996.457000","edited":{"user":"U01D44KSY9Z","ts":"1637760038.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"FIK"}]},{"client_msg_id":"f32a5f74-9fca-4529-af8d-2656c38c67e4","type":"message","user":"U9S4G0LJW","text":"実情がどうであれ一般に「テキストエディタそこそこ詳しい」と言えるくらいの力はあると思ってるので、自己否定ループに陥りそうになったらそれを思い出すことにしてる","ts":"1637759989.456700","team":"T03C4RC8V","reactions":[{"name":"sorena","count":3,"users":["UDDCM376D","U7JL1UKKL","U02269AAADD"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"25eP"}]},{"client_msg_id":"bad494e7-05a8-4036-9a07-f050c4b3c163","type":"message","user":"UDDCM376D","text":"不安は、ありますね\n誰しも\nぼくもあります","ts":"1637759961.455000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"nETr"}]},{"client_msg_id":"F93D9619-0152-4EBF-AB54-C06383888FE6","type":"message","user":"U78A6ESHM","text":"将来がどうなるんだと言う不安はよく分かります。","ts":"1637759935.454200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"CHh"}]},{"client_msg_id":"545bca5c-cf0d-4279-a37d-c3fdee4fd191","type":"message","user":"UDDCM376D","text":"不安なんて考えられないほど、とにかく目の前にあることを全力で頑張ると道が開けます","ts":"1637759926.453800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"cYc="}]},{"client_msg_id":"6666dd71-959f-4352-bbdf-6f5592957422","type":"message","user":"U9S4G0LJW","text":"卑下はやめました、自分が楽しいことをやったらいいと開き直った","ts":"1637759912.452900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"1PFGZ"}]},{"client_msg_id":"989FEBE3-9285-49F5-B3B7-94F41F0D42DC","type":"message","user":"U78A6ESHM","text":"卑下するのと謙虚になるのとは違いますもんねぇ。","ts":"1637759902.452000","team":"T03C4RC8V","rep