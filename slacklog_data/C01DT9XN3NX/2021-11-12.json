D62"}]},{"client_msg_id":"444F397A-9D15-4630-9EEF-A6CFFABB8BD3","type":"message","user":"U782D5DF1","text":"Vim採用大手のフィックスポイントさんだ","ts":"1636715123.407200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"y7k"}]},{"client_msg_id":"386dbe71-5976-4e42-a8c1-d7d05c5b3ab4","type":"message","user":"U776661HA","text":"（僕が副業してる暇がないくらい忙しいので、そういう意味ではお勧めするべきではないですがw）","ts":"1636708205.405500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jz9m7"}]},{"client_msg_id":"9d9af2b0-f20d-4f1f-8566-ccfdf91f1106","type":"message","user":"U776661HA","text":"念のため置いておきますね\n\n\u003chttps://www.fixpoint.co.jp/recruitinfo/career/\u003e","ts":"1636708152.404800","attachments":[{"fallback":"fixpoint - 次の自動化の世界をつくる: 株式会社フィックスポイント","id":1,"title":"株式会社フィックスポイント","title_link":"https://www.fixpoint.co.jp/recruitinfo/career/","text":"フィックスポイントは、システム運用の自動化サービスと運用コストの削減をご提案します。","blocks":null,"ts":1573888658,"service_name":"fixpoint - 次の自動化の世界をつくる","service_icon":"https://www.fixpoint.co.jp/wp-content/uploads/cropped-logo_mark-180x180.jpg","from_url":"https://www.fixpoint.co.jp/recruitinfo/career/","original_url":"https://www.fixpoint.co.jp/recruitinfo/career/"}],"team":"T03C4RC8V","reactions":[{"name":"goodjob","count":9,"users":["U0238G3KV8D","U01AQ5BFNLX","UDPT2BZ6E","U7JL1UKKL","U782D5DF1","U022XK5866Q","U9S4G0LJW","UD1FQV38V","UG6DF6W87"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ASFTy"}]},{"client_msg_id":"de38eef1-47ee-48da-8ab3-aa3446993252","type":"message","user":"U022XK5866Q","text":"副業する気も置きないくらい金くれってのはそうっすね。んーまぁ今の会社見てるとそういう話乗ってくるか怪しいし、最近色々と頭固い雰囲気出てきちゃってるからなー。とか色々考え中です。","ts":"1636708042.404000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"UsAK"}]},{"client_msg_id":"404558CE-B6E4-4989-9F89-B9AC3BE7D934","type":"message","user":"UFHQ7TNT0","text":"とりあえず、300万くらい稼げる副業を諦めるんだから、年収200万くらい上げてって言ってもバチは当たらないんじゃないですかね","ts":"1636707019.402300","team":"T03C4RC8V","reactions":[{"name":"moneybag","count":1,"users":["U0238G3KV8D"]},{"name":"tashikani","count":1,"users":["U023KQQKC6T"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0I+vI"}]},{"client_msg_id":"94e980b2-6f62-4f82-9dff-3e9d62a445b2","type":"message","user":"U03C71D7H","text":"会社と話を付けるなり話の分かる会社に移るなりをしないと今後もチャンスを逃し続けるんだなぁ","ts":"1636705981.400700","team":"T03C4RC8V","reactions":[{"name":"sorena","count":2,"users":["U022XK5866Q","U776661HA"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"oaZs"}]},{"client_msg_id":"cdd4768a-e257-4985-8ff4-5d8f669c2a93","type":"message","user":"U022XK5866Q","text":"ですねー。今回が美味しい案件とは言え、一時のものにそこまでリスク踏むほどじゃないかなという判断にしてます。","ts":"1636705642.399900","team":"T03C4RC8V","reactions":[{"name":"wakaru","count":1,"users":["U023KQQKC6T"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"yWgT"}]},{"client_msg_id":"3662bf8f-a2bc-4e59-983e-5e113a4008a3","type":"message","user":"U023KQQKC6T","text":"あと、もし懲戒されなかったとしても、「やらないで」って言われたことをやるは会社員としては割にリスク高め（個人の感想）ではありますわね","ts":"1636705571.398900","edited":{"user":"U023KQQKC6T","ts":"1636705574.000000"},"team":"T03C4RC8V","reactions":[{"name":"tashikani","count":1,"users":["U0238G3KV8D"]},{"name":"sorena","count":1,"users":["U776661HA"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"GjG"}]},{"client_msg_id":"55f88cc3-7cb1-40dd-aa35-977f6dba3e23","type":"message","user":"U023KQQKC6T","text":"法的には副業しても会社が atusy さんを懲戒できないかもしれませんね\n\n私も上の記事みてましたが\n\n\u0026gt; 裁判例では、就業規則において、会社の許可なく副業した場合に懲戒事由としている場合において、形式的に就業規則の規定に抵触したとしても、\n\u0026gt; * 職場秩序に影響せず、\n\u0026gt; * 使用者に対する労務提供に支障を生ぜしめない程度・態様のものは、\n\u0026gt; 就業規則に反するものではないとして、懲戒処分を認めていない傾向にあります。\n\u0026gt; 参考：\u003chttps://www.mhlw.go.jp/file/06-Seisakujouhou-11200000-Roudoukijunkyoku/0000192844.pdf|副業･兼業の促進に関するガイドライン｜厚生労働省\u003e\nという格好ですし。とはいえどちらも判断する人に依りそうですが……","ts":"1636705516.397700","team":"T03C4RC8V","reactions":[{"name":"wakaru","count":2,"users":["UD1FQV38V","U022XK5866Q"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"yoz=I"}]},{"client_msg_id":"ccb79d56-a999-48f3-a2dc-bc1dab008ed7","type":"message","user":"U022XK5866Q","text":"ちなみに就業規則には記載ないのは確認済みです。","ts":"1636705357.396000","team":"T03C4RC8V","reactions":[{"name":"thinking_face","count":2,"users":["U776661HA","U01AQ5BFNLX"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"trqs"}]},{"client_msg_id":"cd337a27-86f1-4231-943a-0b4b84bb6cfc","type":"message","user":"U0238G3KV8D","text":"\u003chttps://www.adire.jp/lega-life-lab/no-side-business305/\u003e\n\u0026gt;  会社員の副業は基本的には可能です。\n\u0026gt;  ただし、一定の場合に、会社の就業規則で副業を制限することは禁止されてはいません。","ts":"1636703896.393700","attachments":[{"fallback":"リーガライフラボ: 副業禁止は法律的にOKなの？企業が副業を禁止する理由についても解説 | リーガライフラボ","id":1,"title":"副業禁止は法律的にOKなの？企業が副業を禁止する理由についても解説 | リーガライフラボ","title_link":"https://www.adire.jp/lega-life-lab/no-side-business305/","text":"「収入を増やしたいので副業したい。会社が副業を禁止しているけど、副業してもいいの？」このような方も多いことでしょう。実は、企業による副業の禁止・制限は、必ずしもOKというわけではありません。副業について、弁護士が解説いたします。アディーレ法律事務所がお届けする「あなたの法律のお悩み一発解決サイト」リーガライフラボ（Lega-Life Lab）。","image_url":"https://www.adire.jp/lega-life-lab/wp-content/uploads/2021/01/305_roudou.jpg","blocks":null,"ts":1613527200,"service_name":"リーガライフラボ","service_icon":"https://www.adire.jp/lega-life-lab/wp-content/uploads/2020/08/cropped-siteicon-180x180.png","from_url":"https://www.adire.jp/lega-life-lab/no-side-business305/","original_url":"https://www.adire.jp/lega-life-lab/no-side-business305/"}],"team":"T03C4RC8V","reactions":[{"name":"naruhodo","count":1,"users":["U776661HA"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"dzNU"}]},{"client_msg_id":"0937221e-4d9d-4336-af40-b76962f5c622","type":"message","user":"U06ECBRTJ","text":"\u003chttps://www.ishioroshi.com/biz/kaisetu/roumu/index/roudoushagimu_fukugyou/\u003e\n就業規則で縛ることができる感じですね","ts":"1636703873.393300","attachments":[{"fallback":"労働者の義務～労働者の副業 - 弁護士法人クラフトマン IT・技術・特許・商標に強い法律事務所(東京丸の内・横浜)　","id":1,"title":"労働者の義務～労働者の副業 - 弁護士法人クラフトマン IT・技術・特許・商標に強い法律事務所(東京丸の内・横浜)　","title_link":"https://www.ishioroshi.com/biz/kaisetu/roumu/index/roudoushagimu_fukugyou/","text":"副業（兼業）の禁止に関する諸問題 副業を禁止することはできるか まず、労働基準法などの法律では、副業禁止の規定はありませんから、就業規則で定めないかぎり、禁止はできません。 そして、実際に多くの就業規則では、副業の禁止が含まれています。もっとも、就業規則で禁止するとしても、厳密に考えると無制限に","blocks":null,"service_name":"ishioroshi.com","service_icon":"https://www.ishioroshi.com/favicon.ico","from_url":"https://www.ishioroshi.com/biz/kaisetu/roumu/index/roudoushagimu_fukugyou/","original_url":"https://www.ishioroshi.com/biz/kaisetu/roumu/index/roudoushagimu_fukugyou/"}],"team":"T03C4RC8V","reactions":[{"name":"naruhodo","count":1,"users":["U776661HA"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ggcM"}]},{"client_msg_id":"01ade12d-a029-45ae-9ca7-588002505e68","type":"message","user":"U013QL1RAPN","text":"労働契約時にどうしているかによるかと","ts":"1636703759.392000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jlnu"}]},{"client_msg_id":"dde17902-e7f4-49c3-bf2c-ef9e008b4c07","type":"message","user":"U776661HA","text":"（法的に副業って禁止できたんでしたっけ？）","ts":"1636703728.391600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hnimZ"}]},{"client_msg_id":"1e58e971-93b6-4b6f-84ab-1465888b226d","type":"message","user":"U72TB62UF","text":"めっちゃ優秀な社員さんが半年で退社。\n管理業務が嫌になったんだろうなぁ…","ts":"1636703552.390600","edited":{"user":"U72TB62UF","ts":"1636703564.000000"},"team":"T03C4RC8V","reactions":[{"name":"tsurai_orange","count":3,"users":["U013QL1RAPN","U022XK5866Q","U782D5DF1"]},{"name":"totemoturai","count":3,"users":["U06ECBRTJ","U7JL1UKKL","U01J7703PFT"]}],"replace_original":