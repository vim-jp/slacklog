ethain.com/static/author.png","blocks":null,"ts":1586437200,"service_name":"lethain.com","service_icon":"https://lethain.com/favicon.ico","thumb_width":400,"thumb_height":400,"from_url":"https://lethain.com/staff-engineer-archetypes/","original_url":"https://lethain.com/staff-engineer-archetypes/"}],"team":"T03C4RC8V","reactions":[{"name":"eyes","count":1,"users":["U7CJ2P52B"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"WgWx"}]},{"client_msg_id":"e613f10c-52e0-4fda-965e-2298f2321e7e","type":"message","user":"UCL78DG68","text":"↑の流れを読んで、非マネジメントの方向で極めていく individual contributor (ないし staff engineer) のキャリアパスとか有名人のインタビューとかまとめた面白そうなサイトを最近見つけたことを思い出しました\n\u003chttps://staffeng.com/book\u003e","ts":"1627871957.079500","attachments":[{"fallback":"Staff Engineer: Leadership beyond the management track","id":1,"title":"Staff Engineer: Leadership beyond the management track","title_link":"https://staffeng.com/book","text":"Buy Staff Engineer: Leadership beyond the management track","blocks":null,"service_name":"staffeng.com","from_url":"https://staffeng.com/book","original_url":"https://staffeng.com/book"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"A3x"}]},{"client_msg_id":"0d0ae5bf-479b-4084-b393-57f9532c9d2f","type":"message","user":"U782D5DF1","text":"営業職でIT系の技術理解できるんならシャッチョさんになるだろうな\nエンジニアが経営とか業務にまで詳しくなったら起業するっつーねんに通じるものが・・・","ts":"1627861520.077700","edited":{"user":"U782D5DF1","ts":"1627861550.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"kQhVA"}]},{"client_msg_id":"a1687870-5424-45d2-ac56-37fc909b7115","type":"message","user":"U01J7703PFT","text":"営業の人が適当に出来ます出来ますって言って内容理解せずに仕事取ってきて\nいざエンジニアが行ってみたら事前に聞いていた内容と全然違ったっていうのは本当よくある(自分もあった)ケース","ts":"1627835918.072300","edited":{"user":"U01J7703PFT","ts":"1627835960.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5iBlY"}]},{"client_msg_id":"260717f1-6afa-4ef8-b3b4-73623e5eb119","type":"message","user":"U01J7703PFT","text":"営業職でIT系の技術をしっかり理解出来る人ってそんなにいないから技術営業とかいうのが有るというのは\n実際人事の人に聞いたことあったなそういえば","ts":"1627835828.071000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"WfqGy"}]},{"client_msg_id":"e0c0d103-5498-4541-b1e4-2dd290bf2780","type":"message","user":"UFHQ7TNT0","text":"セールスエンジニアという役職も、本来はそもそも営業が技術の勉強しろよっていうだけの話な気がする。\nただ、営業職で寄ってくる人って端的に言って勉強が苦手な人が多いから、営業に技術の勉強させるよりは、技術者に営業させたほうが早いみたいな話なのかも。","ts":"1627831624.069200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fFlZ"}]},{"client_msg_id":"966013fb-978a-4c51-9720-454affe305df","type":"message","user":"UFHQ7TNT0","text":"しかし、営業話術はこんなのもあるからなぁ\n\u003chttps://twitter.com/toricls/status/1421466463567683592?s=20\u003e","ts":"1627831292.065700","attachments":[{"fallback":"\u003chttps://twitter.com/toricls|@toricls\u003e: これは全世界の営業系ロールの方に向けたお気持ちなんですが、コスト削減を謳ってコンテナ売り込むのやめません？それ目的だとだいたい変な使い方し始めるんですよ\n『起動したコンテナの中で手作業でセットアップ作業して HTTP サーバー起動してますけど何か問題でも？』みたいなことをピュアな目でi","id":1,"author_name":"Tori Hara","author_subname":"@toricls","author_link":"https://twitter.com/toricls/status/1421466463567683592","author_icon":"https://pbs.twimg.com/profile_images/479342752941879297/BNYaEHfL_normal.png","text":"これは全世界の営業系ロールの方に向けたお気持ちなんですが、コスト削減を謳ってコンテナ売り込むのやめません？それ目的だとだいたい変な使い方し始めるんですよ\n『起動したコンテナの中で手作業でセットアップ作業して HTTP サーバー起動してますけど何か問題でも？』みたいなことをピュアな目でi","blocks":null,"footer":"Twitter","footer_icon":"https://a.slack-edge.com/80588/img/services/twitter_pixel_snapped_32.png","ts":1627738989,"service_name":"twitter","from_url":"https://twitter.com/toricls/status/1421466463567683592?s=20","original_url":"https://twitter.com/toricls/status/1421466463567683592?s=20"}],"team":"T03C4RC8V","reactions":[{"name":"totemoturai","count":2,"users":["UD1FQV38V","U01J7703PFT"]},{"name":"majika","count":1,"users":["U013QL1RAPN"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"GkRY"}]},{"client_msg_id":"424caf09-eb20-4336-bb32-1eca54696382","type":"message","user":"U78A6ESHM","text":"わかる。それら一人で全部できるのなら起業した方が良さそうと思えちゃう。\n(なので世の中セールスエンジニア/技術営業というロールがあるんだと思ってる)","ts":"1627830564.063100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0Pl=u"}]},{"client_msg_id":"fcf50f11-6e53-4728-9be4-99778d44f3a0","type":"message","user":"U03C71D7H","text":"(できるに越したことはないが)","ts":"1627830520.062300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Vgl=0"}]},{"client_msg_id":"237750be-1d8c-462e-b3d2-b9c60d3b078a","type":"message","user":"U03C71D7H","text":"1 人で全部やる必要はないはずなんだけどね…","ts":"1627830508.062000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"iPAfU"}]},{"client_msg_id":"748def24-7441-4d30-a051-37c50c5d04e6","type":"message","user":"UNJ2DANJC","text":"いい感じに顧客からマネーを引き出す能力\n欲しい","ts":"1627830478.061600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"rVJ"}]},{"client_msg_id":"9e65e8de-7827-4cc3-97b9-e22ff57a0529","type":"message","user":"UKHUVMBJR","text":"てなると非エンジニア目線でトークできるかも問われてきますねやはり","ts":"1627830357.060100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"KGf+"}]},{"client_msg_id":"4e0d1cad-9b86-409d-8019-7069dba8198e","type":"message","user":"U01J7703PFT","text":"だからそこで納得して頂く為の話術も重要になってくると...","ts":"1627830307.059400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0LEt3"}]},{"client_msg_id":"88280ca7-8ae9-4075-9bc8-43861e7712fa","type":"message","user":"U03C71D7H","text":"『顧客が本当に必要だったもの』は提供する前に提案して納得してもらうフェーズがある","ts":"1627830259.058700","team":"T03C4RC8V","re