.png","permalink_public":"https://slack-files.com/T03C4RC8V-F01SAHBS25B-805ac6b175","edit_link":"","preview":"","preview_highlight":"","lines":0,"lines_more":0,"is_public":true,"public_url_shared":false,"channels":null,"groups":null,"ims":null,"initial_comment":{},"comments_count":0,"num_stars":0,"is_starred":false,"shares":{"public":null,"private":null},"display_as_bot":false,"has_rich_preview":false,"thumb_800":"https://files.slack.com/files-tmb/T03C4RC8V-F01SAHBS25B-6f0c9e4c52/image_800.png","thumb_800_h":849,"thumb_800_w":800,"thumb_tiny":"AwAwAC2pnjp+lG4nsPypNx9qCxB7UAGT6UZ9hRvPtSbzQA7d7D8qQnNJu9hQDmgYvHpRkelAB9KOfSmIMr3FG5fSkIOeaTFIBcj0oznpSYpRxQA/I6bc03I9KXvnimkfSgB2R/d/WkyPSikxQAu4elFJiigD/9k=","username":""}],"reactions":[{"name":"+1","count":2,"users":["UL6CFN8NR","U9S4G0LJW"]},{"name":"goodpoem","count":2,"users":["U776661HA","U7B4ZD49X"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Rsl"}]},{"client_msg_id":"1e110dee-a579-4fed-8246-ac0d888906de","type":"message","user":"U017BU3UZBQ","text":"ある程度取り定めたテンプレートにしたがってまとめるのが良さそうですかね..\n元のPostの送信者には確認をとり、引用元もわかりやすい形で明記する、記事内に関連するpostを引用するあたりを気をつければとりあえずなんとななりそうでしょうか(読解力がないのでダメなところは教えてくださるとありがたいです)\n\ntipsをまとめるのはやれると思うのですが、媒体を用意するのはむずかしいです…\nZennとかにあげるのは違うような気もするし、GHPagesなどで作ってもGoogleにindexされる気がしない…\nとりあえずまとめた記事(md)は私のGithubに置いておくことにします。","ts":"1616669156.182000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"GGI"}]},{"client_msg_id":"4aef6d32-fbd6-4fd2-928a-745a21097b61","type":"message","user":"U782D5DF1","text":"vim、組み込み機能のtipsだけでも覚えきれないし\n一生完全に把握できる日は来ないと思うので\n検索できるようにtipsをwebに残してくれるだけでありがたいのです","ts":"1616659977.174700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"R3Oo+"}]},{"client_msg_id":"fde0f621-7aa3-4670-8eb2-f59960e95bb9","type":"message","user":"U7B4ZD49X","text":"まあけど所詮チャットなんで破片だけじゃよくわからんかったりするんですよね。。。そうなってくるとtogetterみたいにしないといけなくなる。そしてそれが見やすいかって話もある","ts":"1616659962.174300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"uFn"}]},{"client_msg_id":"447cbfc9-7861-4b4d-b6f2-69c2a8219ebe","type":"message","user":"UAZ33BKV2","text":"vim-jp slackから引用する前提なら、うまくテンプレート化しておけば事故らない自分も不安にならない、みたいなのはあるかな\n```Title\n\u0026lt;問題と解決方法\u0026gt; (個人が重要そうならxxさんのtipsが参考になり、など自分が思う定型文をとりあえず入れておく)\n\n\u0026lt;code\u0026gt;\n\n---\n\n引用 vim-jp slack (URL)```\nとか","ts":"1616659778.171800","edited":{"user":"UAZ33BKV2","ts":"1616669571.000000"},"team":"T03C4RC8V","reactions":[{"name":"+1","count":1,"users":["UL6CFN8NR"]},{"name":"+1::skin-tone-2","count":1,"users":["U017BU3UZBQ"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"dIO2Q"}]},{"client_msg_id":"151d7b25-3317-4748-9205-923248c1c986","type":"message","user":"UL6CFN8NR","text":"あー、ええと、「改変しない」というのは引用箇所のことですね。適切に引用を行なってから、その上で自身の解釈を載せるのは自由だと思います。なので解説を付け加えるぶんには問題ないかと","ts":"1616659726.170800","edited":{"user":"UL6CFN8NR","ts":"1616659771.000000"},"team":"T03C4RC8V","reactions":[{"name":"naruhodo","count":1,"users":["U017BU3UZBQ"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"t/01X"}]},{"client_msg_id":"4fcfd2a4-4df0-40fd-8dc2-1d1221030fb1","type":"message","user":"U017BU3UZBQ","text":"なるほど。\n今の内容ではコード片とアイデアを引用として扱っているのですが、コード片の箇所の明示はこれから対応できると思うのですが、アイデアについてどう扱うかが難しいです。解説を付け加える時点で改変に当たってしまうのか…\n\n例えば、冒頭に対象のPostをそのまま載せさせて頂き、解説を付け加えるといった形の方が元のpostが尊重され良いでしょうか（文章怪しくなっててすいません）\n\n最大限引用元のpostを尊重した形にしたいと思っています","ts":"1616659682.169500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"a161"}]},{"client_msg_id":"93e97b14-224a-4d03-a5ef-facd1ab53d72","type":"message","user":"UL6CFN8NR","text":"色々書いてしまいましたが、私が敏感になってるだけのような気もしてきました（アカデミックな分野では引用に関するトラブルを頻繁に見かけるので…）。\n満たしておいて悪いことはありませんが、運用の手間が極端に増えるならある程度柔軟に対応して良いかもですね。","ts":"1616659634.167800","thread_ts":"1616659634.167800","reply_count":1,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"lNh"}]},{"client_msg_id":"dc18c5f9-5eac-484a-b67a-a39cc2edb03d","type":"message","user":"UL6CFN8NR","text":"必然性や主従関係については多少主観も入りますしコンテンツにより事情も異なるので、2, 3はそこまで気にしなくて良いと思います（引用箇所貼って終わり、とかでない限り）。\n1, 4, 5 は引用元へのリスペクトを示す意味でも重要なので、引用を行うなら満たしておきたいですね。","ts":"1616658934.157200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"iIaC"}]},{"client_msg_id":"eaff7529-048a-49ad-aa2f-9a38701291b9","type":"message","user":"U017BU3UZBQ","text":"わざわざ調べてくださってありがとうございます。\n先ほどお見せしたリポジトリの内容ですと\n1-\u0026gt;X  2-\u0026gt;△  3-\u0026gt;O  4-\u0026gt;X  5-\u0026gt;O と言った感じなので、今のスタイルで行くとしたら許諾を取る必要はありそうですね。","ts":"1616658176.152600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"EzA"}]},{"client_msg_id":"48aea361-11fb-4c4e-96d1-166db581b574","type":"message","user":"UL6CFN8NR","text":"\u003chttps://storialaw.jp/blog/6114|こちらのブログ\u003eによると\n\u0026gt; １　本文と引用部分を明瞭に区分する（ブログの場合はblockquoteタグで囲む等）\n\u0026gt; ２　本文（自分の記事）がメインで、引用部分がサブ（主従）の関係にある（質的にも量的にも）\n\u0026gt; ３　引用する必然性がある\n\u0026gt; ４　改変しない\n\u0026gt; ５　出典を明記する（出所明示）\nが適切な引用の条件ということですので、これが満たされていれば許諾を得なくてもそこまで大きなトラブルにはならないと思います。","ts":"1616657594.149900","edited":{"user":"UL6CFN8NR","ts":"1616657608.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Zhsd"}]},{"client_msg_id":"858d252c-b822-455f-a96c-fea087229be3","type":"message","user":"UL6CFN8NR","text":"こういうの、トラブルになったときが一番面倒で手間がかかりますからね…\n懸念事項はなるべく潰しておきたい","ts":"1616656440.144400","edited":{"user":"UL6CFN8NR","ts":"1616656453.000000"},"team":"T03C4RC8V","reactions":[{"name":"hai-small","count":2,"users":["U017BU3UZBQ","U782D5DF1"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"nfUj"}]},{"client_msg_id":"3b5a1ba0-37af-4d9a-a621-926f808d645a","type":"message","user":"U782D5DF1","text":"雑に言うと\nログからtipsの形に整理して記事にするのと\nログをゴロッと掲載のためにログの発言者の許可取るの\nどっちの手間を選択するかになるのかな？","ts":"1616654261.144200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"eR0iq"}]},{"client_msg_id":"6ab6e31c-8cd9-4218-ba88-0c00fa80a9b2","type":"message","user":"U7B4ZD49X","text":"一応公開情報ということになってるからそんなに気にしなくてよいと思いますよ（改変しなければ特に）まとめてくれる人いたほうが絶対有益ですしいい感じにエコシステムが形成されそうな気がしてます。\n泥臭い作業だからあんまり面倒くさいと誰もやらなくなってしまいそうだし。","ts":"1616653374.140300","team":"T03C4RC8V","reactions":[{"name":"desune","count":1,"users":["UAZ33BKV2"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"d/F+/"}]},{"client_msg_id":"21c78f30-a103-4add-b26b-645d36c92ef8","type":"message","user":"UGH7U3SF2","text":"（許可を取る話はなにもせずQiitaにスクショのっけてしまいましたごめんなさい","ts":"1616653039.137900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Zyqa6"}]},{"client_msg_id":"e4efffda-6d9c-4914-933d-cc653cd570f6","type":"message","user":"U06ECBRTJ","text":"\u003chttps://slack.com/intl/ja-jp/blog/news/salesforce-signs-definitive-agreement-to-acquire-slack\u003e\n過去ログ見てたら思い出した","ts":"1616639737.137600","attachments":[{"fallback":"Slack: Salesforce が Slack 買収の最終契約を締結","id":1,"title":"Salesforce が Slack 買収の最終契約を締結","title_link":"https://slack.com/intl/ja-jp/blog/news/salesforce-signs-definitive-agreement-to-acquire-slack","text":"世界 No.1 の CRM と革新的なエンタープライズコミュニケーションプラットフォームの組み合わせで、新しい働き方のオペレーティングシステムが誕生","image_url":"https://d34u8crftukxnk.cloudfront.net/slackpress/prod/sites/6/News-Social-Unfurl.jpg","blocks":null,"service_name":"Slack","service_icon":"https://a.slack-edge.com/80588/marketing/img/meta/favicon-32.png","from_url":"https://slack.com/intl/ja-jp/blog/news/salesforce-signs-definitive-agreement-to-acquire-slack","original_url":"https://slack.com/intl/ja-jp/blog/news/salesforce-signs-definitive-agreement-to-acquire-s