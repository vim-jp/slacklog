%AC%E3%83%AB%E3%83%8B%E3%82%AF%E5%8A%B9%E6%9E%9C%EF%BC%88%E3%83%84%E3%82%A1%E3%82%A4%E3%82%AC%E3%83%AB%E3%83%8B%E3%82%AF%E3%81%93%E3%81%86%E3%81%8B%E3%80%81Zeigarnik,%E8%A6%9A%E3%81%88%E3%81%A6%E3%81%84%E3%82%8B%E3%81%A8%E3%81%84%E3%81%86%E7%8F%BE%E8%B1%A1%E3%80%82|https://ja.wikipedia.org/wiki/%E3%83%84%E3%82%A1%E3%82%A4%E3%82%AC%E3%83%AB%E3%83%8B%E3%82%AF%E5%8A%B9%E6%9E%9C#:~:text=%E3%83%8[…]E8%B1%A1%E3%80%82\u003e","ts":"1632179951.263900","attachments":[{"fallback":"wikipedia: ツァイガルニク効果","id":1,"author_name":"Wikipedia","author_link":"https://ja.wikipedia.org/","title":"ツァイガルニク効果","title_link":"https://ja.wikipedia.org/wiki/%E3%83%84%E3%82%A1%E3%82%A4%E3%82%AC%E3%83%AB%E3%83%8B%E3%82%AF%E5%8A%B9%E6%9E%9C#:~:text=%E3%83%84%E3%82%A1%E3%82%A4%E3%82%AC%E3%83%AB%E3%83%8B%E3%82%AF%E5%8A%B9%E6%9E%9C%EF%BC%88%E3%83%84%E3%82%A1%E3%82%A4%E3%82%AC%E3%83%AB%E3%83%8B%E3%82%AF%E3%81%93%E3%81%86%E3%81%8B%E3%80%81Zeigarnik,%E8%A6%9A%E3%81%88%E3%81%A6%E3%81%84%E3%82%8B%E3%81%A8%E3%81%84%E3%81%86%E7%8F%BE%E8%B1%A1%E3%80%82","text":"ツァイガルニク効果（ツァイガルニクこうか、Zeigarnik effect）は、人は達成できなかった事柄や中断している事柄のほうを、達成できた事柄よりもよく覚えているという現象。ツァイガルニック効果、ゼイガルニク効果、ゼイガルニック効果とも表記する。\nドイツのゲシュタルト心理学者クルト・レヴィンの「人は欲求によって目標指向的に行動するとき 緊張感 が生じ持続するが、目標が達成されると緊張感は解消する」という考えに基づき、リトアニア出身で旧ソビエト連邦の心理学者ブリューマ・ゼイガルニク（1901年11月9日 - 1988年2月24日）が「目標が達成されない行為に関する未完了課題についての記憶は、完了課題についての記憶に比べて想起されやすい」との事実を実験的に示した。以上がツァイガルニク効果。\nさらに、ツァイガルニクらには、未完成の図形と完成した図形についての記憶研究もある。知覚の実験にあっては、未完成図形の方が完成図形に比べて記憶の度合いが悪い。\n自分自身の行為を記憶する過程と、視覚像を記憶する過程とは、相異なる法則性に従っている。","blocks":null,"service_icon":"https://a.slack-edge.com/80588/img/unfurl_icons/wikipedia.png","from_url":"https://ja.wikipedia.org/wiki/%E3%83%84%E3%82%A1%E3%82%A4%E3%82%AC%E3%83%AB%E3%83%8B%E3%82%AF%E5%8A%B9%E6%9E%9C#:~:text=%E3%83%84%E3%82%A1%E3%82%A4%E3%82%AC%E3%83%AB%E3%83%8B%E3%82%AF%E5%8A%B9%E6%9E%9C%EF%BC%88%E3%83%84%E3%82%A1%E3%82%A4%E3%82%AC%E3%83%AB%E3%83%8B%E3%82%AF%E3%81%93%E3%81%86%E3%81%8B%E3%80%81Zeigarnik,%E8%A6%9A%E3%81%88%E3%81%A6%E3%81%84%E3%82%8B%E3%81%A8%E3%81%84%E3%81%86%E7%8F%BE%E8%B1%A1%E3%80%82","original_url":"https://ja.wikipedia.org/wiki/%E3%83%84%E3%82%A1%E3%82%A4%E3%82%AC%E3%83%AB%E3%83%8B%E3%82%AF%E5%8A%B9%E6%9E%9C#:~:text=%E3%83%84%E3%82%A1%E3%82%A4%E3%82%AC%E3%83%AB%E3%83%8B%E3%82%AF%E5%8A%B9%E6%9E%9C%EF%BC%88%E3%83%84%E3%82%A1%E3%82%A4%E3%82%AC%E3%83%AB%E3%83%8B%E3%82%AF%E3%81%93%E3%81%86%E3%81%8B%E3%80%81Zeigarnik,%E8%A6%9A%E3%81%88%E3%81%A6%E3%81%84%E3%82%8B%E3%81%A8%E3%81%84%E3%81%86%E7%8F%BE%E8%B1%A1%E3%80%82"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hCfm"}]},{"client_msg_id":"e897ba30-25ab-41b5-af55-44beaf2f9d74","type":"message","user":"U01AQ5BFNLX","text":"作業Aから作業Bに切り替えた場合意識の大部分が作業A（未達成のタスク）のことを考え続けるため生産性が低下することを証明した理論です","ts":"1632179891.263600","edited":{"user":"U01AQ5BFNLX","ts":"1632179933.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"VgJ"}]},{"client_msg_id":"64112afe-2d8a-4712-82f6-543d9236632a","type":"message","user":"U01AQ5BFNLX","text":"って感じですね。このあたりは「ツァイガルニク効果」と呼ばれる有名な理論があります","ts":"1632179842.262600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"1iNq"}]},{"client_msg_id":"ffbac034-542b-45a9-af05-e6120ce8f59f","type":"message","user":"U01AQ5BFNLX","text":"あくまでもタスクを切り替えているだけ、更に切り替えるたびに集中力は減少していく","ts":"1632179804.261800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"rvm"}]},{"client_msg_id":"bf297336-bb11-44be-9210-1de30266dabe","type":"message","user":"U01AQ5BFNLX","text":"ですね","ts":"1632179778.261200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"D+m"}]},{"client_msg_id":"5fb86ee1-b0b2-4af6-a4fb-c9de85cae56a","type":"message","user":"UAZ33BKV2","text":"動作そのものというよりは、結果側が平行して進行しているか、ですしね","ts":"1632179612.260700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/tWA0"}]},{"client_msg_id":"60baca0d-f218-4544-8228-99084190c0d8","type":"message","user":"U03C4RC8X","text":"ですね","ts":"1632178738.259900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=B/"}]},{"client_msg_id":"f03ff87f-a12f-4df1-9a5a-6208d27dc2b4","type":"message","user":"U03C4RC8X","text":"single core multi green threads","ts":"1632178734.259600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"mmZi"}]},{"client_msg_id":"11419fd8-e03f-4c96-b9bd-3173d1c4209b","type":"message","user":"U01AQ5BFNLX","text":"俗に言われているマルチタスクは「タスクスイッチング」と呼ばれるものでマルチタスクではありません。\n人間の脳は複数のことを同時進行するようにはできていません","ts":"1632178535.259100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"N2C"}]},{"client_msg_id":"3f26ac84-1c6e-4c76-9ebd-3994e1eae0e3","type":"message","user":"U03C4RC8X","text":"(parallelではないのでそういう意味では安心)","ts":"1632156669.258200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Z1dD"}]},{"client_msg_id":"03f51f1c-1f14-491e-94d0-3cd231ef0cfc","type":"message","user":"U03C4RC8X","text":"あと短期スパンの戦術と長期スパンの戦略をどちらもつねに考える必要があるとかも","ts":"1632156658.257800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"vlurV"}]},{"client_msg_id":"8e5caaa3-63b3-4b72-8eee-6316b9a37827","type":"message","user":"U03C4RC8X","text":"建設とか改善とか開拓とか戦争とか研究とかどうしてもいろんな要素をconcurrentにやっていかないといけない","ts":"1632156639.257300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jwE0w"}]},{"client_msg_id":"2bbcb261-fc57-4ffb-8dd9-518a4ec15034","type":"message","user":"U03C4RC8X","text":"あれどんなに頑張っても直列で作業できないので","ts":"1632156605.256100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks"