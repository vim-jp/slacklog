ublic":true,"public_url_shared":false,"channels":null,"groups":null,"ims":null,"initial_comment":{},"comments_count":0,"num_stars":0,"is_starred":false,"shares":{"public":null,"private":null},"display_as_bot":false,"has_rich_preview":false,"thumb_800":"https://files.slack.com/files-tmb/T03C4RC8V-F028B4BE9EY-a2ceb6671f/image_800.png","thumb_800_h":336,"thumb_800_w":800,"thumb_tiny":"AwAUADDRAGeMYp3emEbTxmlIz60AHzUvze1N2j3pwoAOfSj8KWigBCM0AcUUtACYopaKACiiigD/2Q==","username":""}],"replace_original":false,"delete_original":false,"blocks":null},{"client_msg_id":"47d251f2-21b1-48f3-949c-7c5d064ba0e1","type":"message","user":"UDDCM376D","text":"\u0026gt; 適当にやると糖質が意外と追い上げてくる\n今日記録して思いましたね","ts":"1626332997.429400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"iBrye"}]},{"client_msg_id":"0a1345d0-6cd0-4a66-bd23-7f8a3802eb1f","type":"message","user":"U023H98P3N0","text":"意図的にケトーシス状態へもっていくダイエット方法だったと記憶してます。\n糖質をほぼ全面カットすることでケトーシスを起こしやすくして、その分使用されやすい脂肪酸を摂取する。","ts":"1626332709.428700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"nIOW"}]},{"client_msg_id":"4ba36cfd-6042-40a4-bcea-e8a2aff9819d","type":"message","user":"U023FDA0AKC","text":"体内のグルコースを枯渇させて，脂肪酸からケトン体を作り出してこれをエネルギー源にするのがケトジェニックダイエットですね．\n\nそのために糖質はほぼカット，脂質をメインに摂るんですが，普段がローファットな食事なので洗い物が余計に辛くて・・・\n\n脂質を量摂るの確かに大変で，私がケトやったときは 1日に卵 8個，チーズ50g，MCTオイル 20g，調理油 30g，鶏もも or 豚こま を300g 摂取して PFCバランスが 25:70:5 だったので，計画的にやらないと大抵は失敗するらしいですね\n適当にやると糖質が意外と追い上げてくる","ts":"1626332605.427300","team":"T03C4RC8V","reactions":[{"name":"hee","count":2,"users":["U013QL1RAPN","U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5Po"}]},{"client_msg_id":"c1b193b9-b4b7-465d-a3c9-ef74b62ab29a","type":"message","user":"U782D5DF1","text":"それこそもこみちみたいにオリーブオイル飲んで\n料理に追いオリーブオイルしちゃうんかな","ts":"1626329652.420500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Ju/T"}]},{"client_msg_id":"71300a99-319e-4867-8191-52c5d0122b4f","type":"message","user":"U782D5DF1","text":"ただ、脂質ってそれ単体で量摂るって難しくない？","ts":"1626329594.419600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"P/4"}]},{"client_msg_id":"e3f4a0d6-a475-41f0-99d5-99627ae5192c","type":"message","user":"U782D5DF1","text":"脂質の割合を高くして炭水化物少なくしてる分のバランス取るって考え方なんかな","ts":"1626329523.418900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"E8/5k"}]},{"client_msg_id":"2fd9ed89-cc4e-4cb8-91ea-e0f08f1448cf","type":"message","user":"U782D5DF1","text":"ケトンと付くからタンパク質メインなんだろうなぁ","ts":"1626329306.417200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"CzIz"}]},{"client_msg_id":"9aa717e8-7e77-4bfe-9ad9-647a4a1ad574","type":"message","user":"U017BU3UZBQ","text":"その代わり炭水化物を減らすらしい？","ts":"1626329227.416600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"XYf"}]},{"client_msg_id":"e937d0fc-5a4f-4f8c-bd01-52bb650a2863","type":"message","user":"U03C6TEAZ","text":"脂質を取るダイエットなのか。","ts":"1626329206.416200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"7a8Y"}]},{"client_msg_id":"f19f8078-77a0-4f86-88b7-a187f64e1af9","type":"message","user":"UDDCM376D","text":"ケトは高脂質、中タンパク質、低糖質なので\nタンパク質とりすぎも駄目らなのが地味につらい","ts":"1626328785.415800","team":"T03C4RC8V","reactions":[{"name":"thinking_face","count":1,"users":["U022XK5866Q"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"M5ZIr"}]},{"client_msg_id":"62e44de0-4666-4bbe-a950-ae20f82d84a4","type":"message","user":"UDDCM376D","text":"\u0026gt; アーモンドとかのナッツ類だと脂質は取れそう。\n完食はそれが良いらしいですね","ts":"1626328739.415000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"rnW"}]},{"client_msg_id":"e2fe2c65-6d93-4a4d-a901-8d186e14d743","type":"message","user":"U023H98P3N0","text":"一時期流行ったバターコーヒーとかもケトジェニックの亜種だと考えると、かなりの脂質が必要そうですよね","ts":"1626328373.414600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"xWV"}]},{"client_msg_id":"9c306310-9264-47c6-8b67-0692af1236ca","type":"message","user":"U022XK5866Q","text":"煮豆やスープなら洗い物も楽そう","ts":"1626328277.413900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"B60Z"}]},{"client_msg_id":"b4f9542b-ca60-44e4-a399-6089c1392bd6","type":"message","user":"U022XK5866Q","text":"大豆とかどうでしょう。蛋白質も脂質も豊富。","ts":"1626328240.413400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"2nAF6"}]},{"client_msg_id":"0841a844-9974-4f34-a30b-81baccf7b1db","type":"message","user":"U013QL1RAPN","text":"塩とか取りすぎないように、選ばないといけないか。","ts":"1626328223.413000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Sn1"}]},{"client_msg_id":"85ce86c4-5077-4ee2-80b9-dba5714dbd49","type":"message","user":"U023H98P3N0","text":"炭水化物で摂っていたエネルギーを脂質で補う必要があるので、ナッツだけで足りるのかなぁ","ts":"1626328178.412400","team":"T03C4RC8V","reactions":[{"name":"naruhodo","count":3,"users":["U013QL1RAPN","U7JL1UKKL","U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Ms0"}]},{"client_msg_id":"7b759ecb-7aa8-4ec1-859c-17e0b367b23c","type":"message","user":"U013QL1RAPN","text":"アーモンドとかのナッツ類だと脂質は取れそう。","ts":"1626328109.411600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"gutQ7"}]},{"client_msg_id":"1174ec16-cd9f-4cf7-a4ec-a4f77d244fe0","type":"message","user":"U023H98P3N0","text":"脂質を大量に摂る必要があるので、洗い物の際に油汚れが辛いということではないでしょうか？","ts":"1626328059.410800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"7Z+"}]},{"client_msg_id":"a36dc86a-fde0-472a-9454-f79ae0151867","type":"message","user":"U03C6TEAZ","text":"なにか辛いんです？","ts":"1626327844.409700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"wnI"}]},{"client_msg_id":"c25c541b-b72b-49a9-96ea-f5472ab8fbc9","type":"message","user":"UDDCM376D","text":"あー、脂質…","ts":"1626326225.409100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"dNKpo"}]},{"client_msg_id":"d1fcd57d-68eb-4d09-83e2-ad392c20c40c","type":"message","user":"U023FDA0AKC","text":"ケトは洗い物が辛すぎてやめました","ts":"1626324124.408600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jw=gh"}]},{"client_msg_id":"1a1efe26-512b-40e1-8911-03fc7278211f","type":"message","user":"UDDCM376D","text":"今日から記録をとっていくことにしました","ts":"1626320691.408100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fwO"}]},{"type":"message","user":"UDDCM376D","ts":"1626320685.407700","files":[{"id":"F028ALYLSFN","created":1626320682,"timestamp":1626320682,"name":"image.png","title":"image.png","mimetype":"image/png","image_exif_rotation":0,"filetype":"png","pretty_type":"PNG","user":"UDDCM376D","mode":"hosted","editable":false,"is_external":false,"external_type":"","size":163863,"url":"","url_download":"","url_private":"https://files.slack.com/files-pri/T03C4RC8V-F028ALYLSFN/image.png","url_private_download":"https://files.slack.com/files-pri/T03C4RC8V-F028ALYLSFN/download/image.png","original_h":602,"original_w":1902,"thumb_64":"https://files.slack.com/files-tmb/T03C4RC8V-F028ALYLSFN-722d38674a/image_64.png","thumb_80":"https://files.slack.com/files-tmb/T03C4RC8V-F028ALYLSFN-722d38674a/image_80.png","thumb_160":"https://files.slack.com/files-tmb/T03C4RC8V-F028ALYLSFN-7