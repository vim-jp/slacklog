er=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen\u003e\u003c/iframe\u003e","video_html_width":400,"video_html_height":225,"from_url":"https://m.youtube.com/watch?v=tWHHMIer9g8","original_url":"https://m.youtube.com/watch?v=tWHHMIer9g8"}],"reply_count":2,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"xJI"}]},{"client_msg_id":"847f7250-90bb-4cb0-8504-1c8d84341306","type":"message","user":"U023FDA0AKC","text":"背中は意識するの難しいですよね\n器械体操やってたので広背筋は意識できるんですが，僧帽筋が難しすぎてやばいです","ts":"1627647597.011300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ujH"}]},{"client_msg_id":"CBF7ED9B-750D-4A62-AED6-F6B407545C6B","type":"message","user":"UDDCM376D","text":"背中鍛えるの難しすぎてやばい","ts":"1627647271.009600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"qSHi"}]},{"client_msg_id":"601D537B-9829-4288-A6EF-4209C67CC710","type":"message","user":"UDDCM376D","text":"この動画見ました","ts":"1627647258.009200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"oUV"}]},{"client_msg_id":"60b196d1-f56c-4923-a9b1-d52947d744ec","type":"message","user":"U023FDA0AKC","text":"参考文献はおそらくこちらです．\n\u003chttps://www.researchgate.net/publication/270003471_Evaluation_of_Open_and_Closed_Kinetic_Chain_Exercises_in_Rehabilitation_Following_Anterior_Cruciate_Ligament_Reconstruction|https://www.researchgate.net/publication/270003471_Evaluation_of_Open_and_Closed_Kineti[…]tation_Following_Anterior_Cruciate_Ligament_Reconstruction\u003e\n\n運動時に，動作する側の手足が固定されているクローズドキネティックチェーン種目は筋力・筋量が上がりやすいとのこと","ts":"1627647041.009000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"h6g1"}]},{"client_msg_id":"9d7bbabf-2e84-41b2-896b-b9926ccc5a34","type":"message","user":"U023FDA0AKC","text":"\u003chttps://www.youtube.com/watch?v=A6GS8OlyVyM\u0026amp;t=458s\u003e\n\n懸垂は背中トレの中でも全体的に筋力が上がりやすいから習得するのがオススメらしいですね","ts":"1627646836.007200","attachments":[{"fallback":"YouTube Video: 【筋トレ】マジのマジで背中の全てを置いてきた動画。","id":1,"author_name":"筋肉あるある","author_link":"https://www.youtube.com/channel/UCIzzH3m7wKDe-zrbg5RPBtw","title":"【筋トレ】マジのマジで背中の全てを置いてきた動画。","title_link":"https://www.youtube.com/watch?v=A6GS8OlyVyM\u0026amp;t=458s","thumb_url":"https://i.ytimg.com/vi/A6GS8OlyVyM/hqdefault.jpg","blocks":null,"service_name":"YouTube","service_icon":"https://a.slack-edge.com/80588/img/unfurl_icons/youtube.png","thumb_width":480,"thumb_height":360,"video_html":"\u003ciframe width=\"400\" height=\"225\" src=\"https://www.youtube.com/embed/A6GS8OlyVyM?feature=oembed\u0026start=458\u0026autoplay=1\u0026iv_load_policy=3\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen\u003e\u003c/iframe\u003e","video_html_width":400,"video_html_height":225,"from_url":"https://www.youtube.com/watch?v=A6GS8OlyVyM\u0026amp;t=458s","original_url":"https://www.youtube.com/watch?v=A6GS8OlyVyM\u0026amp;t=458s"}],"team":"T03C4RC8V","reactions":[{"name":"+1","count":1,"users":["U013QL1RAPN"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"2hE2/"}]},{"client_msg_id":"69C70692-8276-4755-9577-9E0C4FC9618C","type":"message","user":"UDDCM376D","text":"ぼくは広く持つと上がらないので背中の筋肉が足りてない","ts":"1627644775.006300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fg5Gm"}]},{"client_msg_id":"6641263B-C9B4-4643-B3E1-2A20DAD58579","type":"message","user":"UDDCM376D","text":"全く上がらない握り方と引きかただとどの部位の筋肉が弱いのかが分かるんで、どこの筋肉が足りないのかが分かります","ts":"1627644743.006200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"uj7"}]},{"client_msg_id":"162174DA-2CF2-4A72-8CED-C166689161AE","type":"message","user":"UDDCM376D","text":"懸垂は握り方と引き方で結構効く部位が変わるんですよね","ts":"1627644687.005100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"YG3G"}]},{"client_msg_id":"287aeb75-9e65-4aca-bb93-55df871feea6","type":"message","user":"UCL78DG68","text":"近所の公園でちまちま懸垂を続けていて、ようやくワイドグリップで上がるようになってきました\n最初は負荷のかけ方がまったくわからなかった","ts":"1627644586.004300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"6qYxg"}]},{"client_msg_id":"e1522b24-e23d-4ef2-9910-07764732df65","type":"message","user":"UAZ33BKV2","text":"というか種別でどの筋肉を鍛えるのかを意識して、内容を調整/運動時に意識的にその筋肉に負荷をかけないと運動として効率がよくないかもしれませんな(一言で懸垂っていってもいろいろあるみたいだし)","ts":"1627644344.003000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"d5T"}]},{"client_msg_id":"60BFF822-715E-4391-A076-CE958192E836","type":"message","user":"UDDCM376D","text":"そういえば、懸垂上がりやすいやり方と全然上がらないやり方があって、上がらない方は筋肉が足りてないんだなって思った","ts":"1627643764.001600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"pGc1"}]},{"client_msg_id":"2deaa3e9-889c-4ad3-976c-41f736591573","type":"message","user":"UDDCM376D","text":"これからジム\n懸垂頑張る","ts":"1627643522.000500","team":"T03C4RC8V","reactions":[{"name":"subara","count":3,"users":["U01BY3SDBRS","U01PMN2BVJQ","U023FDA0AKC"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"uh/0"}]},{"client_msg_id":"F7024572-A307-41E2-8FAA-D9A076CF77A5","type":"message","user":"UDDCM376D","text":"これ、良さそう\n今度やってみよ","ts":"1627649169.015400","thread_ts":"1627648423.011900","parent_user_id":"U011FTGJ3SN","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"9P/"}]}]
