0880/9633/products/3_1800x1800_b2c80d52-3a43-4f84-a2f2-c32d89a1aa07_1200x1200.jpg?v=1612415452","blocks":null,"service_name":"遊舎工房","service_icon":"http://cdn.shopify.com/s/files/1/0532/0880/9633/files/fc7fd70965795e87776f47f1af3432c4_32x32.jpg?v=1613113062","from_url":"https://shop.yushakobo.jp/products/a0500st/?variant=37665699463329","original_url":"https://shop.yushakobo.jp/products/a0500st/?variant=37665699463329"}],"subtype":"thread_broadcast","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"oEWy"}],"root":{"client_msg_id":"92ff6d05-24ec-48c4-b5db-6e0cf0a6d715","type":"message","user":"U76V658V6","text":"質問ばかりですみません。\nDZ60 RGB V2 ってどのサイズのスタビライザーを選べばいいのでしょうか。遊舎工房のサイトでは３つのなかから選ぶようになってるので。","ts":"1621900033.041600","thread_ts":"1621900033.041600","reply_count":1,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"YeBm"}]}},{"client_msg_id":"b1b8dcaf-a478-4118-8227-45a236f8f22e","type":"message","user":"U76V658V6","text":"先人のビルドログを見つけたので勉強してみます。\n\u003chttps://salicylic-acid3.hatenablog.com/entry/dz60rgb-build-log\u003e","ts":"1621901725.042300","attachments":[{"fallback":"自作キーボード温泉街の歩き方: 自作キーボードキット『DZ60 RGB v2』ビルドログ - 自作キーボード温泉街の歩き方","id":1,"title":"自作キーボードキット『DZ60 RGB v2』ビルドログ - 自作キーボード温泉街の歩き方","title_link":"https://salicylic-acid3.hatenablog.com/entry/dz60rgb-build-log","text":"こんにちは。自キ温泉ガイドのサリチル酸です。 今回は一体型キーボードキット『DZ60 RGB v2』の組み立て記録、ビルドログを書きたいと思います。","image_url":"https://cdn-ak.f.st-hatena.com/images/fotolife/S/Salicylic_acid3/20210216/20210216020554.png","blocks":null,"ts":1613430000,"service_name":"自作キーボード温泉街の歩き方","service_icon":"https://salicylic-acid3.hatenablog.com/icon/touch","from_url":"https://salicylic-acid3.hatenablog.com/entry/dz60rgb-build-log","original_url":"https://salicylic-acid3.hatenablog.com/entry/dz60rgb-build-log"}],"edited":{"user":"U76V658V6","ts":"1621901815.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"l4w8M"}]},{"client_msg_id":"92ff6d05-24ec-48c4-b5db-6e0cf0a6d715","type":"message","user":"U76V658V6","text":"質問ばかりですみません。\nDZ60 RGB V2 ってどのサイズのスタビライザーを選べばいいのでしょうか。遊舎工房のサイトでは３つのなかから選ぶようになってるので。","ts":"1621900033.041600","thread_ts":"1621900033.041600","reply_count":1,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"YeBm"}]},{"client_msg_id":"ce948737-d446-47ed-9745-671d209e0b6b","type":"message","user":"U76V658V6","text":"大阪住みなので遊舎工房の店舗に行くのは難しいですね。","ts":"1621894942.040100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hxR"}]},{"client_msg_id":"7474b5ae-58a8-4c41-8eea-0d6c63822364","type":"message","user":"U76V658V6","text":"DZ60 RGB V2 ですがソケット式っていうのがメンテナンスが楽そうでけっこういいなぁと思いました。","ts":"1621894829.039200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"FsLP"}]},{"client_msg_id":"08c867b9-6df2-4d11-8fde-0554b47a46a5","type":"message","user":"U76V658V6","text":"基板から起こすのはもう少し先ですかね。\n• 最初は必要な工具は最低限でスクラッチ可能なもの\n• 工具を揃えてあまり組み上げるのが難しくないもの (\u003chttps://shop.yushakobo.jp/collections/keyboard-parts/products/promicro-spring-pinheader|Pro Micro\u003eのハンダづけでなんかやらかしてしまいそう)\n• 難易度を上げて組み上げる\nくらいまでが自分の限界かなと思ってます。基板起こしは電気の知識が一切ないので今は難しいかもです。","ts":"1621894683.037900","attachments":[{"fallback":"遊舎工房: Pro Micro （コンスルー付き）","id":1,"title":"Pro Micro （コンスルー付き）","title_link":"https://shop.yushakobo.jp/collections/keyboard-parts/products/promicro-spring-pinheader","text":"Pro Micro互換機とコンスルー（スプリングピンヘッダ）のセットです。 各種キーボードキットの保守部品になります。","image_url":"http://cdn.shopify.com/s/files/1/0532/0880/9633/products/promicro-012_1200x1200.jpg?v=1612415901","blocks":null,"service_name":"遊舎工房","service_icon":"http://cdn.shopify.com/s/files/1/0532/0880/9633/files/fc7fd70965795e87776f47f1af3432c4_32x32.jpg?v=1613113062","from_url":"https://shop.yushakobo.jp/collections/keyboard-parts/products/promicro-spring-pinheader","original_url":"https://shop.yushakobo.jp/collections/keyboard-parts/products/promicro-spring-pinheader"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=qi"}]},{"client_msg_id":"b067f54e-9ba1-4751-b0e6-899e282dc90c","type":"message","user":"U76V658V6","text":"DZ60 RGB V2 ってはんだごてすら持ってないので最初に手を付けるにはよさげですね。組み上げるのも難しくなさそうですし。","ts":"1621894343.034400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"3IQg"}]},{"client_msg_id":"7940e1f7-476b-4e9b-9bff-74fb2eaf5a7f","type":"message","user":"U06BRP8VD","text":"ああ、プラは干渉します。が、そこはあらかじめ切っとくと良い。","ts":"1621923058.051000","thread_ts":"1621919874.050600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"EHx"}]},{"client_msg_id":"9d5b8d84-55b6-47d6-a111-268728c2a112","type":"message","user":"U06BRP8VD","text":"ちょっとしたニッパーがあれば切れるので。","ts":"1621923069.051200","thread_ts":"1621919874.050600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"V=KT"}]},{"client_msg_id":"684d8cc0-ba05-4795-a9b9-8a36b7fbdc74","type":"message","user":"U06BRP8VD","text":"\u003chttps://www.kaoriya.net/blog/2021/04/23/diy-keyboards-in-5-months/kb007c.jpg\u003e\n\n切るのはこんな感じ。","ts":"1621923125.051800","thread_ts":"1621919874.050600","attachments":[{"fallback":"677x481px image","id":1,"image_url":"https://www.kaoriya.net/blog/2021/04/23/diy-keyboards-in-5-months/kb007c.jpg","blocks":null,"from_url":"https://www.kaoriya.net/blog/2021/04/23/diy-keyboards-in-5-months/kb007c.jpg","original_url":"https://www.kaoriya.net/blog/2021/04/23/diy-keyboards-in-5-months/kb007c.jpg"}],"parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Vk9x4"}]},{"client_msg_id":"