","block_id":"b98gd"}]},{"client_msg_id":"0d2d8eb7-a6b3-4924-b391-24e25bc2eff6","type":"message","user":"UDPT2BZ6E","text":"ありすえさんが素早い回答すぎてすごい。。ありがとうございますー!","ts":"1618222655.231000","team":"T03C4RC8V","reactions":[{"name":"quick_alisue","count":3,"users":["U7B4ZD49X","U06ECBRTJ","UL6CFN8NR"]},{"name":"fuita","count":1,"users":["U776661HA"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ePg3"}]},{"client_msg_id":"e93edf3d-6bc3-4328-8ecb-161f23e0b1b7","type":"message","user":"UAZ33BKV2","text":"これは、結合してからUser抽出するか、結合時にいっぺんに処理しちゃうか..","ts":"1618222610.230800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"8qI7"}]},{"client_msg_id":"ccbe5926-3d58-44a5-8c81-228fb44ffccb","type":"message","user":"UAZ33BKV2","text":"おっと私のはちょっとミスってたな...","ts":"1618222568.230200","team":"T03C4RC8V","reactions":[{"name":"bow","count":1,"users":["UDPT2BZ6E"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Mw7"}]},{"client_msg_id":"1f7c32d0-c901-4825-a9ab-60593b0a69ed","type":"message","user":"U776661HA","text":"でいけそう","ts":"1618222553.229800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"FXc"}]},{"client_msg_id":"fd382ea3-c390-464c-b36d-7b7a922ffaa7","type":"message","user":"U776661HA","text":"```dic_res = {k: dic_a_map[k] | dic_b_map[k] for k in set(dic_a_map.keys()) | set(dic_b_map.keys())}```","ts":"1618222549.229500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"yDh"}]},{"client_msg_id":"07b55e00-d363-439a-b1c5-a8701da3fa11","type":"message","user":"UDPT2BZ6E","text":"続けての質問になって申し訳ないんですが、こういう風にデータを持ち直したいときにおすすめな方法ありますでしょうか。。？\n愚直に書く方法しか思いつかなかったんですよね。。\n```dic_a = [\n    {'User': 'a', 'Enabled': True, 'UserStatus': 'FORCE_CHANGE_PASSWORD'},\n    {'User': 'b', 'Enabled': False, 'UserStatus': 'ARCHIVED'}\n]\n\ndic_b = [\n    {'User': 'a', 'email': '\u003cmailto:mary@example.com|mary@example.com\u003e', 'email_verified': True},\n    {'User': 'b', 'email': '\u003cmailto:bob@example.com|bob@example.com\u003e', 'email_verified': False}\n]\n\ndic_res = {\n    'a': {\n        'Enabled': True,\n        'UserStatus': 'FORCE_CHANGE_PASSWORD',\n        'email': '\u003cmailto:mary@example.com|mary@example.com\u003e',\n        'email_verified': True\n    },\n    'b': {\n        'Enabled': False,\n        'UserStatus': 'ARCHIVED',\n        'email': '\u003cmailto:bob@example.com|bob@example.com\u003e',\n        'email_verified': False\n    }\n}```","ts":"1618222506.228600","edited":{"user":"UDPT2BZ6E","ts":"1618222522.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"72Q"}]},{"client_msg_id":"5f476f3a-1a7c-4631-99bf-afbe954aa663","type":"message","user":"U776661HA","text":"`|` が便利すぎて、これだけで Python 3.9 にしたくなる","ts":"1618222463.228400","team":"T03C4RC8V","reactions":[{"name":"benri","count":2,"users":["UDPT2BZ6E","U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/i="}]},{"client_msg_id":"120625eb-8a6d-469b-b03d-669836e9e090","type":"message","user":"U776661HA","text":"僕のコードで `dic_a_map[k] | dic_b_map[k]` となってるところは `dict(dic_a_map[k], **dic_b_map[k])` に置き換えられますよ、という意味でした","ts":"1618222399.227900","team":"T03C4RC8V","reactions":[{"name":"naruhodo","count":1,"users":["UDPT2BZ6E"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Dd53O"}]},{"client_msg_id":"549e37db-f236-494c-84db-b46f63e18d97","type":"message","user":"UDPT2BZ6E","text":"dict試したんですが、\n```\u0026gt;\u0026gt;\u0026gt; dict(dic_b, **dic_a)\nTraceback (most recent call last):\n  File \"\u0026lt;stdin\u0026gt;\", line 1, in \u0026lt;module\u0026gt;\nTypeError: dict() argument after ** must be a mapping, not list```\nでした。今相手にしてるのが2つの辞書じゃなくて、2つの辞書のリストなんですよね。\nそして、変数名が悪かったですね。","ts":"1618222338.227000","edited":{"user":"UDPT2BZ6E","ts":"1618222353.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=j2k"}]},{"client_msg_id":"13b51a26-d228-4099-b4cc-5bafe9d217e4","type":"message","user":"UDPT2BZ6E","text":"ちゃんと動きましたー! なるほど、ありがとうございます。","ts":"1618222247.225700","team":"T03C4RC8V","reactions":[{"name":"tada","count":3,"users":["U776661HA","U9S4G0LJW","U06BRP8VD"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"94G"}]},{"client_msg_id":"4e8efa17-b405-46a3-9670-ce0e65c60c24","type":"message","user":"UDPT2BZ6E","text":"あ、それはないです。20件くらいを想定してます。","ts":"1618222162.225200","team":"T03C4RC8V","reactions":[{"name":"angxing","count":3,"users":["U776661HA","U06BRP8VD","U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"mku"}]},{"client_msg_id":"f5bf1b57-1ea1-4d41-bedd-c1eae7a40843","type":"message","user":"U06BRP8VD","text":"# 片方に億とか入ってたら「ちょまてよ」ってなる。","ts":"1618222130.224800","team":"T03C4RC8V","reactions":[{"name":"wakaru","count":1,"users":["U776661HA"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"d5UY"}]},{"client_msg_id":"16b14038-6af4-4541-8db1-61be0c78df57","type":"message","user":"U776661HA","text":"ちなみに、読みやすいから `|` で書いているだけで、やってるのは \u003chttps://vim-jp.slack.com/archives/CK2REVD8E/p1618221596218500\u003e　と同じです。なので Python 3.8 とかでもできます","ts":"1618222122.224500","attachments":[{"fallback":"[April 12th, 2021 2:59 AM] tsuyoshi_cho: なら、ここの記述を信じると\n\u003chttps://blog.utgw.net/entry/2017/08/04/013507\u003e\n```dict_res = dict(dict_b, **dict_a)```\nかな?","id":1,"author_id":"UAZ33BKV2","author_name":"Tsuyoshi CHO","author_subname":"Tsuyoshi CHO","author_link":"https://vim-jp.slack.com/team/UAZ33BKV2","author_icon":"https://avatars.slack-edge.com/2018-05-31/373472791093_ed16847a152da533e013_48.png","text":"なら、ここの記述を信じると\n\u003chttps://blog.utgw.net/entry/2017/08/04/013507\u003e\n```dict_res = dict(dict_b, **dict_a)```\nかな?","mrkdwn_in":["text"],"blocks":null,"footer":"Posted in #lang-python","ts":1618221596.218500,"from_url":"https://vim-jp.slack.com/archives/CK2REVD8E/p1618221596218500","original_url":"https://vim-jp.slack.com/archives/CK2REVD8E/p1618221596218500"}],"edited":{"user":"U776661HA","ts":"1618222190.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"m5d"}]},{"client_msg_id":"287dad56-22dd-4302-9e4f-52b64cd4ca14","type":"message","user":"U776661HA","text":"1. 配列内のどのペアが結合されるかを決定する方法（僕の例では map 使って `User` の値で合わせた）\n2. ペアの結合方法（僕の例では単純な辞書結合使った `|` ）\nって分けて考えるといい感じにできそうです","ts":"1618222039.223600","team":"T03C4RC8V","reactions":[{"name":"man-bowing","count":1,"users":["UDPT2BZ6E"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ktZ"}]},{"client_msg_id":"0026143e-1ee4-463a-bd1d-1179fe3f4e70","type":"message","user":"UDPT2BZ6E","text":"なるほど。(入れてるPythonが3.8だったので、急遽インストールしてます)","ts":"1618221887.222000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"J=V"}]},{"client_msg_id":"73572f15-5814-471c-b887-fbbbce23766c","type":"message","user":"U06BRP8VD","text":"あとは仮にouter joinなら、1つのmapで要素2個のタプルを値にして、aとbをぶら下げて両方揃ってるものだけを出力、という手もあるかもしれない。","ts":"1618221740.221200","edited":{"user":"U06BRP8VD","ts":"1618221771.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"E9Y"}]},{"client_msg_id":"38965d68-d051-4809-aabd-cd45fa11144d","type":"message","user":"U776661HA","text":"余分なものを打ち込むコードが必要になるくらいですね","ts":"1618221693.220500","thread_ts":"1618221693.220500","reply_count":1,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"3hZS"}]},{"client_msg_id":"3391cf57-6580-4d98-821b-21044c9cfbda","type":"message","user":"U776661HA","text":"あ、ですね","ts":"1618221663.220100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4t59"}]},{"client_msg_id":"92388a8b-56d3-41c6-b464-51d9b2392956","type":"message","user":"U06BRP8VD","text":"a が基準ならmap作るのbだけでよくない?","ts":"1618221649.219900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"rb7"}]},{"client_msg_id":"92af9e05-a55f-4930-a527-73d45e236893","type":"message","user":"UAZ33BKV2","text":"あー、たしかに","ts":"1618221641.219700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"o4Os"}]},{"client_msg_id":"8819f574-fc2f-4c2a-b54c-6f55a134baa2","type":"message","user":"U776661HA","text":"Python 3.9 の記法使ってるので注意です","ts":"1618221632.219400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5gN"}]},{"client_msg_id":"d2c5e252-c3a4-4ef2-a951-cbdc052d4b11","type":"message","user":"U78A6ESHM","text":"あ、ありすえさんの方","ts":"1618221623.219100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"v/W"}]},{"client_msg_id":"140c1e50-f87b-4f81-9a6a-c91e4c7680d7","type":"message","user":"U78A6ESHM","text":"↑良さそう。","ts":"1618221612.218800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"SB+"}]},{"client_msg_id":"41e99cac-2887-4ffc-96cd-701f3a0b28a8","type":"message","user":"UAZ33BKV2","text":"なら、ここの記述を信じると\n\u003chttps://blog.utgw.net/entry/2017/08/04/013507\u003e\n```dict_res = dict(dict_b, **dict_a)```\nかな?","ts":"1618221596.218500","attachments":[{"fallback":"私が歌川です: Python で2つの辞書をマージした新しい辞書を作りたいとき - 私が歌川です","id":1,"title":"Python で2つの辞書をマージした新しい辞書を作りたいとき - 私が歌川です","title_link":"https://blog.utgw.net/entry/2017/08/04/013507","text":"要件 辞書 d1 と d2 をマージして新しい辞書を作りたい． 重複するキーがあった場合は d2 の値を優先することにする． たとえば {'a': 1, 'b': 2} と {'b': 3, 'c': 4} をマージすると {'a': 1, 'b': 3, 'c': 4} となってほしい． マージをする過程で d1 や d2 の中身は書き換えたくない． 方法 dict(d1, **d2) d2 をキーワード引数として展開して dict のコンストラクタに渡すという方法． キーワード引数が与えられた場合、キーワード引数とその値が位置引数から作られた辞書に追加されます。既に存在しているキーが追加さ…","image_url":"https://ogimage.blog.st-hatena.com/8454420450101794816/8599973812285464759/1602028410","blocks":null,"ts":1501778107,"service_name":"私が歌川です","service_icon":"https://blog.utgw.net/icon/touch","from_url":"https://blog.utgw.net/entry/2017/08/04/013507","original_url":"https://blog.utgw.net/entry/2017/08/04/013507"}],"team":"T03C4RC8V","reactions":[{"name":"interrobang","count":1,"users":["UDPT2BZ6E"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ZGNX"}]},{"client_msg_id":"7c5fceef-fc32-4fbf-9c7e-94781c672cb2","type":"message","user":"U776661HA","text":"とか？","ts":"1618221553.217800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"pOr"}]},{"client_msg_id":"73dd68db-8fff-4f83-9be6-048ea04baa4c","type":"message","user":"U776661HA","text":"```dic_a_map = {x['User']: x for x in dic_a}\ndic_b_map = {x['User']: x for x in dic_b}\ndic_res = [dic_a_map[k] | dic_b_map[k] for k in set(dic_a_map.keys()) | set(dic_b_map.keys())]\nprint(dic_res)```","ts":"1618221549.217600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"cLadX"}]},{"client_msg_id":"d70dfabd-f3aa-4790-aff8-8540af87f9b8","type":"message","user":"UDPT2BZ6E","text":"ですねぇ。。ユーティリティ関数をforで書いてそれを使うようにしますかね。。","ts":"1618221513.217300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"tFO"}]},{"client_msg_id":"28fdfb49-f398-4c46-8f69-e3d569bcd5e1","type":"message","user":"U78A6ESHM","text":"自分なら多分脳筋で解決するw","ts":"1618221462.217000","team":"T03C4RC8V","reactions":[{"name":"me-too","count":2,"users":["U9S4G0LJW","U776661HA"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"506Nf"}]},{"client_msg_id":"a794f3fe-a00a-4a6f-b6b9-51e76c00ed81","type":"message","user":"U06ECBRTJ","text":"愚直に for 回ししたくなる","ts":"1618221447.216700","team":"T03C4RC8V","reactions":[{"name":"sorena","count":2,"users":["U9S4G0LJW","U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"yeLre"}]},{"client_msg_id":"9c26e628-30b1-42dc-b6e5-88af22ecb396","type":"message","user":"U9S4G0LJW","text":"自分だったら腕力で処理してしまいそう","ts":"1618221445.216500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"WCaYK"}]},{"client_msg_id":"e9b278f1-e34b-4d55-8cca-8bb1d0b09827","type":"message","user":"UDPT2BZ6E","text":"あ、キー被りは想定してませんでした。これはdic_aが優先で大丈夫です。","ts":"1618221438.216300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"AndPz"}]},{"client_msg_id":"7cf12f36-1760-4bae-9b33-56f36456feec","type":"message","user":"U9S4G0LJW","text":"やれって言われたらできそうだけど考えるのがだるいな","ts":"1618221431.215900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"bTFsl"}]},{"client_msg_id":"1e536b6e-f889-4f22-a773-dc2caaddf484","type":"message","user":"UAZ33BKV2","text":"どっちが優先されるかも考えてちゃんと処理しないとだめかな","ts":"1618221392.215800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"g=4"}]},{"client_msg_id":"44913129-c326-4961-85bb-9052d087b761","type":"message","user":"UAZ33BKV2","text":"\u003chttps://note.nkmk.me/python-dict-keys-items-set/\u003e\n\u0026gt; この例のようにキーが共通で値が異なるタプルがあると、その集合から辞書を生成する場合にどちらか一方のみが残るが、いずれの値が残るかは指定できない。\n\u0026gt; union_dict = dict(d1.items() | d2.items())\nかなしみ","ts":"1618221357.215200","team":"T03C4RC8V","reactions":[{"name":"eyes","count":1,"users":["UDPT2BZ6E"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"v=L6D"}]},{"client_msg_id":"149b8d36-c328-4436-ad0a-41bcd4318d8e","type":"message","user":"UDPT2BZ6E","text":"ですね。dic_aはユーザーa, cの情報を持っていて、dic_bがユーザー b, cを持ってるみたいな。。","ts":"1618221352.215000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"uTeKE"}]},{"client_msg_id":"63578825-82d1-4d85-9bae-7e9de649e7b8","type":"message","user":"U776661HA","text":"あ、そろってないことがあるということですね OK","ts":"1618221316.214600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Bww"}]},{"client_msg_id":"18d14d18-f88c-4b42-8b0c-7562ffded4ba","type":"message","user":"U776661HA","text":"ん、じゃ `User` で並び替えれば良くないです？","ts":"1618221304.214300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Fqkid"}]},{"client_msg_id":"19a1f904-fae0-4a99-a895-05fa0961cb3f","type":"message","user":"UDPT2BZ6E","text":"ない場合は考えないです。その前で弾きます。","ts":"1618221290.214000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Hb2ls"}]},{"client_msg_id":"a79ac37c-2753-4ac9-9a93-36858a02e4a0","type":"message","user":"U776661HA","text":"`User` がない場合の扱いはどうする感じです？","ts":"1618221277.213800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"awaB"}]},{"client_msg_id":"8ef5eb75-1e3f-404b-81b7-414a062aafa8","type":"message","user":"UDPT2BZ6E","text":"dic_aとdic_bを'User'の値を元に結合したいのです。SQLだとFULLJOINですかね。。？","ts":"1618221252.213400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ue0Qi"}]},{"client_msg_id":"0091a722-17a0-47e6-be1c-1df7283fa93f","type":"message","user":"U9S4G0LJW","text":"何そのクソデータって思ったけど順序が合っていたらいけるか","ts":"1618221216.213200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"n/MNZ"}]},{"client_msg_id":"1badf32c-ed5a-4b39-9191-2b60fc5b56bb","type":"message","user":"U06ECBRTJ","text":"```SELECT * FROM dic_a a\nLEFT JOIN dic_b b a.User = b.User;```\nって書きたくなるSQLer","ts":"1618221202.213100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4ERS"}]},{"client_msg_id":"91468b2c-a9e8-46cd-8aab-a0d176f9fc7c","type":"message","user":"U776661HA","text":"（そっちのが楽だけど）","ts":"1618221181.212800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+W/"}]},{"client_msg_id":"20e20c72-5c9d-48cd-9f60-5bef3760720a","type":"message","user":"U776661HA","text":"となると順序だけが正しい情報ですか？","ts":"1618221176.212600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Gr9RJ"}]},{"client_msg_id":"d86b88d7-8de9-4796-ad2a-153aaa82ad5f","type":"message","user":"UDPT2BZ6E","text":"あ、すいません、 dic_a と dic_b のUserは欠けてることがあるのです。。","ts":"1618221152.211700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"P6DmA"}]},{"client_msg_id":"ab074c6c-24ee-4c17-9344-07d1c41bebef","type":"message","user":"U776661HA","text":"1. `'User'` で並び替え\n2. 各要素で `a | b` \nで行けそうです","ts":"1618221091.210800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"RlDcr"}]},{"client_msg_id":"cfa87c35-b914-46d3-9285-dda565dba7d3","type":"message","user":"UDPT2BZ6E","text":"この `dic_a`と `dic_b` から `dic_res` になるように辞書を結合したいのですが、簡単な方法ありますでしょうか。。？\n```dic_a = [\n    {'User': 'a', 'Enabled': True, 'UserStatus': 'FORCE_CHANGE_PASSWORD'},\n    {'User': 'b', 'Enabled': False, 'UserStatus': 'ARCHIVED'}\n]\n\ndic_b = [\n    {'User': 'a', 'email': '\u003cmailto:mary@example.com|mary@example.com\u003e', 'email_verified': True},\n    {'User': 'b', 'email': '\u003cmailto:bob@example.com|bob@example.com\u003e', 'email_verified': False}\n]\n\ndic_res = [\n    {\n        'User': 'a',\n        'Enabled': True,\n        'UserStatus': 'FORCE_CHANGE_PASSWORD',\n        'email': '\u003cmailto:mary@example.com|mary@example.com\u003e',\n        'email_verified': True\n    },\n    {\n        'User': 'b',\n        'Enabled': False,\n        'UserStatus': 'ARCHIVED',\n        'email': '\u003cmailto:bob@example.com|bob@example.com\u003e',\n        'email_verified': False\n    }\n]```\n(データサンプル元: \u003chttps://docs.aws.amazon.com/cli/latest/reference/cognito-idp/list-users.html\u003e)","ts":"1618220992.210100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"k6KQ"}]},{"type":"message","user":"U01UHHEGGHE","text":"\u003c@U01UHHEGGHE\u003e has joined the channel","ts":"1618195129.209400","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null},{"client_msg_id":"e554f4fe-082c-42f6-81d5-bac2897f5a9f","type":"message","user":"U776661HA","text":"そっちのが面倒だからパフォーマンスとか求めないなら作っちゃった方が楽っぽい","ts":"1618221758.221400","thread_ts":"1618221693.220500","parent_user_id":"U776661HA","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"xfXtj"}]}]
