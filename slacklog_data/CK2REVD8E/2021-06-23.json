s","count":1,"users":["UDPT2BZ6E"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"l1AK"}]},{"client_msg_id":"5911ae82-1277-44ab-9e36-5dc638ff83ba","type":"message","user":"U78A6ESHM","text":"昔ダンプを流し込んでたw","ts":"1624446365.068500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"rv5"}]},{"client_msg_id":"6e60a3fa-d391-4369-bfb5-371e6feec4d7","type":"message","user":"U06BRP8VD","text":"1秒かかるのは仕方ない。","ts":"1624446364.068300","team":"T03C4RC8V","reactions":[{"name":"gunnyari","count":1,"users":["UDPT2BZ6E"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"bxR="}]},{"client_msg_id":"38d27d6f-0c90-4624-a62a-a3c70eefff88","type":"message","user":"UDPT2BZ6E","text":"dockerでpostgresを立てるとして、\n\u0026gt; - postgresにデータどうやって入れる。。？ (create tableとinsert into)\n\u0026gt; - 更新系のAPI(関数)のテスト終わった後のpostgresに残ったデータはどうやってきれいにする？\nこれはどうされてますか？\n今はcreate tableを全テストで共有していて、テストデータはテストスイートの中で直接insert、テストスイート終了後にdrop schemaしています(各テストでどのテーブルを触ったのか分からない)\nただ、これだと1つのテストするのに1秒くらいかかるので遅いなぁ。。と思っています。","ts":"1624446346.068000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Hrv"}]},{"client_msg_id":"8bb7c46b-6034-4b7a-ab96-695ae8cf0c4e","type":"message","user":"UNJ2DANJC","text":"テストケース毎にクリーンアップしたいけど遅いからどこかで妥協しないとなあ","ts":"1624446327.067700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"KBV"}]},{"client_msg_id":"d3f143e7-0d69-4bf8-9ec5-83a5c1780910","type":"message","user":"U06BRP8VD","text":"たぶんこのGoモジュールと同じコンセプトのライブラリはPythonにもあるんじゃないかな?","ts":"1624446308.067600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"TJl7"}]},{"client_msg_id":"3a4be7fc-a855-47ac-8685-78659fbfb19f","type":"message","user":"U06BRP8VD","text":"Goのモジュールのほうは遅いんで、単体には使えない。","ts":"1624446253.066300","thread_ts":"1624446253.066300","reply_count":1,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"q0q"}]},{"client_msg_id":"e822b42e-2a64-41bc-9b18-fd282c1e1644","type":"message","user":"U78A6ESHM","text":"すごいw","ts":"1624446250.066100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"IWK"}]},{"client_msg_id":"0b1aab17-7509-4902-8f0f-5c63a28ee6df","type":"message","user":"U06BRP8VD","text":"ちなみにローカルでPostgreSQL建てる時も、コマンド直叩きとGoのモジュールの2パターン使い分けてるw\n\n\u003chttps://github.com/koron-go/pgctl\u003e","ts":"1624446241.065200","attachments":[{"color":"24292f","fallback":"koron-go/pgctl","id":1,"title":"koron-go/pgctl","text":"pg_ctl command wrapper for golang","fields":[{"title":"Stars","value":"1","short":true},{"title":"Language","value":"Go","short":true}],"blocks":null}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"2j/m"}]},{"client_msg_id":"53327146-300f-4c83-8467-7052c59ff4ba","type":"message","user":"U78A6ESHM","text":"テスト用の DB 立てるだけですしね。テスト前にクリーンナップするスクリプト流す感じでしょうか。","ts":"1624446225.064700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"vXD8s"}]},{"client_msg_id":"facaa733-36bc-40a9-bfe2-8be8127da105","type":"message","user":"U06BRP8VD","text":"もちろんローカルpostgresqlでもええんやけども。","ts":"1624446179.064000","team":"T03C4RC8V","reactions":[{"name":"+1","count":1,"users":["U78A6ESHM"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ARG"}]},{"client_msg_id":"17ae7701-cebf-4155-ae46-62d3dc2c6158","type":"message","user":"U78A6ESHM","text":"となると docker かな。","ts":"1624446178.063900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"l5OP3"}]},{"client_msg_id":"fe4ffea9-992b-4456-98fb-731569c8ec04","type":"message","user":"U06BRP8VD","text":"ならdocker一択では","ts":"1624446167.063400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0xe"}]},{"client_msg_id":"c51ae5f2-162f-47bd-891c-a39ea546a30a","type":"message","user":"UDPT2BZ6E","text":"sqliteありですね。\nただ、O/Rマッパーを使ってるのですが、postgresに依存してpostgres専用のクエリを叩くようになってるのでsqliteは使えないのです。。","ts":"1624446150.063100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ZbHr"}]},{"client_msg_id":"63aec785-a8f0-4aa7-8f66-bd1cece14490","type":"message","user":"U78A6ESHM","text":"1つ目\n自分は SQLite のメモリーモードでテストしてます。docker-compose で DB 立ててテストしてる人もいます(テストごとに Django のマイグレーション走るのがうざいって人)\n2 つ目\nfixture で作ったり、factory_boy で入れたりしてます\n3 つ目\nSQLite のメモリーなので毎度綺麗になります(その代わりロードは遅い)","ts":"1624446079.062400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"h+Sib"}]},{"client_msg_id":"0656293e-f9cd-4c6d-b212-adcc689a60d3","type":"message","user":"UD1FQV38V","text":"私は自動テストならsqlite+fixtureかなー。ローカルならscirpts/とかにマイグレ用スクリプト置きます","ts":"1624446073.062300","edited":{"user":"UD1FQV38V","ts":"1624446124.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"m82"}]},{"client_msg_id":"fc51b91d-845b-40eb-8793-4df208e848ec","type":"message","user":"U06BRP8VD","text":"Goだけど僕はとあるプロジェクトで3パターン併用してて、テスト用のpostgresqlをdockerで建てる、ローカルで建てる、SQLite3(メモリ)で代用するって感じ。","ts":"1624446069.062100","edited":{"user":"U06BRP8VD","ts":"1624446092.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"9Xu"}]},{"client_msg_id":"69ced2ce-c4fb-4245-bae0-85b039b30317","type":"message","user":"UDPT2BZ6E","text":"バックエンドのテストってみなさんどうされてますでしょうか。\n本番はDBにpostgresを使っていて、参照系と更新系のAPIがあります。O/RマッパーにSQLAlchemyを使っています。\n\n具体的には下のようなことが疑問です。\n\n- postgresをdocker-composeで立てる。。？\n- postgresにデータどうやって入れる。。？ (create tableとinsert into)\n- 更新系のAPI(関数)のテスト終わった後のpostgresに残ったデータはどうやってきれいにする？\n- postgresをモックするという考え方でDBを立てない。。？\n- SQLAlchemyが出力するクエリを文字列比較で比較する。。？","ts":"1624445772.056600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"cVRwN"}]},{"type":"message","user":"U01TQP86UM6","text":"\u003c@U01TQP86UM6\u003e has joined the channel","ts":"1624436009.056200","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null},{"client_msg_id":"eb4e04e7-880a-42ff-b6a4-2ff3b7c2e8f5","type":"message","user":"U78A6ESHM","text":"自分は諦めましたw","ts":"1624446600.073800","thread_ts":"1624446392.069500","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","reactions":[{"name":"laughing","count":1,"users":["U06BRP8VD"]},{"name":"wakaru","count":1,"users":["U06BRP8VD"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"TsSS+"}]},{"client_msg_id":"6beb0c20-1926-483c-aa4b-7fa47b04d93e","type":"message","user":"U06BRP8VD","text":"正確にはpostgresqlのDBを作るのが遅い。","ts":"1624446270.066800","thread_ts":"1624446253.066300","edited":{"user":"U06BRP8VD","ts":"1624446278.000000"},"parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"C2R"}]}]
