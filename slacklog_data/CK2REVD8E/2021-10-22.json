rich_text","block_id":"Nfhc"}]},{"client_msg_id":"bdee8a06-8be1-4af6-a866-cf668092857d","type":"message","user":"UDPT2BZ6E","text":"`~/dev/sample/index.py`\n```import util\n\n# from . import util\n\n# Traceback (most recent call last):\n#   File \"/home/conao/dev/python/rel-import/index.py\", line 2, in \u0026lt;module\u0026gt;\n#     from . import util\n# ImportError: attempted relative import with no known parent package\n\nutil.version()```\n`~/dev/sample/util.py`\n```def version():\n    print(\"0.0.1\")```\n```$ python index.py```","ts":"1634831579.090300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"en1"}]},{"client_msg_id":"0033254b-6a49-47c6-a5ce-b55f82c82e2f","type":"message","user":"UDPT2BZ6E","text":"なぜPythonはトップレベルで相対importできないのか。。。","ts":"1634831312.089100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Kjw"}]}]
