00","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"9ZD0e"}]},{"client_msg_id":"5bdfb1b7-45e2-4137-82e3-04190636af8a","type":"message","user":"UERCTTT8B","text":"自宅が事務所だと按分しなきゃいけないんじゃありませんでしたっけ?","ts":"1616073623.086700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"b+GE"}]},{"client_msg_id":"984d0cfe-1119-4d74-8a9d-0f69c4f7a5e0","type":"message","user":"U7B4ZD49X","text":"mattnさんが父親ならそれだけでだいぶかっこいい感あるけど・・・","ts":"1616073609.086200","team":"T03C4RC8V","reactions":[{"name":"mattn","count":1,"users":["UDPT2BZ6E"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"LUO/n"}]},{"client_msg_id":"1AAC50CC-D53E-4AEF-924E-594892B2C6D5","type":"message","user":"UFHQ7TNT0","text":"関西は露骨な人が多い印象（偏見","ts":"1616073589.085800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Y2b3o"}]},{"client_msg_id":"34467adb-7d2f-4ca9-a92a-9c8cb27d4699","type":"message","user":"U03C6TEAZ","text":"そのおうち、シャッターあくと高い車が3台並んでて娘がカッコいい~って言うので毎回辛い思いをしています。","ts":"1616073490.085000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"DlT7"}]},{"client_msg_id":"62e91e2e-d84b-4a31-aecc-f5f989cb1675","type":"message","user":"UFHQ7TNT0","text":"そういうやり方は個人的にあまり好まなかったんですけど、WFHのお陰で堂々とできるようになったので、去年からやりはじめました。","ts":"1616073365.082800","team":"T03C4RC8V","reactions":[{"name":"goodpoem","count":1,"users":["U03C6TEAZ"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"lAi55"}]},{"client_msg_id":"fccd955b-2fa8-45cb-aed0-93c48642f27f","type":"message","user":"U03C6TEAZ","text":"自宅の周りに結構大きな家があってよくよく聞くと事務所扱いにして節税してはるんですよね。ぜんぜん事務所らしくないんだけどw","ts":"1616073297.081800","team":"T03C4RC8V","reactions":[{"name":"hee","count":1,"users":["U7B4ZD49X"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Djuln"}]},{"client_msg_id":"e48890f9-76b1-4f88-ab5a-f2dd0c4074eb","type":"message","user":"UFHQ7TNT0","text":"個人の確定申告では僕はそれ面倒なのでやってないですね。\n逆に会社では、自宅の一部をオフィスとして借用していることにして、ちゃんと契約書を締結した上で、会社の経費として支払っています。","ts":"1616073156.079600","team":"T03C4RC8V","reactions":[{"name":"naruhodo","count":1,"users":["U03C6TEAZ"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"UoD"}]},{"client_msg_id":"2073f845-c895-411c-a456-b8a9e36e0fcf","type":"message","user":"U03C6TEAZ","text":"tomoya さんとかだと自宅を事務所として扱ってるのかな。","ts":"1616073016.077700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Ju2rr"}]},{"client_msg_id":"bda05ca3-adc2-4a2f-a206-da52cb305094","type":"message","user":"U7B4ZD49X","text":"今年しかだめだという不退転の決意で臨んだ方がいいw","ts":"1616072831.076800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"spjiR"}]},{"client_msg_id":"1ff41154-0e2d-449b-9518-ac92cc6a63eb","type":"message","user":"UFHQ7TNT0","text":"今年初めて医療費控除やったんですけど、国税庁にはこう書いてあったんですよね。\n\n\u0026gt; ・１月１日から12月31日までに実際に支払った医療費に限って控除の対象となります。未払となっている医療費は、実際に支払った年の控除対象となります。\n\u003chttps://www.nta.go.jp/publication/pamph/koho/kurashi/html/04_1.htm\u003e","ts":"1616072734.076100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jj4N"}]},{"client_msg_id":"a11ffba4-9f71-4b9a-a708-a7f685e4af53","type":"message","user":"U03C6TEAZ","text":"ふるさと納税も数年行けたはず。","ts":"1616072722.076000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Mfum"}]},{"client_msg_id":"90cc6cbe-185f-4aa4-9701-e7e5614894f4","type":"message","user":"U03C6TEAZ","text":"数年前までは行けたと思います。","ts":"1616072673.074900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"LhM"}]},{"client_msg_id":"3664d6fc-1c59-40e8-a8b5-f53d5c6efa91","type":"message","user":"UAZ33BKV2","text":"なんかそういうのだったので、やるなら事前に調べておいてくださいねw","ts":"1616072541.074400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=ns"}]},{"client_msg_id":"AD89CA7C-B43B-4768-B406-B66F30090137","type":"message","user":"U011FTGJ3SN","text":"後でまとめられるんですね！","ts":"1616072488.073900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"aZs=y"}]},{"client_msg_id":"b83fc130-965b-42e8-8ad6-ae4c6c1c4c8c","type":"message","user":"UFHQ7TNT0","text":"医療費控除って、年またぎでもいいんですか?","ts":"1616072486.073800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"MQGLM"}]},{"client_msg_id":"9a93e4dc-438b-42e2-8b91-da6376199332","type":"message","user":"UAZ33BKV2","text":"そういや、家族(生計を一にする家族)と自分の医療費を2年まとめてで医療控除を受けたことはあるな\n自分は金額を追記しただけだが...\nまとめてなので手間ではあるが、額がそれなりになるのでわかりやすかった\n...たしか2年でもやれなくはない、んだよね(すでに記憶があいまい)","ts":"1616072438.072800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"aQfg"}]},{"client_msg_id":"9A668D50-EEC3-455E-91D9-E146C58BE14D","type":"message","user":"UFHQ7TNT0","text":"文筆業の人は休暇じゃなくて、実は編集さんから逃げているだけだと思いますけどね。","ts":"1616071853.070500","team":"T03C4RC8V","reactions":[{"name":"naruhodo","count":2,"users":["U7B4ZD49X","U011FTGJ3SN"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"E2AY"}]},{"client_msg_id":"133283b5-1b75-4e9d-83ac-6287d0c443ae","type":"message","user":"U03C6TEAZ","text":"スタバじゃないと仕事できないと説明できるならスタバ代も経費にできると思う。","ts":"1616071823.069700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"wdJoL"}]},{"client_msg_id":"3d8ae8f0-9a69-495c-8c9a-70db03504b28","type":"message","user":"U7B4ZD49X","text":"小説家は割とやるイメージある","ts":"1616071800.068600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"89G+K"}]},{"client_msg_id":"c8531ef0-e058-44ae-a038-b45c12893532","type":"message","user":"U7B4ZD49X","text":"仕事に息詰まった状態で休暇にいける人すごいと思う。終わってからじゃないと生きた心地しない","ts":"1616071788.068000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+dho"}]},{"client_msg_id":"44fd6007-9759-46e1-94d4-33a3c44d3b69","type":"message","user":"U7B4ZD49X","text":"まじすか。意外","ts":"1616071667.066100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"yjm"}]},{"client_msg_id":"757D3ADD-F98A-4E5E-9612-7EFCEB21D09C","type":"message","user":"UFHQ7TNT0","text":"ウッ、風立ちぬまだ見てない","ts":"1616071648.065600","team":"T03C4RC8V","reactions":[{"name":"me-too","count":2,"users":["U76GA7MFA","UD1FQV38V"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"D0OC"}]},{"client_msg_id":"dd8d0998-8263-45c5-8fc4-5c16d3397d80","type":"message","user":"U7B4ZD49X","text":"風立ちぬ初見時、小説家とエンジニアの２人の人生合体させてるの知らずに見てて、主人公がいきなり軽井沢で休暇を過ごし始めたときに「こいつ本当にエンジニアなんか・・・？」って思ったけどやっぱり違って安心したのを思い出した","ts":"1616071553.064400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"lRUu"}]},{"client_msg_id":"4AD8F06D-A14B-4B6B-BC5A-3F14C66A5871","type":"message","user":"UFHQ7TNT0","text":"あとは旅館に行って缶詰したり","ts":"1616071336.062100","team":"T03C4RC8V","reactions":[{"name":"thinking_face","count":1,"users":["U03C6TEAZ"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"i0Agk"}]},{"client_msg_id":"035132fd-b479-4434-a1f5-acb28e424457","type":"message","user":"U03C6TEAZ","text":"収入の方の確定申告は納めてる感が非常に濃いんですが、逆なんですよね。原価掛かってるからそんなに儲けてないし、納める予定の税金返してくれという意味。たとえば執筆であれば電気代やノートパソコンも必要経費。","ts":"1616071292.061500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Xd0O"}]},{"client_msg_id":"e