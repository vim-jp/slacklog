728.250700","team":"T03C4RC8V","reactions":[{"name":"warau","count":4,"users":["U017BU3UZBQ","U9S4G0LJW","U01BY3SDBRS","U06ECBRTJ"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"DwS"}]},{"client_msg_id":"1074b426-f39f-4d20-afb4-04c57f2cc947","type":"message","user":"UFHQ7TNT0","text":"僕が原付で軽くあてられたときは、とりあえず3万くらい握らせてくれたぞw","ts":"1615221663.249200","team":"T03C4RC8V","reactions":[{"name":"goodpoem","count":2,"users":["U7B4ZD49X","U9S4G0LJW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zclf"}]},{"client_msg_id":"1a34a3e4-80f8-48d7-83a8-41a43e176654","type":"message","user":"U7B4ZD49X","text":"社会人３年目の人に1000円ってw","ts":"1615221613.248100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4q2sH"}]},{"client_msg_id":"39017c8d-968f-4942-86e7-80b15ebcc921","type":"message","user":"U9S4G0LJW","text":":warau:","ts":"1615221595.247700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hKr"}]},{"client_msg_id":"68856b11-0a66-4a0a-8c56-473213322717","type":"message","user":"U7B4ZD49X","text":"正直１０万くらいだともみ消したw","ts":"1615221573.247300","team":"T03C4RC8V","reactions":[{"name":"warau","count":1,"users":["U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"gbW"}]},{"client_msg_id":"15855b32-506e-4aa9-9bbd-7a6679fe4c56","type":"message","user":"U9S4G0LJW","text":"（お、まじか）の部分で笑ってしまった","ts":"1615221550.246600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"DCN=N"}]},{"client_msg_id":"6f7fc8ff-4b71-4f50-bc5a-741a50aa5819","type":"message","user":"U7B4ZD49X","text":"自転車（私[社会人３年目]）と車（時速10kmくらい）の交差点での事故だったんで大したことなかったんですけど、\n私「とりあえず、警察呼びますね〜」\nおっちゃん「いや勘弁してよ。大丈夫だったよね？」\n私「いや一応こういうのはちゃんとしとかないと」\nおっちゃん「こんなおっちゃんをいじめて楽しいのかよ。。。おれはもう６５も超えてて・・・」\n私「いやまあw」\nおっちゃん「わかったよ。お金が欲しいのか。これあげるから今回は見逃してくれ！」\n私（お、まじか）\nおっちゃん「今持ち合わせがないからこれで」１０００円\n私「１０００円w」","ts":"1615221506.245900","edited":{"user":"U7B4ZD49X","ts":"1615221823.000000"},"team":"T03C4RC8V","reactions":[{"name":"yamaiyatsu","count":4,"users":["U9S4G0LJW","U01J7703PFT","U01BY3SDBRS","UL6CFN8NR"]},{"name":"money_with_wings","count":2,"users":["UNJ2DANJC","U01J7703PFT"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Su3"}]},{"client_msg_id":"a920f9f9-689b-4c40-bc64-87f352c112d1","type":"message","user":"UNJ2DANJC","text":"最近は●berEatsとかフードデリバリもあれですね。若い女性の一人暮らしとか注意した方がいいやつ。","ts":"1615221466.245600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"aQS"}]},{"client_msg_id":"8f12f859-ccf8-45f6-be2a-03cccd12b5d4","type":"message","user":"UFHQ7TNT0","text":"携帯が普及しはじめのタイミングだったので、すぐに警察が呼べてよかった。","ts":"1615221406.243500","edited":{"user":"UFHQ7TNT0","ts":"1615221412.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"UASbz"}]},{"client_msg_id":"564bbef3-b56b-4454-864a-5783c225dc6f","type":"message","user":"UFHQ7TNT0","text":"そういえば、高校生のとき軽くあてられて自転車がこけたら、車が逃げようとして、チャリをタイヤで巻き込んで動けなくなってざまぁって思ったことがあった。","ts":"1615221379.242100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"diN"}]},{"client_msg_id":"d8f7caf8-5c96-42a1-8fa4-f74283512bf7","type":"message","user":"U03C6TEAZ","text":"やばい人は逃げるからねぇ。","ts":"1615221311.239100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Lpy"}]},{"client_msg_id":"55c0b030-9022-4351-af8b-34261d0e9663","type":"message","user":"U7B4ZD49X","text":"正直やった側は仕方ないと思うんですけど、やられた側もなんで公開しなくちゃならんのかわからないんですよね・・・変な人だったらさらになにかに巻き込まれる可能性とか考えられて・・・（実際少し変なおっちゃんだったし）","ts":"1615221250.237900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"2IYgp"}]},{"client_msg_id":"1fe8987b-b395-46e5-8e5c-9b37064f0d5e","type":"message","user":"U03C6TEAZ","text":"むかし子供を自転車の前に乗っけて小道走ってたら、横から猛スピードで女子高生が自転車で曲がってきて衝突した事があって、結果的には僕がちょっと怪我しただけだったけど、子供が怪我してたらと思って一応女子高生の電話番号聞いたな。女子高生も怖いだろうなと思ったけど。","ts":"1615221097.236100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"p8to"}]},{"client_msg_id":"eb325d12-826e-445d-ade7-3fc6eed5c0ce","type":"message","user":"UFHQ7TNT0","text":"保険屋どうしがやるとばかり思っていた","ts":"1615221053.235200","team":"T03C4RC8V","reactions":[{"name":"wakaru","count":1,"users":["U7B4ZD49X"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"9aJlh"}]},{"client_msg_id":"e0e2bdce-1f60-4a9b-bd4e-a7201ce5498f","type":"message","user":"U7B4ZD49X","text":"なにかしらこじれたときに不安しかないですよね・・・間になにかかませてほしい","ts":"1615220990.233900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jNmf"}]},{"client_msg_id":"5f296e09-d29c-4691-b2a2-110b255d1889","type":"message","user":"UFHQ7TNT0","text":"へー。そんなんあるんだ","ts":"1615220867.232900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"7IKQ"}]},{"client_msg_id":"6ba065e4-1d15-4edf-813e-5067bc5f6937","type":"message","user":"U7B4ZD49X","text":"個人的に一番やめて欲しいのは事故ったとき（事故られたとき）の氏名と住所と電話番号交換ですね。警察にそこらへんの配慮がまったくなかった。","ts":"1615220815.232600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"J/m"}]},{"client_msg_id":"02d75d1f-b653-4f10-acc5-61cc1b1c0ce6","type":"message","user":"UFHQ7TNT0","text":"会社住所が自宅だともう一瞬で調べられちゃう\n\u003chttps://www.houjin-bangou.nta.go.jp/\u003e","ts":"1615220747.231500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Kaek6"}]},{"client_msg_id":"4f3e9450-7e89-4388-bb44-246e7a445f0f","type":"message","user":"U01J7703PFT","text":"この流れでww","ts":