ider.jp/post-229076","text":"2020年度連結純利益予想、ついに1兆円超……このまま推移すれば、2021年春は、ソニーにとって過去最高の春となるだろう。2月3日にソニーが発表した、2020年度第3四半期（2020年12月31日まで）決算は、市場の予測を上回るものだった。","image_url":"https://assets.media-platform.com/bi/dist/images/2021/02/04/sony-logo-w960.jpg","blocks":null,"ts":1612386600,"service_name":"businessinsider.jp","service_icon":"https://www.businessinsider.jp/asset/favicon/apple-touch-icon.png","from_url":"https://www.businessinsider.jp/post-229076","original_url":"https://www.businessinsider.jp/post-229076"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"V15Xc"}]},{"client_msg_id":"41a3f7dd-a8f2-4c63-82cc-1f1db9295a99","type":"message","user":"U76GA7MFA","text":"SONY が最近、何で利益を伸ばしているのか全然知らない…","ts":"1616586554.118000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"OEFc"}]},{"client_msg_id":"6dffbfcc-adc2-4dc4-b347-8b4074edc0e6","type":"message","user":"UD1FQV38V","text":"\u003chttps://www.nikkei.com/article/DGXZQODZ244OI0U1A320C2000000/\u003e\nしゅごい","ts":"1616586117.117500","attachments":[{"fallback":"日本経済新聞: ソニー、賞与7カ月で回答　コロナ下でも過去最高に","id":1,"title":"ソニー、賞与7カ月で回答　コロナ下でも過去最高に","title_link":"https://www.nikkei.com/article/DGXZQODZ244OI0U1A320C2000000/","text":"ソニーは24日、2021年度の賞与を巡り、基本給の7.0カ月（特別一時金は0.3カ月）にするとソニー中央労働組合に回答した。組合側の要求は6.9カ月で、要求を上回り、同社として過去最高の水準となる。ソニーはゲーム事業が好調で新型コロナウイルス下でも20年度の連結純利益で最高となる見込み。社員に報いるほか、優秀な人材確保につなげる。賞与は、一般的な係長未満に相当する「上級担当者グレード」の標準の","image_url":"https://article-image-ix.nikkei.com/https%3A%2F%2Fimgix-proxy.n8s.jp%2FDSXZQO0429424024032021000000-1.jpg?auto=format%2Ccompress\u0026ch=Width%2CDPR\u0026q=45\u0026fit=crop\u0026bg=FFFFFF\u0026w=1200\u0026h=630\u0026fp_x=0.5\u0026fp_y=0.5\u0026fp_z=1\u0026crop=focalpoint\u0026ixlib=js-1.4.1\u0026s=7e14dc7fe74347d4782e6a6ba58dfce2","blocks":null,"ts":1616562529,"service_name":"日本経済新聞","service_icon":"https://www.nikkei.com/.resources/k-components/180.rev-79352c3.png","from_url":"https://www.nikkei.com/article/DGXZQODZ244OI0U1A320C2000000/","original_url":"https://www.nikkei.com/article/DGXZQODZ244OI0U1A320C2000000/"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"kzi/"}]},{"client_msg_id":"839110aa-77a4-4edd-a853-3fa39afe99c5","type":"message","user":"UAZ33BKV2","text":"ある程度はこれでやってみよ","ts":"1616582470.116800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hfvV="}]},{"client_msg_id":"4964d521-2737-4ef5-9ea2-920cd179c25f","type":"message","user":"UAZ33BKV2","text":"そういや Kyash 振り込み口座が作れるようになった\nなんだかんだいって使うので、うまく利用額くらいを入れてポイント効率を落さない運用はできそう(そっち誘導なんだろうけど)","ts":"1616582463.116600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"VnH"}]},{"type":"message","user":"U01S1HVLWCW","text":"\u003c@U01S1HVLWCW\u003e has joined the channel","ts":"1616560575.115600","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null},{"client_msg_id":"1b7fd825-35cf-4ecc-93fc-def6e1e98a30","type":"message","user":"UGJG6S9JM","text":"IPOときいて","ts":"1616521084.115200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Fdrbo"}]}]
