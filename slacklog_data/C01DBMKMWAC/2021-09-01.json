[{"type":"message","user":"U02DR773E4Q","text":"\u003c@U02DR773E4Q\u003e has joined the channel","ts":"1630490469.108900","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null},{"client_msg_id":"54fc9ef3-4d07-4207-b740-bc956995625b","type":"message","user":"UDPT2BZ6E","text":"\u003chttps://ja.wikipedia.org/wiki/%E3%82%B8%E3%83%97%E3%82%B7%E3%83%BC\u003e\n「ジプシーする」というの、意味が取れなかった。。なるほど。","ts":"1630484671.107600","attachments":[{"fallback":"wikipedia: ジプシー","id":1,"author_name":"Wikipedia","author_link":"https://ja.wikipedia.org/","title":"ジプシー","title_link":"https://ja.wikipedia.org/wiki/%E3%82%B8%E3%83%97%E3%82%B7%E3%83%BC","text":"ジプシー（gypsy）は、一般にはヨーロッパ（欧州）で生活している移動型民族を指す民族名。転じて、様々な地域や団体を渡り歩く者を比喩する言葉ともなっている。ドイツ語の「ツィゴイナー（Zigeuner）」を含めて外名であり、当人らの自称ではない。自称としては「ロマ」のほか、「シンティ（ジンティ）」「トラヴェラーズ」などがあるが、それぞれがジプシー全てを包含しているわけではなく、確立された統一呼称は存在しない。宗教面ではキリスト教の諸宗派（カトリック教会、プロテスタント、正教会）信徒もムスリムもいる。言語的にも、ロマが話すロマ語（ロマニ―語）には60を超える方言があり、多様な人々である。","image_url":"https://upload.wikimedia.org/wikipedia/commons/9/97/Bundesarchiv_Bild_183-J0525-0500-003%2C_Rheinland%2C_Sinti_und_Roma_mit_Wohnwagen_auf_Landstra%C3%9Fe.jpg","blocks":null,"service_icon":"https://a.slack-edge.com/80588/img/unfurl_icons/wikipedia.png","from_url":"https://ja.wikipedia.org/wiki/%E3%82%B8%E3%83%97%E3%82%B7%E3%83%BC","original_url":"https://ja.wikipedia.org/wiki/%E3%82%B8%E3%83%97%E3%82%B7%E3%83%BC"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"8/o"}]},{"client_msg_id":"a8357d1f-24f9-4418-891c-2a44a3de73cd","type":"message","user":"UNJ2DANJC","text":"Nature Remoのセットと迷ったけどマネフォやめることは多分無いので","ts":"1630484496.107000","team":"T03C4RC8V","reactions":[{"name":"eyes","count":1,"users":["U72TB62UF"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"PmHd"}]},{"client_msg_id":"e1fb11d4-e1c9-4acf-a422-4350af5fe2db","type":"message","user":"UNJ2DANJC","text":"マネフォ電気使ってる","ts":"1630484438.105800",