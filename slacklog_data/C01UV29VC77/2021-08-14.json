turn\n\t\t}\n\n\t\tline := scanner.Text()\n\t\tl := lexer.New(line)\n\t\tp := parser.New(l)\n\n\t\tprogram := p.ParseProgram()\n\t\tif len(p.Errors()) != 0 {\n\t\t\tprintParserError(out, p.Errors())\n\t\t\tcontinue\n\t\t}\n\n\t\tcomp := compiler.NewWithState(symbolTable, constants)\n\t\terr := comp.Compile(program)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(out, \"Woops! Compilation failed:\\n %s\\n\", err)\n\t\t\tcontinue\n\t\t}\n\n\t\tcode := comp.Bytecode()\n\n\t\tmachine := vm.NewWithGlobalsStore(code, globals)\n\t\terr = machine.Run()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(out, \"Woops! Executing bytecode failed:\\n %s\\n\", err)\n\t\t\tcontinue\n\t\t}\n\n\t\tstackTop := machine.LastPoppedStackElem()\n\t\tio.WriteString(out, stackTop.Inspect())\n\t\tio.WriteString(out, \"\\n\")\n\t}\n```","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/skanehira/monkey|skanehira/monkey\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"6aS/"}]},{"client_msg_id":"c1ff064b-6c39-475d-a86e-efe3e78f2c71","type":"message","user":"U03C71D7H","text":"スコープ自由に積める言語なら 1 行ごとに新しいスコープ作ってどんどん積んでくみたいになるのかな…想像…","ts":"1628869118.204500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"I18"}]},{"client_msg_id":"11522d25-ee70-4624-a0ae-4f35acf3136f","type":"message","user":"UDDCM376D","text":"ネイティブコンパイルではないです","ts":"1628869083.203900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"m1+"}]},{"client_msg_id":"74d28849-8cb0-4731-941a-a43b3bec8844","type":"message","user":"UDDCM376D","text":"まぁ、スタックマシンです","ts":"1628869071.203700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"XWE="}]},{"client_msg_id":"f66c677d-436d-4f78-8e43-ff60a750bd9f","type":"message","use