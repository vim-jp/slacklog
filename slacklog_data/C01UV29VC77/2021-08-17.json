[{"client_msg_id":"31185bc7-9b25-4c60-a16b-812bf0955488","type":"message","user":"UAZ33BKV2","text":"\u003chttps://ja.wikipedia.org/wiki/GPL%E3%83%AA%E3%83%B3%E3%82%AF%E4%BE%8B%E5%A4%96\u003e","ts":"1629199711.236300","attachments":[{"fallback":"wikipedia: GPLリンク例外","id":1,"author_name":"Wikipedia","author_link":"https://ja.wikipedia.org/","title":"GPLリンク例外","title_link":"https://ja.wikipedia.org/wiki/GPL%E3%83%AA%E3%83%B3%E3%82%AF%E4%BE%8B%E5%A4%96","text":"GPLリンク例外（英: GPL linking exception）とは、GNU一般公有使用許諾 (GPL) を改変して作られる新しいライセンスの総称で、ライブラリコードを提供するソフトウェアのプロジェクトにGPLの全ての条項を適用せずに、他のプログラムがリンクすることを可能にするものである。リンクとは、実行可能なファイルを作成するためにライブラリのコードを使用するコードに接続する技術的な処理であり、コンパイル時または実行時に機械語コードを生成する際に行われる。リンク例外を適用しない場合、GPLコードとリンクするコードにも、自動的にGPLが適用される。\nGNU 劣等一般公衆利用許諾契約 (LGPL) のバージョン3は、同様なGPLの例外として作られたものである。","blocks":null,"service_icon":"https://a.slack-edge.com/80588/img/unfurl_icons/wikipedia.png","from_url":"https://ja.wikipedia.org/wiki/GPL%E3%83%AA%E3%83%B3%E3%82%AF%E4%BE%8B%E5%A4%96","original_url":"https://ja.wikipedia.org/wiki/GPL%E3%83%AA%E3%83%B3%E3%82%AF%E4%BE%8B%E5%A4%96"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fL7z+"}]},{"client_msg_id":"8e0da26b-41f9-4deb-b9ac-62601235566e","type":"message","user":"UERCTTT8B","text":"これ単に LGPL のこといっているっぽいな","ts":"1629199672.236100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"1iR0n"}]},{"client_msg_id":"1fa703f2-a402-4686-97a7-492f559e9cef","type":"message","user":"UAZ33BKV2","text":"っぽいですけど、どっかで明確な解説ほしいですね","ts":"1629199553.235700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"QCDjS"}]},{"client_msg_id":"7c66e8a3-bf36-4d9c-90fc-4eedbcd47f6c","type":"message","user":"UERCTTT8B","text":"libgcc とかは静的にリンクしてもライセンス (LGPL?) の影響ないですよということなんでしょうか","ts":"1629198245.235400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":