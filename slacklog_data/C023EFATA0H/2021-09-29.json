 - preEditLength;\n  }\n\n  async gatherCandidates(\n    args: GatherCandidatesArguments\u0026lt;Record\u0026lt;string, never\u0026gt;\u0026gt;,\n  ): Promise\u0026lt;Candidate\u0026lt;CompletionMetadata\u0026gt;[]\u0026gt; {\n    const candidates =\n      (await args.denops.dispatch(\"skkeleton\", \"getCandidates\")) as [\n        string,\n        string[],\n      ][];\n    const ddcCandidates = candidates.flatMap((e) =\u0026gt; {\n      return e[1].map((word) =\u0026gt; ({\n        word: word.replace(/;.*$/, \"\"),\n        abbr: word,\n        user_data: {\n          kana: e[0],\n          word,\n        },\n      }));\n    });\n    return Promise.resolve(ddcCandidates);\n  }\n\n  params() {\n    return {};\n  }\n\n  async onCompleteDone(\n    args: OnCompleteDoneArguments\u0026lt;Record\u0026lt;string, never\u0026gt;, CompletionMetadata\u0026gt;,\n  ) {\n    const meta = args.userData;\n    await args.denops.dispatch(\n      \"skkeleton\",\n      \"registerCandidate\",\n      meta.kana,\n      meta.word,\n    );\n  }\n}\n\n```","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/vim-skk/denops-skkeleton.vim|vim-skk/denops-skkeleton.vim\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png"}],"team":"T03C4RC8V","reactions":[{"name":"bow","count":2,"users":["U9S4G0LJW","U01AQ5BFNLX"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5ff"}]},{"client_msg_id":"77f97dcf-5672-4571-9568-cbebc630f440","type":"message","user":"U01AQ5BFNLX","text":"そういえば前にここで、ddcを使ったskkeletonの補完が話題になったと思うんですが、\nあれってリポジトリ名なんでしたっけ？","ts":"1632903559.430400","edited":{"user":"U01AQ5BFNLX","ts":"1632903572.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"dEbZ"}]},{"client_msg_id":"8827a5e6-d9ff-44e5-b356-b2e31714a26e","type":"message","user":"UD1FQV38V","text":"\u003chttps://twitter.com/peacock0803sz/status/1443127222949142532\u003e\n自作ステッカ