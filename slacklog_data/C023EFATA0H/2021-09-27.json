essage","user":"U9S4G0LJW","text":"闇が見える","ts":"1632749282.381900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"nO8cr"}]},{"client_msg_id":"92a12de7-4ea1-401a-bf7d-87c71e185758","type":"message","user":"U9S4G0LJW","text":"やばい","ts":"1632749272.381500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"9gEPu"}]},{"client_msg_id":"bc335a73-9586-46d0-ad05-659dcdb81583","type":"message","user":"U776661HA","text":"\u003chttps://github.com/vim-denops/deno-denops-std/blob/main/denops_std/helper/echo.vim\u003e","ts":"1632749259.380900","attachments":[{"color":"24292f","fallback":"\u003chttps://github.com/vim-denops/deno-denops-std/blob/main/denops_std/helper/echo.vim | echo.vim\u003e","id":1,"title":"\u003chttps://github.com/vim-denops/deno-denops-std/blob/main/denops_std/helper/echo.vim | echo.vim\u003e","text":"```\nif exists('g:loaded_denops_std_helper_echo')\n  finish\nendif\nlet g:loaded_denops_std_helper_echo = 1\n\n\" Redraw debounce interval defined in denops.vim\n\" \u003chttps://github.com/vim-denops/denops.vim/pull/90\u003e\nlet s:redraw_interval = 10\n\nfunction! DenopsStdHelperEcho(message, name, id) abort\n  let info = {}\n  let info.name = a:name\n  let info.id = a:id\n  let info.message = a:message\n  let info.updatetime = \u0026amp;updatetime\n  let s:denops_std_helper_echo_info = info\n  \" Wait s:redraw_interval + alpha to avoid debounced\n  \" `redraw` call after RPC. See #77 for details.\n  \" \u003chttps://github.com/vim-denops/deno-denops-std/issues/77\u003e\n  let \u0026amp;updatetime = float2nr(ceil(s:redraw_interval * 1.5))\n  \" Reset Vim's internal timer for 'updatetime'\n  call feedkeys('jk', 'n')\n  augroup denops_std_helper_echo\n    autocmd!\n    autocmd CursorHold * ++once call s:denops_std_helper_echo_post()\n  augroup END\nendfunction\n\nfunction! s:denops_std_helper_echo_post() abort\n  let info = s:denops_std_helper_echo_info\n  silent! unlet! s:denops_std_helper_echo_info\n  let \u0026amp;updatetime = info.updatetime\n  redraw | echo info.message\n  call denops#request(info.name, info.id, [])\nendfunction\n\n\n```","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/vim-denops/deno-denops-std|vim-denops/deno-denops-std\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png"}],"team":"T03C4RC8V","reactions":[{"name":"yamaiyatsu","count":3,"users":["U017BU3UZBQ","U7JL1UKKL","U9S4G0LJW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"xrf"}]},{"client_msg_id":"ecdd6fa0-9d2a-46b3-9035-02e9c2051507","type":"message","user":"U9S4G0LJW","text":"いつの間にそんなの生えていたんだ、ちょっと試してみよう","ts":"1632749242.380700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/TKy="}]},{"client_msg_id":"37b29ab3-3b1f-4846-b4f3-c3c568eb988d","type":"message","user":"U776661HA","text":"この辺のコードを参考にすると非同期から呼び出されたものでも echo で止められます","ts":"1632749231.380500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"pcr"}]},{"client_msg_id":"1d62c7e3-3353-498d-813a-33b28ee115f1","type":"message","user":"U03C71D7H","text":"分割されちゃう件は最小構成だと再現しないので何かの設定が干渉しているっぽいな…","ts":"1632749228.380300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Us7"}]},{"client_msg_id":"f9c5ef87-92bd-4f7b-8892-142d7f00e511","type":"message","user":"U776661HA","text":"\u003chttps://github.com/vim-denops/deno-denops-std/blob/main/denops_std/helper/echo.ts#L5\u003e","ts":"1632749214.379600","attachments":[{"color":"24292f","fallback":"\u003chttps://github.com/vim-denops/deno-denops-std/blob/main/denops_std/helper/echo.ts | echo.ts\u003e","id":1,"title":"\u003chttps://github.com/vim-denops/deno-denops-std/blob/main/denops_std/helper/echo.ts | echo.ts\u003e","text":"```\n/**\n```","mrkdwn_in":["te