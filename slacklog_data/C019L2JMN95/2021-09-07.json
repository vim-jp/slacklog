[{"type":"message","user":"U023BF90BFS","text":"\u003c@U023BF90BFS\u003e has joined the channel","ts":"1631003184.003800","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null},{"client_msg_id":"4b3802b8-93e6-4465-a818-0aec54125b40","type":"message","user":"UKHUVMBJR","text":"\u003chttps://note.com/campintheair/n/n1de7d676c55d\u003e","ts":"1630950342.003500","attachments":[{"fallback":"note（ノート）: コスメとギターエフェクターのビジネスモデルはほぼ同一｜伊藤聡｜note","id":1,"title":"コスメとギターエフェクターのビジネスモデルはほぼ同一｜伊藤聡｜note","title_link":"https://note.com/campintheair/n/n1de7d676c55d","text":"商品が多すぎて選べない 半年ほど前である。鏡にうつる自分の顔のみすぼらしさに嫌気がさし、スキンケアをきちんとしなければと思い立った。私の顔は全体的にひどかった。仕事帰り、電車の窓にうつった私はいかにも生気がなく、まるで「会社の金を横領してつかまった経理部の中年男性」といった独特の陰鬱さがあった。われながら、この容姿はどうしたものかと情けなくなったのである。できればもう少し、はつらつとした顔になりたい。肌や身体の手入れをおろそかにしてきたツケがきたと思った。それまでも、風呂上がりに無印で買った安価な化粧水ぐらいはつけていたが、きちんとしたケアをしなければと考え、ドラッグストアへ向かっ","image_url":"https://assets.st-note.com/production/uploads/images/60535056/rectangle_large_type_2_735ce2dfb7a8db51377496942e6e5ddd.png?fit=bounds\u0026quality=85\u0026width=1280","blocks":null,"service_name":"note（ノート）","service_icon":"https://d291vdycu0ht11.cloudfront.net/nuxt/static/metaicon/apple-touch-icon.png","from_url":"https://note.com/campintheair/n/n1de7d676c55d","original_url":"https://note.com/campintheair/n/n1de7d676c55d"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"n9=D"}]},{"client_msg_id":"d92fa387-11a5-4347-ae10-ef6aacdf3f4d","type":"message","user":"U03C4RC8X","text":"パイプオルガンのあるホールいいなあ","ts":"1630949506.003300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"DMpM"}]},{"client_msg_id":"b7d1f08f-3ea2-4875-9336-44b39ec74f6e","type":"message","user":"U03C4RC8X","text":":goodpoem:","ts":"1630949465.002900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Mt+f"}]}]
