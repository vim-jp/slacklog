6958.163200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"C4Lup"}]},{"type":"message","user":"U022BS23XJN","text":"\u003c@U022BS23XJN\u003e has joined the channel","ts":"1621404835.162400","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null},{"client_msg_id":"f8e3d2f4-1899-4fb2-bbb0-0941c1c22ff5","type":"message","user":"U03C71D7H","text":"最新版で動けばヨシ :yoshi: の精神","ts":"1621404198.161500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"oZLn"}]},{"client_msg_id":"9661288b-79aa-4628-8d22-13e3a515cb28","type":"message","user":"U6XP9LZ6V","text":"いつのバージョンで入ったんだっけ。使わないというか、互換性を気にしてまだ気軽に使えない。","ts":"1621404171.161000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"wnr"}]},{"client_msg_id":"10877b92-23f0-44b6-905f-a52f5bfc876b","type":"message","user":"U03C71D7H","text":"syntax highlight もコメント扱いにならない","ts":"1621404155.160800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"WD7B3"}]},{"client_msg_id":"5e17dfd0-9534-49da-a327-888fed8798bd","type":"message","user":"U6XP9LZ6V","text":"使わないのでなかなか覚えられない","ts":"1621403993.159500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"N0s"}]},{"type":"message","user":"UPZHKAM7W","text":"```\n                                        *line-continuation-comment*\n継続行の間にコメントを追加するには、行を '\"\\ ' で始める。バックスラッシュの後の\nスペースに注意すること。例:  \n        let array = [\n                \"\\ first entry comment\n                \\ 'first',\n                \"\\ second entry comment\n                \\ 'second',\n                \\ ]\n \n解説:\n        多くのプログラムは行継続を、継続する行の末尾にバックスラッシュを置くこ\n        とで表現する。その方法をVimで採用してしまうと、Viとの互換性に重大な欠\n        陥ができてしまう。たとえばこのようなViのマッピングを考えるとわかりやす\n        い:  \n                :map xx  asdf\\\n        従って一般的ではないが行頭のバックスラッシュを採用している。\n \n        継続行の中でコメントを開始すると、後続のすべての行がコメントの一部にな\n        る。それは長い間このようなものだったので、継続行のシーケンスの途中でコ\n        メントを追加しようとしたとき、\\\" は有効な継続行であるため、それを使用\n        することはできなかった。'\"\\ ' を使用すると最も近いものになるが、少し奇\n        妙に見えるかもしれない。バックスラッシュの後にスペースを必要とすること\n        は、これが通常のコメント行にはとても見えないようにするためである。\n```","ts":"1621403964.159000","bot_id":"BPM858KEE","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":null},{"client_msg_id":"9e85acd2-5ef9-4e64-b495-2efdfcf65aae","type":"message","user":"U6XP9LZ6V","text":":help line-continuation-comment","ts":"1621403964.158900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Z38u"}]},{"client_msg_id":"7f133c91-de56-4dda-8118-94a491f65d65","type":"message","user":"U7B4ZD49X","text":"ありましたね。なんかここらへん好きな人たちはみんなLSPに興味を持って霧散したイメージあります","ts":"1621403924.158400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Xt6tI"}]},{"client_msg_id":"bffe57a9-14be-4a9e-b379-9a989a4ee8ed","type":"message","user":"U03C71D7H","text":"Go で作り直そうみたいな動きなかったっけ…","ts":"1621403861.157600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"qTj"}]},{"client_msg_id":"42549b95-28aa-4ff5-aac2-49c0b8ae1980","type":"message","user":"U03C71D7H","text":"vint はメンテできる人がいない印象がある。複雑とかではなくて単に人手不足","ts":"1621403839.157200","team":"T03C4RC8V","reactions":[{"name":"wakaru","count":2,"users":["U7B4ZD49X","U776661HA"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fVrYN"}]},{"client_msg_id":"9495ebfa-c3e0-42ba-9161-4d5ee256458b","type":"message","user":"U8996GYBF","text":"自分も今まで諦めてたけど、最近こうやればできるってのを見かけたんで気になってたんですよね\nlintで弾かれるなら諦めよう・・・","ts":"1621403761.156500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"yh1"}]},{"client_msg_id":"daa14f0a-72b7-4079-