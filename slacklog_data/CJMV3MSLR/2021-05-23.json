733875.055000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"3zTn"}]},{"client_msg_id":"be5556b3-0e79-4fa3-98b9-43c272ad4429","type":"message","user":"UD1FQV38V","text":"Coc.nvim: node.js製、あんまり設定しなくてもすぐ使えるやつでIDEっぽくしたい人向け\nvim-lsp: Pure Vim script製、Cocよりは機能少ないけどIDEっぽくなる\nDeoplete: Python製、闇の力を得たいプロ向け\nneovim lsp(built-in): luaで設定書くぞーーーうおーって人向け","ts":"1621733868.054700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Sfi2l"}]},{"client_msg_id":"b048497c-cde0-4c9c-8abd-8b0941a2b0a4","type":"message","user":"UD1FQV38V","text":"\u003chttps://github.com/princemaple/ts-langserver\u003e\nこれを使えるLSP clientと↑のLS使うって感じですね。Coc.nvimならcoc-tsserverが主流?","ts":"1621733532.049100","attachments":[{"fallback":"GitHub: princemaple/ts-langserver","id":1,"title":"princemaple/ts-langserver","title_link":"https://github.com/princemaple/ts-langserver","text":"Contribute to princemaple/ts-langserver development by creating an account on GitHub.","image_url":"https://opengraph.githubassets.com/b86bb082b6869974aea4f1d33dcd224052dbd49e0dac2bc7a14b6071f9457156/princemaple/ts-langserver","blocks":null,"service_name":"GitHub","service_icon":"https://a.slack-edge.com/80588/img/unfurl_icons/github.png","from_url":"https://github.com/princemaple/ts-langserver","original_url":"https://github.com/princemaple/ts-langserver"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"IYQ+"}]},{"client_msg_id":"cfab4a45-88df-4306-9fe2-68be74557451","type":"message","user":"UAZ33BKV2","text":"まあctagsでも飛べる設定はできるでしょうけど....ls使えるようにしちゃったほうがラクそうではあるw","ts":"1621733427.048000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4X2"}]},{"client_msg_id":"5ffad266-4082-458c-8d86-312e0a5516a8","type":"message","user":"U022DJ9E3K4","text":"そうなんですか？！\nts-langserver+LSP clientは聞いたことがなかったので使ってみます！","ts":"1621733379.047300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"djiT"}]},{"client_msg_id":"87e44bc8-5399-4983-a1f2-ac49c559f524","type":"message","user":"UD1FQV38V","text":"TypeScriptでctags使ってる人いるのだろうか","ts":"1621733279.046200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ivtrK"}]},{"client_msg_id":"9af26630-1033-462c-bedb-5b900927b293","type":"message","user":"UD1FQV38V","text":"ctagsじゃなくてts-langserver+LSP clientを使いましょう案件ですかね?","ts":"1621733224.045500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+K37"}]},{"client_msg_id":"603c7809-4f16-4aca-a236-9af39bc2d77e","type":"message","user":"U022DJ9E3K4","text":"質問をさせていただきたいです！\n\nNext(typescript)でctagsを使おうとしてるのですが、component/atom以下のファイルがtagsに読み込まれておらず、\n`import Title from \"../../components/atoms/Text/Title\";`  \nのTitleにとぼうとしても\n`E426: tag not found: Title`\n上記のエラーがでてしまいます。\nctags -Rとやっているのになぜtag not foundと出るのかが分からず、どう解決したら良いかがわからないです。。。","ts":"1621732953.044000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"vTqx"}]},{"type":"message","user":"U022K4QMWTG","text":"\u003c@U022K4QMWTG\u003e has joined the channel","ts":"1621732402.041600","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null},{"type":"message","user":"U0234G063UZ","text":"\u003c@U0234G063UZ\u003e has joined the channel","ts":"1621731281.041400","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null},{"type":"message","user":"U022RSUFWR0","text":"\u003c@U022RSUFWR0\u003e has joined the channel","ts":"1621729415.041200","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null},{"type":"message","user":"U022NL6N9MK","text":"\u003c@U022NL6N9MK\u003e has joined the channel","ts":"1621713285.04100