item) abort\n  call sonictemplate#apply(a:item.items[0], 'n')\nendfunction\n\nfunction! fz#sonictemplate#run() abort\n  call fz#run({'type': 'list', 'list': sonictemplate#complete(\"\", \"\", 0), 'accept': function('s:handler')})\nendfunction\n\n```","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/mattn/vim-sonictemplate|mattn/vim-sonictemplate\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Et4"}]},{"client_msg_id":"3ad13299-2460-4702-a145-a9622b039ccb","type":"message","user":"U01AQ5BFNLX","text":"これを実行しても結果が `[]`になってしまいます","ts":"1635823309.023700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"oG3g"}]},{"client_msg_id":"baf96ab4-7227-4e57-9044-8de098072260","type":"message","user":"U01AQ5BFNLX","text":"```function! vimrc#sonictemplateSelector() abort\n    let candidate = getcompletion('Template ', 'cmdline')\n    echo candidate\nendfunction\n\nnnoremap \u0026lt;Leader\u0026gt;\u0026lt;Leader\u0026gt; \u0026lt;Cmd\u0026gt;call vimrc#sonictemplateSelector()\u0026lt;CR\u0026gt;```","ts":"1635823288.023200","thread_ts":"1635823288.023200","reply_count":2,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"pmkS4"}]},{"client_msg_id":"6fc1f992-ef69-4418-98e3-3968524338f0","type":"message","user":"U7JL1UKKL","text":"Cmdマッピング使うべきですね","ts":"1635823225.022600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"IOX5"}]},{"client_msg_id":"3340631d-caab-4bee-b624-8c502dc978a3","type":"message","user":"U7JL1UKKL","text":"引数を補完するときにはコマンドの後にスペース入れますよね？","ts":"1635823163.022200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"w+KHo"}]},{"client_msg_id":"9f3588aa-df39-4368-89df-d57