0","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"XKUBV"}]},{"client_msg_id":"681602cc-1897-496f-9d94-85869f94d42d","type":"message","user":"U01D9BALEKU","text":"profileやってみるか","ts":"1628436959.248400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"sU9"}]},{"client_msg_id":"347d7b7f-b8d8-40a3-bc17-aea4defde6ad","type":"message","user":"U01D9BALEKU","text":"前はもっと速かった気がする","ts":"1628436409.248100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jsTm"}]},{"client_msg_id":"4f582375-80aa-42bc-b6b5-34bcec52c65b","type":"message","user":"U01D9BALEKU","text":"なんだかctrlpがすっごい重いことに気づいたのですが、キャッシュ消す以外にできることってありますかね？（消したけど重い）\n重い、っていうのもなんか妙で矢印キー上下移動ですら応答が遅いのでマッチャーの問題ではなさそうです\n`:CtrlPBuffer`みたいに数少ないやつでも同じく重いです","ts":"1628436403.247900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"dtN"}]},{"client_msg_id":"0b97b29f-44f3-4421-8564-f57d91a9a15d","type":"message","user":"U776661HA","text":"```await helper.batch(denops, (denops) =\u0026gt; {\n  denops.cmd(\"edit dummy1\");\n  denops.cmd(\"file dummy2\");\n});\nconst cwd = await fn.getcwd(denops) as string;\nconst src = [\"%\", \"%:p\", \"%hello\", \"#\", \"#:p\", \"#hello\"];\nconst dst = await normCmdArgs(denops, src);\nconst exp = [\n  \"dummy2\",\n  path.join(cwd, \"dummy2\"),\n  \"dummy2\",\n  \"dummy1\",\n  path.join(cwd, \"dummy1\"),\n  \"dummy1\",\n];\nassertEquals(dst, exp);```\nこんな感じの処理（denops）で `normCmdArgs` で `expand()` を読んでる","ts":"1628519579.277100","thread_ts":"1628519544.277000","parent_user_id":"U776661HA","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"HUG"}]},{"client_msg_id":"14041079-88f8-4c4b-8f35-7a2c7b19fa03","type":"message","user":"U776661HA","text":"\u003c@U03C71D7H\u003e","ts":"1628519582.277300","thread_ts":"1628519544.277000","parent_user_id":"U776661HA","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"uvr"}]}]
