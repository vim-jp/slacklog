[{"client_msg_id":"4b7189d2-2ab1-44af-bcb5-4b55f07f6e88","type":"message","user":"U9S4G0LJW","text":"すみません:cat-dogeza-mike:","ts":"1625902356.459000","edited":{"user":"U9S4G0LJW","ts":"1625902373.000000"},"team":"T03C4RC8V","reactions":[{"name":"+1","count":1,"users":["UDP2NNSHW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"DKg"}]},{"client_msg_id":"df716322-5d95-4559-ad78-5df38d9dd151","type":"message","user":"UDP2NNSHW","text":"5.1です\n\u003chttps://www.lua.org/manual/5.1/manual.html#pdf-require\u003e","ts":"1625902341.458700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"I93W"}]},{"client_msg_id":"35eb7edb-0adc-4d82-b352-791133ddcc1d","type":"message","user":"U9S4G0LJW","text":"LuaJITは5.2相当だったかな\n\u003chttp://milkpot.sakura.ne.jp/lua/lua52_manual_ja.html\u003e","ts":"1625902298.458400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"1O3H"}]},{"client_msg_id":"2b97a81a-90ad-4ac6-9d38-e32ce169795e","type":"message","user":"U01AQ5BFNLX","text":"とりあえず見つけたものを共有しておきます\n\u003chttps://github.com/kikito/fay/blob/master/src/lib/require.lua\u003e","ts":"1625902286.458000","attachments":[{"color":"24292f","fallback":"\u003chttps://github.com/kikito/fay/blob/master/src/lib/require.lua | require.lua\u003e","id":1,"title":"\u003chttps://github.com/kikito/fay/blob/master/src/lib/require.lua | require.lua\u003e","text":"```\nlocal oldRequire = require\n\nrequire = {}\n\nsetmetatable(require, {__call = function(_,path) return oldRequire(path) end})\n\n-- require.tree private functions\n--\nlocal lfs   = love.filesystem\nlocal cache = {}\n\nlocal function toFSPath(requirePath) return requirePath:gsub(\"%.\", \"/\") end\nlocal function toRequirePath(fsPath) return fsPath:gsub('/','.') end\nlocal function noExtension(path)     return path:gsub('%.lua$', '') end\nlocal function noEndDot(str)         return str:gsub('%.$', '') end\n\nfunction require.tree(requirePath)\n  if not cache[requirePath] then\n    local result = {}\n\n    local fsPath = toFSPath(requirePath)\n    local entries = lfs.enumerate(fsPath)\n\n    for _,entry in ipairs(entries) do\n      fsPath = toFSPath(requirePath .. '.' .. entry)\n      if lfs.isDirectory(fsPath) then\n        result[entry] = require.tree(toRequirePath(fsPath))\n      else\n        entry = noExtension(entry)\n        result[entry] = require(toRequirePath(requirePath .. '/' .. entry))\n      end\n    end\n\n    cache[requirePath] = result\n  end\n\n  return cache[requirePath]\nend\n\nfunction require.path(filePath)\n  return noEndDot(noExtension(filePath):match(\"(.-)[^%.]*$\"))\nend\n\nfunction require.relative(...)\n  local args = {...}\n  local first, last = args[1], args[#args]\n  local path = require.path(first)\n  return require(path .. '.' .. last)\nend\n\n\n\n```","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/kikito/fay|kikito/fay\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png"}],"team":"T03C4RC8V","reactions":[{"name":"+1","count":1,"users":["U027GSZR87M"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Uuu"}]},{"client_msg_id":"49630b80-64fd-4337-877d-21774b1217ff","type":"message","user":"U01AQ5BFNLX","text":"luaってそもそもリファレンスみたいなものがないのかな","ts":"1625902248.457400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Fvi"}]},{"client_msg_id":"3098d73d-351d-4fb9-84fe-281a418c9257","type":"message","user":"U01AQ5BFNLX","text":"もしかしたら `require.tree('\u003chttp://path.to|path.to\u003e.dir')`でいけるかも","ts":"1625902041.455700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"EbuK5"}]},{"client_msg_id":"13c30c60-7545-4db5-8b8b-4d2ef1f98320","type":"message","user":"U027GSZR87M","text":"neovimのluaチュートリアルには載ってないんですが実は出来たりしないかな