cmd BufEnter * call \u0026lt;SID\u0026gt;set_syntax()\n\nfunction! s:enable_syntax() abort\n  syntax on\n  TSEnableAll highlight\n  TSEnableAll context_commentstring\n  TSEnableAll rainbow\nendfunction\n\nfunction! s:disable_syntax() abort\n  syntax off\n  TSDisableAll highlight\n  TSDisableAll context_commentstring\n  TSDisableAll rainbow\nendfunction\n\nfunction! s:set_syntax() abort\n  let max_file_size = 500000\n\n  call \u0026lt;SID\u0026gt;disable_syntax()\n\n  let fsize = getfsize(@%)\n  let line_num = line('$')\n  if fsize \u0026gt; max_file_size \u0026amp;\u0026amp; input(printf('\"%s\" is too large file.(%s lines, %s byte) Continue? [y/N]', @%, line_num, fsize)) !~? '^y\\%[es]$'\n    bwipeout\n    call \u0026lt;SID\u0026gt;enable_syntax()\n  endif\n\n  if \u0026amp;ft ==# \"\" || fsize \u0026lt; max_file_size\n    call \u0026lt;SID\u0026gt;enable_syntax()\n  endif\nendfunction```\nこうなりました","ts":"1630032066.032300","thread_ts":"1630032066.032300","edited":{"user":"U8996GYBF","ts":"1630032935.000000"},"reply_count":2,"team":"T03C4RC8V","reactions":[{"name":"tada","count":1,"users":["U7JL1UKKL"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"7SXA"}]},{"client_msg_id":"6dfe909f-d7ef-42fb-9333-59b939036219","type":"message","user":"U9S4G0LJW","text":"気のせいだった、FileTypeで動いてるわ","ts":"1630031095.031700","thread_ts":"1630030873.028900","subtype":"thread_broadcast","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"8LR6a"}],"root":{"client_msg_id":"3f3fa127-5f98-4e17-ae0d-e49b3cd518e7","type":"message","user":"U9S4G0LJW","text":"なんかautocmd刺さってないしこれどうやって動作してるんだ","ts":"1630030873.028900","thread_ts":"1630030873.028900","reply_count":1,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"cRW"}]}},{"client_msg_id":"f4c9d22c-71ef-4137-98de-3c51e11e8515","type":"message","user":"U8996GYBF","text":"このコードに追加でinputのbwipeout仕込むのはありかも","t