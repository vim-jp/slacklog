cure.gravatar.com/avatar/da34283a48f2b5323a65e4bf548a3b25.jpg?s=48\u0026d=https%3A%2F%2Fa.slack-edge.com%2Fdf10d%2Fimg%2Favatars%2Fava_0011-48.png","text":"この on_complete_done_after がキラッと見えるなぁ。\nこれは feedkeys から来ているみたいだけどタイミングが変わったことによって見えてしまうようになったのかな。","mrkdwn_in":["text"],"blocks":null,"footer":"From a thread in #tech-denops","ts":1633528844.105400,"from_url":"https://vim-jp.slack.com/archives/C01N4L5362D/p1633528844105400?thread_ts=1633522181.095100\u0026amp;cid=C01N4L5362D","original_url":"https://vim-jp.slack.com/archives/C01N4L5362D/p1633528844105400?thread_ts=1633522181.095100\u0026amp;cid=C01N4L5362D"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"wM3"}]},{"client_msg_id":"4aebe4a2-7e64-4a04-8ceb-88eda1cd4d84","type":"message","user":"U0177HB2VA8","text":"\u003c@U7JL1UKKL\u003e さん\nぜんぜん isVolatile とか関係なかったっぽいでした","ts":"1633520577.248100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"2cJN"}]},{"client_msg_id":"b7488d60-d971-41cf-83b7-50ec17d70b24","type":"message","user":"U7JL1UKKL","text":"pum.vim使うと解決するとかあるかもしれない","ts":"1633520278.247400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"2+Je"}]},{"client_msg_id":"937c03ae-217e-4740-bd28-fa2c6470b2ff","type":"message","user":"U7JL1UKKL","text":"うーん、こりゃあデフォルトのv:completed_itemの挙動がヤバそうですな","ts":"1633520248.246900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"T85l"}]},{"type":"message","user":"U0177HB2VA8","text":"自分は意味がわかってないですけど、解決しました。。。\n\u003c@U7JL1UKKL\u003e さんのコレが決め手でした。\n```$ diff -u init1.vim init2.vim\n--- init1.vim\t2021-10-06 20:24:19.000000000 +0900\n+++ init2.vim\t2021-10-06 20:25:15.000000000 +0900\n@@ -35,11 +35,11 @@\n filetype plugin indent on\n syntax enable\n\n-set completeopt-=preview\n+set completeopt=noinsert\n set pumheight=10\n set backspace=indent,eol,start\n\n-inoremap \u003csilent\u003e\u003cexpr\u003e \u003cCR\u003e pumvisible() ? \"\\\u003cC-y\u003e\" : \u003cCR\u003e\n+inoremap \u003csilent\u003e\u003cexpr\u003e\u003cCR\u003e  pumvisible() ? \"\\\u003cC-y\u003e\" : \"\\\u003cCR\u003e\"\n\n \"ddc.vim settings\n call ddc#custom#patch_global('sourceOptions', {```","ts":"1633520070.245700","attachments":[{"color":"D0D0D0","fallback":"[October 6th, 2021 12:48 PM] shougo.matsu: completeoptでnoinsertをセットした状態でC-yした方がよいです","author_id":"U7JL1UKKL","author_name":"Shougo","author_subname":"Shougo","author_link":"https://vim-jp.slack.com/team/U7JL1UKKL","author_icon":"https://secure.gravatar.com/avatar/7f5a1bfaf8b64cbcdfaf82a7de92506b.jpg?s=48\u0026d=https%3A%2F%2Fa.slack-edge.com%2Fdf10d%2Fimg%2Favatars%2Fava_0017-48.png","text":"completeoptでnoinsertをセットした状態でC-yした方がよいです","mrkdwn_in":["text"],"blocks":null,"footer":"Posted in #plugins","ts":1633492137.066800,"from_url":"https://vim-jp.slack.com/archives/CLKR04BEF/p1633492137066800"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4aw"}]},{"client_msg_id":"c1ceeb89-59b9-438e-be8b-05639c244370","type":"message","user":"U8R597E9H","text":"vim-lsp の CompleteDone のハンドリングでは、「ユーザがなんらかの候補を選択した状態で CompleteDone が発火したか？」で処理を分けています。","ts":"1633487512.244300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"BCWC"}]},{"client_msg_id":"06ed0467-3161-4013-bd22-c75ebfcc75db","type":"message","user":"U8R597E9H","text":"なので、一般的な自動補完プラグインの場合、CompleteDone はほぼ毎タイプごとに呼び出されます。","ts":"1633487448.242700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4Jq"}]},{"client_msg_id":"39c9aaaa-a616-432c-b69a-0ac360218501","type":"message","user":"U8R597E9H","text":"complete 関数は、すでに表示されている pum をうわがく形で呼び出されると、それを閉じてから新しい pum を開いた。という形で処理がなされるようです。","ts":"1633487410.241600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"IQdWy"}]},{"client_msg_id":"d8bdb831-cdf1-4cbe-a4fb-e6c5ef762c32","type":"message","user":"U7JL1UKKL","text":"補完が確定されたときに呼ばれます","ts":"1633487061.239500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Zf8G"}]},{"client_msg_id":"66f2d073-0fb2-4503-9ecc-760d7e467963","type":"message","user":"U7JL1UKKL","text":"CompleteDoneにデバッグログを仕込んでみてタイミングを見るのはどうですか","ts":"1633487050.239100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fp8UL"}]},{"client_msg_id":"E042ACD3-8FEB-4542-9586-4C7A381C58AB","type":"message","user":"U0177HB2VA8","text":"そういう風に動くことになるんですかね、、、？\nなんでdeopleteとか、asyncomplete.vimは大丈夫なんだ、、、？\nでも、complete あたりを見てけば良さそうということですかね、、、？\nありがとうございます。","ts":"1633485848.238400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"z3JxY"}]},{"client_msg_id":"6eacc870-f278-4e8c-87db-198c83d9eb93","type":"message","user":"UAZ33BKV2","text":"あー、キャンセルされても出るのか、事故りそうだ","ts":"1633481310.235400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"af2E"}]},{"client_msg_id":"25ad4976-c19f-45dc-8502-16f575338b72","type":"message","user":"U7HFY4HFY","text":"「中止されても発行される」らし\nしかし補完が実行されたのか中止されたのかを知る術はない？","ts":"1633481303.235200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"63G"}]},{"type":"message","user":"UPZHKAM7W","text":"```\n                                                        *CompleteDone*\nCompleteDone                    挿入モード補完が完了したとき。補完が実行されて\n                                も中止されても発行される。 |ins-completion|\n                                |complete_info()| を使うことができる。情報は\n                                CompleteDone が発行される前にクリアされる。必\n                                要ならば CompleteDonePre を使うこと。\n                                変数 |v:completed_item| には補完された候補につい\n                                ての情報が含まれている。\n```","ts":"1633481193.233900","bot_id":"BPM858KEE","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":null},{"client_msg_id":"dd53126e-41c7-47ae-9b6c-6b8f9e9547f1","type":"message","user":"U7HFY4HFY","text":":h CompleteDone","ts":"1633481193.233800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fkif"}]},{"client_msg_id":"fa1d6e0c-7f14-4362-ba13-51900c630af8","type":"message","user":"U0177HB2VA8","text":"なるほど！","ts":"1633478056.233500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"FkPjI"}]},{"client_msg_id":"5b75d88f-021e-4601-8105-2a914915b7de","type":"message","user":"U9S4G0LJW","text":"時間がないので離脱","ts":"1633478029.233300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"vLIau"}]},{"client_msg_id":"a7a11cc4-2f2b-46f8-b565-693a9b8a1f62","type":"message","user":"U9S4G0LJW","text":"EVENT_COMPLETEDONEでgrepするとよさそう","ts":"1633478024.233000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"erc"}]},{"client_msg_id":"52deb8a6-693f-4acc-b53d-f7a948963233","type":"message","user":"U0177HB2VA8","text":"やっぱりそういうものですよね。\nじゃー、やっぱりどこかで意図しないタイミングで呼ばれてるんだろうなぁ。。。\nvim script的に何をコールしたら `CompleteDone` が呼ばれるのかもよくわかってなくて。。。","ts":"1633477940.232200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"f53U"}]},{"client_msg_id":"fa45aa4b-0fe9-4177-b07d-4be55825d842","type":"message","user":"UAZ33BKV2","text":"うーん、選択完了で呼ばれる気がするけど、どうだったっけ...","ts":"1633477837.230800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"rlVGj"}]},{"client_msg_id":"f88271be-1987-4e50-a6ad-1db75ccae1e5","type":"message","user":"U0177HB2VA8","text":"vimのソースを読んでみたのですが場所がわからなかったので教えてほしいです。\n`CompleteDone` のイベントは、 `complete` を呼んだ直後で実行される物なのでしょうか？\n追加したログを見ていて「そういうものなのか」と思っていたのですが、どちらかというと、`complete` で候補を表示して、候補から何かしら選択したあとに `CompleteDone` イベントが呼ばれるのが普通の挙動なんじゃないかと思ってきました。\nどこかで意図しないタイミングで `CompleteDone` が呼ばれてるからvim-lsp 側で保持しているuser_data がクリアされてimport の自動追加ができていないように見えるためです。","ts":"1633477721.230400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"B/B"}]},{"client_msg_id":"405c8968-c439-40b1-926b-314b26f5342e","type":"message","user":"U8996GYBF","text":"\u0026gt; You cannot use lazy \u0026lt;Plug\u0026gt; mappings twice.\nこれ把握してなかった","ts":"1633473664.225600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"VDRe4"}]},{"type":"message","user":"UPZHKAM7W","text":"```\n                                                        *dein-options-on_map*\non_map          (Dictionary) or (List) or (String)\n                If it is the Dictionary, the key is {mode} and the items are\n                {mapping} or [{mapping1}, {mapping2}, ...].\n                If it is the List, the items are {mapping} or [{mode},\n                {mapping1}, [{mapping2}, ...]].\n                If {mode} is omitted, \"nx\" is used.\n                Note: You can use plugin prefix mappings.\n                For example, you can use \"\u0026lt;Plug\u0026gt;(ref-\" instead of\n                \"\u0026lt;Plug\u0026gt;(ref-back)\" and so on.\n                For example:  \n                call dein#add('Shougo/deol.nvim',\n                \\ { 'on_map': {'n': '\u0026lt;Plug\u0026gt;'} })\n \n                Note: You can use \"\u0026lt;Plug\u0026gt;\" keyword as {mapping}. If\n                {mapping} is \"\u0026lt;Plug\u0026gt;\", \"\u0026lt;Plug\u0026gt;({normalized_name}\" is\n                used.\n                For example:  \n                \" It is same as \"'on_map': '\u0026lt;Plug\u0026gt;(anzu'\"\n                call dein#add('osyo-manga/vim-anzu', {'on_map': '\u0026lt;Plug\u0026gt;'})\n \n                \" It is same as \"'on_map': '\u0026lt;Plug\u0026gt;(easy-align'\"\n                \" But it does not work as expected.  Because the plugin\n                \" defines '\u0026lt;Plug\u0026gt;(EasyAlign)' mapping instead.\n                call dein#add('junegunn/vim-easy-align', {'on_map': '\u0026lt;Plug\u0026gt;'})\n \n                \" This works as expected\n                call dein#add('junegunn/vim-easy-align',\n                \\ {'on_map': '\u0026lt;Plug\u0026gt;(EasyAlign)'})\n \n                Note: You cannot use lazy \u0026lt;Plug\u0026gt; mappings twice.\n                For example:  \n                call dein#add('osyo-manga/vim-anzu',\n                \\ {'on_map': '\u0026lt;Plug\u0026gt;(anzu-'}\n                \" Not working!!\n                nmap n \u0026lt;Plug\u0026gt;(anzu-jump-n)\u0026lt;Plug\u0026gt;(anzu-echo-search-status)zv\n                nmap N \u0026lt;Plug\u0026gt;(anzu-jump-N)\u0026lt;Plug\u0026gt;(anzu-echo-search-status)zv\n```","ts":"1633473527.225100","bot_id":"BPM858KEE","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":null},{"client_msg_id":"86bbf8ff-da42-4000-8661-4fcce4933a17","type":"message","user":"U8996GYBF","text":":h on_map","ts":"1633473526.225000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ahM4e"}]},{"client_msg_id":"d6cdb12d-b167-43c3-9149-c851707182bb","type":"message","user":"U8996GYBF","text":"間違えてないか確認したいんですけど、これってプラグイン名がskkeletonだから `\u0026lt;Plug\u0026gt;` ってショートハンドで書けますよね？","ts":"1633473490.224800","thread_ts":"1633473490.224800","reply_count":1,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"kBW"}]},{"client_msg_id":"9b9d9367-aeb6-4539-9f61-b29d189071ca","type":"message","user":"U8996GYBF","text":"昔にlazyしてた時期はon_mapを全て辞書で書いてたんですけど、今はnx以外のときだけにしてしまった","ts":"1633473300.223600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"EQyiu"}]},{"client_msg_id":"d9d1d60b-38e7-4234-ac53-a7f04a1293db","type":"message","user":"U8996GYBF","text":"デフォがnxですよね、iとかoでたまに忘れる","ts":"1633473237.222600","edited":{"user":"U8996GYBF","ts":"1633473243.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"nIM"}]},{"client_msg_id":"57ae0067-ee6d-4bea-a13e-5d1c6c331ba7","type":"message","user":"U7JL1UKKL","text":"そうです","ts":"1633472390.222200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"BuW"}]},{"client_msg_id":"b5890d95-c17b-4cfd-9403-c6e12ef49301","type":"message","user":"U01D44KSY9Z","text":"imap or cmap","ts":"1633472318.222000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0+IV7"}]},{"client_msg_id":"ed01b5de-1824-4eb2-a217-15bbbf0b59f4","type":"message","user":"U01D44KSY9Z","text":"insertかcmdlineモードって事じゃないですかね","ts":"1633472295.221400","edited":{"user":"U01D44KSY9Z","ts":"1633472303.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Hm0"}]},{"client_msg_id":"ca8a834d-85b2-4ff1-94d5-43ebd0277340","type":"message","user":"U01AQ5BFNLX","text":"`on_map = {ic = '\u0026lt;Plug\u0026gt;(skkeleton-toggle)'}` のicってどういう意味を持つんでしょうか?","ts":"1633471750.220800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"SOFy"}]},{"client_msg_id":"f38bbcd1-c08d-4307-b344-f19bcdc76efb","type":"message","user":"U06ECBRTJ","text":"行けました！ ありがとうございました！","ts":"1633447070.220000","team":"T03C4RC8V","reactions":[{"name":"tada","count":3,"users":["U03C71D7H","U9S4G0LJW","U7JL1UKKL"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"rTE