5177.479200","edited":{"user":"U01D9BALEKU","ts":"1615305266.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Asz"}]},{"client_msg_id":"e717d910-9ccd-4302-b4b7-15caa0d8bc65","type":"message","user":"U01D9BALEKU","text":"聞こうとして整理していたら:jiketsu: したけどせっかくなので貼っておきます","ts":"1615305173.479000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"BoWm"}]}]
