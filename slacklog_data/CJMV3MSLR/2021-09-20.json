ond startup.\n\n*Expected*\n\nlexima works even when \"lazy\" is set.\n\n*Environment Information (Required!)*\n\n• dein.vim version(SHA1): bc75c5de7c26a8d478541a71f181635fae229eaa\n• OS: macOS Big Sur\n• Vim/neovim version: NVIM v0.6.0-dev+308-g89db07556\n\n*Provide a minimal .vimrc with less than 50 lines (Required!)*\n*vimrc*\n\n```\nlet s:DEIN_BASE_PATH = $HOME . '/.vim/bundle/'\nlet s:DEIN_PATH      = expand(s:DEIN_BASE_PATH . 'repos/github.com/Shougo/dein.vim')\nif !isdirectory(s:DEIN_PATH)\n  if executable('git')\n    execute '!git clone --depth=1 \u003chttps://github.com/Shougo/dein.vim\u003e' s:DEIN_PATH\n  endif\nendif\n\nlet \u0026amp;runtimepath .= ',' . s:DEIN_PATH\n\nif dein#load_state(s:DEIN_BASE_PATH)\n  call dein#begin(s:DEIN_BASE_PATH)\n\n  call dein#add('cohama/lexima.vim', {'lazy': 1, 'on_i': 1, 'hook_post_source': 'call SetupLexima()'})\n\n  call dein#end()\n  call dein#save_state()\nendif\n\nif dein#check_install()\n  call dein#install()\nendif\n\nfunction! SetupLexima() abort\n  let s:rules = []\n\n  let s:rules += [\n  \\ { 'char': '\u0026lt;BS\u0026gt;', 'at': '(\\%#)', 'input': '\u0026lt;BS\u0026gt;\u0026lt;Del\u0026gt;', },\n  \\ ]\n\n  for s:rule in s:rules\n    call lexima#add_rule(s:rule)\n  endfor\nendfunction\n```\n\n*Dockerfile*\n\n```\nFROM ubuntu:focal\n\nENV DEBIAN_FRONTEND=noninteractive\n\nRUN apt update \u0026amp;\u0026amp; apt install -y ninja-build gettext libtool libtool-bin autoconf automake cmake g++ pkg-config unzip git\n\nWORKDIR /usr/local/src\nRUN git clone \u003chttps://github.com/neovim/neovim.git\u003e\n\nWORKDIR /usr/local/src/neovim\nRUN make \u0026amp;\u0026amp; make install\n\nRUN apt install -y python pip\nRUN pip install neovim\n\nRUN sh -c 'curl -fLo /root/.config/nvim/init.vim --create-dirs \u003chttps://gist.githubusercontent.com/yuki-yano/31370b93bb1532fe724e88e91fa92960/raw/8b4d7c1f19cec0890d6ba3207b589c6bd8a2e617/wilder_and_lexima_test.vim\u003e'\n\nENTRYPOINT [\"bash\"]\n```\n\n*The reproduce ways from Vim starting (Required!)*\n\n1. `$ nvim`\n2. Input: `(` -\u0026gt; Output: `()`\n3. `:qa`\n4. `$ nvim`\n5. `Input:` (`-\u0026gt; Output:`(`\n\n*Screen shot (if possible)*\n\n\u003chttps://user-images.githubusercontent.com/5423775/133975576-15ef6f84-f24d-4197-b8bf-b8e025b8a5b0.mp4|https://user-images.githubusercontent.com/5423775/133975576-15ef6f84-f24d-4197-b8bf-b8e025b8a5b0.mp4\u003e","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/Shougo/dein.vim|Shougo/dein.vim\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png","ts":1632127056}],"parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Vln"}]},{"client_msg_id":"100e0165-cf57-4493-804f-6b7ab92b556f","type":"message","user":"U7JL1UKKL","text":"原因判明しました","ts":"1632129643.257600","thread_ts":"1632124095.255300","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"SqCQF"}]},{"client_msg_id":"d473f4d0-a920-4900-8ab7-34de0929a9af","type":"message","user":"U8996GYBF","text":"あ、確認しました\nありがとうございます","ts":"1632129664.257800","thread_ts":"1632124095.255300","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"wTTT"}]},{"client_msg_id":"65da6459-c8fb-4763-8890-ecd552cd830c","type":"message","user":"U7JL1UKKL","text":"on_iは削除されてるのでon_eventを使う必要があります","ts":"1632129668.258000","thread_ts":"1632124095.255300","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"bbjQ6"}]}]
