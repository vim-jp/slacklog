rfileで最小構成として試しています\n```FROM ubuntu:focal\n\nENV DEBIAN_FRONTEND=noninteractive\n\nRUN apt update \u0026amp;\u0026amp; apt install -y ninja-build gettext libtool libtool-bin autoconf automake cmake g++ pkg-config unzip git\n\nWORKDIR /usr/local/src\nRUN git clone \u003chttps://github.com/neovim/neovim.git\u003e\n\nWORKDIR /usr/local/src/neovim\nRUN make \u0026amp;\u0026amp; make install\n\nRUN apt install -y python pip\nRUN pip install neovim\n\nRUN sh -c 'curl -fLo /root/.config/nvim/init.vim --create-dirs \u003chttps://gist.githubusercontent.com/yuki-yano/31370b93bb1532fe724e88e91fa92960/raw/932f7b3b2df6d696352cf2cbdd056f05a2bf28c2/wilder_and_lexima_test.vim\u003e'\n\nENTRYPOINT [\"bash\"]```","ts":"1632123924.252700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"bjDD+"}]},{"client_msg_id":"ebd0822a-d000-4240-bcf7-1b5fa1ba8573","type":"message","user":"U8996GYBF","text":"lazyを付けてると2回目以降の起動で何故かleximaが効かなくて、lazyがなかったら2回目以降の起動でleximaがちゃんと動くって感じです","ts":"1632123832.252300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"S6LN"}]},{"client_msg_id":"4f4680a0-5ed9-4e06-8e4e-5f4303b01c3d","type":"message","user":"U8996GYBF","ts":"1632123765.251300","files":[{"id":"F02EJ527023","created":1632123762,"timestamp":1632123762,"name":"Kapture 2021-09-20 at 16.41.53.mp4","title":"Kapture 2021-09-20 at 16.41.53.mp4","mimetype":"video/mp4","image_exif_rotation":0,"filetype":"mp4","pretty_type":"MPEG 4ビデオ","user":"U8996GYBF","mode":"hosted","editable":false,"is_external":false,"external_type":"","size":1156146,"url":"","url_download":"","url_private":"https://files.slack.com/files-pri/T03C4RC8V-F02EJ527023/kapture_2021-09-20_at_16.41.53.mp4","url_private_download":"https://files.slack.com/files-pri/T03C4RC8V-F02EJ527023/download/kapture_2021-09-20_at_16.41.53.mp4","original_h":0,"original_w":0,"thumb_64":"","thumb_80":"","thumb_160":"","thumb_360":"","thumb_36