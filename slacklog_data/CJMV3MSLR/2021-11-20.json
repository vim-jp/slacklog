m/T03C4RC8V-F02NFG44N81-c1958320b3","edit_link":"","preview":"","preview_highlight":"","lines":0,"lines_more":0,"is_public":true,"public_url_shared":false,"channels":null,"groups":null,"ims":null,"initial_comment":{},"comments_count":0,"num_stars":0,"is_starred":false,"shares":{"public":null,"private":null},"display_as_bot":false,"has_rich_preview":false,"thumb_800":"https://files.slack.com/files-tmb/T03C4RC8V-F02NFG44N81-acec05ddf3/image_800.png","thumb_800_h":511,"thumb_800_w":800,"thumb_tiny":"AwAeADDP3Z69qTd7U5mbb0PNNLMev8qAAt6Ck3H2/KkwaKACijBooAf83pRlh1WpJAAowx5HpUZB/vH3oAaWJ9qNx9TRtNIRg4oAKKKKAP/Z","username":""}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ZUbz7"}]},{"client_msg_id":"a92af683-e7cf-44b2-b057-e77ec76f0a4a","type":"message","user":"U03C71D7H","text":"私の環境で LANG を変えると文字化けしたので、この辺りの環境が影響していそうな予感はあります。LANG が設定されているだけでシステムにロケールがインストールされてない、なんてことはないですかね…?","ts":"1637395933.145800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"HTb"}]},{"client_msg_id":"dced1a90-7e40-4cf1-b805-ecdfece65388","type":"message","user":"U01D44KSY9Z","text":"\u0026gt; locale  が空文字列 \"\" の場合、ロケールの各部分の設定には環境変数が参照される。 その詳細は実装依存である。 glibc の場合、まず最初に (どんな category に対しても) 環境変数 LC_ALL が検査される。 次にカテゴリー (category) と同じ名前の環境変数 (上記の表を参照) が検査され、最後に環境変数 LANG が検査される。 最初に見つかった環境変数を使用する。 その値がロケール指定として正しくなければ、ロケールは変更されず、 setlocale()  は NULL を返す。\n`man setlocale` より","ts":"1637395917.145400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"3Lh"}]},{"client_msg_id":"8b623a8e-acdf-4b69-86fa-8f31ddf7db03","type":"message","user":"U03C71D7H","text":"`$LC_` 系の環境変数が何になっているか確認してみるとよいかも?","ts":"1637395916.145300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"U6NF"}]},{"client_msg_id":"e80b24b5-2622-43a5-b7aa-d7cbd96649d3","type":"message","user":"U01D44KSY9Z","text":"`$LANG` は優先順位一番低そう","ts":"1637395879.144400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+5M0n"}]},{"client_msg_id":"ba10bc33-88b4-46d5-86b2-0d41719448fd","type":"message","user":"U03C71D7H","text":"なんか優先順位があったような…しかし私の環境では `$LC_???` 系は何も設定されていなかった :innocent:","ts":"1637395817.143500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zsp"}]},{"client_msg_id":"b61ef5f7-f7bb-4a98-ab19-40331f0f5b36","type":"message","user":"U01D44KSY9Z","text":"こういう時って `$LC_ALL` も関係あるんでしたっけ","ts":"1637395770.142900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"1iXb"}]},{"client_msg_id":"b5e87a82-0d67-4ba7-9b35-7a422ef5ec24","type":"message","user":"U03C71D7H","text":"一緒だな…","ts":"1637395735.142400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"WIJw"}]},{"client_msg_id":"d0b032ac-30ae-4976-bb33-d1242254ca6d","type":"message","user":"U01ATUT6PL3","text":"`2.34.0` にしても同じでした","ts":"1637395733.142300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+88"}]},{"client_msg_id":"a17d83b7-b0ef-4d96-a950-a3feb9c320d6","type":"message","user":"U01ATUT6PL3","text":"`ja_JP.UTF-8` ですね","ts":"1637395724.141800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"M24b"}]},{"client_msg_id":"f9f61b94-09d1-4017-bc41-0e8e554ec6d9","type":"message","user":"U03C71D7H","text":"`LANG=C` でやると私の環境でも文字化けしました","ts":"1637395692.141100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Z+e"}]},{"client_msg_id":"2dd693fe-732b-46dc-b30b-2ae83b4dc88c","type":"message","user":"U03C71D7H","text":"あるいは、 $LANG って何になってます? `UTF-8` 入ってるでしょうか?","ts":"1637395671.140500","team":"T03C4RC8V","replace_original