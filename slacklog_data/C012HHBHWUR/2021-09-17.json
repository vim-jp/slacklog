0900","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"56gP"}]},{"client_msg_id":"5f3c741f-be21-493b-aafb-f73a56f2f715","type":"message","user":"U06BRP8VD","text":"ああ `partition_options:` が2つあるのかw","ts":"1631882715.084700","thread_ts":"1631879422.080900","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"nLR8S"}]},{"client_msg_id":"00ca8fa6-83a9-4450-83db-04e0e10a0445","type":"message","user":"UDDCM376D","text":"\u003chttps://dev.mysql.com/doc/refman/8.0/en/alter-table.html\u003e の121行目にあります","ts":"1631882717.084900","thread_ts":"1631879422.080900","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"qFY4"}]},{"client_msg_id":"86d674e6-5fa7-4890-a09b-839c6f871cfa","type":"message","user":"UDDCM376D","text":"はい","ts":"1631882720.085100","thread_ts":"1631879422.080900","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"kD/5"}]},{"client_msg_id":"ee595285-11d1-44da-8b40-e4fe15b2f4f8","type":"message","user":"U06BRP8VD","text":"たぶん partition_definition \u0026amp; partition_definitions のことなんだろうな","ts":"1631882760.085300","thread_ts":"1631879422.080900","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Ltm"}]},{"client_msg_id":"69eeea1c-758a-444e-a135-aa18536d29ee","type":"message","user":"U06BRP8VD","text":"この2つは alter table に記述がないから。","ts":"1631882784.085500","thread_ts":"1631879422.080900","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"aXVQ"}]},{"client_msg_id":"540c439f-b94e-43cc-8ea2-60105b359996","type":"message","user":"U06BRP8VD","text":"alter table はだいたい `alter table {テーブル名} {動詞} {対象}` という構文になってるんですよ。","ts":"1631882827.085700","thread_ts":"1631879422.080900","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"mDVj"}]},{"client_msg_id":"4e6d3cbf-8138-4147-b235-46a305acdce2","type":"message","user":"U06BRP8VD","text":"さらに言えばSQLは英語の文として自然に近くなるように構成されている。","ts":"1631882852.085900","thread_ts":"1631879422.080900","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"61cy"}]},{"client_msg_id":"f094b8ce-70ea-4b5c-a3cc-723a62ee2574","type":"message","user":"U06BRP8VD","text":"なので `alter table {テーブル名} partition` はマニュアルみるまでもなく「なにかおかしい」ってなります。","ts":"1631882885.086100","thread_ts":"1631879422.080900","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"OKx8Y"}]},{"client_msg_id":"13a94212-dd01-41b0-9671-be3f527a0bbd","type":"message","user":"UDDCM376D","text":"え","ts":"1631882899.086300","thread_ts":"1631879422.080900","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"wNerf"}]},{"client_msg_id":"6c23db33-071b-4c17-a5dd-7a4e26c1ee92","type":"message","user":"UDDCM376D","text":"そうなのか","ts":"1631882913.086500","thread_ts":"1631879422.080900","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+KjI"}]},{"client_msg_id":"f1b69e4e-4d4e-49ca-a8f2-3cebff57e9b7","type":"message","user":"UDDCM376D","text":"これは普通に動くんですが、こいつが例外ってことか\n```ALTER TABLE table_a\nPARTITION BY LIST COLUMNS(a) (\n   PARTITION type_p1 VALUES IN (\"x\", \"y\", \"z\")\n)```","ts":"1631882996.086700","thread_ts":"1631879422.080900","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"AHW"}]},{"client_msg_id":"fcea55fa-beb0-4550-9892-fd6aca901413","type":"message","user":"U06BRP8VD","text":"ええ。それが動く理由が僕には説明できない。","ts":"1631883019.086900","thread_ts":"1631879422.080900","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Gxa/f"}]},{"client_msg_id":"c47462be-7331-441d-8cfd-f35f3c85dceb","type":"message","user":"UDDCM376D","text":"なるほど","ts":"1631883031.087100","thread_ts":"1631879422.080900","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"79of"}]},{"client_msg_id":"1f26ef13-29c5-4229-ab0d-80b2c29ec37c","type":"message","user":"UDDCM376D","text":"\u0026gt; alter table はだいたい `alter table {テーブル名} {動詞} {対象}` という構文になってるんですよ。\nこれは覚えておきます\nありがとうございます","ts":"1631883044.087300","thread_ts":"1631879422.080900","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0mg"}]},{"client_msg_id":"9086dd0c-deed-438b-a82d-60e1c645027f","type":"message","user":"UDDCM376D","text":"ALTERのsyntaxを読むと、ADD PARTITION が正だなこれは","ts":"1631883230.087500","thread_ts":"1631879422.080900","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Ldb"}]},{"client_msg_id":"ab08b8b5-cab8-41f9-9371-be3b9ebe39a5","type":"message","user":"UDDCM376D","text":"```ALTER TABLE table_a\nPARTITION BY LIST COLUMNS(a)\nSUBPARTITION BY KEY(key)\nSUBPARTITIONS 55 (\n    PARTITION type_p1 VALUES IN (\"x\", \"y\", \"z\")\n);```\nこれで行けました","ts":"1631885046.087700","thread_ts":"1631879422.080900","parent_user_id":"UDDCM376D","team":"T03C4RC8V","reactions":[{"name":"+1","count":1,"users":["U06BRP8VD"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"p=DHJ"}]},{"client_msg_id":"bd37e75a-619d-40f9-bcc1-6e36c04679bb","type":"message","user":"UDDCM376D","text":"難しすぎてわからんわこれ…","ts":"1631885067.088000","thread_ts":"1631879422.080900","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"eXZH"}]},{"client_msg_id":"a9e86156-a1d8-44ce-9893-de0e150d9b1a","type":"message","user":"UDDCM376D","text":"subpartitions の中でpartition by listの定義を書いていくの、そういうことかって思った","ts":"1631885210.088200","thread_ts":"1631879422.080900","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"1Ho"}]}]
