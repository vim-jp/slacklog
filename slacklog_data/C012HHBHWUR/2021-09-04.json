84d9-abc892c5f48c","type":"message","user":"UNJ2DANJC","text":"論理的には同じテーブルに格納できるときもユースケース次第でテーブル分けたりもするしDB設計難しい","ts":"1630730056.045300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"3ZtR"}]},{"client_msg_id":"a887572c-2948-49f3-9cb8-2f9273d0ae69","type":"message","user":"UDDCM376D","text":":naruhodo:","ts":"1630729961.042700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"PoqA"}]},{"client_msg_id":"994a16ff-c6f0-4bde-b90c-51a9804bc376","type":"message","user":"U022PB40WAF","text":"DBチューニングってサーキット用に最適化するか公道でも120km/h出せる白いハチロクを作るかぐらい奥が深い話ですしね。","ts":"1630729817.042000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/Ml6"}]},{"client_msg_id":"b6ee5938-79f8-43df-b204-e18a8804a2e2","type":"message","user":"U06BRP8VD","text":"くらいが基本方針ですかね。例外はいくらでも考えられるけど。","ts":"1630729711.040500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4Lp"}]},{"client_msg_id":"ba348cb9-d7ee-467d-9090-645906cd4b8d","type":"message","user":"UDDCM376D","text":":naruhodo:","ts":"1630729704.040100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"sju"}]},{"client_msg_id":"dec206ac-f95f-48e6-bb7d-efb1a7f4826e","type":"message","user":"U06BRP8VD","text":"キツイ性能要件がある場合は、上の登場人物や関係性に無理なく組み込めるならそれらを考慮して調整すればよい。できないようなら外付けでキャッシュ的な仕組みでなんとかする。","ts":"1630729694.039800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Ava"}]},{"client_msg_id":"70025e41-6299-45bd-8b8b-231f008db932","type":"message","user":"UDDCM376D","text":"ありがとうございます\nメモっておきました","ts":"1630729592.038300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5id"}]},{"client_msg_id":"72a22dfc-886a-4231-a89d-4d8c48df4657","type":"message","user":"U06BRP8VD","text":"DB設計の考え方まとめると:\n\n1. 全ユースケース(機能要件)を網羅するストーリーととらえ\n2. その物語の表現に必要十分な登場人物(E)とその関係性(R)を決め\n3. 正規化重点、最適化は最後の手段 (とはいえ全ユースケースが決まってるなら、貼るべきインデックスなどは自ずと決まる","ts":"1630729559.038000","edited":{"user":"U06BRP8VD","ts":"1630729608.000000"},"team":"T03C4RC8V","reactions":[{"name":"tips","count":1,"users":["UDDCM376D"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"7ZIiC"}]},{"client_msg_id":"3d2dd31d-e9ce-4feb-987a-5738ced25384","type":"message","user":"UDPT2BZ6E","text":"ISUCON最終兵器 -\u0026gt; パスワードのハッシュアルゴリズム変更","ts":"1630729357.035200","team":"T03C4RC8V","reactions":[{"name":"sorena","count":2,"users":["UKHUVMBJR","UD1FQV38V"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hY1u"}]},{"client_msg_id":"cb55a898-ce5a-480f-a461-ac5d30c607db","type":"message","user":"U06BRP8VD","text":"とにかく点数・速度のために非正規化どころか脱RDBMSも上等、って感じだもんねw","ts":"1630729347.034800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"awZCs"}]},{"client_msg_id":"6efe73ab-f104-4d81-a1f8-7d03217329e1","type":"message","user":"UKHUVMBJR","text":"な、なるほどたしかに・・・実運用に向かないISUCON最終兵器とかあるからなあ・・・","ts":"1630729313.034000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"dW9HA"}]},{"client_msg_id":"1662f7e6-a513-470e-aea9-94e50fcbf201","type":"message","user":"U06BRP8VD","text":"まぁ豊富な実例ではあるけども。","ts":"1630729300.033700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"yGaPn"}]},{"client_msg_id":"85d00d26-fad3-4913-b5a2-8fc5e6bb30af","type":"message","user":"U06BRP8VD","text":"いやISUCONは特殊解過ぎて…","ts":"1630729280.033100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"WJx"}]},{"client_msg_id":"85dbeafe-779b-46ab-8992-363fdc72a646","type":"message","user":"U022P