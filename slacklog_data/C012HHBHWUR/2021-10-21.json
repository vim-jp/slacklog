.jp/img/2021/02/24/sqlite-many-queries/00_m.png","blocks":null,"service_name":"GIGAZINE","service_icon":"https://gigazine.net/apple-touch-icon.png","from_url":"https://gigazine.net/news/20210224-sqlite-many-queries/","original_url":"https://gigazine.net/news/20210224-sqlite-many-queries/"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ai0Ze"}]},{"client_msg_id":"541ccdd7-1a9c-4a08-8f11-9272d04e0d2b","type":"message","user":"UNJ2DANJC","text":"timescaledbとかも面白いですね","ts":"1634784892.022700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"z2f1k"}]},{"client_msg_id":"ff69fa34-a095-43a1-901a-5d40c849e0d9","type":"message","user":"U03C6TEAZ","text":"↑地図上で空間検索できたりするやつです。","ts":"1634784892.022600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"bPdu"}]},{"client_msg_id":"e37eb80a-2adf-43ce-ba17-591a96312c02","type":"message","user":"U03C6TEAZ","text":"PostGIS ほんと良く出来てる。","ts":"1634784840.021900","team":"T03C4RC8V","reactions":[{"name":"honsore","count":1,"users":["U06BRP8VD"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"PZZ/"}]},{"client_msg_id":"fd733043-357c-4a0e-985b-43d67aa77d9c","type":"message","user":"U03C6TEAZ","text":"GIS 関連だと今は PostgreSQL の方が高性能ですね。","ts":"1634784827.021700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"eV0h"}]},{"client_msg_id":"146f0359-2342-44be-84dd-0dfe54ffda89","type":"message","user":"U06ECBRTJ","text":"11g だったからかもしれないけど","ts":"1634784713.021300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Ti6lS"}]},{"client_msg_id":"a43fbb5d-e09e-40f4-b2b2-8083bc54e33a","type":"message","user":"U06ECBRTJ","text":"Oracle は前にちょっと調べただけだと、なんかめんどくさい印象が","ts":"1634784699.021100","team":"T03C4RC8V","rep