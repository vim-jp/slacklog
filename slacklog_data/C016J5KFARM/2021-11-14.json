:"https://a.slack-edge.com/80588/img/unfurl_icons/wikipedia.png","from_url":"https://ja.m.wikipedia.org/wiki/%E3%83%8F%E3%83%B3%E3%83%AD%E3%83%B3%E3%81%AE%E5%89%83%E5%88%80","original_url":"https://ja.m.wikipedia.org/wiki/%E3%83%8F%E3%83%B3%E3%83%AD%E3%83%B3%E3%81%AE%E5%89%83%E5%88%80"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ikmyJ"}]},{"client_msg_id":"13165516-a2fc-4994-8a91-9bbbd5657828","type":"message","user":"U9S4G0LJW","text":"無能で説明できることに悪意を見出すな、でしたっけ","ts":"1636871855.190000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ZN/"}]},{"client_msg_id":"D9F5F87C-2826-41A6-9A57-500028542CA1","type":"message","user":"UP6PA1UBE","text":"悪意より無能を疑えばイライラしないで済みますよ","ts":"1636871658.189200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/Ke"}]},{"client_msg_id":"39ea0c68-3c87-41d5-9e6e-8629396fd80d","type":"message","user":"U022XK5866Q","text":"かっちよいいー！","ts":"1636871630.188500","files":[{"id":"F02M91FV3M1","created":1636871619,"timestamp":1636871619,"name":"IMG20211114152925.jpg","title":"IMG20211114152925.jpg","mimetype":"image/jpeg","image_exif_rotation":0,"filetype":"jpg","pretty_type":"JPEG","user":"U022XK5866Q","mode":"hosted","editable":false,"is_external":false,"external_type":"","size":644304,"url":"","url_download":"","url_private":"https://files.slack.com/files-pri/T03C4RC8V-F02M91FV3M1/img20211114152925.jpg","url_private_download":"https://files.slack.com/files-pri/T03C4RC8V-F02M91FV3M1/download/img20211114152925.jpg","original_h":4000,"original_w":3000,"thumb_64":"https://files.slack.com/files-tmb/T03C4RC8V-F02M91FV3M1-6cc2bf1aba/img20211114152925_64.jpg","thumb_80":"https://files.slack.com/files-tmb/T03C4RC8V-F02M91FV3M1-6cc2bf1aba/img20211114152925_80.jpg","thumb_160":"https://files.slack.com/files-tmb/T03C4RC8V-F02M91FV3M1-6cc2bf1aba/img20211114152925_160.jpg","t