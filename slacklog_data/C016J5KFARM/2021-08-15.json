.jp/etc/designs/panasonic/common-clientlibs/images/favicon.ico","from_url":"https://panasonic.jp/teeth/products/EW-DJ54.html","original_url":"https://panasonic.jp/teeth/products/EW-DJ54.html"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Aouh2"}]},{"client_msg_id":"48282c0f-e092-43ca-b546-2a98829919ca","type":"message","user":"UAZ33BKV2","text":":wakaru:  実際歯石取り(といっても普段からメンテしてると表面を磨くくらい)だけでもだいぶちがう","ts":"1629015823.194500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hr="}]},{"client_msg_id":"d5794c44-e11f-4967-8320-8272091cc375","type":"message","user":"UGXMRNBUM","text":"なんだかんだ1ヶ月に1回〜2ヶ月に1回、歯医者にメンテしてもらうことでQOLが上がっている","ts":"1629015596.193300","team":"T03C4RC8V","reactions":[{"name":"subara","count":1,"users":["U013QL1RAPN"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"9H8dg"}]},{"client_msg_id":"2fae76ce-0494-44f7-8299-0a030288075f","type":"message","user":"UAZ33BKV2","text":"正直溜る人って歯磨きがんばるとはいえ、検査間隔が広いっていうのもある気がするのでしょうがないかなと","ts":"1629010825.192500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"nwKc"}]},{"client_msg_id":"e0e217c3-10aa-4fa0-9785-0fd081ed8974","type":"message","user":"UAZ33BKV2","text":"歯磨きで軽減はできても付かないわけじゃないので、まあ程度問題なんだけどね... \u0026gt; 歯石","ts":"1629010768.191600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"yjrNn"}]},{"client_msg_id":"2b8e4740-42b1-4a55-aab3-34f53cb49965","type":"message","user":"U76GA7MFA","text":"三年以上、歯医者で歯石除去してない。引っ越してから気に入る歯医者が見つからない。","ts":"1629010707.191100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"8SX"}]},{"client_msg_id":"D25771E6-867D-41FD-A023-B605A640874C","type":"message","user":"UP6PA1UBE","text":"はみがきむずかしい","ts":"1629010479.190200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"2p1"}]},{"client_msg_id":"C6A4AD67-747C-40CC-A3D2-6416BD72FC55","type":"message","user":"UP6PA1UBE","text":"どれだけ指導しても結構な割合の人が結局歯石溜まってるって歯医者さんが言ってた","ts":"1629010463.189900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"8VOri"}]},{"client_msg_id":"1d412d5d-1ce3-4a3a-b1df-83e684cb7370","type":"message","user":"UFHQ7TNT0","text":"うちの歯医者はシュミテクト押しですね","ts":"1629007673.187800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"EymW0"}]},{"client_msg_id":"D0B11CE7-114B-4C5B-965A-55081E3C9F8C","type":"message","user":"U81LLJ340","text":"\u003c#C01BXG2FGD8|life-healthcare\u003e ?","ts":"1629007626.187400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/wCJW"}]},{"client_msg_id":"6E390A90-9BBF-40C6-999D-4BA269AA5B3B","type":"message","user":"U81LLJ340","text":"あと歯磨きジェルは歯科衛生士さんにすすめられたやつを使ってます。\n\nバトラーデンタルリキッドジェル#1270P 80ml \u003chttps://www.amazon.co.jp/dp/B008OQO5V2|https://www.amazon.co.jp/dp/B008OQO5V2\u003e","ts":"1629007577.187100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"uiPLN"}]},{"client_msg_id":"2CFB67B5-1891-4290-B183-A3ADCB3DB844","type":"message","user":"U81LLJ340","text":"コンクールfはいいぞ","ts":"1629006969.185600","team":"T03C4RC8V","reactions":[{"name":"wakaru","count":1,"users":["U013QL1RAPN"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"QSB0G"}]},{"client_msg_id":"B3773017-658E-451A-B978-A14006615259","type":"message","user":"UFHQ7TNT0","text":"僕は3年前くらいに、自分の通っている歯医者のオススメで、フィリップスのソニックケアー買って電動歯ブラシデビューしましたね。\nあと、フロスとうがい薬（コンクール）もその時から使うようになった。","ts":"1629006476.185200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"3Ce"}]},{"client_msg_id":"7bbe9766-7565-4730-ae91-e73829aac26c","type":"message","user":"U78A6ESHM","text":"数ヶ月に一回歯科検診兼歯石とりに通ってる。","ts":"1629002766.182500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"UbIYE"}]},{"client_msg_id":"7ff68490-e835-43b5-ab9b-9d6c45bf4c21","type":"message","user":"U782D5DF1","text":"うん、歯石は個人のケアだと厳しいみたい","ts":"1629002634.182000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"xVy"}]},{"client_msg_id":"110FE870-1E21-48F7-9A44-AAD349D4FCFA","type":"message","user":"UKHUVMBJR","text":"歯を悪くするのは結局糖分特にジュースという情報を目にしてから、食事どき以外は水しか口にしない縛りしてる\nたぶん効いてる、といいな","ts":"1629002595.181600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"LL2m"}]},{"client_msg_id":"b6fd3234-ab62-41ca-b8b0-7eaebf58b20b","type":"message","user":"U013QL1RAPN","text":"可能なら、ソフトウェアじゃないほうのFlossを使うのがいいかと。","ts":"1629002451.180000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Zupg"}]},{"client_msg_id":"fad1de7e-d2ef-4676-b4e8-dc3cae49d6e4","type":"message","user":"UAZ33BKV2","text":"あれは機械的(高周波のアレ)に除去せんとどうにもならんらしいです。","ts":"1629002057.178700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4uX8"}]},{"client_msg_id":"393eccb5-a45a-48f8-9b4d-2ff82dc82dff","type":"message","user":"UFBGUPDP0","text":"なるほどー　歯石はとれないのか","ts":"1629002016.177800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"DPno"}]},{"client_msg_id":"6b007859-ab37-4896-ae18-e777017898ea","type":"message","user":"UAZ33BKV2","text":"歯磨きもやる気でない状態だとしたら\n1. 歯石取りとチェックのためにも、定期的に医師にかかる(できれば状態を伝えても変に扱わないところと出会えればなおよし)\n2. そこで歯石をちゃんと除去してもらっているなら、それこそ普通に磨いていればよくなるので、気分がのる歯磨きギアを選ぶ\nくらいでもいいかも\n歯石ある状態だと万全の効果でませんしね","ts":"1629001989.177500","edited":{"user":"UAZ33BKV2","ts":"1629002019.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zMgOU"}]},{"client_msg_id":"e271c71e-1230-48d0-90fa-cb95679ea4c1","type":"message","user":"U01HFNMNB55","text":"歯磨きで対応不能な状態になっている可能性もないとはいえないのでまずはやはり検診でしょう。","ts":"1629001966.176900","edited":{"user":"U01HFNMNB55","ts":"1629001985.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"uWYg"}]},{"client_msg_id":"7dca2959-3a4c-469e-9103-c817720df92f","type":"message","user":"U01HFNMNB55","text":"「ちょっとやばい」がどれくらいやばいのかによりますが","ts":"1629001941.175900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"KkJ+"}]},{"client_msg_id":"2788a01d-af20-4fb9-b815-e104633161cf","type":"message","user":"U782D5DF1","text":"ああうん、歯医者にかかって、できれば定期的にケアしてもらうこと前提で話してました","ts":"1629001576.174000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"IAFUW"}]},{"client_msg_id":"0fb087cf-9de9-4356-99f3-472c87b1cff3","type":"message","user":"UFBGUPDP0","text":"歯医者さんは…長いことご無沙汰ですね　確かに先に医者なのかなー","ts":"1629001537.173200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"2T7gY"}]},{"client_msg_id":"0e1aa63b-45dc-4f34-a98c-df47312a9b97","type":"message","user":"UFBGUPDP0","text":"確かにそうなんですが、ちょっとアレな話ですが、鬱がひどくて歯磨きすらやる気失ってて\n良いもの買ってそのインパクトや払ったコストのために歯磨きを強制しようという目論見がありまして\nつまり基本的な歯磨きが怪しいのでやる気を買おうくらいの気持ちでした　意外と買えば使う傾向にあるので","ts":"1629001454.172200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Ei+d"}]},{"client_msg_id":"88c0443f-a327-400b-87ff-54620af649e5","type":"message","user":"UL6CFN8NR","text":"なのでまず良い歯医者さんを見つけて（既にご存知かもしれませんが）そこで自分にあった器具を相談するのが良いと思います。医療器具に近いものは素人が適当に勧めるのも良くないので。","ts":"1629001362.170900","edited":{"user":"UL6CFN8NR","ts":"1629001373.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Bqe"}]},{"client_msg_id":"d728736a-ed74-41b8-a6e2-9237f5e92e60","type":"message","user":"UL6CFN8NR","text":"身もふたもないこと言いますが、歯に投資するなら、信頼できる歯医者での定期検診が一番大切です。","ts":"1629001249.167700","team":"T03C4RC8V","reactions":[{"name":"daiji","count":4,"users":["U81LLJ340","U01HFNMNB55","U782D5DF1","U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"WJwJ"}]},{"client_msg_id":"715e74e8-9975-4f64-bb51-edf1652ab419","type":"message","user":"UFBGUPDP0","text":"商品ページを見ると、ドルツはかなり歯科医の言うことを聞いてるなって印象","ts":"1629001230.167100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"gAcg"}]},{"client_msg_id":"22f16184-1842-4e93-b4df-f1725d1612a9","type":"message","user":"UFBGUPDP0","text":"ドルツ、日本歯科医師会推薦とか書いてるけどどうなんだろ","ts":"1629001128.165700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ZS6M"}]},{"client_msg_id":"3ee8f3c1-d52b-4b80-8337-d6c37e33febc","type":"message","user":"U01HFNMNB55","text":"小林製薬の糸ようじいいですよ。フロスが下手でも無関係に扱える","ts":"1629001121.165500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"HYGL"}]},{"client_msg_id":"3f95d56f-55b4-4d08-aa2d-07d4b1754490","type":"message","user":"U022PB40WAF","text":"ぶっちゃけ正しい磨き方をしてリステリン…じゃなくてコンクールFで洗口すればいいんじゃないかと。\n\u003chttps://www.amazon.co.jp/dp/B07QZ2M1LT\u003e","ts":"1629001084.164800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Rakl"}]},{"client_msg_id":"78675216-1c61-4f00-aac6-ad4b99dcf28a","type":"message","user":"UL6CFN8NR","text":"簡単に使える糸ようじを買っておくと良いと思います。","ts":"1629001067.164500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"XnCG"}]},{"client_msg_id":"7bf816cd-62f3-4f25-a46f-6c62bb0632af","type":"message","user":"U782D5DF1","text":"最近はフッ素入りの洗口液が手に入りやすくなっています","ts":"1629001039.163700","team":"T03C4RC8V","reactions":[{"name":"hee","count":1,"users":["U76GA7MFA"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"n/9t"}]},{"client_msg_id":"b6c35345-c0ba-4584-b067-7f9f6a33daf6","type":"message","user":"U76GA7MFA","text":"電動歯ブラシの話ではないですが、虫歯予防の観点だとフッ素を行き渡らせるためのブラッシングは必要なんだろうと思ってます。","ts":"1629001002.163100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"nwUm8"}]},{"client_msg_id":"5f07c9bc-2f36-4070-902f-8393fc75b684","type":"message","user":"U782D5DF1","text":"電動は微妙かも","ts":"1629000946.162400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4AU87"}]},{"client_msg_id":"754c9f39-a40c-4d94-989a-94b30c976a5a","type":"message","user":"U01HFNMNB55","text":"「手先が思うように動かせない人（高齢者など）でなければ普通の歯ブラシでいいです（断言）」とけっこう圧強めに言われた記憶が","ts":"1629000936.162100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Cko"}]},{"client_msg_id":"8dcb086c-bde9-4ba7-b715-e2deaf228318","type":"message","user":"U782D5DF1","text":"人の手の力でもむしろ力加減しなきゃならんくらいだから","ts":"1629000932.161900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"iNZY"}]},{"client_msg_id":"b302b3c2-d2f4-4754-9db6-f0a47695d384","type":"message","user":"U782D5DF1","text":"電動はあまりおすすめされないすね","ts":"1629000859.159200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"sXMr"}]},{"client_msg_id":"888ee179-f4fa-4c90-88a5-e66873bff33b","type":"message","user":"U01HFNMNB55","text":"僕の通ってるところでもあんまりおすすめされてなかったですね","ts":"1629000845.158600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5Jgi"}]},{"client_msg_id":"c2f47848-bb81-465f-9fb5-