cover_news047.jpg","blocks":null,"service_name":"ITmedia NEWS","service_icon":"https://www.itmedia.co.jp/favicon.ico","thumb_width":490,"thumb_height":341,"from_url":"https://www.itmedia.co.jp/news/articles/1810/11/news047.html","original_url":"https://www.itmedia.co.jp/news/articles/1810/11/news047.html"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5by"}]},{"client_msg_id":"f881dc9d-1e13-42fb-a8ea-cda18b3d57ab","type":"message","user":"UAZ33BKV2","text":"aptX は ノーマル/LL(低遅延)/HD/lossless (含むAdaptive) といろいろになったな...\n\u003chttps://av.watch.impress.co.jp/docs/news/1348134.html\u003e","ts":"1630817201.147300","attachments":[{"fallback":"AV Watch: Bluetoothで44.1kHz/16bitロスレス「aptX Lossless」","id":1,"title":"Bluetoothで44.1kHz/16bitロスレス「aptX Lossless」","title_link":"https://av.watch.impress.co.jp/docs/news/1348134.html","text":"米Qualcommは現地時間の9月1日、ニューヨークでイベントを開催し、Bluetoothでロスレスオーディオを提供する「aptX Lossless」を発表した。これはaptX Adaptiveの新機能で、BluetoothでCDクオリティの44.1kHz/16bitロスレスオーディオを提供する「Snapdragon Sound」の新たな機能として2021年に提供される予定。","image_url":"https://av.watch.impress.co.jp/img/avw/list/1348/134/qua-1.jpg","blocks":null,"ts":1630551547,"service_name":"AV Watch","service_icon":"https://av.watch.impress.co.jp/favicon.ico","from_url":"https://av.watch.impress.co.jp/docs/news/1348134.html","original_url":"https://av.watch.impress.co.jp/docs/news/1348134.html"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"yTw"}]},{"client_msg_id":"21e71ff0-33ad-42fc-ae0b-eddc54adad2d","type":"message","user":"U8996GYBF","text":"なるほど、そういえばAirPods Proだと気になってなかったからその辺の規格どれ使ってるかとかありそう","ts":"1630817086.146000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"RqRO5"}]},{"client_msg_id":"8da9c7c7-7c51-4781-bda3-f042f9f93733","type":"message","user":"UAZ33BKV2","text":"\u003chttps://ja.wikipedia.org/wiki/AptX\u003e\n\u003chttps: