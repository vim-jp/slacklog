 --format \"{{.Names}}\" | fzf` ${CMD}\n  else\n      docker exec -it  `docker ps --format \"{{.Names}}\" | fzf` bash\n  fi\n}\n\nfunction all-down-container(){\n  docker stop `docker ps -qa` \u0026amp;\u0026amp; docker rm `docker ps -qa`\n}\n\ncase $1 in\n  run  ) comp-docker-image ;;\n  exec ) exec-docker-container ;;\n  ald  ) all-down-container ;;\nesac\n\n```","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/hashue/config|hashue/config\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png"}],"team":"T03C4RC8V","reactions":[{"name":"eyes","count":1,"users":["U9S4G0LJW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"PsG5"}]},{"client_msg_id":"2cae0f2e-9349-47d6-8cb4-33db2f5336f3","type":"message","user":"U9S4G0LJW","text":"個人的には見たい","ts":"1625049963.446900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5Rbd"}]},{"client_msg_id":"158bce89-6a44-4b6c-8af9-0057bac74c40","type":"message","user":"U9S4G0LJW","text":"書けばいいと思う","ts":"1625049958.446700","team":"T03C4RC8V","reactions":[{"name":"desune","count":1,"users":["U01AQ5BFNLX"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"vlSMr"}]},{"client_msg_id":"b532ac8e-a8aa-4f3b-9fd4-975174d8f2fa","type":"message","user":"U01AQ5BFNLX","text":"話変わるんですけど、dockerコマンドをfzfで使いやすくした記事とかみなさん見たいと思います?","ts":"1625049935.446200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"wXZXl"}]},{"client_msg_id":"6b6078aa-97c0-425c-a9e6-c0378a367a2c","type":"message","user":"U9S4G0LJW","text":"GitHubのプロフィール何も設定してないな","ts":"1625049906.445100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"QJ46"}]},{"client_msg_id":"de4edfb6-2a06-42fe-a949-aae8fefc9b83","type":"message","user":"UL6CFN8NR","text":"たしかに。 GitHub アカウントに紐付いてたら、ぐらいでい