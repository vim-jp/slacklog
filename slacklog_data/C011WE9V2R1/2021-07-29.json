[{"client_msg_id":"89beacc4-5137-4f07-b100-8989182a77d0","type":"message","user":"UAZ33BKV2","text":"\u003chttps://www.atmarkit.co.jp/ait/articles/2107/29/news021.html\u003e\n記事として、わかりやすい、と思う","ts":"1627550048.487700","attachments":[{"fallback":"＠IT: Hyper-Vとサードパーティー製仮想マシン環境を共存させる","id":1,"title":"Hyper-Vとサードパーティー製仮想マシン環境を共存させる","title_link":"https://www.atmarkit.co.jp/ait/articles/2107/29/news021.html","text":"Hyper-Vだけでなく、場合によってはサードパーティー製の仮想マシン環境ソフトウェアを使わなければならないこともある。そのような場合、Hyper-Vを無効化せずに、サードパーティー製の仮想マシン環境ソフトウェアを使う方法について解説する。","thumb_url":"https://image.itmedia.co.jp/ait/articles/2107/29/cover_news021.jpg","blocks":null,"service_name":"＠IT","service_icon":"https://www.atmarkit.co.jp/favicon.ico","thumb_width":589,"thumb_height":331,"from_url":"https://www.atmarkit.co.jp/ait/articles/2107/29/news021.html","original_url":"https://www.atmarkit.co.jp/ait/articles/2107/29/news021.html"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/vw"}]},{"type":"message","user":"U01BVGM8K63","text":"\u003c@U01BVGM8K63\u003e has joined the channel","ts":"1627544850.487300","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null},{"client_msg_id":"d03cd57f-4c35-4f20-8178-ba92ebd862d8","type":"message","user":"UP6PA1UBE","text":"定期的にSNSとかでショートカットとかがバズって「◯年前に知りたかった」とか言われてますね。みんな気分でWindowsを使っている。","ts":"1627535118.486900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Gy0D"}]},{"client_msg_id":"02a43c7b-5657-4e91-bf15-4426e907bfdc","type":"message","user":"U06BRP8VD","text":"最近、そんな記事があったよね。","ts":"1627534997.485500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"tKF"}]},{"client_msg_id":"fe8dbc14-0635-4a64-9ae9-f528de6a65ec","type":"message","user":"U06BRP8VD","text":"公式ドキュメントを見るのが一番よ。\n\n\u003chttps://docs.microsoft.com/ja-jp/windows/\u003e","ts":"1627534982.485100","attachments":[{"fallback":"Windows に関するドキュメント","id":1,"title":"Windows に関するドキュメント","title_link":"https://docs.microsoft.com/ja-jp/windows/","text":"アプリケーション開発者、ハードウェア開発者、および IT 担当者向けの情報です。","thumb_url":"https://docs.microsoft.com/en-us/media/logos/logo-ms-social.png","blocks":null,"service_name":"docs.microsoft.com","service_icon":"https://docs.microsoft.com/favicon.ico","thumb_width":400,"thumb_height":400,"from_url":"https://docs.microsoft.com/ja-jp/windows/","original_url":"https://docs.microsoft.com/ja-jp/windows/"}],"team":"T03C4RC8V","reactions":[{"name":"naruhodo","count":2,"users":["U013QL1RAPN","U022J6JLQ3V"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"HU3"}]},{"client_msg_id":"269cfec6-2373-4a2c-8056-d92e1aa61673","type":"message","user":"UP6PA1UBE","text":"Windows なんとなくで使えるほどやさしいけど、知ってればもっと便利だったという機能が山ほど隠れてる","ts":"1627534806.484700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jJlh"}]},{"client_msg_id":"1ae4aa17-048c-40c3-afb6-146ccee000c0","type":"message","user":"UD69ADC3X","text":"めちゃめちゃ勉強になります…。この手の知識、winを使いだす前にまるっと頭に入れておきたいという希望はあるんですけど、どこで学習していいやらさっぱりなんですよね。","ts":"1627534514.483900","thread_ts":"1627524324.480400","subtype":"thread_broadcast","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"buW4"}],"root":{"client_msg_id":"e6c53852-7b1f-4054-8c1b-556ee0c1f311","type":"message","user":"U06BRP8VD","text":"ちなみにWinの最新のショートカット事情に即して言うと、タスクバーにアプリを固定して、Win+数字キー(左から順に)のショートカットキーで起動するのがオススメ。こちらはショートカットリンクとは別口の仕組みなので凄く安定している。","ts":"1627524324.480400","thread_ts":"1627524324.480400","reply_count":1,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"l+3xb"}]}},{"client_msg_id":"dcefcb2c-5e08-481a-aa38-18d11e683326","type":"message","user":"U011FTGJ3SN","text":"あーなるほど","ts":"1627525406.483700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Gtp5"}]},{"client_msg_id":"73c33891-e060-4d7e-b218-0b8ebee517c4","type":"message","user":"U06BRP8VD","text":"Windowsにおいてシェルっていうのはデスクトップだったりタスクバーだったりスタートメニューを表示するプログラムなんですが、それらは全部Explorer(=explorer.exe)なんですよ。\n\nで、シェルのExplorerがそこに置いてある各種アイコンを表示するにはその実体であるショートカットリンクファイルを全部読み込まないといけない。それを「舐めた」と表現しました。","ts":"1627525358.483500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"1FiSd"}]},{"client_msg_id":"ff4e834a-6d72-4b8b-91e5-4e4336bf8f1c","type":"message","user":"U011FTGJ3SN","text":"シェルのExplorerが舐めた\nというのはどういう意味なんでしょう","ts":"1627525213.481300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"adG"}]},{"client_msg_id":"e6c53852-7b1f-4054-8c1b-556ee0c1f311","type":"message","user":"U06BRP8VD","text":"ちなみにWinの最新のショートカット事情に即して言うと、タスクバーにアプリを固定して、Win+数字キー(左から順に)のショートカットキーで起動するのがオススメ。こちらはショートカットリンクとは別口の仕組みなので凄く安定している。","ts":"1627524324.480400","thread_ts":"1627524324.480400","reply_count":1,"team":"T03C4RC8V","reactions":[{"name":"tips","count":1,"users":["UEB0VGD7E"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"l+3xb"}]}]
