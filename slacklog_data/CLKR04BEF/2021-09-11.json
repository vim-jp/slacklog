 call `hook_post_source` properly at this stage.\n3. Restart vim again.\n4. `hoge` was not shown.","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/Shougo/dein.vim|Shougo/dein.vim\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png","ts":1631340414}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Nf="}]},{"client_msg_id":"c45dfccf-b041-4456-856c-5f2683c14ba0","type":"message","user":"U9S4G0LJW","text":"これでもauto_recache後に呼ばれてないっぽいのでissue作ります","ts":"1631339737.499800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"T9r=d"}]},{"client_msg_id":"50616f81-c306-4d1e-b3d0-6247c0812540","type":"message","user":"U9S4G0LJW","ts":"1631339719.499200","files":[{"id":"F02E13TSTMK","created":1631339718,"timestamp":1631339718,"name":"a.toml","title":"a.toml","mimetype":"text/plain","image_exif_rotation":0,"filetype":"python","pretty_type":"Python","user":"U9S4G0LJW","mode":"snippet","editable":true,"is_external":false,"external_type":"","size":75,"url":"","url_download":"","url_private":"https://files.slack.com/files-pri/T03C4RC8V-F02E13TSTMK/a.toml","url_private_download":"https://files.slack.com/files-pri/T03C4RC8V-F02E13TSTMK/download/a.toml","original_h":0,"original_w":0,"thumb_64":"","thumb_80":"","thumb_160":"","thumb_360":"","thumb_360_gif":"","thumb_360_w":0,"thumb_360_h":0,"thumb_480":"","thumb_480_w":0,"thumb_480_h":0,"thumb_720":"","thumb_720_w":0,"thumb_720_h":0,"thumb_960":"","thumb_960_w":0,"thumb_960_h":0,"thumb_1024":"","thumb_1024_w":0,"thumb_1024_h":0,"permalink":"https://vim-jp.slack.com/files/U9S4G0LJW/F02E13TSTMK/a.toml","permalink_public":"https://slack-files.com/T03C4RC8V-F02E13TSTMK-a689604806","edit_link":"https://vim-jp.slack.com/files/U9S4G0LJW/F02E13TSTMK/a.toml/edit","preview":"[[plugins]]\nrepo = 'Shougo/dein.vim'\nhook_post_source = '''\necho 'hoge'\n'''","preview_highlight":"\u003cd