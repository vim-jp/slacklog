text","block_id":"38az"}]},{"client_msg_id":"1b835676-6a7e-427d-9690-3511c31b8f20","type":"message","user":"U776661HA","text":"`Promise.all` する場合、コンカレントに走るので `let completePos` みたいなのは使えないです","ts":"1627714949.038300","thread_ts":"1627704937.014800","parent_user_id":"U776661HA","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"WYrQ"}]},{"client_msg_id":"dd0959b5-4f68-4274-b792-2517ae95d816","type":"message","user":"U776661HA","text":"コンカレントにしなくていいなら、この改修自体が無意味ですね","ts":"1627714962.038500","thread_ts":"1627704937.014800","parent_user_id":"U776661HA","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"xcL"}]},{"client_msg_id":"3cef61a3-b05b-479d-9ad5-e0d411fb977f","type":"message","user":"U776661HA","text":"1. 各ソースで `completePos` と `candidates` を算出\n2. 各ソースの `completePos` から代表値を算出（ここのロジック、何が良いのかは知らないですが既存の「最後を利用する」がベストなのか？は疑問）\n3. 各ソースの `candidates` をフラット結合して最終的な `candidates` の生成","ts":"1627715093.038700","thread_ts":"1627704937.014800","parent_user_id":"U776661HA","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"i+Yt"}]},{"client_msg_id":"1d93a40a-3580-4b8f-8ed1-8ccbcc3d6f0d","type":"message","user":"U776661HA","text":"やってることはこれだけなので、ややこしいというのがあまりわからないです。","ts":"1627715103.038900","thread_ts":"1627704937.014800","parent_user_id":"U776661HA","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"7u2"}]},{"client_msg_id":"063ffab2-b599-4526-8fd2-c506da958098","type":"message","user":"U776661HA","text":"\u0026gt; completePositionとcandidatesを同じ配列に詰めると\nちなみに `[A, B]` というのはタプルで `A[]` というのはリストです。なので `[number, DdcCandidate[]][]` は `[number, DdcCandidate[]]` というタプルのリストですね。","ts":"1627715206.039100","thread_ts":"1627704937.014800","parent_user_id":"U776661HA","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"puy4"}]},{"client_msg_id":"221e41fd-ffb1-4ddf-afc2-81f44ddb8b20","type":"message","user":"U776661HA","text":"`Array\u0026lt;[number, Array\u0026lt;DdcCandidate\u0026gt;]\u0026gt;` と書いても同じです","ts":"1627715233.039300","thread_ts":"1627704937.014800","parent_user_id":"U776661HA","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"L=d1"}]},{"client_msg_id":"02b710bf-a704-4eef-a79b-be278ada3fc7","type":"message","user":"U776661HA","text":"おっと、コミットキレイにするつもりだったけどマージされてしまったｗまぁ Shougo さんが気にしないのであればいいかｗ","ts":"1627715316.039500","thread_ts":"1627704937.014800","parent_user_id":"U776661HA","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"pDQG6"}]},{"client_msg_id":"58bba794-d1d7-4adb-9f94-d03674f2da97","type":"message","user":"U7JL1UKKL","text":"私はそこは気にしません","ts":"1627715705.039700","thread_ts":"1627704937.014800","parent_user_id":"U776661HA","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"YCrqW"}]},{"client_msg_id":"5d5dd4dc-d0dd-422c-9446-b90951e01b24","type":"message","user":"U7JL1UKKL","text":"私が気にしてるのは、結局候補をマージするときになかみをへんこうしないとだめなので","ts":"1627715936.039900","thread_ts":"1627704937.014800","parent_user_id":"U776661HA","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/kiD="}]},{"client_msg_id":"eafcd5ea-cb93-439b-b099-eddcc0918bec","type":"message","user":"U7JL1UKKL","text":"ここをがんばって一行にまとめてるのはあんまり意味がないなと、それならタプルよりオブジェクトのほうが分かりやすく拡張しやすいのではという話。","ts":"1627715997.040100","thread_ts":"1627704937.014800","parent_user_id":"U776661HA","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"cTw0"}]},{"client_msg_id":"1d225c35-373b-4b15-a10a-7ea93d2393f1","type":"message","user":"U776661HA","text":"？","ts":"1627716292.040300","thread_ts":"1627704937.014800","parent_user_id":"U776661HA","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"pmJ"}]},{"client_msg_id":"43eb4b74-b0d5-4cce-8148-56499f4c2c19","type":"message","user":"U776661HA","text":"\u0026gt; ここをがんばって一行にまとめてるのはあんまり意味がないなと、それならタプルよりオブジェクトのほうが分かりやすく拡張しやすいのではという話。\n```return { completePos, candidates };```\nという意味です？別にそれでも良いと思います。違いは殆ど無いです。","ts":"1627716335.040500","thread_ts":"1627704937.014800","parent_user_id":"U776661HA","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"RfZ1"}]},{"client_msg_id":"f5a70737-b8bb-4025-a994-ed4e63fd4b43","type":"message","user":"U776661HA","text":"\u003chttps://github.com/Shougo/ddc.vim/blob/main/denops/ddc/ddc.ts#L178\u003e\n\nのことかな？以下みたいに書いたほうがわかりやすいのであれば、それでも良いと思います。\n\n```const fs = rs.filter((v) =\u0026gt; v) as [number, DdcCandidate[]][];\nif (!fs.length) {\n  return [0, []];\n}\nconst completePos = fs[fs.length - 1][0];\nconst candidates = fs.flatMap(([_, cs]) =\u0026gt; cs);\nreturn [completePos, candidates];```","ts":"1627716581.040700","thread_ts":"1627704937.014800","edited":{"user":"U776661HA","ts":"1627716602.000000"},"parent_user_id":"U776661HA","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ybO"}]},{"client_msg_id":"9816ba46-883a-4a7c-8931-973ae1b1f34d","type":"message","user":"U776661HA","text":"たぶん以下でもOK。試してないのでもしかするとダメかもですが。\n\n```const fs = rs.filter((v) =\u0026gt; v as [number, DdcCandidate[]]);\nif (!fs.length) {\n  return [0, []];\n}\nconst completePos = fs[fs.length - 1][0];\nconst candidates = fs.flatMap(([_, cs]) =\u0026gt; cs);\nreturn [completePos, candidates];```","ts":"1627716658.041200","thread_ts":"1627704937.014800","parent_user_id":"U776661HA","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"MFU"}]},{"client_msg_id":"02ffdd6c-4ce8-4c11-8c76-97f316111d00","type":"message","user":"U776661HA","text":"タイプガード使うのも手か\n\n```const fs = rs.filter((v): v is Exclude\u0026lt;typeof v, undefined\u0026gt; =\u0026gt; !!v);\nif (!fs.length) {\n  return [0, []];\n}\nconst completePos = fs[fs.length - 1][0];\nconst candidates = fs.flatMap(([_, cs]) =\u0026gt; cs);\nreturn [completePos, candidates];```","ts":"1627716784.041400","thread_ts":"1627704937.014800","parent_user_id":"U776661HA","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"i7pi"}]},{"client_msg_id":"188b2633-a70f-4294-b9e8-e673e6142aac","type":"message","user":"U7JL1UKKL","text":"とりあえず、completePositionの件は直しました","ts":"1627716851.041600","thread_ts":"1627704937.014800","parent_user_id":"U776661HA","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=uK"}]},{"client_msg_id":"f133f06a-051d-490d-9be5-97af7eeeeaaf","type":"message","user":"U776661HA","text":"```const fs = rs.filter(\u0026lt;T\u0026gt;(v: T  | undefined): v is T =\u0026gt; !!v);\nif (!fs.length) {\n  return [0, []];\n}\nconst completePos = fs[fs.length - 1][0];\nconst candidates = fs.flatMap(([_, cs]) =\u0026gt; cs);\nreturn [completePos, candidates];```\nとかもありですね","ts":"1627716868.041800","thread_ts":"1627704937.014800","parent_user_id":"U776661HA","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Eo9"}]},{"client_msg_id":"f7409c0e-5a78-40bd-9cab-835191fb6ae3","type":"message","user":"U776661HA","text":"あ、ミスってる","ts":"1627716898.042000","thread_ts":"1627704937.014800","parent_user_id":"U776661HA","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"SsojP"}]},{"client_msg_id":"1fafa636-0db3-408e-9045-35540dc13c80","type":"message","user":"U776661HA","text":"\u003chttps://github.com/Shougo/ddc.vim/commit/790549c8788856ba8dd300132350d743424ce362#diff-1d3cd8b7424ad19e4fa7d2ef04c0e3cff4b9b85c75a767f27b00