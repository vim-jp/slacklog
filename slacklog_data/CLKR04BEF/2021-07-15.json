402.478800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"h=Zd"}]},{"client_msg_id":"605bd730-f25e-4aa4-b055-463f8038c07a","type":"message","user":"U78A6ESHM","text":"FF?","ts":"1626355398.478700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"tG6vd"}]},{"client_msg_id":"ad00ea4a-f516-4c80-b7c7-adff5f803ff2","type":"message","user":"U78A6ESHM","text":"同じ作者さんの \u003chttps://github.com/monkoose/fzf-hoogle.vim\u003e","ts":"1626355396.478300","attachments":[{"color":"24292f","fallback":"monkoose/fzf-hoogle.vim","id":1,"title":"monkoose/fzf-hoogle.vim","text":"(neo)vim plugin that uses fzf for previewing hoogle search results","fields":[{"title":"Stars","value":"28","short":true},{"title":"Language","value":"Vim script","short":true}],"blocks":null}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"lgtfH"}]},{"client_msg_id":"59430ad7-2840-4da3-b95b-561a831b1dc9","type":"message","user":"U9S4G0LJW","text":"VIM9000とか笑う","ts":"1626355392.478200","team":"T03C4RC8V","reactions":[{"name":"vim","count":2,"users":["U025UTETFDJ","U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"bWgA3"}]},{"client_msg_id":"8dade02b-506d-4438-ab8e-f84630598a33","type":"message","user":"U7HFY4HFY","text":"vim9-stargate使ってみてるなう　いい感じ\nアイコン見てSF好きなのかなーとは思ってたけど、Vimプラグインに世界観作られててわろた\n\u003chttps://github.com/monkoose/vim9-stargate/blob/main/INTRODUCTION.md\u003e","ts":"1626355330.477500","attachments":[{"color":"24292f","fallback":"\u003chttps://github.com/monkoose/vim9-stargate/blob/main/INTRODUCTION.md | INTRODUCTION.md\u003e","id":1,"title":"\u003chttps://github.com/monkoose/vim9-stargate/blob/main/INTRODUCTION.md | INTRODUCTION.md\u003e","text":"*The story*\n\nThe year is 3001. You are the only crew member of a fully automated science  \nspaceship. Your only companion is advanced AI system VIM9000. The mission is to  \nfind a powerful obelisk, that can be anywhere in all known galaxies, so for  \nfast traveling you are using technology called... STARGATES.\n\n*Explained terminology of the source code*\n\n*Ship* - current cursor position.\n\n*Galaxy* - window of vim, so all reachable galaxies are windows of the current  \ntabpage.\n\n*Orbit* - a line of the buffer/window, so reachable are currently visible buffer  \nlines.\n\n*Orbital arc* - visible columns of a line.\n\n*Degree* - a column of a line (I'm not an expert, so not sure if it is even  \ncorrect term for an orbit).\n\n*Black matter* - vim folds.\n\n*Display* - current vim window without sign columns.\n\n*Labels* - hints for windows and cursor jump positions.\n\n*Destinations* - all possible cursor jumps for the char or a pattern.\n\n*Workstation* - collection of utility functions.\n\n*Star* - character on a line.\n\n*Stargate* - a hint with the desired position, act of using a stargate is just  \ncursor jump to that hint.","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/monkoose/vim9-stargate|monkoose/vim9-stargate\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png"}],"team":"T03C4RC8V","reactions":[{"name":"fuita","count":5,"users":["U9S4G0LJW","U78A6ESHM","U01H161HVPS","UAZ33BKV2","U017BU3UZBQ"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0oC0"}]},{"client_msg_id":"7e4c9623-f8c3-4a4a-9e39-07ab04d098d1","type":"message","user":"U8R597E9H","text":"なので、既存のマッピングといい感じに共存して動く必要があって、そのためのヘルパを書いた感じです。","ts":"1626328805.475300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Qebh"}]},{"client_msg_id":"08ef6682-f23d-4243-95cc-fac42761e182","type":"message","user":"U8R597E9H","text":"この辺の処理ですね。（アイテムが選択されたとき、そのアイテムに設定された commitCharacters をマッピングとして遅延で適用する）\n\u003chttps://github.com/hrsh7th/nvim-cmp/pull/1/files#diff-cd2a497bbea2e7b2e1cf9baa1235a0940bcb747a2af73648b05fde36a2faf27aR154\u003e","ts":"1626328781.474800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"aFk1W"}]},{"client_msg_id":"83fa2f90-e277-407d-9626-2bd4d0673a93","type":"message","user":"U8R597E9H","text":"普通の補完プラグインにおいてはプラグインでやることではない。と思いますが、LSP の仕様に commitCharacters というのがあるので、どっちにしろ対応が必要になってしまった。。。という感じですね。","ts":"1626328645.474200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"EPZ/"}]},{"client_msg_id":"73fd0ffa-7d83-45f7-845a-7cb45a3864d1","type":"message","user":"U7JL1UKKL","text":"なるほど。それプラグイン側でやることではないよね","ts":"1626328605.473400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"75FVS"}]},{"client_msg_id":"346d49f7-c5c6-4877-8c3f-07ab833d2ba3","type":"message","user":"U8R597E9H","text":"でも、補完の確定も \u0026lt;CR\u0026gt; でやりたい。という感じのケースで、適切に \u0026lt;expr\u0026gt; マッピングなんかで設定すればいけるんですけど、やり方がわからない。とか","ts":"1626328589.472900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5jt"}]},{"client_msg_id":"6a2529d1-2cce-41e3-8621-f0173e946b92","type":"message","user":"U8R597E9H","text":"あまりなれてない人には難しい気がします。autopairs 系のプラグインがデフォルトで \u0026lt;CR\u0026gt; に対するマッピングを持つことが多くて","ts":"1626328560.472200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"YPOO"}]},{"client_msg_id":"339b00d6-3f31-4a75-be31-58a9795a92d8","type":"message","user":"U7JL1UKKL","text":"そんなに難しいんだっけ","ts":"1626328534.471700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"tTR36"}]},{"client_msg_id":"91c0a6ea-a77a-49ee-957b-f517aa0c9234","type":"message","user":"U8R597E9H","text":"nvim-compe もそうです。しかし、「autopairs とどうやって共存したらいいんだ？！」という issue が大量に飛んできたので面倒見てあげたほうが早いかな。。。と","ts":"1626328509.471400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"9f5Xn"}]},{"client_msg_id":"20ee5593-0ffe-4b02-bc36-f96323027583","type":"message","user":"U7JL1UKKL","text":"私は干渉が嫌なのでマッピングはうわがきしないようにしている","ts":"1626328471.470700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jEMOH"}]},{"client_msg_id":"45232775-8a73-464b-9fd3-d0261b7da81a","type":"message","user":"U8R597E9H","text":"エンターで確定させようとするとどうしてもという感じでした。。。","ts":"1626328445.470100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"vfw"}]},{"client_msg_id":"9bebacec-4e55-4b09-9ce7-d813f1404ae9","type":"message","user":"U7JL1UKKL","text":"干渉系の不具合はつらいなぁ","ts":"1626327689.469800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"nYos3"}]},{"client_msg_id":"3e369112-a628-4799-b861-a57a0b689cb2","type":"message","user":"U8R597E9H","text":"めちゃくちゃ issue が飛んできていた autopairs 系プラグインとの干渉問題についてはほぼ完全に対応したはず。。。と思っています。","ts":"1626327596.469500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"t7r"}]},{"client_msg_id":"420e0563-8a76-4aac-8f0a-440d1a94c98a","type":"message","user":"U8R597E9H","text":"マッピングとか、設定記述は Vim script からもできるようにしていたのですが、せっかく Lua 使ってるんだから関数で設定追加したりできたほうがいいかなあと思って撤廃することとしました。","ts":"1626327512.468900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"6ett+"}]},{"client_msg_id":"f9d5f0ab-de7a-4bfe-b33a-54b677a7171a","type":"message","user":"U7JL1UKKL","text":"そもそもVim script APIあったんだ","ts":"1626327127.467700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"PY9=A"}]},{"client_msg_id":"6ab82191-0741-426c-928b-b2eb054aca51","type":"message","user":"U7JL1UKKL","text":"ふむふむ","ts":"1626327102.467300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ki1"}]},{"client_msg_id":"11f8d474-7a25-406b-8ffe-5cdb9feb0ef5","type":"message","user":"U8R597E9H","text":"あとは LSP プロトコルに完全べったりにした都合、ソース作るのにヘルパがないとかなり厳しいということがわかりました。","ts":"1626326952.466500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"54T+"}]},{"client_msg_id":"1ad0c476-0216-456f-b452-4c887150d5dd","type":"message","user":"U8R597E9H","text":"ソースの API がまったく変わるのと、Vim script での設定を全撤廃する。くらいですかね。まあ、別プラグインへの移行にはなってしまうとは思います。","ts":"1626326863.466000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"qOPE"}]},{"client_msg_id":"36849d61-9743-49f6-9230-1cf152981107","type":"message","user":"U7JL1UKKL","text":"似た感じで使えるなら移行はできそうだけれど","ts":"1626326806.465200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fb/"}]},{"client_msg_id":"cabaa2fe-2781-44cc-9833-afafad187ad5","type":"message","user":"U7JL1UKKL","text":"そんなに変わるのかな","ts":"1626326781.464700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"kODJ"}]},{"client_msg_id":"2f8a1ab6-65be-499f-8394-c8f529ebe04f","type":"message","user":"U8R597E9H","text":"_目下の課題は、nvim-compe からどうやって移行するんだろうこれ。。。ってところです。_","ts":"1626326340.464400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"TXDZs"}]},{"client_msg_id":"4bb72513-43b4-4e17-9e66-6624db680e61","type":"message","user":"U8R597E9H","text":"source configuration はそこそこイメージ湧いてきましたが、まだまだ考えが必要かもしれません。。。","ts":"1626326091.463900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"mhDjD"}]},{"client_msg_id":"510a53c3-d217-4095-9160-6189d5349145","type":"message","user":"U8R597E9H","text":"2 についても手元で実験したら結構うまくいきました。悪くない動きだったが、後ろにテキストがあると使えないのでうーむ。。。という感じ。","ts":"1626326041.463300","edited":{"user":"U8R597E9H","ts":"1626326053.000000"},"team":"T03C4RC8V","reactions":[{"name":"totemoturai","count":2,"users":["U01TQP86UM6","U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"RwAv"}]},{"client_msg_id":"d47847d5-7179-462d-8397-62dbd43313f3","type":"message","user":"U8R597E9H","text":"アイデア自体はそこそこあります。\n1. LSP の TextEdit の削除範囲をハイライトで明示する\n2. Snippet 展開されるアイテムを選択したとき、その行の変化をプレビュー表示する（現状の neovim だと、カーソル後方にテキストがない場合だけ可能）","ts":"1626326012.462700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0UJk="}]},{"client_msg_id":"58f3b953-f923-4418-ad88-d7948c1aba33","type":"message","user":"U8R597E9H","text":"さっき ReplaceRangeHighlight 削除しました。（今後、VSCode に搭載される機能とちょっとぶつかるかもしれないなと思ったので）","ts":"1626325754.461200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zmz+R"}]},{"client_msg_id":"f5552ceb-c03e-42a9-98d6-33012bc381da","type":"message","user":"U01TQP86UM6","text":"textedit許可したlspでカーソル後ろ食われるの嫌いだから\nReplaceRangeHighlightが気になってる","ts":"1626324734.460600","edited":{"user":"U01TQP86UM6","ts":"1626324819.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4tx0a"}]},{"client_msg_id":"7b7f12c6-a9df-40b8-9d25-19e408a01e82","type":"message","user":"U01AQ5BFNLX","text":"ヒェェ","ts":"1626323176.459100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"BbgYI"}]},{"client_msg_id":"4ffb50cd-fc6f-43b5-bc5a-33b926d6c1a2","type":"message","user":"U7JL1UKKL","text":"大変そう","ts":"1626323139.458600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5Ic"}]},{"client_msg_id":"bdf80ba7-0495-4eb6-8d58-72df80292a5f","type":"message","user":"U7JL1UKKL","text":"\u003chttp