03chttps://user-images.githubusercontent.com/5981889/125408709-c19d5500-e3ed-11eb-92f7-6d73abee9fa8.png|image\u003e","image_url":"https://user-images.githubusercontent.com/5981889/125408709-c19d5500-e3ed-11eb-92f7-6d73abee9fa8.png","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/hrsh7th/nvim-compe|hrsh7th/nvim-compe\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png","ts":1626160801}],"team":"T03C4RC8V","reactions":[{"name":"wakaru","count":2,"users":["U8R597E9H","U01TQP86UM6"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"YqQ7r"}]},{"client_msg_id":"e2ae32fd-58e8-4d70-89e0-4cbee9fabbe0","type":"message","user":"U8996GYBF","text":"一時ファイルに書くしかないみたいになりそう","ts":"1626164355.435800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"b3FW"}]},{"client_msg_id":"4be40b33-aaa1-4597-828b-c1d504db0ef8","type":"message","user":"U03C71D7H","text":"なるほど。まあ代替手段があるならそれを使えば実現は可能なのか。CLI から RPC 叩く方法知らんけど","ts":"1626164320.435400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Ez="}]},{"client_msg_id":"a7456edf-44ad-4eee-9717-777ab21d35fb","type":"message","user":"U776661HA","text":"なので +clientserver は消されてたはず","ts":"1626164291.434800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"OXK"}]},{"client_msg_id":"e13dd407-d6b1-48bb-a9cb-49c35e2dec73","type":"message","user":"U776661HA","text":"Neovim はそもそも RPC 経ってますね","ts":"1626164282.434500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ar8j"}]},{"client_msg_id":"31b0b1dc-e573-449d-8311-fdc940b8f867","type":"message","user":"U03C71D7H","text":"そもそも `+clientserver` って Neovim にもまだあるんだろうか。その辺りは全然知らない","ts":"1626164244.434200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"t