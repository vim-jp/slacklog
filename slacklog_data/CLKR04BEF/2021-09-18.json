h_text","block_id":"vxi5a"}]},{"client_msg_id":"21705590-aca3-4165-a78b-0f3066df33af","type":"message","user":"U7JL1UKKL","text":"skkeletonの確定処理にも使えるかもしれない","ts":"1631942810.172200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"b+Ct9"}]},{"client_msg_id":"26db2fbc-089e-4fb8-bc09-648d99a9ff7d","type":"message","user":"U9S4G0LJW","text":"既に変えていたので磐石","ts":"1631942764.171700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Y/ToQ"}]},{"client_msg_id":"e15491b1-2872-4b86-86ea-64696243687a","type":"message","user":"U9S4G0LJW","text":"お","ts":"1631942751.171400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"GIgS"}]},{"client_msg_id":"816bccc7-89fa-4cea-895b-40f8c58b42cf","type":"message","user":"U7JL1UKKL","text":"オブジェクトしか使えないようにします","ts":"1631942711.171100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fzW"}]},{"client_msg_id":"afaaff7f-02da-4e24-a1d5-75114ca99f97","type":"message","user":"U7JL1UKKL","text":"user_dataの仕様を変更します","ts":"1631942696.170700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"WDL"}]},{"client_msg_id":"cc549d7a-d631-409e-9eda-30a138210ef0","type":"message","user":"US5UW1UNB","text":"普通に無理だった。","ts":"1631942100.170100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"k3I"}]},{"client_msg_id":"68ea4826-3529-426f-887e-8265132bfb95","type":"message","user":"US5UW1UNB","text":"new_suffix 使えば複数行 completion できそうだな。 (ありかな)","ts":"1631941147.169700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"JmFI"}]},{"client_msg_id":"86fbbfc8-914f-461d-9f46-60d1878a420c","type":"message","user":"US5UW1UNB","text":"ddc-tabnine のほうも JSON.stringify はずします","ts":"1631932864.169100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"DFRr"}]},{"client_msg_id":"71806c22-5d21-4035-a738-c072a5def5ea","type":"message","user":"US5UW1UNB","text":"任意の型てかいてあた","ts":"1631932828.168600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=WD"}]},{"client_msg_id":"f575c3d9-7471-4276-aa67-ed59ace7a5e4","type":"message","user":"US5UW1UNB","text":"あり、そもそも dictionary 入るのか","ts":"1631932762.168300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hbz"}]},{"client_msg_id":"ada16216-575e-4223-adb0-c1255fe40b4f","type":"message","user":"U7JL1UKKL","text":"user_dataに文字列を入れるのは古い仕様なので、dictionaryだけ見るようにした方が良さそうね","ts":"1631930732.167700","edited":{"user":"U7JL1UKKL","ts":"1631930747.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"nee"}]},{"client_msg_id":"446d3489-3827-4906-8bc1-4a6405e651ad","type":"message","user":"US5UW1UNB","text":"new_suffix、 ddc.vim 側が面倒見すぎな感じもするなあと思ってきた。`user_data` はjson入れないとエラーでるようになったのもある…\n`onDone(item)` を `class Source` に生やせるとか (そのsourceのものだけ取れる)。同期性の問題は少しあるが。\nあとは ddc 側が Candidate に oldSuffix, newSuffix をはやして、`{ oldSuffix, newSuffix, user_data }` にラップして生 user_data にするとか。\n上のみか両方が自然なきもする… たとえば coc.nvim 連携に関しても少し役立ちそうで、 coc.nvim 側に `complete done` を知らせるのを ddc のsource の `onDone()` でする、とか。 (今は coc 側を改造して、ddc-coc-patched が付加したマークを見つけてそれだけ使う、としてみてます)","ts":"1631927906.166600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"oP=t"}]},{"client_msg_id":"c104af07-8f9b-4deb-afd3-fb189461fc4b","type":"message","user":"US5UW1UNB","text":"Params を指定できるようにするとどうしても params() は abstract (required)になるな…。\n実際 `Params = {a: string}` とか指定したなら required かなと思いつつ、`Params` なしなら optional になってほしい気持ちもわかり…","ts":"1631974329.184500","thread_ts":"1631970963.184200","parent_user_id":"US5UW1UNB","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"m/1kU"}]},{"client_msg_id":"c4ad0fe7-aa6c-4396-b919-ae0a4a9f2acb","type":"message","user":"U7JL1UKKL","text":"お","ts":"1631976154.184700","thread_ts":"1631970963.184200","parent_user_id":"US5UW1UNB","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fgYF"}]}]
