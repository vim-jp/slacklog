true}],"blocks":null}],"reply_count":2,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"eOO"}]}},{"client_msg_id":"bf717f2a-edec-4d08-8ace-32ec896fb505","type":"message","user":"UAZ33BKV2","text":":naruhodo:","ts":"1633082960.481200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"TDU"}]},{"client_msg_id":"8e9bec3e-7e3e-407a-bd8d-40edcb91cc46","type":"message","user":"U03C71D7H","text":"リロードしたら直ってた","ts":"1633082949.481000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/s6/"}]},{"client_msg_id":"485729b4-042d-4e48-82a9-918c084672cb","type":"message","user":"U03C71D7H","text":"`w:` の変数名に `#` は使えなかったと思うんだけど、エラーにならないのか? いや、試したらエラーになるな","ts":"1633082917.480700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"sb9j"}]},{"client_msg_id":"dbb3bc08-70f8-45fe-b8ee-e8aee44e2492","type":"message","user":"UAZ33BKV2","text":"そのままだと未定義でエラーするから、get() でさらにチェックかな?","ts":"1633082843.479600","edited":{"user":"UAZ33BKV2","ts":"1633082851.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"f+E8P"}]},{"client_msg_id":"ed98aa0b-47ec-4692-94e8-e265496a4d94","type":"message","user":"UBQ2H65JQ","text":"If -1 != index(getmatches(), w:match_id)\n  call matchdelete(w:match_id)\nend if\nlet w:match_id = matchadd()\n今の感じだとこんな感じになるかな","ts":"1633082813.478900","edited":{"user":"UBQ2H65JQ","ts":"1633082838.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"26H6t"}]},{"client_msg_id":"18693f8b-7bb2-49fb-8010-56ccef48046f","type":"message","user":"U03C71D7H","text":"バッファ切り替える度に重複するハイライトが無限に追加されていってどんどん Vim が重くなります","ts":"1633082527.475400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"mhL8a"}]},{"client_msg_id":"acfd1e5f-5da9-4299-b2e4-1803970c6682","type":"message","user":"UL6CFN8NR","text":"（つい2日前作ったやつ）","ts":"1633082511.475100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"c/nwZ"}]},{"client_msg_id":"acf9689d-c061-4f44-bc89-27328897332a","type":"message","user":"UL6CFN8NR","text":"私は `w:` にしてます\n\u003chttps://github.com/monaqa/modesearch.vim/blob/b79a2a8546ffd47e1b79f96303e5b02b60cfbb16/autoload/modesearch/highlight.vim\u003e","ts":"1633082395.474500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"h8o"}]},{"client_msg_id":"02cf6d81-d870-4213-abdf-916a41501979","type":"message","user":"UAZ33BKV2","text":"あー、そうですね、そのウィンドウごとか","ts":"1633082176.474000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"q5VK"}]},{"client_msg_id":"a1751a60-fc28-48b5-b87f-cf346204ccef","type":"message","user":"U9S4G0LJW","text":"後複数回呼ぶのを前提にするならリストにしといた方がよさげ","ts":"1633082062.473400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"JQyMx"}]},{"client_msg_id":"83e4332c-be7f-47b8-9b92-a30669794f60","type":"message","user":"U9S4G0LJW","text":"w:がよさそう","ts":"1633082036.472500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"AsW"}]},{"client_msg_id":"43320b79-f12a-45ee-87e1-0564143b2371","type":"message","user":"UBQ2H65JQ","text":"g:ではなく、b:かw:にするべきかな。","ts":"1633082027.472000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"cR0P"}]},{"client_msg_id":"a0968229-5ec6-4357-8ec7-423331e1ce0c","type":"message","user":"U9S4G0LJW","text":"あれ、letの先ってcall置けたのか","ts":"1633082026.471900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Hk