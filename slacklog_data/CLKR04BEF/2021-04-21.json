ck_id":"jKw"}]},{"client_msg_id":"ac5024ba-ed11-4b62-bb4a-8a548a7d8190","type":"message","user":"U6XP9LZ6V","text":"head は動かしたらcore dump\n\u003chttps://github.com/k-takata/minpac/runs/2400785190?check_suite_focus=true\u003e","ts":"1619014405.379300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"HfxR"}]},{"client_msg_id":"7acd8ae1-0844-49b1-b8ac-9921f8d52c74","type":"message","user":"U6XP9LZ6V","text":"stable はビルド時になんかエラー\n\u003chttps://github.com/k-takata/minpac/runs/2400785352?check_suite_focus=true\u003e","ts":"1619014366.378500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zBa"}]},{"client_msg_id":"b70cc36e-50fa-4da7-a1b7-9fce58bc1130","type":"message","user":"U03C71D7H","text":"head じゃないな。stable","ts":"1619014342.378000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"eT5"}]},{"client_msg_id":"31e38172-8cdc-484d-9df8-49720934bf4a","type":"message","user":"U03C71D7H","text":"最近聞いた気がする。head です?","ts":"1619014285.377600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"deKe"}]},{"client_msg_id":"0f2d9bd3-c2b1-426b-afec-7d2b7e585d5f","type":"message","user":"U6XP9LZ6V","text":"そして Ubuntu + Neovim がちゃんと動かない。","ts":"1619014254.377000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"NRql"}]},{"client_msg_id":"37a815d2-9230-4c6d-addb-25d0636353fe","type":"message","user":"U03C71D7H","text":"appimage 版…","ts":"1619014237.376600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jfKG"}]},{"client_msg_id":"46bb22f5-37cd-4be4-af32-e0dcf4e9807f","type":"message","user":"U6XP9LZ6V","text":"Ubuntu + Vim は download せずに build するようにした。","ts":"1619014223.376100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"IJ7u"}]},{"client_msg_id":"6e13cf80-3044-4ff2-aa36-3ed42c115dbe","type":"message","user":"U6XP9LZ6V","text":"thinca/action-setup-vim で vim  をセットアップしたら、Ubuntu で feedkeys() がちゃんと動かなかったり、Vim から git コマンドを呼び出したらおかしなことになったりして悩んだが、結局 appimage 版の Vim が問題だった。feedkeys() の問題は追っていないが、git が動かないのは、appimage 版が LD_LIBRARY_PATH を書き換えているのが原因だった。","ts":"1619014156.375000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fxzH"}]},{"client_msg_id":"0b2502bb-9ed5-4dce-8c8b-e410b0b016fb","type":"message","user":"U6XP9LZ6V","text":"minpacのCIをtravisからGHAに移行しようとして格闘してた。","ts":"1619013695.370700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0ts"}]},{"client_msg_id":"af39b353-da3d-4a99-8641-1562c698a703","type":"message","user":"UAZ33BKV2","text":"あれでPayPayがそこそこ考えられてるらしいね","ts":"1618994435.369200","team":"T03C4RC8V","reactions":[{"name":"hee","count":1,"users":["UL6CFN8NR"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"o6="}]},{"client_msg_id":"6fb65a43-b8d5-46b3-9a86-503290bf2df4","type":"message","user":"U782D5DF1","text":"ガチでその辺意識してる所は\nグレースケールにした時に濃淡がわかるような色にしてるんだっけか","ts":"1618994405.368900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/s2P9"}]},{"client_msg_id":"79af955a-bedb-43e5-be9f-8e6f5158834b","type":"message","user":"UDPT2BZ6E","text":"色で内容を表すの、色弱の方にとっては辛そうというのはあります。","ts":"1618992926.367500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"FO9"}]},{"client_msg_id":"02538840-3fca-4eae-9c5c-9c4eeb7ee3a6","type":"message","user":"UDPT2BZ6E","text":"思いました笑\n高度に抽象化された図から情報が得られてる","ts":"1618992719.367300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"N9s"}]},{"client_msg_i