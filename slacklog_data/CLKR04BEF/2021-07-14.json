a3f0da4c9","type":"message","user":"U8996GYBF","text":"すごい","ts":"1626259819.452700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"05i"}]},{"client_msg_id":"b4a618bf-9951-4edc-be44-e7cdb41fe4a3","type":"message","user":"U8996GYBF","text":"めっちゃありがたい","ts":"1626259818.452500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"I1C6F"}]},{"client_msg_id":"11e8b9e0-4357-43ca-a869-bc1f163f71dc","type":"message","user":"U06ECBRTJ","text":"```const bat_theme = process.env.FZF_PREVIEW_PREVIEW_BAT_THEME || 'ansi';\n\nconst GREP_OUTPUT_REGEX = new RegExp(\n    '^(\\s\\s\\s.+\\s)?(\\d+\\s)?(?\u0026lt;dev_icon\u0026gt;.\\s\\s)?(?\u0026lt;file_name\u0026gt;[^:]+):(?\u0026lt;line_num\u0026gt;\\d+)(:(?\u0026lt;col\u0026gt;\\d+))?(:(?\u0026lt;match\u0026gt;.*))?'\n);\nconst CLEAN_LINE_REGEX = new RegExp('\\x1B(?:[@-Z\\\\-_]|\\[[0-?]*[ -/]*[@-~])');\n\n\nfunction is_installed(cmd) {\n    const which = require('which')\n    return which.sync(cmd.split(' ')[0], {nothrow: true})\n}\n\n\nmatch = process.argv[1].match(GREP_OUTPUT_REGEX)\nif (match === null) {\n    console.log(\n        \"Cannot process the entry :(\\n\" +\n        \"Please open an issue and describe what happened\\n\" +\n        \"including information such as file name and g:fzf_preview_grep_cmd\"\n    );\n    process.exit(1);\n}\n\nconst file_name = match.groups.file_name;\nconst line_num = parseInt(match.groups.line_num);\n\n// Set preview window offset. See: \u003chttps://github.com/junegunn/fzf/commit/0f9cb5590ec0a397143a7a4caf003a54885f4375\u003e\n// start = max(line_num - 10, 1)\n// last = line_num + 100\n\nconst cats = [\n    `bat --highlight-line=\"{line_num}\" --color=always --style=grid --theme=\"{bat_theme}\" --plain`,\n    'cat'\n];\ncat = cats.filter(is_installed)[0];\n\nseds = [\n    'gsed',\n    'sed'\n];\nsed = seds.filter(is_installed)[0];\n\nconst { execSync } = require('child_process');\nconst result = execSync(`{cat} {file_name}`);\n\nresult.toString().split(\"\\n\").forEach(function(line, index){\n    if (cat == 'cat' and line_num - 1 == index) {\n        line = line.replace(CLEAN_LINE_REGEX, '')\n        console.log(`\\ux1b[1m\\ux1b[4m\\ux1b[31m{line}\\ux1b[0m`)\n    } else {\n        console.log(line)\n    }\n});```","ts":"1626259712.452300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"dxZA"}]},{"client_msg_id":"f50535f1-996f-4fcf-9ee6-a744d20c7635","type":"message","user":"U06ECBRTJ","text":"コードできたけど、検証めんどいな…","ts":"1626259686.452100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"87iEf"}]},{"client_msg_id":"d19df2d6-b7c0-43c6-9baf-fb3e6f76a6c1","type":"message","user":"U06ECBRTJ","text":"引数順がわかりにくかった…","ts":"1626259266.451700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Q5SMZ"}]},{"client_msg_id":"fcf2782d-a517-4a82-ad2b-32c0e47a3768","type":"message","user":"U06ECBRTJ","text":"あ、わかった","ts":"1626259215.451400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"oEnb"}]},{"client_msg_id":"1517885f-904a-42fe-8e81-f9f92a23cfdd","type":"message","user":"U06ECBRTJ","text":"\u003chttps://github.com/yuki-yano/fzf-preview.vim/blob/cffcaecec6771b6fd531878b0037c235f94ca800/bin/preview_fzf_grep#L54\u003e\nここがよくわからない…","ts":"1626259132.451100","attachments":[{"color":"24292f","fallback":"\u003chttps://github.com/yuki-yano/fzf-preview.vim/blob/cffcaecec6771b6fd531878b0037c235f94ca800/bin/preview_fzf_grep | preview_fzf_grep\u003e","id":1,"title":"\u003chttps://github.com/yuki-yano/fzf-preview.vim/blob/cffcaecec6771b6fd531878b0037c235f94ca800/bin/preview_fzf_grep | preview_fzf_grep\u003e","text":"```\n        line = CLEAN_LINE_REGEX.sub('', line)\n```","mrkdwn_in":["text"],"blocks":null,"footer":"\u003ch