_id":"Di2U"}]},{"client_msg_id":"eb70f392-befe-4647-8c8f-bf613a50bfe8","type":"message","user":"U06ECBRTJ","text":"node で which コマンド実装してるライブラリ無いかな…","ts":"1626234033.446700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"dt22g"}]},{"client_msg_id":"8a7afee4-68d5-4f30-94df-b7beb83a64aa","type":"message","user":"U8996GYBF","text":"これ拾いもので許可取ったやつなので・・・","ts":"1626233968.445900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"uw2j"}]},{"client_msg_id":"fcd50779-997d-4374-9360-e87263f644d6","type":"message","user":"U06ECBRTJ","text":"\u003chttps://github.com/yuki-yano/fzf-preview.vim/blob/cffcaecec6771b6fd531878b0037c235f94ca800/bin/git_blame_pr\u003e\nこっちは perl …","ts":"1626233564.445500","attachments":[{"color":"24292f","fallback":"\u003chttps://github.com/yuki-yano/fzf-preview.vim/blob/cffcaecec6771b6fd531878b0037c235f94ca800/bin/git_blame_pr | git_blame_pr\u003e","id":1,"title":"\u003chttps://github.com/yuki-yano/fzf-preview.vim/blob/cffcaecec6771b6fd531878b0037c235f94ca800/bin/git_blame_pr | git_blame_pr\u003e","text":"```\n#! /usr/bin/perl\n#\n# Written in 2017 by Kazuho Oku\n#\n# To the extent possible under law, the author(s) have dedicated all copyright and related and neighboring rights to this software to the public domain worldwide. This software is distributed without any warranty.\n# You should have received a copy of the CC0 Public Domain Dedication along with this software. If not, see \u003chttp://creativecommons.org/publicdomain/zero/1.0/\u003e.\n\nuse strict;\nuse warnings;\n\nmy $git_blame_pid = open(my $fh, \"-|\", \"git\", \"blame\", \"--first-parent\", @ARGV)\n    or die \"failed to invoke git-blame:$!\";\n\nmy %cached; # commit-id -\u0026gt; substitution string\n\nwhile (my $line = \u0026lt;$fh\u0026gt;) {\n    my ($commit, $src) = split / .*?\\) /, $line, 2;\n    $cached{$commit} = lookup($commit)\n        unless $cached{$commit};\n    print $cached{$commit}, ' ', $src;\n}\n\nwhile (waitpid($git_blame_pid, 0) != $git_blame_pid) {}\nexit $?;\n\nsub lookup {\n    my $commit = shift;\n    my $message = `git show --oneline $commit`;\n    if ($message =~ /Merge\\s+(?:pull\\s+request|pr)\\s+\\#?(\\d+)\\s/i) {\n        return sprintf '%-9s', \"PR #$1\";\n    }\n    return $commit;\n}\n\n```","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/yuki-yano/fzf-preview.vim|yuki-yano/fzf-preview.vim\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jN/y"}]},{"client_msg_id":"6a450b58-79ef-4fe7-bff3-142741612767","type":"message","user":"UD1FQV38V","text":"L11-14が難解過ぎるｗｗ","ts":"1626233358.445300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"OLT"}]},{"client_msg_id":"ee8fad75-cec4-4e77-b79c-6448039f9eb8","type":"message","user":"U78A6ESHM","text":"gyp san のせいで Python 入ってそうですしね…。","ts":"1626232872.444900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"K05x"}]},{"client_msg_id":"b7b52c71-9f2d-465e-bdca-e67a564bbf5c","type":"message","user":"U8996GYBF","text":"Node入れるような人はPython入れるのにあんまり抵抗なさそうだし、困ってるって意見も聞かないからなんか問題出たら対応するか・・・","ts":"1626232731.444400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"TibT"}]},{"client_msg_id":"ec4813d8-26bf-4716-8e4f-b88bb65b2f63","type":"message","user":"U8996GYBF","text":"ロジック自体は簡単なんだけど制御文字がガンガン入ってるからそこの移植が問題ないかの確認が結構面倒そう","ts":"1626232518.443700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"m/YV7"}]},{"client_msg_id":"9878a4aa-e15f-4483-b172-23a8786276a3","type":"message","user":"U8996GYBF","text":"誰かこれ書き直して・・・\n\u003chttps://github.com/yuki-yano/fzf-preview.vim/blob/cffcaecec6771b6fd531878b0037c235f94ca800/bin/preview_fzf_grep\u003e","ts":"1626232331.443000","attachments":[{"color":"24292f","fallback":"\u003chttps://github.com/yuki-yano/fzf-preview.vim/blob/cffcaecec6771b6fd531878b0037c235f94ca800/bin/preview_fzf_grep | preview_fzf_grep\u003e","id":1,"title":"\u003chttps://github.com/yuki-yano/fzf-preview.vim/blob/cffcaecec6771b6fd531878b0037c235f94ca800/bin/preview_fzf_grep | preview_fzf_grep\u003e","text":"```\n#!/usr/bin/env python3\n\nimport sys\nimport subprocess\nimport shutil\nimport re\nimport os\n\nbat_theme = (os.environ.get('FZF_PREVIEW_PREVIEW_BAT_THEME', 'ansi'))\n\nGREP_OUTPUT_REGEX = re.compile(\n    r'^(\\s\\s\\s.+\\s)?(\\d+\\s)?(?P\u0026lt;dev_icon\u0026gt;.\\s\\s)?(?P\u0026lt;file_name\u0026gt;[^:]+):(?P\u0026lt;line_num\u0026gt;\\d+)(:(?P\u0026lt;col\u0026gt;\\d+))?(:(?P\u0026lt;match\u0026gt;.*))?'\n)\nCLEAN_LINE_REGEX = re.compile(r'\\x1B(?:[@-Z\\\\-_]|\\[[0-?]*[ -/]*[@-~])')\n\n\ndef is_installed(cmd):\n    return shutil.which(cmd.split(' ')[0])\n\n\nmatch = GREP_OUTPUT_REGEX.match(sys.argv[1])\nif not match:\n    print(\n        \"Cannot process the entry :(\\n\"\n        \"Please open an issue and describe what happened\\n\"\n        \"including information such as file name and g:fzf_preview_grep_cmd\"\n    )\n    sys.exit(1)\n\nfile_name = match.group('file_name')\nline_num = int(match.group('line_num'))\n\n# Set preview window offset. See: \u003chttps://github.com/junegunn/fzf/commit/0f9cb5590ec0a397143a7a4caf003a54885f4375\u003e\n# start = max(line_num - 10, 1)\n# last = line_num + 100\n\ncats = [\n    f'bat --highlight-line=\"{line_num}\" --color=always --style=grid --theme=\"{bat_theme}\" --plain',\n    'cat'\n]\ncat = list(filter(is_installed, cats))[0]\n\nseds = [\n    'gsed',\n    'sed'\n]\nsed = list(filter(is_installed, seds))[0]\n\nresult = subprocess.check_output(\n    f'{cat} {file_name}', shell=True)\n\nfor index, line in enumerate(result.decode().split(\"\\n\")):\n    if cat == 'cat' and int(line_num) - 1 == index:\n        line = CLEAN_LINE_REGEX.sub('', line)\n        print(f\"\\033[1m\\033[4m\\033[31m{line}\\033[0m\")\n    else:\n        print(line)\n\n```","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/yuki-yano/fzf-preview.vim|yuki-yano/fzf-preview.vim\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ei/KS"}]},{"client_msg_id":"27e8fa04-6c87-48f1-a7f5-d4a8b36e7d26","type":"message","user":"U8996GYBF","text":"絶対Nodeでpreviewスクリプト書き直した方がいい","ts":"1626232283.442600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"bSt"}]},{"client_msg_id":"e3bb518f-d9e9-468b-84a6-fa0df1cf268b","type":"message","user":"U8996GYBF","text":"fzf-preview、node入ってる前提なのになんでPython依存のスクリプトでpreviewさせてしまっているのかという気持ちになってきた","ts":"1626232273.442300","team":"T03C4RC8V","reactions":[{"name":"kzk","count":2,"users":["U9S4G0LJW","U7JL1UKKL"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"mM3"}]},{"client_msg_id":"a8ce0548-034b-4f6b-a4c3-0cc2119437a7","type":"message","user":"U7JL1UKKL","text":"候補のソートルーチンを実装したいところです","ts":"1626231720.441800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"A6zu9"}]},{"client_msg_id":"3ef5b654-50a6-42ba-a6e8-cca0469cace9","type":"message","user":"U01AQ5BFNLX","text":"使ってみましたけど結構便利でした","ts":"1626231654.441200","team":"T03C4RC8V","reactions":[{"name":"goodpoem","count":1,"users":["U7JL1UKKL"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4+8"}]},{"client_msg_id":"c88b2b61-a7df-45fa-9583-92d66ea4f4e8","type":"message","user":"U8996GYBF","text":"cocに入らないかな","ts":"1626229372.440800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text