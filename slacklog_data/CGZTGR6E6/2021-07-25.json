frob\":\"417eca9f6ed82dfcc911493f9ec778e10f23ff79\"}} ';\nconst obj = JSON.parse(json);\n\nconsole.log(obj.rsp.stat);```\nしたら出るみたいだし、だめってことはない気がするけど....というか str を さらに JSON.stringify してるのなんで?","ts":"1627176410.252500","attachments":[{"fallback":"JSON.parse() - JavaScript | MDN","id":1,"title":"JSON.parse() - JavaScript | MDN","title_link":"https://developer.mozilla.org/ja/docs/Web/JavaScript/Reference/Global_Objects/JSON/parse","text":"JSON.parse() メソッドは文字列を JSON として解析し、文字列によって記述されている JavaScript の値やオブジェクトを構築します。任意の reviver 関数で、生成されたオブジェクトが返される前に変換を実行することができます。","image_url":"https://developer.mozilla.org/mdn-social-share.0ca9dbda.png","blocks":null,"service_name":"developer.mozilla.org","service_icon":"https://developer.mozilla.org/apple-touch-icon.0ea0fa02.png","from_url":"https://developer.mozilla.org/ja/docs/Web/JavaScript/Reference/Global_Objects/JSON/parse","original_url":"https://developer.mozilla.org/ja/docs/Web/JavaScript/Reference/Global_Objects/JSON/parse"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"UCR"}]},{"client_msg_id":"68afee75-aa4b-4e08-862f-2c4cc6edccd9","type":"message","user":"U72TB62UF","text":"```    const str = await res?.read().then(({ done, value }) =\u0026gt; {\n      const d = new TextDecoder();\n      return d.decode(value).toString();\n    });\n    const j = JSON.parse(JSON.stringify(str));\n    console.log(j.rsp.stat);```\n上記処理で、返却値  `{\"rsp\":{\"stat\":\"ok\",\"frob\":\"417eca9f6ed82dfcc911493f9ec778e10f23ff79\"}}` のような 文字列で返ってきたとき、\njsonに変換して値にアクセスしようとしたのですが、undefinedになります。\n値にアクセスするには、配列に変換するなどの処理が必要なのでしょうか。","ts":"1627176130.251700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"I2lD2"}]}]
