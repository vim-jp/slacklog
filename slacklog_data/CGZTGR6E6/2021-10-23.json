ps://pkg.go.dev/golang.org/x/sync/singleflight"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hIe"}]},{"client_msg_id":"604b61fe-ac04-41ba-b814-216f2bc4ce8c","type":"message","user":"U9S4G0LJW","text":"セマフォとか雑に挟んだらなんとかならないのかな","ts":"1634992982.054400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"wEd1"}]},{"client_msg_id":"04cb1475-f74e-43b2-a87e-4791d8bb309f","type":"message","user":"U8996GYBF","text":"これってuseVersionを使うコンポーネントが複数マウントされたら複数fetchしちゃうと思うんですけど、そういうのの検知をどうやったらいいかは分かっていない","ts":"1634992932.053500","edited":{"user":"U8996GYBF","ts":"1634992989.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ZdF9"}]},{"client_msg_id":"596febd3-834d-4bee-90cc-02ba47e5d540","type":"message","user":"UNJ2DANJC","text":"1コンポーネントに1カスタムフック（その中でさらに色々なカスタムフックを使うことはある）みたいなデザインパターンあると思う","ts":"1634992868.052800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"OyA"}]},{"client_msg_id":"e7f3804e-18dc-4ab2-9093-1d4f6c5dce3d","type":"message","user":"U8996GYBF","text":"とりあえずuseVersion作っちゃえば使う側は `const { version } = useVersion()` 以外の知識を持たなくていいから楽と思います\nコンポーネントがレンダリングされたときにfetchが走るとかを含めコードレベルで意識すると辛いと思うので","ts":"1634992866.052700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/Nc"}]},{"client_msg_id":"1a557630-de5c-429e-a5dd-1be3c24060c5","type":"message","user":"U78A6ESHM","text":"custom hooks の中では使っちゃってます…。","ts":"1634992735.048200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Ijbd"}]},{"client_msg_id":"438cf5f2-1f08-475e-850e-b01615e96d52","type":"message","user":"U8996GYBF","text":"結構custom hooksの中ではuseState使っちゃうからよくないことしてるかも","ts":"1634992715.047500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0vX3"}]},{"client_msg_id":"cd013f9c-d54c-4cbe-85aa-3f2855ea7fc3","type":"message","user":"U78A6ESHM","text":"自分もだいたいそうしてます。トグルしたいとかはコンポーネントの中で state 持つことはありますが。","ts":"1634992683.046500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zpaiv"}]},{"client_msg_id":"297b6aa3-8de9-4861-94d2-9ef21b59d293","type":"message","user":"U9S4G0LJW","text":"React、コンポーネントの中にStateを一切置かずにFluxパターンに従うのが一番楽なのではと思ってる","ts":"1634992616.045400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"WI+"}]},{"client_msg_id":"7fb5ad41-1bcb-46d4-9788-5d8012576563","type":"message","user":"UNJ2DANJC","text":"useRefでも良いかな","ts":"1634992613.045300","thread_ts":"1634992613.045300","reply_count":1,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Kekl"}]},{"client_msg_id":"556a4170-b509-4310-979b-89e56a4e78fd","type":"message","user":"U8996GYBF","text":"VersionコンポーネントはuseVersionするだけにした方がいい","ts":"1634992594.044500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Qtlw3"}]},{"client_msg_id":"ef67c4a2-0853-496a-bd6e-4c4be45a5fbc","type":"message","user":"U8996GYBF","text":"contextに適当にオブジェクトを突っ込めば解決するわけではないかな","ts":"1634992559.043800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hHfd"}]},{"client_msg_id":"8be86ff6-a382-4438-9075-b0cd1fc44805","type":"message","user":"U06ECBRTJ","text":"あー api を State に持つのはありですね","ts":"1634992556.043600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"3JJ"}]},{"client_msg_id":"af743653-b98d-4c27-89ee-4f64d480eee9","type":"message","user":"U8996GYBF","text":"分からんけどこんな感じな気がする\n```const useVersion = (): { version: string } =\u0026gt; {\n  const [version, setVersion] = useState(\"\");\n  const { config } = useContext(ConfigurationParametersContext);\n\n  const [api, setApi] = useState(\n    new VoicevoxApi(new Configuration(context.config)),\n  );\n\n  useEffect(() =\u0026gt; {\n    setApi(new VoicevoxApi(new Configuration(context.config)));\n  }, [config]);\n\n  useEffect(() =\u0026gt; {\n    VoicevoxService.getVersion(api).then((v) =\u0026gt; {\n      setVersion(v);\n    });\n  }, [api]);\n\n  return { version };\n};```","ts":"1634992508.042800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"aHea"}]},{"client_msg_id":"63986059-a837-4f81-87ca-c5973159a119","type":"message","user":"U06ECBRTJ","text":"context に Api のインスタンスを突っ込むようにしたほうがいいですかね","ts":"1634992270.042500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5Oppd"}]},{"client_msg_id":"5a561362-b0a0-4552-96b5-a5b58f3c866d","type":"message","user":"U8996GYBF","text":"hooksの依存関係が既に大分複雑だから分割しないときつい気がする","ts":"1634992086.041900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"G2LFR"}]},{"client_msg_id":"E414C179-7C17-4E38-9C39-25E615C97B22","type":"message","user":"UFHQ7TNT0","text":"脳死で使うと死ぬ時もあるんですが、ないよりはミスが減るかと","ts":"1634991987.040200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Lw8Lp"}]},{"client_msg_id":"bfec93c0-4279-4b5d-8af3-8c2992dfb2ab","type":"message","user":"U9S4G0LJW","text":"エントリポイントをuseEffectのdepsに指定しておいたらよさそう","ts":"1634991983.040100","edited":{"user":"U9S4G0LJW","ts":"1634992019.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"FWC5G"}]},{"client_msg_id":"077749b0-9611-46b8-99ac-8f7ad8aafb5d","type":"message","user":"U06ECBRTJ","text":"そういえば、全くlint とかやってない…","ts":"1634991983.040000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"9rW"}]},{"client_msg_id":"f7aa181d-522d-43be-a2b5-0ccac6acff40","type":"message","user":"U8996GYBF","text":"あとこのコードだと再レンダリングの度にclassからインスタンス生成してるからパフォーマンス的にもよくないと思います","ts":"1634991971.039100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"awv7"}]},{"client_msg_id":"9B621542-5B22-4C3F-91B0-C557E6B9D249","type":"message","user":"UFHQ7TNT0","text":"\u003chttps://www.npmjs.com/package/eslint-plugin-react-hooks|https://www.npmjs.com/package/eslint-plugin-react-hooks\u003e\nとりあえずこれ入れるといいです","ts":"1634991961.038100","attachments":[{"fallback":"npm: eslint-plugin-react-hooks","id":1,"title":"eslint-plugin-react-hooks","title_link":"https://www.npmjs.com/package/eslint-plugin-react-hooks","text":"ESLint rules for React Hooks","thumb_url":"https://static.npmjs.com/338e4905a2684ca96e08c7780fc68412.png","blocks":null,"service_name":"npm","service_icon":"https://static.npmjs.com/58a19602036db1daee0d7863c94673a4.png","thumb_width":1200,"thumb_height":630,"from_url":"https://www.npmjs.com/package/eslint-plugin-react-hooks","original_url":"https://www.npmjs.com/package/eslint-plugin-react-hooks"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"FN3"}]},{"client_msg_id":"988f35b0-9afb-4882-98f9-72ad24cb6476","type":"message","user":"U06ECBRTJ","text":"おー 確かに第2引数はずしたら通りました…","ts":"1634991921.037300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5tINy"}]},{"client_msg_id":"cca2521b-d89e-41ef-bbdf-a8f4f85eabdd","type":"message","user":"U8996GYBF","text":"これだとstateが書き換わってもfetchが走らない","ts":"1634991917.037100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+bG"}]},{"client_msg_id":"D625407B-43DC-4A02-9ED3-7A1360A347ED","type":"message","user":"UFHQ7TNT0","text":"だよね","ts":"1634991894.036400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"6bX"}]},{"client_msg_id":"e1e41616-da4a-4b3d-bcd5-b208751810a2","type":"message","user":"U8996GYBF","text":"多分そう","ts":"1634991890.036200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"uoUWY"}]},{"client_msg_id":"5B3D6A72-0BB7-4DE3-9311-32E9E202C28C","type":"message","user":"UFHQ7TNT0","text":"useEffectの第二引数？","ts":"1634991880.035900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"lcwGW"}]},{"client_msg_id":"851131fd-84ca-4c20-8d0c-106ce9b11adc","type":"message","user":"U8996GYBF","text":"useEffectのdepsが空だからマウントされた1回目しか `VoicevoxService.getVersion()` が実行されないです","ts":"1634991873.035700","edited":{"user":"U8996GYBF","ts":"1634991882.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"biF"}]},{"client_msg_id":"5304c4f9-e470-4836-b9ff-5b4f75d73cfc","type":"message","user":"U8996GYBF","text":"コード的に再描画はされてるのであってるはず","ts":"1634991810.034500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"vnx0"}]},{"client_msg_id":"80a815a5-4bee-438d-b538-f253247467e0","type":"message","user":"U8996GYBF","text":"依存関係が読みにくくてあってるか分からないですけど、 `setVersion` が発火しないからじゃないですかね","ts":"1634991788.034200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"xQQla"}]},{"client_msg_id":"169ec1a0-4a51-49c6-a2b9-202f5cd3cf9d","type":"message","user":"U06ECBRTJ","text":"ログ入れてみたら、再描画はされてるんですが、version 変数は更新されてないようです","ts":"1634991771.033800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"1NkG"}]},{"client_msg_id":"1c074b2f-8800-498d-88cf-1a099301c49c","type":"message","user":"U06ECBRTJ","text":"されないようなんですよね…","ts":"1634991523.032900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"cUP"}]},{"client_msg_id":"0dc51dd1-2c2d-4a5c-a366-19a0268bc25d","type":"message","user":"U06ECBRTJ","text":"SettingScreen で `onPreess` したら、下の `Version` を再レンダリングしてもらいたいんですが","ts":"1634991515.032600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"DdA"}]},{"client_msg_id":"f6fcc033-bafa-4483-abdb-3feb7e2f6e9d","type":"message","user":"U06ECBRTJ","text":"```function Version() { // {{{\n  const [version, setVersion] = useState('');\n  const fontSize = 18;\n  const paddingVertical = 6;\n  const context = useContext(ConfigurationParametersContext)\n  const voicevoxApi = new VoicevoxApi(new Configuration(context.config));\n\n  useEffect(() =\u0026gt; {\n    VoicevoxService.getVersion(voicevoxApi).then(value =\u0026gt; {\n      setVersion(value);\n    })\n  }, []);\n\n  return (\n    \u0026lt;Text style={{ fontSize, paddingVertical, fontFamily: 'NotoSansJP_400Regular' }}\u0026gt;\n      Voivevox version:{version}\n    \u0026lt;/Text\u0026gt;\n  );\n} // }}}\n\nexport function SettingScreen() {\n  const [text, onChangeText] = useState('');\n  const context = useContext(ConfigurationParametersContext)\n  return (\n    \u0026lt;View style={styles.container}\u0026gt;\n      \u0026lt;TextInput\n        style={styles.input}\n        onChangeText={onChangeText}\n        value={text}\n        placeholder='\u003chttp://192.168.1.XXX:50021\u003e'\n      /\u0026gt;\n      \u0026lt;Button title='保存' onPress={async () =\u0026gt; {\n        const config = new Configuration({ basePath: text } as ConfigurationParameters);\n        context.setConfig(config);\n      }} /\u0026gt;\n      \u0026lt;Version /\u0026gt;\n      \u0026lt;StatusBar style='auto' /\u0026gt;\n    \u0026lt;/View\u0026gt;\n  );\n}```","ts":"1634991402.031700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ChF"}]},{"client_msg_id":"03b46c67-1f2c-449b-87f9-af0b3e40493e","type":"message","user":"U8996GYBF","text":"差し替える前にAPI叩いているとは一体","ts":"1634991389.031500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"CR0r"}]},{"client_msg_id":"0512b243-48b0-44c8-945b-db095d824cbd","type":"message","user":"U06ECBRTJ","text":"API を叩く先のエントリポイントをユーザに TextInput から入力させて、差し替えたいんですが、コンポーネント的に差し替える前に、先にAPI 叩いてるんですよね","ts":"1634991364.031200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"wF1=l"}]},{"client_msg_id":"fc7d9671-b262-4904-b68b-efd7eb0ecbe9","type":"message","user":"U9S4G0LJW","text":"手でやるべきなのかというの自体分かってない","ts":"1634991339.030700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"cagI"}]},{"client_msg_id":"c6aea894-321c-4db9-87cc-d2f302933dc0","type":"message","user":"U9S4G0LJW","text":"普通のReactなら手で再描画叩き込むんだけどNativeは世界観知らないからなー","ts":"1634991314.029800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ut3FR"}]},{"client_msg_id":"6ba01a2e-f2af-42a5-aa27-6f64d76a377c","type":"message","user":"U8996GYBF","text":"更新された場合のhookってのが意図読み切れてないかも","ts":"1634991267.028100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"1dt=R"}]},{"client_msg_id":"44db3c93-ca7c-47bd-8612-4f42e5da405a","type":"message","user":"U8996GYBF","text":"一緒に使うイメージは強いですね","ts":"1634991110.027500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Cwr"}]},{"client_msg_id":"877c1c26-c3ee-46bf-bbac-8aaf8ceac999","type":"message","user":"U06ECBRTJ","text":"Reducer 使うしかないかな","ts":"1634990911.027100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"PhaJ"}]},{"client_msg_id":"da7fe1c6-fa0a-4207-a252-fce5df13f1a1","type":"message","user":"U06ECBRTJ","text":"んー context が更新された場合の Hook ってどう書けばいいんでしょう","ts":"1634990806.026300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Wu7"}]},{"client_msg_id":"eb155d23-c296-47ab-823a-c199c778fb9f","type":"message","user":"U06ECBRTJ","text":"\u003chttps://www.digitalocean.com/community/tutorials/react-react-native-navigation-ja#%E3%82%A2%E3%83%97%E3%83%AA%E3%81%ABfriendscontext%E3%82%92%E8%BF%BD%E5%8A%A0%E3%81%99%E3%82%8B\u003e\n\u0026gt; 注:以前のバージョンのReact Navigationでは、screenPropsを使用して画面間でデータを共有することができました。現在のバージョンのReact Navigationでは、React Contextを使用して画面間でデータを共有することをお勧めします。\nReact Navigation 使ってる方、どっち使ってます？","ts":"1634978785.025000","attachments":[{"fallback":"DigitalOcean: React NativeでReact Navigationを使用したルーティングの使用方法 | DigitalOcean","id":1,"title":"React NativeでReact Navigationを使用したルーティングの使用方法 | DigitalOcean","title_link":"https://www.digitalocean.com/community/tutorials/react-react-native-navigation-ja#%E3%82%A2%E3%83%97%E3%83%AA%E3%81%ABfriendscontext%E3%82%92%E8%BF%BD%E5%8A%A0%E3%81%99%E3%82%8B","text":"React Navigationは、React Nativeアプリケーションでルーティングとナビゲーションを行うための一般的なライブラリです。このチュートリアルでは、ソーシャルメディアアプリケーションを構築し、react-navigationを使用してモバイルアプリケーション画面をナビゲートする方法を説明します。","image_url":"https://www.digitalocean.com/assets/community/illustrations/DigitalOcean_Community-e00e73a18df20667c3117725e727f3ade330204dff619ad8153050ded7341627.jpg","blocks":null,"service_name":"DigitalOcean","service_icon":"https://www.digitalocean.com/assets/community/apple-icon-180x180-4b5ac7f80f7cb483dde5afeb99c279301c50ec3670129c73ce568f1b465354be.png","from_url":"https://www.digitalocean.com/community/tutorials/react-react-native-navigation-ja#%E3%82%A2%E3%83%97%E3%83%AA%E3%81%ABfriendscontext%E3%82%92%E8%BF%BD%E5%8A%A0%E3%81%99%E3%82%8B","original_url":"https://www.digitalocean.com/community/tutorials/react-react-native-navigation-ja#%E3%82%A2%E3%83%97%E3%83%AA%E3%81%ABfrien