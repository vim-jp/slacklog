486800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"HsCC"}]},{"client_msg_id":"ab1f6bc1-4bab-49bd-b6c2-ac0ea29e2d70","type":"message","user":"U03C71D7H","text":"たぶんこれ初歩的な質問なんですけど、`tsc` でコンパイル時に `node_modules` 以下でエラーが出るのってどうすればいいんですっけ…","ts":"1626274102.486500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/vRC="}]},{"client_msg_id":"dcd64bc8-0313-4952-8be6-8157d9afc6f5","type":"message","user":"U06ECBRTJ","text":"javascript 難しい","ts":"1626274046.485900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"3Zir"}]},{"client_msg_id":"2d6d3c42-f7b4-4ed3-a45b-961058d05720","type":"message","user":"UNM8AVCB0","text":"`obj[methodName]` は不変とは限らないので `if (typeof obj[methodName] === 'function') obj[methodName]()` はできないよね","ts":"1626273916.485300","team":"T03C4RC8V","reactions":[{"name":"nanido","count":2,"users":["U03C71D7H","U01BY3SDBRS"]},{"name":"naruhodo","count":1,"users":["U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"6yW"}]},{"client_msg_id":"558e50c3-d082-454d-8993-f0c5923417f9","type":"message","user":"U03C71D7H","text":"`method.call(obj)` でいけるか","ts":"1626273646.484000","team":"T03C4RC8V","reactions":[{"name":"sorena","count":1,"users":["UNM8AVCB0"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"GzhG"}]},{"client_msg_id":"901a4cec-33af-46c2-be5c-ff92dc10ef1b","type":"message","user":"U03C71D7H","text":"でもこれだとメソッドとして呼べてないですね…","ts":"1626273610.483700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ds3/"}]},{"client_msg_id":"b73b06b6-149f-4d73-88ee-aa84a67ecd33","type":"message","user":"U03C71D7H","text":"とりあえずなんでもいいから index アクセスできるようにしちゃう感じか","ts":"1626273531.483400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Akx"}]},{"client_msg_id":"c894b704-9efa-4e4f-a3f5-fe81a06084c5","type":"message","user":"UNM8AVCB0","text":"\u003chttps://github.com/microsoft/TypeScript/issues/25720#issuecomment-533438205\u003e からの `isUnknownObject` をよく使っています。\n\n```class Foo {\n  bar() {\n    console.log(\"hi\");\n  }\n}\n\nfunction isUnknownObject(x: unknown): x is { [key in PropertyKey]: unknown } {\n  return x !== null \u0026amp;\u0026amp; typeof x === 'object';\n}\n\nfunction call(obj: unknown, methodName: string) {\n  if (!isUnknownObject(obj)) return\n  const method = obj[methodName]\n  if (typeof method === 'function') method()\n}\n\nconst foo = new Foo();\ncall(foo, \"bar\");\ncall(foo, \"baz\")```","ts":"1626272674.482700","edited":{"user":"UNM8AVCB0","ts":"1626272683.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"gce"}]},{"type":"message","user":"U027M25H7D5","text":"\u003c@U027M25H7D5\u003e has joined the channel","ts":"1626272215.481700","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null},{"client_msg_id":"e67d2d1f-6984-42c2-b4d9-393985e0bb5d","type":"message","user":"U03C71D7H","text":"ここで `typeof Invoker.prototype[value] === \"function\"` がチェックしたくなるんですが、これはやっぱり型エラーになってできない…","ts":"1626271884.481300","thread_ts":"1626265334.471400","subtype":"thread_broadcast","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"q8M7h"}],"root":{"client_msg_id":"ec25d257-fa7f-40f6-85cf-a5b9adf4cc28","type":"message","user":"U776661HA","text":"```export function isInvokerMethod(value: string): value is keyof Invoker {\n  return value in Invoker.prototype;\n}```","ts":"1626265334.471400","thread_ts":"1626265334.471400","last_read":"1626271884.481300","subscribed":true,"reply_count":1,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0Ym"}]}