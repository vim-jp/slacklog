ars":0,"is_starred":false,"shares":{"public":null,"private":null},"display_as_bot":false,"has_rich_preview":false,"username":""}],"upload":true,"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"mN05"}]},{"client_msg_id":"0e220167-4048-4df0-91d4-b0eaa84cca8a","type":"message","user":"U8996GYBF","text":"うーんって思ってるのは、今書いたとおりサーバにクエリを発行する側の都合でサーバがResolverを実装していかないといけないのってどうなのかってところです","ts":"1625042333.260400","thread_ts":"1625042333.260400","edited":{"user":"U8996GYBF","ts":"1625042353.000000"},"reply_count":3,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"CjS"}]},{"client_msg_id":"eb0619a0-7c3a-4dcb-b7a7-b24ffed43349","type":"message","user":"U06BRP8VD","text":"で、ycinoさんが主張している要求は、GraphQLサーバー側でのResolverについてに見えるんですよね。","ts":"1625042299.259200","edited":{"user":"U06BRP8VD","ts":"1625042325.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"QVj"}]},{"client_msg_id":"29c3186c-3baf-47d8-bcbb-ead649ada4d7","type":"message","user":"U8996GYBF","text":"\u003c@UNM8AVCB0\u003e 実際解決するならそれなんですけど、フロントの都合でResolverの実装をしていかないといけないのがもやるって感じです","ts":"1625042275.258700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Vp="}]},{"client_msg_id":"e04101d4-82e3-4367-bf78-6995c742106b","type":"message","user":"U8996GYBF","text":"koronさんが言ってるのは実装的にはまぁそうなるよなってのは分かるんですよね、ただもやるって感じです","ts":"1625042238.257600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"nP/"}]},{"client_msg_id":"8a87f314-d4ca-457a-9a55-269ca93b9ca1","type":"message","user":"UNM8AVCB0","text":"フロントエンド側は component としては `DetailUser` `UserListItem` みたいに区別されましたね。そのように `query DetailUser {}` `query UserListItem {}` にしたらいいじゃないですか。","ts":"1625042189.256500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"VKFjJ"}]},{"client_msg_id":"07a248ba-26a4-4db5-9197-846601244c5e","type":"message","user":"U06BRP8VD","text":"だとすればそれは僕は全く違和感なくて、なぜならcodegenはquery名でエントリポイントというか関数を生成する必要ありますよね。なので何かずらす手段がない限り問題、ユーザーがクエリ名を変えるしかない。","ts":"1625042180.256200","edited":{"user":"U06BRP8VD","ts":"1625042204.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zWv/"}]},{"client_msg_id":"ee392c55-95aa-484c-b7f2-e8933c0d1074","type":"message","user":"U8996GYBF","text":"TSのクエリ実装 -\u0026gt; TSの型及びクライアント生成です","ts":"1625042112.254300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"qjcF"}]},{"client_msg_id":"1d722ac3-3868-46e4-b937-938b2a9405ae","type":"message","user":"U06BRP8VD","text":"どっち(サーバーorクライアント)のコード生成?","ts":"1625042074.252700","edited":{"user":"U06BRP8VD","ts":"1625042097.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"33n"}]},{"client_msg_id":"679e595a-b3d3-4ef0-900d-79250c12a80b","type":"message","user":"U8996GYBF","text":"上の例だとgetUserWithNameとgetUserWithAgeを定義しないといけなくなってしまう","ts":"1625042070.252500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Ig8=n"}]},{"client_msg_id":"95c1827c-50f6-49ef-8cd5-33a276f868fc","type":"message","user":"U8996GYBF","text":"codegenがコードを生成するタイミングですね、GraphQL自体の問題ではないです","ts":"1625042011.252000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"p7WCd"}]},{"client_msg_id":"34341f31-51b4-4a82-8c70-8b38e0dc183d","type":"message","user":"U06BRP8VD","text":"えっとそれは誰がどの段階で怒ってるのかな?","ts":"1625041989.251400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"nxB"}]},{"client_msg_id":"7164b1b5-81cb-471d-ae52-a5e3d7d42d6d","type":"message","user":"U8996GYBF","text":"って状態です \u003c@U06BRP8VD\u003e","ts":"1625041898.250400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+Wi"}]},{"client_msg_id":"a57b0df9-0b76-4797-9f89-66d4ec52f48b","type":"message","user":"U8996GYBF","text":"それで\n```query User($id: Int!) {\n  getUser(id: $id) {\n    name\n  }\n}\n\nquery User($id: Int!) {\n  getUser(id: $id) {\n    age\n  }\n}```\nみたいなクエリを使ってそれぞれサーバに必要なプロパティだけを取りにいくものだと思ってるんですが、ここからcodegenを使うとgetUserへアクセスするクエリがuniqueじゃないとダメって怒られてしまう","ts":"1625041890.250200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"qPJ2"}]},{"client_msg_id":"121fb2ed-c21f-4b8c-856b-a78a8524d5ac","type":"message","user":"U8996GYBF","text":"例えばgetUserがあったとして、id, name, ageを持ってるときに、普通GraphQLってそのときに欲しいプロパティを取れるものだと思っているんですよね","ts":"1625041737.247500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Isa"}]},{"client_msg_id":"5e2c0e35-7009-4a39-a8db-223632773c3e","type":"message","user":"U8996GYBF","text":"自分の説明がすごい下手なんだろうな・・・","ts":"1625041655.246300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Vj77"}]},{"client_msg_id":"328b3699-1114-4853-9970-5488c04a05d6","type":"message","user":"U8996GYBF","text":"用事done","ts":"1625041641.245900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"F+h9E"}]},{"client_msg_id":"92f8cd92-d610-4a3c-b148-bee0eb0e64ea","type":"message","user":"U8996GYBF","text":"すみません、ちょっと離れるんでもしよかったらまたあとで話聞かせてください\n申し訳ないです","ts":"1625040546.244700","team":"T03C4RC8V","reactions":[{"name":"+1","count":1,"users":["U06BRP8VD"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"l0b"}]},{"client_msg_id":"f79ab6b2-4141-41b1-8a8b-5e99fffb5692","type":"message","user":"U06BRP8VD","text":"んーなんかGraphQLの理解がズレてる気がしてきたな…","ts":"1625040526.244200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"QPiI"}]},{"client_msg_id":"b043549b-8b6d-4549-a049-7464552ca2a9","type":"message","user":"U8996GYBF","text":"どっちも関わってるつもりでした、フロントが実行するクエリからcodegenをするときにサーバサイドにgetUserが存在しているとして、`getUser(id取得)` と `getUser(name取得)` みたいなクエリを定義するとgetUserの使い方がuniqueじゃないって言われて落ちる","ts":"1625040470.243300","edited":{"user":"U8996GYBF","ts":"1625040484.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"vMf92"}]},{"client_msg_id":"69fa7ef3-576c-4c01-9144-e765cb48692a","type":"message","user":"U06BRP8VD","text":"え、いまどっちの話してるの? サーバーサイドで良いの?","ts":"1625040358.241400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"nNItA"}]},{"client_msg_id":"e082508c-6a9c-4936-ab7d-d179724a6c4f","type":"message","user":"U8996GYBF","text":"例えばトップ画面で取得するユーザ一覧と、別の画面で取得するユーザ一覧で取りたいプロパティが違う場合に別のResolverがないといけない","ts":"1625040327.240800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"C86"}]},{"client_msg_id":"4b771809-df92-4d67-933d-5dbe72829f14","type":"message","user":"U8996GYBF","text":"自分がちゃんと分かってなかったらすみません、クライアントが発行するクエリの都合でサーバがResolver定義しないといけないのっておかしくないですか？","ts":"1625040293.239900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"XpPg"}]},{"client_msg_id":"2d5c2dd8-8d5a-4650-93ad-d21cdd384998","type":"message","user":"U06BRP8VD","text":"# まぁ普通GraphQLでresolverいうたらサーバーのイメージなんだけども。","ts":"1625040273.239500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Kkz/"}]},{"client_msg_id":"f41ec0df-4d14-4ee5-ae62-a332fdb3dea2","type":"message","user":"U06BRP8VD","text":"クライアント側のresolverの話?","ts":"1625040254.238800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"WjaQS"}]},{"client_msg_id":"ed35887d-5087-4794-aca4-cf6f577041c8","type":"message","user":"U8996GYBF","text":"resolver自体を毎回作らないといけない","ts":"1625040230.238400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"2BHYx"}]},{"client_msg_id":"42735253-435a-46d3-960b-4957bef5ce8d","type":"message","user":"U8996GYBF","text":"名前を変える手段が存在しない、のが辛いって感じですね","ts":"1625040220.238200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Nagn"}]},{"client_msg_id":"a181e55b-8719-4adf-9c14-5f4d6d496acb","type":"message","user":"U06BRP8VD","text":"機能として違うんだから、名前変えるってのがcodegen的なアプローチなんでしょ?","ts":"1625040206.237900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"bFLH"}]},{"client_msg_id":"2d11718f-360d-4af9-a661-66134598b74d","type":"message","user":"U8996GYBF","text":"そのときにgetUserでidを取りたいクエリとnameを取りたいクエリがそれぞれあったとして、それをcodegenして自動生成しようとすると落ちるって状態です","ts":"1625040170.237400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"kIM"}]},{"client_msg_id":"06aadf1f-fd7e-48f4-8be4-f829d750f981","type":"message","user":"U06BRP8VD","text":"それはOR/Mと同じ、インピーダンスミスマッチでは","ts":"1625040160.237100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"1VXlj"}]},{"client_msg_id":"1ae1da89-608f-4114-bad8-c686501d9d39","type":"message","user":"U8996GYBF","text":"マージじゃなくてGraphQLってユースケース毎にどのプロパティを取得するか指定するじゃないですか","ts":"1625040121.235900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"e=N"}]},{"client_msg_id":"8fab97ea-d74f-4397-918b-91701e486f23","type":"message","user":"U06BRP8VD","text":"同じ名前で、内容違ったらどうするの?","ts":"1625040094.235400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"BRyb"}]},{"client_msg_id":"ed7baa17-917f-46b8-b822-e6ef18a7c321","type":"message","user":"U06BRP8VD","text":"同じクエリ名\u0026amp;内容なら重複チェックしてマージして欲しいって話?","ts":"1625040078.234800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"GLq"}]},{"client_msg_id":"b587812b-33a5-462f-a411-5bf5d120a52f","type":"message","user":"U8996GYBF","text":"getUserが2回使われてたら落ちる","ts":"1625040028.233600","edited":{"user":"U8996GYBF","ts":"1625040035.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"uFI"}]},{"client_msg_id":"fbc3046b-04e3-44da-a849-058304e341ab","type":"message","user":"U8996GYBF","text":"getUserとかの方がいいかな","ts":"1625039995.233100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"dxklt"}]},{"client_msg_id":"fc3350c5-d64f-428e-98c8-457cd4e6a873","type":"message","user":"U8996GYBF","text":"```export const TestQuery = gql`\n  query getUser($id: ID!) {\n    user(id: $id) {\n      id\n    }\n  }\n`;\nexport const Test2Query = gql`\n  query getUser($id: ID!) {\n    user(id: $id) {\n      name\n    }\n  }\n`;```\n具体的にはこれでcodegen通らないです","ts":"1625039968.232600","edited":{"user":"U8996GYBF","ts":"1625040011.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"EjH"}]},{"client_msg_id":"a821b1f8-51c3-4cd7-be16-e5cf3229020d","type":"message","user":"U06BRP8VD","text":"このissueは生成されたコードに識別子を付けなきゃ使えないからユニークな名前が必要だよ、くらいの印象なんですよね。中身ちゃんと見れてないけど","ts":"1625039913.232200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/onPQ"}]},{"client_msg_id":"cb42066b-79a7-4f31-8e33-dc843c9e92ba","type":"message","user":"U8996GYBF","text":"Resolverが正しいのかな、Resolverの名前？","ts":"1625039864.231400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"R2n0"}]},{"client_msg_id":"1f53030b-4729-47f3-b13c-624b66acb712","type":"message","user":"U06BRP8VD","text":"そのエントリポイントってGraphQLの用語?","ts":"1625039837.230900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"1hN"}]},{"client_msg_id":"53b7dc6e-9ac1-491e-9d18-b479bf461f90","type":"message","user":"U06BRP8VD","text":"ん? ぜんぜんそんな話に読み取れないけど","ts":"1625039825.230600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"c3fM"}]},{"client_msg_id":"5010af83-b35d-4b53-9f40-9aef672c7a66","type":"message","user":"U8996GYBF","text":"User1, User2みたいな","ts":"1625039807.230200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"MiN"}]},{"client_msg_id":"6908ed20-36ba-4162-9644-a6d6f3c5ccf9","type":"message","user":"U8996GYBF","text":"クライアントが発行するクエリ毎にエントリポイントを用意しないといけないって話です・・・","ts":"1625039788.230000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zGN"}]},{"client_msg_id":"4cf8f3a5-30bf-408a-b43f-2e956d9fc17d","type":"message","user":"U06BRP8VD","text":"ん? なんのことだ? 名前つけなきゃいけないってこと?","ts":"1625039709.228900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"XgrF"}]},{"client_msg_id":"eaec587e-44a3-4e3a-86ef-e46f43cebf97","type":"message","user":"U8996GYBF","text":"やってることRESTじゃんっていう","ts":"1625039655.228500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"w7s"}]},{"client_msg_id":"79217f62-3c7a-4a6f-9f1c-6ad03af9a608","type":"message","user":"U8996GYBF","text":"GraphQL + codegen使ってる人がいたら聞きたいんですけど、この制約があまりにもひどすぎると思うんですがどう対処されてますか？\n\u003chttps://github.com/apollographql/apollo-tooling/issues/670\u003e","ts":"1625039572.227900","attachments":[{"color":"cb2431","fallback":"\u003chttps://github.com/apollographql/apollo-tooling/issues/670|#670 Why does codegen:generate require query names to be unique?\u003e","id":1,"title":"\u003chttps://github.com/apollographql/apollo-tooling/issues/670|#670 Why does codegen:generate require query names to be unique?\u003e","text":"It makes no sense.\n\nI have a component with a query like this (simplified example):\n\n```\nconst postsQuery = gql`\n  query Posts {\n    posts {\n      id\n      title\n    }\n  }\n`;\n\n```\n\nAnd another componentn with a query like this:\n\n```\nconst postsQuery = gql`\n  query Posts {\n    posts {\n      id\n      author\n    }\n  }\n`;\n\n```\n\nWhen I run `codegen:generate` to generate typescript type, I get an error:\n\n\u0026gt; _There can be only one operation named \"Posts\"_\n\nThis forces me to think of unique query names for each query. But why? I don't need a unique query name here. The query is unique based on its content. The name is only helpful for debugging purposes.\n\nAnd everything works fine. Apollo and graphql don't care about two queries having the same name. But I cannot generate types.\n\nThis seems to me to be horribly inconvenient. I want to colocate queries with my components. With this rule you could just as well disallow having two functions with the same name across the project.\n\nCan this check be disabled somehow? Or do you think that my approach is wrong? If so, can you please try to explain the best course of action?","fields":[{"title":"Comments","value":"16","short":true}],"mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/apollographql/apollo-tooling|apollographql/apollo-tooling\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png","ts":1541687939}],"edited":{"user":"U8996GYBF","ts":"1625039582.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"LR1m"}]},{"type":"message","user":"UG8UWTUBC","text":"\u003c@UG8UWTUBC\u003e has joined the channel","ts":"1625016532.227300","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null},{"client_msg_id":"eba0f7e3-0533-4693-b420-4f1fb0a4c07c","type":"message","user":"U06ECBRTJ","text":"なるほど","ts":"1625015562.227100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"nN9K"}]},{"client_msg_id":"a14202b9-70dc-4c2a-aca4-cb243da16215","type":"message","user":"U78A6ESHM","text":"うーん。フォーマットは効くけど、多分現状実用には耐えられんと思うので typescript-language-server 使っておくのがいいと思います。","ts":"1624983185.226800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"49Ca8"}]},{"client_msg_id":"2b124050-67ac-42da-8993-e35ee97abdea","type":"message","user":"U78A6ESHM","text":"\u003chttps://github.com/mattn/vim-lsp-settings/blob/master/settings/rome.vim\u003e","ts":"1624981850.226000","attachments":[{"color":"24292f","fallback":"\u003chttps://github.com/mattn/vim-lsp-settings/blob/master/settings/rome.vim | rome.vim\u003e","id":1,"title":"\u003chttps://github.com/mattn/vim-lsp-settings/blob/master/settings/rome.vim | rome.vim\u003e","text":"```\naugroup vim_lsp_settings_rome\n  au!\n  LspRegisterServer {\n      \\ 'name': 'rome',\n      \\ 'cmd': {server_info-\u0026gt;lsp_settings#get('rome', 'cmd', [lsp_settings#exec_path('rome'), 'lsp'])},\n      \\ 'root_uri':{server_info-\u0026gt;lsp#utils#path_to_uri(lsp#utils#find_nearest_parent_file_directory(lsp#utils#get_buffer_path(), '.config/'))},\n      \\ 'initialization_options': lsp_settings#get('rome', 'initialization_options', {}),\n      \\ 'allowlist': lsp_settings#get('rome', 'allowlist', ['javascript', 'javascriptreact', 'typescript', 'typescriptreact', 'typescript.tsx', 'json']),\n      \\ 'blocklist': lsp_settings#get('rome', 'blocklist', []),\n      \\ 'config': lsp_settings#get('rome', 'config', {}),\n      \\ 'workspace_config': lsp_settings#get('rome', 'workspace_config', {}),\n      \\ 'semantic_highlight': lsp_settings#get('rome', 'semantic_highlight', {}),\n      \\}\naugroup END\n\n```","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/mattn/vim-lsp-settings|mattn/vim-lsp-settings\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"s+l"}]},{"client_msg_id":"6603cda8-af8a-4b17-a46b-857a2c34cfc5","type":"message","user":"U78A6ESHM","text":"今動くのかな。一応 lsp-settings にはあります。","ts":"1624981830.225800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"yVUF"}]},{"client_msg_id":"ba092f5d-9198-49e9-abd9-7953863f137f","type":"message","user":"U06ECBRTJ","text":"\u003chttps://twitter.com/heavenshell/status/1292810529723965442\u003e\n去年8月は動かなかったらしい","ts":"1624981514.225300","attachments":[{"fallback":"\u003chttps://twitter.com/heavenshell|@heavenshell\u003e: Rome を vim-lsp で動かそうとしてるけど動かない。","id":1,"author_name":"heavenshell","author_subname":"@heavenshell","author_link":"https://twitter.com/heavenshell/status/1292810529723965442","author_icon":"https://pbs.twimg.com/profile_images/401153188/profile_img_normal.png","text":"Rome を vim-lsp で動かそうとしてるけど動かない。","blocks":null,"footer":"Twitter","footer_icon":"https://a.slack-edge.com/80588/img/services/twitter_pixel_snapped_32.png","ts":1597065024,"service_name":"twitter","from_url":"https://twitter.com/heavenshell/status/1292810529723965442","original_url":"https://twitter.com/heavenshell/status/1292810529723965442"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jPSyI"}]},{"client_msg_id":"34f2787a-8458-4b9b-9aa2-16b16c24c3ce","type":"message","user":"U06ECBRTJ","text":"あ、rome が入りそう","ts":"1624981320.224900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"UvTVo"}]},{"client_msg_id":"05b18ff4-b360-4a86-ba61-7822a56