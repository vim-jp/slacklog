ge","value":"JavaScript","short":true}],"blocks":null},{"color":"24292f","fallback":"nobrainr/morphism","id":2,"title":"nobrainr/morphism","fields":[{"title":"Website","value":"\u003chttps://morphism-playground.now.sh/\u003e","short":true},{"title":"Stars","value":"376","short":true}],"blocks":null}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"MgUm1"}]},{"client_msg_id":"25562d21-7895-42f2-a2fe-0ec577290661","type":"message","user":"U9S4G0LJW","text":"1,5,2,3,4だと思っていた","ts":"1629698154.030600","thread_ts":"1629698059.030500","parent_user_id":"U9S4G0LJW","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=T8o8"}]},{"client_msg_id":"7b7d253b-0a13-4b50-b189-8476d22d63e6","type":"message","user":"UDPT2BZ6E","text":"1,2,5,3,4かと思ってました。\n実行してなるほど。","ts":"1629698406.030800","thread_ts":"1629698059.030500","parent_user_id":"U9S4G0LJW","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"QJIiV"}]},{"client_msg_id":"229eadc3-ff1f-4e36-8199-fb033d4d2629","type":"message","user":"UAZ33BKV2","text":"ああ、そりゃそうか\nでもawaitの挙動が気をつけないと納得できなくなるなw","ts":"1629716469.053600","thread_ts":"1629698059.030500","parent_user_id":"U9S4G0LJW","team":"T03C4RC8V","reactions":[{"name":"desune","count":1,"users":["U9S4G0LJW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"W0nNf"}]}]
