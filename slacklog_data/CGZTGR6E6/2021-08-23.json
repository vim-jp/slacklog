,"block_id":"skL"}]},{"client_msg_id":"4e706699-dc41-485e-bf93-5beddd1b92b7","type":"message","user":"UDDCM376D","text":"\u003chttps://tarao.hatenablog.com/entry/deep-equality\u003e","ts":"1629724746.054400","attachments":[{"fallback":"貳佰伍拾陸夜日記: 再帰的な構造のデータの同値性判定はどうしたらいいか - 貳佰伍拾陸夜日記","id":1,"title":"再帰的な構造のデータの同値性判定はどうしたらいいか - 貳佰伍拾陸夜日記","title_link":"https://tarao.hatenablog.com/entry/deep-equality","text":"数日前にTwitterで, JavaScriptのオブジェクトに対する===の挙動が初心者には難しいみたいな話を見かけた. 発端や周辺の議論をちゃんと追いかけてないからとくに出典は貼らない. たぶん元々の話は「へぇ, こういう挙動なんだ, 簡単ではないね」くらいの話だったのかもしれない. 自分のタイムラインの観測範囲では「そうだそうだ, (参照の同一性ではなく)同値性にしとけばいいのに」と思っている人もそれなりにいそうに見えた.個人的にも同値性が簡単に確認できるとよい気はするものの, 「なんでそうしないんだ, オブジェクトの中身を確認していくだけだろ!」みたいな簡単な話ではないことも知っている…","image_url":"https://cdn-ak.f.st-hatena.com/images/fotolife/t/tarao/20210823/20210823113727.png","blocks":null,"ts":1629690296,"service_name":"貳佰伍拾陸夜日記","service_icon":"https://tarao.hatenablog.com/icon/touch","from_url":"https://tarao.hatenablog.com/entry/deep-equality","original_url":"https://tarao.hatenablog.com/entry/deep-equality"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"bgKM"}]},{"client_msg_id":"ff777a2e-c5fb-46e6-a2ed-96347d512855","type":"message","user":"UERCTTT8B","text":"\u003chttps://deno.com/blog/deno-on-mdn\u003e","ts":"1629723884.054000","attachments":[{"fallback":"Deno on MDN","id":1,"title":"Deno on MDN","title_link":"https://deno.com/blog/deno-on-mdn","text":"Web compatibility data for Deno is now available on MDN.","image_url":"https://deno.com/deno-on-mdn/header.png","blocks":null,"service_name":"deno.com","service_icon":"https://deno.com/static/favicon.ico","from_url":"https://deno.com/blog/deno-on-mdn","original_url":"https://deno.com/blog/deno-on-mdn"}],"team":"T03C4RC8V","reactions":[{"name":"benri","count":1,"users":["UP6PA1UBE"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"mr24"}]},{"client_msg_id":"fef82bf1-8e1e-4ea5-9453-328af5d594b9","type":"message","user":"U7JL1UKKL","text":"確かにJSだとasync外からawait使うと怒られますね","ts":"1629714135.053400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"7i9yF"}]},{"type":"message","user":"U010PEHHL3B","text":"\u003c@U010PEHHL3B\u003e has joined the channel","ts":"1629706064.051600","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null},{"client_msg_id":"43e2e11f-1e87-4a88-a1b0-551b2b7a1dd6","type":"message","user":"UD1FQV38V","text":"tipsもつけておこう","ts":"1629705730.051300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"eqO3w"}]},{"client_msg_id":"f9882739-5af9-4d4d-8c87-602329469284","type":"message","user":"U9S4G0LJW","text":"有益そうだったので","ts":"1629705417.051100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ZBqi"}]},{"client_msg_id":"199edd35-e926-46e5-97da-ac62a9c84f68","type":"message","user":"U9S4G0LJW","text":"Pinした","ts":"1629705412.050800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5BB"}]},{"client_msg_id":"518d8cd1-69b3-4d6f-bbf9-28c12dd900c3","type":"message","user":"UD1FQV38V","text":"Pinされてる","ts":"1629705386.050600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jx/"}]},{"client_msg_id":"3b0c3a8b-e285-40c0-8eac-a917bf025f4a","type":"message","user":"U7FL0Q71D","text":"`async`キーワードは、その関数が`Promise`返すという目印(と、返り値が`Promise`じゃなかったら`Promise`でラップする)ぐらいの気持ちで読むと良いですね。そして、`await` が右辺の`Promise`が解決されるされるのを待つ部分なんで、そこが非同期コンテキストへの切れ目になるイメージ。\n`async`/`await`が一番はじめに(たぶん…)実装されたC#だと、`await`が元々キーワードじゃなくて後方互換性が壊れるから、まず`async`関数というのを作ってその中でしか`await`できなくしたんだったと思うので( \u003chttps://ufcpp.net/study/csharp/ap_compatibility.html#await\u003e )、JSも似たような感じかな？と見てます。","ts":"1629705191.049900","pinned_to":["CGZTGR6E6"],"attachments":[{"fallback":"++C++; // 未確認飛行 C: 互換性の維持","id":1,"title":"互換性の維持","title_link":"https://ufcpp.net/study/csharp/ap_compatibility.html#await","text":"概要 C# は後方互換性に非常に注意を払っています。 C# 自身についても、C# のバージョンを上げることで動かなくなるコードが出ないように気を付けて機能追加をしていますし、 C# で書かれたライブラリについても、…","thumb_url":"https://ufcpp.net/images/logo_4.jpg","blocks":null,"ts":1384070400,"service_name":"++C++; // 未確認飛行 C","service_icon":"https://ufcpp.net/images/icons/apple-touch-icon-57x57.png","thumb_width":1000,"thumb_height":1000,"from_url":"https://ufcpp.net/study/csharp/ap_compatibility.html#await","original_url":"https://ufcpp.net/study/csharp/ap_compatibility.html#await"}],"team":"T03C4RC8V","reactions":[{"name":"naruho","count":3,"users":["U9S4G0LJW","U013QL1RAPN","U7JL1UKKL"]},{"name":"tips","count":1,"users":["UD1FQV38V"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"M6wn3"}]},{"client_msg_id":"d6f08a8e-608a-4af9-87af-abe0db6e9435","type":"message","user":"U03C71D7H","text":"元のコードはトップレベルの関数を await してないので、5 も同期的に呼ばれますね","ts":"1629704277.045200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"j9M2"}]},{"client_msg_id":"a3d99e8e-eadd-4b33-98df-60ff86498ecc","type":"message","user":"U9S4G0LJW","text":"おれたちは雰囲気で非同期をやっている","ts":"1629704152.044600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"s2xr"}]},{"client_msg_id":"19b3eb63-17d9-483e-a59c-cc6cb444d44a","type":"message","user":"U8R597E9H","text":"あと、`(async () =\u0026gt; {})()` が即座に非同期コンテキストを作らないっていうのは普通に不勉強だった。","ts":"1629704137.044200","edited":{"user":"U8R597E9H","ts":"1629704151.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"opc8a"}]},{"client_msg_id":"8f7ff36a-1b4a-44d2-9491-42bb61438a5c","type":"message","user":"U8R597E9H","text":"そうですね。これ top level await のお陰っぽいですね。","ts":"1629704116.043700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"xgVNm"}]},{"client_msg_id":"a63812bc-3958-45e9-90c6-082694293d44","type":"message","user":"UKHUVMBJR","text":"top level await が可能ならそうなりそうですね","ts":"1629704084.042800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"3D+vn"}]},{"client_msg_id":"713d1020-99b5-41d7-824c-7d29c01b6bd9","type":"message","user":"U8R597E9H","text":"前提として、 `async () =\u0026gt; { ... }` の呼び出しでは非同期コンテキストは作られない。というのがあって、その前提で読むと\n\n1, 2, 3 まではすべて同期の処理で進む（Promise のコンストラクタ関数は同期的に呼び出されるため）\n4 は `setTimeout(r, 1000)` を await で待ち受けているので非同期コンテキストに入る。\n5 は、非同期コンテキストに入った直後の処理で印字される。","ts":"1629704019.041600","edited":{"user":"U8R597E9H","ts":"1629704065.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/vFX"}]},{"client_msg_id":"ce803a2f-f614-45d9-8e46-6b2c4551a545","type":"message","user":"U8R597E9H","text":"多分そういうことな気がする。やっとちゃんと処理を脳内で追いかけることができた。。。","ts":"1629703890.039900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"OoDwP"}]},{"client_msg_id":"7b0a882d-f8eb-4635-b7d4-b70ce43afeb6","type":"message","user":"U8R597E9H","text":"同期コンテキストのまま setTimeout(r, 1000) を await する処理に突入しちゃうから 5 が後ろに回るのかな。","ts":"1629703820.039400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0mJ"}]},{"client_msg_id":"40c0fc86-da2e-4d37-ae88-9742b4df1691","type":"message","user":"U8R597E9H","text":"まだ自分はちゃんと理解できてなさそうです。。。","ts":"1629703760.038800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Iyz"}]},{"client_msg_id":"974eb70c-ee26-4454-8466-fe468e7412fc","type":"message","user":"U8R597E9H","text":"```console.log(1);\nawait (async () =\u0026gt; {\n console.log(2);\n await new Promise(r =\u0026gt; {\n   setTimeout(r, 1000);\n   console.log(3);\n });\n console.log(4);\n})();\nconsole.log(5);```\nこれなら 5 も納得なんですけどね。","ts":"1629703747.038500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"T16G5"}]},{"client_msg_id":"b134f455-e14b-45a1-ba5b-fe5419a71fe5","type":"message","user":"U9S4G0LJW","text":"awaitした瞬間にPromiseが返ってくると考えたらそうかってなった","ts":"1629702827.038000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ePO=="}]},{"client_msg_id":"a63f05ed-39a3-40ea-b796-ba9af976cf54","type":"message","user":"U9S4G0LJW","text":"AsyncFunctionの実行順だけは分からなかった(Vimのtimerみたいにキューに積まれる物だとばかり思っていた)","ts":"1629702797.037600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"CABXh"}]},{"client_msg_id":"19a977d4-d2d3-470d-8f44-88f7b57619d0","type":"message","user":"UKHUVMBJR","text":"なおかつシングルスレッドモデルっていう","ts":"1629702779.037200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"T9P"}]},{"client_msg_id":"43b385d0-0abe-4e93-a044-8cf73b5f61c2","type":"message","user":"UKHUVMBJR","text":"思想的に言うとJSはDOMのイベントをハンドリングする役割があるので、走り続けてGUIを止めるわけにはいかない。","ts":"1629702727.036700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Sq+"}]},{"client_msg_id":"56297450-367b-44ae-8be5-2760c6571753","type":"message","user":"U03C71D7H","text":"関数から戻ってきた Promise を無視しているだけなので、普通に次の処理が実行されますね","ts":"1629702540.036200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4wyz"}]},{"client_msg_id":"cc4edc71-2179-4968-af4d-5a7aff8f72e6","type":"message","user":"U8R597E9H","text":"さらにいうと async 関数を await してないのになぜ 5 が。。。みたいなお気持ちも。。。","ts":"1629702501.035600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ByQ"}]},{"client_msg_id":"e6f6df7d-7fef-4ff8-a153-9ec1e0f1abb4","type":"message","user":"U8R597E9H","text":"内部的に `new Promise((resolve, reject) =\u0026gt; { ... ここに処理が入ってくるようなトランスパイルを受ける ... });` なので同期のコンテキストを引き継ぐのだろうなと今は解釈しています。","ts":"1629702454.035000","edited":{"user":"U8R597E9H","ts":"1629702532.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"KEn"}]},{"client_msg_id":"fa9e5a5b-2cab-4ef8-a8be-39df7d48accf","type":"message","user":"U03C71D7H","text":"async は単に Promise を返すというだけですね","ts":"1629702343.034000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"sjJSS"}]},{"client_msg_id":"bd5ffe29-d81d-45ca-aaa9-45f96a2f1a4b","type":"message","user":"U8R597E9H","text":"async () =\u0026gt; の中の世界は常に非同期扱いを受けると思ってました。非同期処理が挟まるまでは同期のコンテキストをそのまま引き継ぐんですねえこれ","ts":"1629702250.033500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"mlz"}]},{"type":"message","user":"U01R5R36QK0","text":"\u003c@U01R5R36QK0\u003e has joined the channel","ts":"1629702049.033000","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null},{"client_msg_id":"98585cac-f19e-49c9-9c6b-2b3d6a131a3a","type":"message","user":"U03C71D7H","text":"シングルスレッドなんだから関数を呼んだら呼ばれた関数に処理が移るし処理している間は別の処理が割り込むことはないよね、って考えるとまあそうなるよねって答えが出る","ts":"1629701385.032600","team":"T03C4RC8V","reactions":[{"name":"tashikani","count":1,"users":["U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"6cB3/"}]},{"client_msg_id":"198c56ac-2975-4da3-9702-e88e96043d66","type":"message","user":"U03C71D7H","text":"JS は処理系が基本シングルスレッドなのでまだわかりやすい","ts":"1629701312.031800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"HpuS"}]},{"client_msg_id":"8c3521f0-f8dd-4b38-9571-034ca4f84581","type":"message","user":"U8R597E9H","text":"こういうの回答すると毎回間違ってて悲しくなる","ts":"1629700956.031500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"46v9"}]},{"client_msg_id":"2aa60d46-c524-45bc-b559-097be7da27b0","type":"message","user":"U03C71D7H","text":"想像通りだった","ts":"1629700811.031100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"nxQv"}]},{"client_msg_id":"f0bfde1e-5164-41df-8621-20695e35003a","type":"message","user":"U9S4G0LJW","text":"想像していた順番と全然違った、脳内モデルがアップデートできた","ts":"1629698059.030500","thread_ts":"1629698059.030500","reply_count":3,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"OhP+6"}]},{"client_msg_id":"ddc0a0e1-c3a8-457e-9f85-d66397180361","type":"message","user":"U01NKCTP7B4","text":"async await quiz\n\u003chttps://twitter.com/tkihira/status/1429061261895946240\u003e","ts":"1629697826.029800","attachments":[{"fallback":"\u003chttps://twitter.com/tkihira|@tkihira\u003e: // どういう順番で表示されるでしょうか？\nconsole.log(1);\n(async () =\u0026gt; {\n  console.log(2);\n  await new Promise(r =\u0026gt; {\n    setTimeout(r, 1000);\n    console.log(3);\n  });\n  console.log(4);\n})();\nconsole.log(5);","id":1,"author_name":"Takuo Kihira","author_subname":"@tkihira","author_link":"https://twitter.com/tkihira/status/1429061261895946240","author_icon":"https://pbs.twimg.com/profile_images/1392329123637338114/3jtjrRnu_normal.jpg","text":"// どういう順番で表示されるでしょうか？\nconsole.log(1);\n(async () =\u0026gt; {\n  console.log(2);\n  await new Promise(r =\u0026gt; {\n    setTimeout(r, 1000);\n    console.log(3);\n  });\n  console.log(4);\n})();\nconsole.log(5);","blocks":null,"footer":"Twitter","footer_icon":"https://a.slack-edge.com/80588/img/services/twitter_pixel_snapped_32.png","ts":1629549730,"service_name":"twitter","from_url":"https://twitter.com/tkihira/status/1429061261895946240","original_url":"https://twitter.com/tkihira/status/1429061261895946240"}],"team":"T03C