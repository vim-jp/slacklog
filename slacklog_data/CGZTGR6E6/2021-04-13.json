btQY"}]},{"client_msg_id":"982f69e3-cb66-4ea7-b3c4-cbbc3ce125d8","type":"message","user":"U8996GYBF","text":"型確認したり明らかに間違えてたらエラー吐いたり","ts":"1618279137.253300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"8x1rS"}]},{"client_msg_id":"33102cdc-bc46-4532-a344-c578c00bc71b","type":"message","user":"U8996GYBF","text":"あ、上の程度ならそれはできるんですけど、型推論って効きますっけ（勘違いしてるかもだけど多分deno lspのおかげでそこまでやってくれて便利な感じになってる）","ts":"1618279094.252800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Q=7ly"}]},{"client_msg_id":"44d4957a-83ec-4182-b223-d17afdebb093","type":"message","user":"UEACRCY0Z","text":"上くらいなら node (javascript) でも QuickRun できますね","ts":"1618279016.251800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"IdrM"}]},{"client_msg_id":"64495c77-f144-445a-97fe-3ed47e730639","type":"message","user":"U8996GYBF","text":"ワンタイムで使いたいTS地獄だったからな・・・","ts":"1618278942.251200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"mzhDy"}]},{"client_msg_id":"d1b7d713-d972-449c-b7aa-2c6a31c4ec3e","type":"message","user":"U78A6ESHM","text":"いちいち TS 環境作らなくて済むのほんと楽。","ts":"1618278826.250800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"tgMo0"}]},{"client_msg_id":"f70f7083-3714-4571-91cc-b32d81dfe6c0","type":"message","user":"U8996GYBF","text":"この手のやつdenoで雑に実行するように慣れてきて便利","ts":"1618278780.250300","team":"T03C4RC8V","reactions":[{"name":"wakaru","count":2,"users":["U78A6ESHM","U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"t1A6"}]},{"client_msg_id":"883ddfed-d170-418d-8d84-41226b76e7f9","type":"message","user":"U8996GYBF","text":"いやそんなことないか","ts":"1618278711.250000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"C=T"}]},{"client_msg_id":"5ade8616-48f5-4bc7-aa67-934596b18dc9","type":"message","user":"U03C71D7H","text":"`b` はエラーが発生するかもしれない副作用がある処理だと推測できるので、意味はありそう (もちろんこの例だけだと絶対にエラーが出るのでって意味で意味がないというのはわかる)","ts":"1618278708.249900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4sy2"}]},{"client_msg_id":"608dc6d9-7925-43a3-b1b3-13306eb05ee7","type":"message","user":"U8996GYBF","text":"ゴリラさんのやつ、console.logでawaitしないとダメそう？","ts":"1618278487.249100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Ald"}]},{"client_msg_id":"6c1cd091-c1f8-494b-b962-ad64ec65af2e","type":"message","user":"U8996GYBF","text":"自分ならこっちで書きそうです","ts":"1618278397.248700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"IOx"}]},{"client_msg_id":"0de45c27-ea06-431f-b1ae-6bd04dc38004","type":"message","user":"UEACRCY0Z","text":"`.then` を書き換えるならこんな感じですかね？（意味はないけど）\n\n```const b = new Promise((_, reject) =\u0026gt; {\n  return reject(new Error(\"some error\"))\n})\n\nasync function a() {\n  try {\n    await b;\n    const result = \"done\";\n    console.log(\"result:\" + result)\n  } catch(error) {\n    console.log(\"error:\" + error)\n  }\n}\n\na()```","ts":"1618278357.248400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5eP"}]},{"client_msg_id":"d71d6112-5114-4400-822f-9027dfe18ef8","type":"message","user":"U03C71D7H","text":"もちろん Promise を Promise のまま扱いたい場合もあるので絶対じゃないですけど、そうじゃない場合はなるべく使わないようにしてますね。 `.then` とかが消せるのが async/await の利点の 1 つなので","ts":"1618273227.247300","team":"T03C4RC8V","reactions":[{"name":"wakaru","count":3,"users":["UEACRCY0Z","U01BY3SDBRS","U01AQ5BFNLX"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"wQFck"}]},{"client_msg_id":"0c84cc22-d30b-4d24-9e7a-4f8999774d51","type":"message","user":"UDDCM376D","text":"thenが必要ない場合はなくてもよいすね","ts":"1618273153.246400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"FnNlR"}]},{"client_msg_id":"49a0737a-3792-4e8e-ad5e-73f481f12717","type":"message","user":"UDDCM376D","text":"あー、そうすね","ts":"1618273146.246100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"GCMu"}]},{"client_msg_id":"2145d09f-8599-4f53-8af7-93c40aa5db10","type":"message","user":"U03C71D7H","text":"なんなら then もなくてもよさそう","ts":"1618272840.245900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"WjCp"}]},{"client_msg_id":"de93ead0-dae7-4165-9d49-37253b33f666","type":"message","user":"UDDCM376D","text":"ありがとうございます","ts":"1618244909.245600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"1HGM"}]},{"client_msg_id":"69bc1608-ae1b-4b87-80b7-9d8e684e00cf","type":"message","user":"UDDCM376D","text":"普通にtry/catchで良かったのか","ts":"1618244904.245400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"P=rS"}]},{"client_msg_id":"42ebef81-2a80-4c9e-8d49-a7db8939b50d","type":"message","user":"UDDCM376D","text":"こうか","ts":"1618244887.244900","team":"T03C4RC8V","reactions":[{"name":"+1","count":1,"users":["U78A6ESHM"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hlP=o"}]},{"client_msg_id":"b0046d66-081b-4e61-b7cd-0c00bc284dd0","type":"message","user":"UDDCM376D","text":"```const b = new Promise((_, reject) =\u0026gt; {\n  return reject(new Error(\"some error\"))\n})\n\nasync function a() {\n  try {\n    const result = await b.then(() =\u0026gt; \"done\")\n    console.log(\"result:\" + result)\n  } catch(error) {\n    console.log(\"error:\" + error)\n  }\n}\n\na()```","ts":"1618244886.244700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"1aCww"}]},{"client_msg_id":"8933dd83-8e39-4238-b6a8-5f8f64c424ca","type":"message","user":"UDDCM376D","text":"なるほど","ts":"1618244885.244400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"gDrHN"}]},{"client_msg_id":"c22ae08a-f6b0-469c-8835-974f9f6fe48e","type":"message","user":"U78A6ESHM","text":"自分も try-catch する","ts":"1618244556.244200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0LCH"}]},{"client_msg_id":"9f813bf3-eae4-4608-907b-eaedc48fd578","type":"message","user":"U03C71D7H","text":"async で reject が発生したら例外になって飛ぶので try catch すればよいよ","ts":"1618244544.244000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"SlUy"}]},{"client_msg_id":"4372ce39-8b8a-40d0-ab1f-648f26fda0c5","type":"message","user":"UDDCM376D","text":"awaitを使って値を取得するときのエラーハンドリングですが、\nエラーを返してresultがエラーオブジェクトかどうか判定するのが良いでしょうか？\n```const b = new Promise((_, reject) =\u0026gt; {\n  return reject(new Error(\"some error\"))\n})\n\nasync function a() {\n  const result = await b.then(() =\u0026gt; \"done\").catch((err) =\u0026gt; {console.log(err)})\n  console.log(\"result:\" + result)\n}\n\na()```","ts":"1618243931.243900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"3xu"}]}]
