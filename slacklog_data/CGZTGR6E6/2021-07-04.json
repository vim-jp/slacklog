-server|theia-ide/typescript-language-server\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png","ts":1591057863}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0zJ"}]},{"client_msg_id":"f25d0b81-627f-453b-94a1-8a8d9f8efe09","type":"message","user":"U78A6ESHM","text":"わからん :innocent:","ts":"1625396575.319400","team":"T03C4RC8V","reactions":[{"name":"totemoturai","count":1,"users":["U06ECBRTJ"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ZHnE"}]},{"client_msg_id":"a986b023-e31c-4d0e-bc94-cf61108c8c0e","type":"message","user":"U78A6ESHM","text":"んー\n\u003chttps://gist.github.com/heavenshell/6503498b3c690650580cc51ac30f5c08\u003e\nちゃんと プロジェクトの tsconfig 使ってるっぽいなぁ。なのになんで Hint が出るんだ。","ts":"1625395499.319200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"UnAi"}]},{"client_msg_id":"01bd3995-8503-49ab-93eb-fa3ebeaaf449","type":"message","user":"U78A6ESHM","text":"ちゃんと定義ジャンプもできるし補完もできるので正しいのに出るのは、確かにうざい","ts":"1625382409.318600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"i1L"}]},{"client_msg_id":"3dd6af6c-2b42-43bc-9e78-4691f3a65a11","type":"message","user":"U9S4G0LJW","text":"ちゃんとtrueになっとるな…","ts":"1625381920.318000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"UZ7"}]},{"client_msg_id":"40685e36-3b3b-48f8-b9c2-6a23232f6f2b","type":"message","user":"U9S4G0LJW","text":"\u003chttps://www.typescriptlang.org/ja/tsconfig#allowUmdGlobalAccess\u003e これでしたっけ","ts":"1625381900.317700","attachments":[{"fallback":"TSConfig リファレンス - すべてのTSConfigのオプションのドキュメント","id":1,"title":"TSConfig リファレンス - すべてのTSConfigのオプションのドキュメント","title_link":"https://www.typescriptlang.org/ja/tsconfig#allowUmdGlobalAccess","text":"allowJs から useDefineForClassFields まで、TSConfigのドキュメント