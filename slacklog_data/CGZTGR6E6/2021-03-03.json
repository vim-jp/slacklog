ext","block_id":"JI4"}]},{"client_msg_id":"D4D1157A-9251-4FB2-BEED-7D1B1BA350B5","type":"message","user":"U78A6ESHM","text":"おっ！","ts":"1614734916.380500","team":"T03C4RC8V","reactions":[{"name":"otxu","count":3,"users":["UAZ33BKV2","U01AQ5BFNLX","U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"6VQhM"}]},{"client_msg_id":"28728aa2-782e-4c12-8177-4f842f0fff48","type":"message","user":"U7TMPGWJ0","text":"Deno 1.8 Release Notes / \u003chttps://deno.land/posts/v1.8\u003e","ts":"1614734870.380100","attachments":[{"fallback":"DenoLand: Deno - A secure runtime for JavaScript and TypeScript","id":1,"title":"Deno - A secure runtime for JavaScript and TypeScript","title_link":"https://deno.land/posts/v1.8","text":"Deno is a simple, modern and secure runtime for JavaScript and TypeScript that uses V8 and is built in Rust.","image_url":"https://deno.land/images/icons/icon-512x512.png","blocks":null,"service_name":"DenoLand","service_icon":"https://deno.land/images/icons/apple-touch-icon-180x180.png","from_url":"https://deno.land/posts/v1.8","original_url":"https://deno.land/posts/v1.8"}],"edited":{"user":"U7TMPGWJ0","ts":"1614734890.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"z=h"}]},{"client_msg_id":"0bc187d9-e1b2-4593-8cb9-02c9f59298b4","type":"message","user":"U01BY3SDBRS","text":"こんな感じでimportしています\n\u003chttps://www.github.com/kkiyama117/denops-rust-example/tree/main/denops%2Frust%2Fmod.ts|https://www.github.com/kkiyama117/denops-rust-example/tree/main/denops%2Frust%2Fmod.ts\u003e","ts":"1614767364.425900","thread_ts":"1614767293.425600","attachments":[{"fallback":"GitHub: kkiyama117/denops-rust-example","id":1,"title":"kkiyama117/denops-rust-example","title_link":"https://www.github.com/kkiyama117/denops-rust-example/tree/main/denops%2Frust%2Fmod.ts","text":"Contribute to kkiyama117/denops-rust-example development by creating an account on GitHub.","thumb_url":"https://avatars.githubusercontent.com/u/27989936?s=400\u0026v=4","blocks":null,"service_name":"GitHub","service_icon":"https://github.com/favicon.ico","thumb_width":320,"thumb_height":320,"from_url":"https://www.github.com/kkiyama117/denops-rust-example/tree/main/denops%2Frust%2Fmod.ts","original_url":"https://www.github.com/kkiyama117/denops-rust-example/tree/main/denops%2Frust%2Fmod.ts"}],"parent_user_id":"U8R597E9H","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"y8f"}]},{"client_msg_id":"23a8ee4d-e167-4ede-8380-ea82ecea8aec","type":"message","user":"U8R597E9H","text":"これ、console.log がうまく動くのは `console` がグローバルな名前空間に定義されているからな気がします。","ts":"1614767466.426200","thread_ts":"1614767293.425600","parent_user_id":"U8R597E9H","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5LcE"}]},{"client_msg_id":"ee96c815-8bd6-45c0-addb-23c4d72ad035","type":"message","user":"U8R597E9H","text":"deno で import した `import * as log` は、モジュールローカルな名前空間なので、読み込めない。。。と推察します。\n\ndeno 側で定義した識別子を任意に wasm に読み取らせる方法があるのかどうかは僕はわからないので、ちょっと調べてみます。","ts":"1614767517.426400","thread_ts":"1614767293.425600","parent_user_id":"U8R597E9H","team":"T03C4RC8V","reactions":[{"name":"naruhodo","count":1,"users":["U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"HbMw"}]},{"client_msg_id":"ff4c6f1f-54c2-47ad-8cbb-bcae07f6b64f","type":"message","user":"U8R597E9H","text":"一応、wasm-bindgen のドキュメントを見るに「このモジュールから識別子を読み込みなさい」という指定はできるようです。","ts":"1614768316.426700","thread_ts":"1614767293.425600","parent_user_id":"U8R597E9H","team":"T03C4RC8V","reactions":[{"name":"eyes","count":1,"users":["U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"nGf"}]},{"client_msg_id":"8a2b0294-46a6-4c12-a4ac-c565cf02d6ae","type":"message","user":"U8R597E9H","text":"\u003chttps://rustwasm.github.io/docs/wasm-bindgen/examples/import-js.html\u003e\nこれの `defined-in-js.js` です。","ts":"1614768340.426900","thread_ts":"1614767293.425600","parent_user_id":"U8R597E9H","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Xmm"}]},{"client_msg_id":"3af49d28-60d1-4d20-942e-98a0db37c72a","type":"message","user":"U8R597E9H","text":"また、WebAssembly の生の利用用途では、下記のように JS 側の識別子を公開するようです。（これをどう wasm-pack がラップしているかは不明。。。）\n\n\u003chttps://developer.mozilla.org/ja/docs/Web/JavaScript/Reference/Global_Objects/WebAssembly/Instance/exports\u003e","ts":"1614768488.427200","thread_ts":"1614767293.425600","attachments":[{"fallback":"WebAssembly.Instance.prototype.exports - JavaScript | MDN","id":1,"title":"WebAssembly.Instance.prototype.exports - JavaScript | MDN","title_link":"https://developer.mozilla.org/ja/docs/Web/JavaScript/Reference/Global_Objects/WebAssembly/Instance/exports","text":"exports は WebAssembly.Instance オブジェクトプロトタイプの読み取り専用プロパティで、 WebAssembly モジュールインスタンスからエクスポートされたすべての関数をメンバ－として持つオブジェクトを返します。これらは、 JavaScript からアクセスして使用することができます。","blocks":null,"service_name":"developer.mozilla.org","service_icon":"https://developer.mozilla.org/favicon144.png","from_url":"https://developer.mozilla.org/ja/docs/Web/JavaScript/Reference/Global_Objects/WebAssembly/Instance/exports","original_url":"https://developer.mozilla.org/ja/docs/Web/JavaScript/Reference/Global_Objects/WebAssembly/Instance/exports"}],"parent_user_id":"U8R597E9H","team":"T03C4RC8V","reactions":[{"name":"naruhodo","count":1,"users":["U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"OVA"}]},{"client_msg_id":"7b6f8462-aecb-4730-923b-bf944d412ecf","type":"message","user":"U01BY3SDBRS","text":"このやりかたでは上手くいきませんでした、すみません......","ts":"1614768557.427500","thread_ts":"1614767090.423500","parent_user_id":"U776661HA","team":"T03C4RC8V","reactions":[{"name":"totemoturai","count":1,"users":["U776661HA"]}],"replace_