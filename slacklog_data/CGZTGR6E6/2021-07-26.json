[{"client_msg_id":"06093fd5-826e-44ac-aebf-fa2c3782f2b1","type":"message","user":"U9S4G0LJW","text":"Vimのstr系関数みたいなものか(違う)","ts":"1627267062.282900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ZYc4"}]},{"type":"message","user":"U022RQ5881Z","text":"\u003c@U022RQ5881Z\u003e has joined the channel","ts":"1627266504.282000","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null},{"client_msg_id":"ab7b9e0d-1605-4d10-9362-89815109bb32","type":"message","user":"U0238G3KV8D","text":"`length`のページでもスプレッド構文で分解しましょうみたいに書かれてますね\n\u003chttps://developer.mozilla.org/ja/docs/Web/JavaScript/Reference/Global_Objects/String/length#unicode\u003e\n\u0026gt; `length` は文字数ではなくコードユニットの数を数えるため、文字数を知りたい場合はこのようなことをする必要があります。\n\u0026gt; \n\u0026gt; function getCharacterLength (str) {\n\u0026gt;   // The string iterator that is used here iterates over characters,\n\u0026gt;   //  not mere code units\n\u0026gt;   return [...str].length;\n\u0026gt; }","ts":"1627263173.281600","attachments":[{"fallback":"String length - JavaScript | MDN","id":1,"title":"String length - JavaScript | MDN","title_link":"https://developer.mozilla.org/ja/docs/Web/JavaScript/Reference/Global_Objects/String/length#unicode","text":"length プロパティは String オブジェクトの文字列長を UTF-16 コードユニットの数で表します。 length は、 string インスタンスの読み取り専用データプロパティです。","image_url":"https://developer.mozilla.org/mdn-social-share.0ca9dbda.png","blocks":null,"service_name":"developer.mozilla.org","service_icon":"https://developer.mozilla.org/apple-touch-icon.0ea0fa02.png","from_url":"https://developer.mozilla.org/ja/docs/Web/JavaScript/Reference/Global_Objects/String/length#unicode","original_url":"https://developer.mozilla.org/ja/docs/Web/JavaScript/Reference/Global_Objects/String/length#unicode"}],"edited":{"user":"U0238G3KV8D","ts":"1627263199.000000"},"team":"T03C4RC8V","reactions":[{"name":"naruhodo","count":2,"users":["U9S4G0LJW","U022B9REYK0"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"25OHh"}]},{"client_msg_id":"45432d45-282a-4cc0-88d7-186c87b9037c","type":"message","user":"U7FL0Q71D","text":"`String.prototype.split()`は昔からあってサロゲートペアとか考慮されてませんが、`String.prototype[@@iterator]()`はそのへん考慮された実装になっているやつですね。\n\u003chttps://developer.mozilla.org/ja/docs/Web/JavaScript/Reference/Global_Objects/String/@@iterator\u003e","ts":"1627261543.280500","attachments":[{"fallback":"String.prototype[@@iterator]() - JavaScript | MDN","id":1,"title":"String.prototype[@@iterator]() - JavaScript | MDN","title_link":"https://developer.mozilla.org/ja/docs/Web/JavaScript/Reference/Global_Objects/String/@@iterator","text":"[@@iterator]() メソッドは、文字列値のコードポイントを走査し、それぞれのコードポイントを文字列値として返すイテレーターオブジェクトを返します。","image_url":"https://developer.mozilla.org/mdn-social-share.0ca9dbda.png","blocks":null,"service_name":"developer.mozilla.org","service_icon":"https://developer.mozilla.org/apple-touch-icon.0ea0fa02.png","from_url":"https://developer.mozilla.org/ja/docs/Web/JavaScript/Reference/Global_Objects/String/@@iterator","original_url":"https://developer.mozilla.org/ja/docs/Web/JavaScript/Reference/Global_Objects/String/@@iterator"}],"team":"T03C4RC8V","reactions":[{"name":"naruho","count":1,"users":["U9S4G0LJW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"APPG+"}]}]
