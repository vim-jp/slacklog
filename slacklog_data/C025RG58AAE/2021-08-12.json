.compile(\".*\");\n                 ~~~~\n    at file:///Users/alisue/ghq/github.com/vim-denops/deno-denops-std/test.ts:4:18\n\nFound 2 errors.\n\n*** time: 0.474781 ***```","ts":"1628760616.020000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"2wy"}]},{"client_msg_id":"dcbc5107-8186-4ded-8956-0fefe67f53c9","type":"message","user":"U776661HA","text":"Issue にごめんなさいしてきますｗ","ts":"1628760532.019700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"PInYc"}]},{"client_msg_id":"5A8BDF1E-12C6-4DB3-A343-985B5FC8410D","type":"message","user":"U776661HA","text":"草","ts":"1628760457.019300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"STJ"}]},{"client_msg_id":"CC10BEC6-DDB6-4951-9CDB-560C34592F3E","type":"message","user":"U776661HA","text":"あれ？","ts":"1628760449.019000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"wvyIL"}]},{"client_msg_id":"f0aadffb-ea5d-4adf-8a2a-bfe7a1274759","type":"message","user":"U03C71D7H","text":"そもそも compile() の使い方間違ってない? Mozilla のドキュメントを読んだ限り、引数に新しいパターンの文字列を渡すのでは?\n```\u0026gt; const patternC = /.*/;\nundefined\n\u0026gt; patternC.compile('.*');\n/.*/\n\u0026gt; \"Success\".match(patternC);\n[ \"Success\" ]```","ts":"1628759730.018800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"51C/N"}]},{"client_msg_id":"a1dc2867-827e-4600-9171-84bae31b2124","type":"message","user":"UL6CFN8NR","text":"あー compile しちゃだめなんですか。たしかに罠だ\n（私も Python の発想でコンパイルすることに違和感がなかった）","ts":"1628757839.017000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"BXB"}]},{"client_msg_id":"7899d828-be6c-4c47-addb-ac587109e38e","type":"message","user":"UNJ2DANJC","text":"Goもcompile","ts":"1628757642.015800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"u12i"}]},{"client_msg_id":"f87224ab-5bb7-4303-8640-d3e7f7e468fb","type":"message","user":"UAZ33BKV2","text":"Vimでもよくありますが、そのリテラルに文字を動的に追加したり、みたいなこともあるので、人間がコンパイル指示しておくと確実、みたいな","ts":"1628754410.014800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"FbVO"}]},{"client_msg_id":"5a1924b0-3a46-49fb-b596-208adb52edbf","type":"message","user":"U9S4G0LJW","text":"リテラルで宣言してたら処理系がよしなにやってくれるだろみたいな気持ちでいた","ts":"1628754198.013700","team":"T03C4RC8V","reactions":[{"name":"hai-small","count":1,"users":["U776661HA"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Satod"}]},{"client_msg_id":"cf3ee4ea-5404-4c21-8f1c-25b33229717c","type":"message","user":"U776661HA","text":"\u003chttps://docs.python.org/3/library/re.html#re.compile\u003e","ts":"1628754163.013000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"WKV"}]},{"client_msg_id":"80fb89c2-c35b-4a03-859a-3e854b368b6b","type":"message","user":"U776661HA","text":"Pythonやってると「正規表現はコンパイルするもの」って発想になって行き着くんですよね〜","ts":"1628754146.012800","team":"T03C4RC8V","reactions":[{"name":"naruhodo","count":2,"users":["U9S4G0LJW","U7JL1UKKL"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"6Lvle"}]},{"client_msg_id":"9119b13c-bb57-4ba2-9f70-173e20175461","type":"message","user":"U9S4G0LJW","text":"compileなんて生えてるというのを今知った","ts":"1628754068.011600","edited":{"user":"U9S4G0LJW","ts":"1628754075.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"7KTD"}]},{"client_msg_id":"8c2fec8f-9eea-4af3-a418-ef0d0f9164d5","type":"message","user":"U776661HA","text":"もう使う人居ないと思いますが、ちょっと罠なので共有\n\u003chttps://github.com/denoland/deno/issues/11663\u003e","ts":"1628753968.011000","attachments":[{"color":"36a64f","fallback":"\u003chttps://github.com/denoland/deno/issues/11663|#11663 RegExp.prototype.compile SILENTLY produce unusable RegExp object\u003e","id":1,"title":"\u003chttps://github.com/denoland/deno/issues/11663|#11663 RegExp.prototype.compile SILENTLY produce unusable RegExp object\u003e","text":"Hi. It seems \u003chttps://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/RegExp/compile|`RegExp.prototype.compile()`\u003e produce unusable RegExp object like\n\n```\nconst patternA = /.*/;\nconst patternB = /.*/.compile();\nconst patternC = /.*/;\npatternC.compile();\n\nconsole.log(\"patternA\", \"Success\".match(patternA));\nconsole.log(\"patternB\", \"Success\".match(patternB));\nconsole.log(\"patternC\", \"Success\".match(patternC));\n```\n\nAbove code shows\n\n```\npatternA [ \"Success\" ]\npatternB [ \"\" ]\npatternC [ \"\" ]\n\n```\n\nI understand that the method is deprecated but I think Deno should warn and keep the object.\n\nTested with Deno v1.13.0 on macOS.","fields":[{"title":"Labels","value":"bug","short":true},{"title":"Comments","value":"1","short":true}],"mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/denoland/deno|denoland/deno\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png","ts":1628751691}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=brw+"}]},{"type":"message","user":"U0177HB2VA8","text":"\u003c@U0177HB2VA8\u003e has joined the channel","ts":"1628730853.010400","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null}]
