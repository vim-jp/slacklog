s_bot":false,"has_rich_preview":false,"thumb_tiny":"","username":""}],"reactions":[{"name":"fuita","count":6,"users":["UD1FQV38V","U017BU3UZBQ","UGXMRNBUM","UP6PA1UBE","U9S4G0LJW","U01BY3SDBRS"]},{"name":"nice-boke","count":3,"users":["UKHUVMBJR","UGXMRNBUM","U7B4ZD49X"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"EIekq"}]},{"client_msg_id":"ecf9c40b-b88e-4ef2-a2a4-cbf7f64978b0","type":"message","user":"UDPT2BZ6E","text":"原因発見すばらしいー! 私だったら再インストールしてたな。\nOSだけ再インストールしやすいように `/` と `/home` 分けてるのもあるので。","ts":"1617693320.074000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"pwBo2"}]},{"client_msg_id":"80afd2ab-a9f6-4603-9723-75d97ce5f4be","type":"message","user":"UGXMRNBUM","text":"ちと夜に頭からインストールし直してきます","ts":"1617693083.073500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"wcZSD"}]},{"client_msg_id":"8202eecf-097c-4d04-9495-6faaf779cf57","type":"message","user":"UGXMRNBUM","text":"あー、わかった。nvidiaとカーネルがミスマッチしている","ts":"1617693070.073400","team":"T03C4RC8V","reactions":[{"name":"naruhodo","count":3,"users":["UDPT2BZ6E","U7JL1UKKL","U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"I9jh"}]},{"client_msg_id":"0158049f-8506-44fa-b330-465b483b119d","type":"message","user":"UGXMRNBUM","text":"毎回指定するのだるいんで、blacklistに指定するべきですね、ありがとうございます","ts":"1617691010.073300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"T617"}]},{"client_msg_id":"5377df20-7497-48ce-8119-5b4785d38cba","type":"message","user":"UGXMRNBUM","text":"systemctl enable gdmはしてなくて、まともに起動するまでは、と思ってsystemctl start gdmを手で叩いているのです","ts":"1617690772.073200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"NhRd"}]},{"client_msg_id":"0b08fee1-e318-433d-947c-f483b82d61d8","type":"message","user":"U03C6TEAZ","text":"nouveau.modeset=0 入れるのはあくまで設定できる状態まで起動する目的なので、もしうまく起動して `/etc/modprobe.d` を触れるなら、そこで nouveau を blacklist に入れてカーネルパラメータは以降指定不要です。\n```blacklist nouveau\noptions nouveau modeset=0```","ts":"1617690567.072600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/+LUe"}]},{"client_msg_id":"e54088a4-29b9-43b6-98d7-3be9c770def7","type":"message","user":"UGXMRNBUM","text":"nvidiaのドライバー入れてたら、drmデバイスねえよって怒られが発生してたので、nouveauに切り替えてたんですよ。\n逆で、nvidiaのドライバー入れて、nouveau.modeset=0を試すべきか…","ts":"1617690247.071100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"EZ3V"}]},{"client_msg_id":"e0c37460-a05a-4261-8afe-530eb69a9144","type":"message","user":"UGXMRNBUM","text":"おっと、ミーティングしている間に知見が…！ちょっと試してみます","ts":"1617689836.071000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"o50Pi"}]},{"client_msg_id":"560b38c3-d070-4405-abba-04afac4013a0","type":"message","user":"UG6DF6W87","text":"\u003chttps://askubuntu.com/a/1048197\u003e\nこれかな?","ts":"1617683473.070700","attachments":[{"fallback":"Ask Ubuntu: Ubuntu 18.04 hangs on booting with message \"started user manager for uid 120\" on Asus 1015PX","id":1,"title":"Ubuntu 18.04 hangs on booting with message \"started user manager for uid 120\" on Asus 1015PX","title_link":"https://askubuntu.com/a/1048197","text":"I installed Ubuntu 18.04 amd64 desktop on Asus Eeepc 1015px, but it hangs on booting. The last message is 'Started User Manager for UID 120'. I managed to boot up in recovery mode and finished the","thumb_url":"https://cdn.sstatic.net/Sites/askubuntu/Img/apple-touch-icon@2.png?v=c492c9229955","blocks":null,"service_name":"Ask Ubuntu","service_icon":"https://cdn.sstatic.net/Sites/askubuntu/Img/apple-touch-icon.png?v=e16e1315edd6","thumb_width":316,"thumb_height":316,"from_url":"https://askubuntu.com/a/1048197","original_url":"https://askubuntu.com/a/1048197"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"LxND"}]},{"client_msg_id":"c43350d4-ecf4-4782-a3bd-197c9fe66972","type":"message","user":"UG6DF6W87","text":"\u003chttps://askubuntu.com/questions/1037922/ubuntu-18-04-hangs-on-booting-with-message-started-user-manager-for-uid-120-on\u003e\n中身まだ読んでないけど、関連しそうなやつかな?","ts":"1617683304.070300","attachments":[{"fallback":"Ask Ubuntu: Ubuntu 18.04 hangs on booting with message \"started user manager for uid 120\" on Asus 1015PX","id":1,"title":"Ubuntu 18.04 hangs on booting with message \"started user manager for uid 120\" on Asus 1015PX","title_link":"https://askubuntu.com/questions/1037922/ubuntu-18-04-hangs-on-booting-with-message-started-user-manager-for-uid-120-on","text":"I installed Ubuntu 18.04 amd64 desktop on Asus Eeepc 1015px, but it hangs on booting. The last message is 'Started User Manager for UID 120'. I managed to boot up in recovery mode and finished the","thumb_url":"https://cdn.sstatic.net/Sites/askubuntu/Img/apple-touch-icon@2.png?v=c492c9229955","blocks":null,"service_name":"Ask Ubuntu","service_icon":"https://cdn.sstatic.net/Sites/askubuntu/Img/apple-touch-icon.png?v=e16e1315edd6","thumb_width":316,"thumb_height":316,"from_url":"https://askubuntu.com/questions/1037922/ubuntu-18-04-hangs-on-booting-with-message-started-user-manager-for-uid-120-on","original_url":"https://askubuntu.com/questions/1037922/ubuntu-18-04-hangs-on-booting-with-message-started-user-manager-for-uid-120-on"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"YuQ"}]},{"client_msg_id":"62e6d83f-6833-4cbb-a5c6-c9429d80b7df","type":"message","user":"UG6DF6W87","text":"```Apr 06 04:49:39 kyoh86-desktop systemd[1]: Starting User Manager for UID 120...\nApr 06 04:49:39 kyoh86-desktop dbus-daemon[387]: [system] Activating via systemd: service name='org.freedesktop.home1' unit='