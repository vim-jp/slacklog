icon.ico","thumb_width":200,"thumb_height":200,"from_url":"https://mag.osdn.jp/06/11/23/0451251","original_url":"https://mag.osdn.jp/06/11/23/0451251"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=aeAk"}]},{"client_msg_id":"597d0ae3-0b69-4a43-92c9-d6a3bc5c77bb","type":"message","user":"U01AQ5BFNLX","text":"今 `lsof`でプロセスから復元できる記事を見つけた","ts":"1614996636.225100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"j8g="}]},{"client_msg_id":"fc5d276e-e495-462f-abe0-fb7ad1a4f38d","type":"message","user":"U9S4G0LJW","text":"自分はリカバリすること無いのでよくわかってないけどこれ見たらなんとなく想像付くかな\n\u003chttps://wiki.archlinux.jp/index.php/%E3%83%95%E3%82%A1%E3%82%A4%E3%83%AB%E3%83%AA%E3%82%AB%E3%83%90%E3%83%AA\u003e","ts":"1614996614.224700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"vzD"}]},{"client_msg_id":"eb18c6a2-2619-4726-b3b0-48e622463566","type":"message","user":"U9S4G0LJW","text":"rmした物を戻すのは基本的に困難です（条件によってはできなくもない）","ts":"1614996553.224000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"GIdr"}]},{"client_msg_id":"117cd53e-5440-45e2-8dcb-77388bcc5325","type":"message","user":"U01AQ5BFNLX","text":"rmを打ったときです","ts":"1614996524.223700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"BhRr"}]},{"client_msg_id":"8911cceb-893c-4bdc-9e4c-bbd59857de10","type":"message","user":"U9S4G0LJW","text":"ゴミ箱からの復元ということならrmするのと違って専用のディレクトリに移動してるだけで、それを再び移動してるようなもんです","ts":"1614996505.223200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"1N="}]},{"client_msg_id":"eb3abe6d-6d24-4c0f-9bd3-6bd511abe44b","type":"message","user":"U01AQ5BFNLX","text":"ということは、なにか復元の操作をしたときは、再びinodeのリンクを作成するという認識であってますか?","ts":"1614996466.222500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=yY"}]},{"client_msg_id":"0c048bd7-3142-478d-869e-124d123640ac","type":"message","user":"U01AQ5BFNLX","text":"あとは、最近Undo、Redoの仕組みも気になっている","ts":"1614996431.221600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=oApG"}]},{"client_msg_id":"1050619f-cef7-48dc-8d32-0f8f2b31dc59","type":"message","user":"U01AQ5BFNLX","text":"面白いな〜","ts":"1614996396.221000","team":"T03C4RC8V","reactions":[{"name":"wakaru","count":1,"users":["U9S4G0LJW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"xtoyx"}]},{"client_msg_id":"d2b53062-35c9-4d0c-a52c-aae165dd1140","type":"message","user":"U9S4G0LJW","text":":desune:","ts":"1614996320.220700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"QOjME"}]},{"client_msg_id":"2f8a928e-6fc7-4bc8-a7a0-00588fd35561","type":"message","user":"U01AQ5BFNLX","text":"なるほど。深いところから消していく感じか","ts":"1614996299.220400","edited":{"user":"U01AQ5BFNLX","ts":"1614996304.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"tVe6y"}]},{"client_msg_id":"901a1516-0d5a-4a15-b790-b6eb8ebcaa90","type":"message","user":"U9S4G0LJW","text":"(他にもあるかもしれない)","ts":"1614996284.220000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"NJk"}]},{"client_msg_id":"e9cedfb7-4259-49e5-9016-3ab7258fc95d","type":"message","user":"U9S4G0LJW","text":"特殊なケースというのはハードリンクされている時と開いているファイルをrmした時","ts":"1614996276.219700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/oDs"}]},{"client_msg_id":"9977e584-52b5-4751-ab58-c05e987a0af9","type":"message","user":"U9S4G0LJW","text":"「リンクが消える」と言っているけど特殊なケースを除いて見た目上はファイルが削除されるのと動作は同じなのであまり気にしすぎなくてもいいと思う","ts":"1614996234.219000","team":"T03C4RC8V","reactions":[{"name":"hee","count":1,"users":["U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5f7lD"}]},{"client_msg_id":"4d160931-27e1-4838-a8e1-781644c27294","type":"message","user":"U9S4G0LJW","text":"シェルで\n```mkdir -p foo/bar\ntouch foo/bar/hoge\nrm -rv foo```\nとかやるとなんとなく把握できると思う","ts":"1614996112.218100","edited":{"user":"U9S4G0LJW","ts":"1614996131.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Wgp2"}]},{"client_msg_id":"71af9b90-2f5b-481a-b7f3-47411524bb25","type":"message","user":"U9S4G0LJW","text":"`rm -r` がやっているのは深さ優先探索を行い、一番深い層から順番にファイルのリンクを消していって、ディレクトリが空になるとそのディレクトリを消すという動作ですね","ts":"1614996080.217400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"8Mw5w"}]},{"client_msg_id":"ea6a335e-181f-4dc6-a2d9-1ac99d50e24b","type":"message","user":"U01AQ5BFNLX","text":"確かに `-f`オプションつけて存在しないフォルダ指定してもエラーでなかった","ts":"1614996009.216800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5TTe0"}]},{"client_msg_id":"68121b4d-151e-4ac2-8efc-d28da5a7487f","type":"message","user":"U01AQ5BFNLX","text":"ハードリンクを知らなかったからちょっと調べよう","ts":"1614995882.215700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"3Wiu"}]},{"client_msg_id":"36d91015-68ff-4bef-afb5-efc868c1d59f","type":"message","user":"U01AQ5BFNLX","text":"なるほど","ts":"1614995869.215400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"L74oS"}]},{"client_msg_id":"2c54afcd-9d29-4b2c-8803-c9a62e0f963b","type":"message","user":"U01AQ5BFNLX","text":"\u0026gt; ハードリンクといって同じinodeに複数エントリ割り振れる機能があるんですが、それで作ったリンクは流石に消えないです","ts":"1614995864.215100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"C29L"}]},{"client_msg_id":"204D0FB7-CD0C-46CA-AEEE-6EEB14C4997C","type":"message","user":"U01PMN2BVJQ","text":"fcitx5でやってますが、インライン入力出来ていたという認識です。（ここら辺あまり詳しくないので違ったらごめんなさい）","ts":"1615030873.275100","thread_ts":"1615030408.268200","parent_user_id":"U017BU3UZBQ","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"53h"}]},{"client_msg_id":"b4ef991d-a0e6-4b88-9001-09edc29b63bc","type":"message","user":"U017BU3UZBQ","text":"あ、インライン入力できるんですね:benri: 。\nOSやIMEによっては変換ウィンドウがでてこない（自分の環境）のでeskkが便利というのがあります。","ts":"1615031137.276700","thread_ts":"1615030408.268200","parent_user_id":"U017BU3UZBQ","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"41oi"}]}]
