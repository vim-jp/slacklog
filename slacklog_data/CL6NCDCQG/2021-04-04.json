/E"}]},{"client_msg_id":"671e0e82-4041-4756-b826-51d3cbe08214","type":"message","user":"UG6DF6W87","text":"network_mode: host がデフォルトの時期とかありましたっけ...? ないですよねー?","ts":"1617465692.051300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"cpub"}]},{"client_msg_id":"d9f1823d-aaac-48c6-b725-695a658204c9","type":"message","user":"U03C71D7H","text":"`docker-compose.yml` が置いてあるのだからそれを使っているはずだけど、このファイルには `network_mode` が設定されていないのですよね \u0026gt;らぁ","ts":"1617465657.050700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"KcxxO"}]},{"client_msg_id":"43f6a5b3-8648-43a2-b7f5-3a461dd8b723","type":"message","user":"UG6DF6W87","text":"提供されてる docker-compose.yaml には network_mode: host 入ってなさそうなんですよねー","ts":"1617465656.050600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Mwbj"}]},{"client_msg_id":"6171e370-da3e-48e9-9cea-4077fbf25de9","type":"message","user":"UG6DF6W87","text":"linux に multicast routing させるっていう手はあるはずなんですけど、具体的にどうやればいいかはわかんらんですねー","ts":"1617465589.049200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hAz"}]},{"client_msg_id":"4f77a6e6-f1b7-4649-874b-d5271e98abdd","type":"message","user":"U03C71D7H","text":"Web だけで使ってる説は 23424 ポートを開けていないので否定された… Serviio はメディアブラウザは 23424 で待ち受けている","ts":"1617465578.049000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"kPdzo"}]},{"client_msg_id":"99e5f656-8102-4356-a8bd-71ef7e92afc7","type":"message","user":"U06ECBRTJ","text":"`--net host` == `docker-compose.yml` での `network_mode: host` なんですが、\nこれで起動すると、`EXPOSE` なポートは全部自動でマッピングされるんですよね","ts":"1617465578.048900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"CqC2"}]},{"client_msg_id":"41af0814-3e5b-4266-b197-b28a2f8b235d","type":"message","user":"UG6DF6W87","text":"ほんとだ","ts":"1617465543.047100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4rWc"}]},{"client_msg_id":"1e81a6f1-e389-4bc6-bf7f-fc61016fff86","type":"message","user":"U03C71D7H","text":"いや、docker-compose.yml も入ってる","ts":"1617465510.046300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"f07SO"}]},{"client_msg_id":"d9743600-a80b-4ae9-afb8-3ee4950e9428","type":"message","user":"U03C6TEAZ","text":"あー","ts":"1617465482.045200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"55Yd"}]},{"client_msg_id":"8435ecb4-9019-4937-b454-ff2dd627182d","type":"message","user":"U06ECBRTJ","text":"`docker run -d --net host serviio` とかな可能性… ＞この人はどうやって","ts":"1617465465.045000","edited":{"user":"U06ECBRTJ","ts":"1617465507.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"BJN"}]},{"client_msg_id":"fe22a1f3-0039-44b0-b4ac-98eb70d1df28","type":"message","user":"U03C71D7H","text":"Web しか使ってないはまあありえそうだ…","ts":"1617465242.044000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"9=BJ"}]},{"client_msg_id":"546d8f9d-a78b-4130-9d88-d315e859535c","type":"message","user":"U03C71D7H","text":"Serviio、ffmpeg 必須ですからね…","ts":"1617465232.043700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"rnGP"}]},{"client_msg_id":"e79dc3f2-e289-4bcc-8d6e-4a8f9537373c","type":"message","user":"U06ECBRTJ","text":"普段はみんなだいたい bridge で docker つかってます","ts":"1617465228.043600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/6NSY"}]},{"client_msg_id":"2d14cf73-6462-44a1-8ab1-0a06c9598d23","type":"message","user":"U03C6TEAZ","text":"web しか使ってないとか。","ts":"1617465228.043500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"aS="}]},{"client_msg_id":"0cadb329-e0b4-4416-a42a-233a41edd858","type":"message","user":"U03C71D7H","text":"\u003chttps://github.com/riftbit/docker-serviio\u003e\nこれを使ったんですけど、この人はどうやって動かしていたんだろう","ts":"1617465212.042700","attachments":[{"fallback":"GitHub: rb-dock8s/serviio","id":1,"title":"rb-dock8s/serviio","title_link":"https://github.com/riftbit/docker-serviio","text":"Fastest and Smallest Docker Container for Serviio DLNA Server - rb-dock8s/serviio","thumb_url":"https://avatars.githubusercontent.com/u/68295454?s=400\u0026v=4","blocks":null,"service_name":"GitHub","service_icon":"https://a.slack-edge.com/80588/img/unfurl_icons/github.png","thumb_width":420,"thumb_height":420,"from_url":"https://github.com/riftbit/docker-serviio","original_url":"https://github.com/riftbit/docker-serviio"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"u6qs"}]},{"client_msg_id":"0919849b-894e-45c3-89f2-f876c0917187","type":"message","user":"U03C6TEAZ","text":"serviio、ラズパイ3だとキツいなぁ。","ts":"1617465202.042300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"aXuB"}]},{"client_msg_id":"43ef88ff-a43e-4edf-83c1-a0f963e0aa86","type":"message","user":"U06ECBRTJ","text":"\u003chttps://knowledge.sakura.ad.jp/images/2020/03/docker-compose-03-03-680x453.png\u003e","ts":"1617465183.041600","attachments":[{"fallback":"680x453px image","id":1,"image_url":"https://knowledge.sakura.ad.jp/images/2020/03/docker-compose-03-03-680x453.png","blocks":null,"from_url":"https://knowledge.sakura.ad.jp/images/2020/03/docker-compose-03-03-680x453.png","original_url":"https://knowledge.sakura.ad.jp/images/2020/03/docker-compose-03-03-680x453.png"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"AzB"}]},{"client_msg_id":"bd9a5624-d887-4965-8359-b5560593adb0","type":"message","user":"U03C6TEAZ","text":"host と bridge と nat とあるんでしょうけど、nat だと無理そうな気がするなぁ。","ts":"1617465164.041300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"YsnL"}]},{"client_msg_id":"4641d552-b731-4ce1-8761-d8af7c7e879e","type":"message","user":"U06ECBRTJ","text":"`network_mode: \"host\"` かな","ts":"1617465141.040200","team":"T03C4RC8V","reactions":[{"name":"sorena","count":1,"users":["UG6DF6W87"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"269l"}]},{"client_msg_id":"a2570bfc-45d4-4b48-a831-3ce6eeda36aa","type":"message","user":"U03C71D7H","text":"NAT はまあ NAT なんですけど、ホスト側で起動させた場合もうまく動いていなかったのはなんかアレな理由でしたね…","ts":"1617465132.039800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"gxnT"}]},{"client_msg_id":"f61fcf2f-47aa-40d9-860d-cf48ecd99134","type":"message","user":"U03C6TEAZ","text":"うちだと serviio、何も設定なく動いた。","ts":"1617465131.039600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"gLD"}]},{"client_msg_id":"9ab51d66-ee82-4ba4-8d1a-f441d39485ea","type":"message","user":"U03C6TEAZ","text":"やはり NAT か。","ts":"1617465101.038700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zYd"}]},{"client_msg_id":"b6c90df2-adb1-4068-93a1-f56a78a3d192","type":"message","user":"U03C71D7H","text":"マルチキャスト難しいなぁ","ts":"1617465068.038400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"H4iUr"}]},{"client_msg_id":"b2f7e589-eb07-4dc3-a577-a26afa4d3016","type":"message","user":"U03C71D7H","text":"デフォルトの NAT だとダメってことですよね","ts":"1617465051.037900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"LN3"}]},{"client_msg_id":"bfa6aa27-8e14-4507-8e02-244305ba9fdc","type":"message","user":"UG6DF6W87","text":"あ、すません、ダメだと言ったのは docker network を使うパターンはだめそうって意味でした","ts":"1617465017.037600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"oj+r"}]},{"client_msg_id":"b633c3ad-3b26-4a75-9f4a-9979d07c2ab3","type":"message","user":"UG6DF6W87","text":"おとなしく host network 使うのがよさそう!","ts":"1617464982.037000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"27twN"}]},{"client_msg_id":"0e204b0c-a068-4026-aa7b-9dc8f9a47e13","type":"message","user":"UG6DF6W87","text":"あ、いやだめですねホスト側が multicast group に入らないといけないけど、それをやる術がない気がします","ts":"1617464967.036600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zlOe"}]},{"client_msg_id":"ace3711c-ed1c-4cab-82d9-4b3dd627068f","type":"message","user":"U03C71D7H","text":"docker-compose.yml あるんですが、これにちょろっと書くと行ける?","ts":"1617464818.035900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"RNf"}]},{"client_msg_id":"d44183b2-4a24-4ffa-bcce-1bad904c496a","type":"message","user":"UG6DF6W87","text":"239.255.255.250/32 でいいですね多分","ts":"1617464788.035000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"VuYVk"}]},{"client_msg_id":"2e2c28dc-aefe-4394-914e-6bc393949094","type":"message","user":"U03C71D7H","text":"何か設定をすればできそうな予感もするけどもはや何もわからんってなってる","ts":"1617464774.034600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"yzp3"}]},{"client_msg_id":"a73473f4-95ca-4152-90e3-0097330363b3","type":"message","user":"UG6DF6W87","text":"さすがに広すぎるかｗ","ts":"1617464771.034400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Kjvf"}]},{"client_msg_id":"8882eda1-961f-45cf-bb02-bf182a33daca","type":"message","user":"UG6DF6W87","text":"あーなるほど docker 内でやるときは、239.0.0.0/8 を docker bridge に向ければよさそうかも","ts":"1617464740.033700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"W3n+"}]},{"client_msg_id":"a26f61ab-e1d4-4bdd-a5c2-3e2a9ca533b3","type":"message","user":"UG6DF6W87","text":"あ! なるほどそういうことですか! 理解!","ts":"1617464622.032800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"8xZ"}]},{"client_msg_id":"78247277-3522-472a-ae97-c1d95afe5e94","type":"message","user":"U03C71D7H","text":"外で起動はしたけど、外からは通常の LAN のネットワーク(192.168.1.3)と Docker のネットワーク(172.18.0.1) が見えてて、Docker 側の方で待ち受けちゃってたみたいです。\n`ip maddr show` も改めて確認すると設定がおかしい場合は Docker 側の方に `239.255.255.250` が増えていました","ts":"1617464595.032400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fVzz2"}]},{"client_msg_id":"e9cc79d8-e002-407f-a44a-3706e0e72a34","type":"message","user":"UG6DF6W87","text":"お! やったー","ts":"1617464506.030800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"tys"}]},{"client_msg_id":"6a8e822f-605e-411b-a157-f75e4c76054e","type":"message","user":"UG6DF6W87","text":"あれー外で起動しても動いてなかったあれはどういうことだったんだろう...?","ts":"1617464492.030400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fXOp"}]},{"client_msg_id":"36758f3e-7efd-41aa-961d-3baaaeb0033c","type":"message","user":"U03C71D7H","text":"そしてこれを手動で設定し直したら、VLC からサービス見えました！","ts":"1617464490.030300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4E9"}]},{"client_msg_id":"63ba1b8a-3ade-47a1-8757-fbf540a601fb","type":"message","user":"U03C71D7H","text":"そして Docker 内で起動した場合は言わずもがな、外側の IP が見えてないですね…","ts":"1617464440.028800","team":"T03C4RC8V","replace_original":false,"delet