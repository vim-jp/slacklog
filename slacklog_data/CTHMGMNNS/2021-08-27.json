[{"client_msg_id":"40e48f2d-6ffe-4677-a683-106032a08306","type":"message","user":"UP6PA1UBE","text":"\u003chttps://www.nikkei.com/article/DGXZQOUC270UO0X20C21A8000000/\u003e","ts":"1630049860.000200","attachments":[{"fallback":"日本経済新聞: 富士通から新たな情報流出か　暴露サイトに複数掲載","id":1,"title":"富士通から新たな情報流出か　暴露サイトに複数掲載","title_link":"https://www.nikkei.com/article/DGXZQOUC270UO0X20C21A8000000/","text":"富士通から流出したとみられるデータが暴露サイトに複数掲載されていることが26日までに分かった。顧客のものと思われるシステム関連データで、データベース設計書やシステム管理設計書などが含まれる。セキュリティー問題に詳しいS\u0026amp;J（東京・港）の三輪信雄社長によると、暴露サイトに情報が掲載されたのは25日ごろ。流出したデータは4ギガバイトで、そのうち解凍後で56メガバイト分が証拠としてさらされて","image_url":"https://article-image-ix.nikkei.com/https%3A%2F%2Fimgix-proxy.n8s.jp%2FDSXZQO0978910027082021000000-1.jpg?auto=format%2Ccompress\u0026ch=Width%2CDPR\u0026q=45\u0026fit=crop\u0026bg=FFFFFF\u0026w=1200\u0026h=630\u0026fp-x=0.5\u0026fp-y=0.5\u0026fp-z=1\u0026crop=focalpoint\u0026ixlib=js-1.4.1\u0026s=d1cf5b571a5e1b0c4d2a67a3ece0d559","blocks":null,"ts":1630031223,"service_name":"日本経済新聞","service_icon":"https://www.nikkei.com/.resources/k-components/180.rev-79352c3.png","from_url":"https://www.nikkei.com/article/DGXZQOUC270UO0X20C21A8000000/","original_url":"https://www.nikkei.com/article/DGXZQOUC270UO0X20C21A8000000/"}],"team":"T03C4RC8V","reactions":[{"name":"mount_fuji","count":2,"users":["U0238G3KV8D","U7JL1UKKL"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0/t"}]}]
