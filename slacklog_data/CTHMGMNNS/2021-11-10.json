h_text","block_id":"n7a"}]},{"client_msg_id":"8257027a-b4d0-4d16-91fd-0e39f5367bdf","type":"message","user":"U06BRP8VD","text":"\u0026gt; Intel® Core™ i7-1068NG7での計測結果。AESはOpenSSLの実装を利用して計測。Roccaも同様にOpen SSLに組み込み計測を実施。","ts":"1636508154.008200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"9X4ZX"}]},{"client_msg_id":"a2421f9d-c7da-4a11-9c51-dd3c6033ca78","type":"message","user":"UAZ33BKV2","text":"\u003chttps://www.itmedia.co.jp/news/articles/2111/09/news084.html\u003e\nなるほどスループット","ts":"1636500702.007900","attachments":[{"fallback":"ITmedia NEWS: KDDI総研ら、世界最速の暗号アルゴリズム開発　6G時代見据え","id":1,"title":"KDDI総研ら、世界最速の暗号アルゴリズム開発　6G時代見据え","title_link":"https://www.itmedia.co.jp/news/articles/2111/09/news084.html","text":"KDDI総合研究所と兵庫県立大学が、Beyond 5G・6G通信に対応できる処理速度をもった暗号アルゴリズム「Rocca」を開発した。処理速度は138Gbpsで世界最速としている。","thumb_url":"https://image.itmedia.co.jp/news/articles/2111/09/cover_news084.jpg","blocks":null,"service_name":"ITmedia NEWS","service_icon":"https://www.itmedia.co.jp/favicon.ico","thumb_width":1019,"thumb_height":425,"from_url":"https://www.itmedia.co.jp/news/articles/2111/09/news084.html","original_url":"https://www.itmedia.co.jp/news/articles/2111/09/news084.html"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"h92C"}]}]
