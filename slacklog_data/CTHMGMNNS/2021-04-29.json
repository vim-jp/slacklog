f1a-901a18bca0e6","type":"message","user":"UKHUVMBJR","text":"たとえばUnityアプリ開発するとして、アニメーションを含む複雑なUIのテストをどうやるのかとか\nUIといってもゲームのアクションとかもかなり絡むし","ts":"1619698348.057200","edited":{"user":"UKHUVMBJR","ts":"1619698371.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"2xCQ5"}]},{"client_msg_id":"8F383627-15B5-4803-B245-E28DEF1F597C","type":"message","user":"UFHQ7TNT0","text":"テストないと正しく動いていると思えないから、テストなしでちゃんと完成していると思えるのが凄い","ts":"1619698337.056800","team":"T03C4RC8V","reactions":[{"name":"wakaru","count":1,"users":["U011FTGJ3SN"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"puYGy"}]},{"client_msg_id":"626c0455-f97f-4348-b9fc-1b0d8d3b78b8","type":"message","user":"U8996GYBF","text":"型は大分頑張るけどテスト書けていない","ts":"1619698335.056600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hHZA"}]},{"client_msg_id":"74a4a8b8-f635-4dc7-81ae-e36252dd74a5","type":"message","user":"U01D44KSY9Z","text":"ゲーム開発よく分からないけどテストフレームワークとかあまりなさそう","ts":"1619698327.056100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"qn="}]},{"client_msg_id":"388a2d9e-9159-47ea-b39c-0b57ad772444","type":"message","user":"UKHUVMBJR","text":"据え置きゲーム文化圏だと、売り切りかつバグがあっても面白ければヨシみたいな感じで、\nしかも開発自体忙しいのでテスト書かないことは多そう\n\nでも運営するゲームだとテストないのはダメですねやっぱり","ts":"1619698312.055300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"HY/k"}]},{"client_msg_id":"f37b80c6-35d7-455f-ae12-96fde0d6b4a0","type":"message","user":"U78A6ESHM","text":"書かないのも問題だけど書きすぎると負債になりすぎて困る。","ts":"1619698293.053900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"2uIC"}]},{"client_msg_id":"edaf16c1-a24a-4baf-a7ad-3a0d6f012b22","type":"message","user":"UDPT2BZ6E","text":"なんかテストを書く前提でコードを書かないとどんどんテストできないコードになっていくんですよね。\n今はテストなしで、将来的にテストできるように考えてやってますが、不毛だなと思っています。。","ts":"1619698278.053200","team":"T03C4RC8V","reactions":[{"name":"wakaru","count":2,"users":["U9S4G0LJW","U011FTGJ3SN"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"GsGKI"}]},{"client_msg_id":"b3faaca2-4e08-4e58-8b4a-47c1e72af0a8","type":"message","user":"U8996GYBF","text":"自分は大分最低限しかテスト書かないから多分よくないんだろうな・・・","ts":"1619698275.053100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"H8o3"}]},{"client_msg_id":"8b9be112-7b87-45ce-ae64-ebc377d91514","type":"message","user":"U9S4G0LJW","text":"テスト書くのだるいけどトータル時間が大幅に削れるのを知ってしまったのでな","ts":"1619698226.050900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Kjhm"}]},{"client_msg_id":"854b4dd2-9110-4864-b40c-aa66fa12ff56","type":"message","user":"U8996GYBF","text":"ゲーム、複雑なビジネスロジックが入るからテスト必要そうなイメージがなんとなく","ts":"1619698162.050300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"vbxA"}]},{"client_msg_id":"8413bba5-bd08-4aba-a676-cd8e05443d38","type":"message","user":"UKHUVMBJR","text":"じゃなくてテスト文化圏にいたことない\n自分はちょこちょこ書いたりしてる","ts":"1619698158.050100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"qZhVS"}]},{"client_msg_id":"f04ec5c2-915a-4317-8c50-136f84b5709c","type":"message","user":"UKHUVMBJR","text":"実はちゃんとテスト書いたことない（ずっとゲーム作ってるので）","ts":"1619698137.049600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Ojc"}]},{"client_msg_id":"0668fce4-152c-44dd-be8d-17de09ec30f5","type":"message","user":"U9S4G0LJW","text":"テンプレ的な異世界転生した主人公が現地人を見るような気分","ts":"1619698103.049200","edited":{"user":"U9S4G0LJW","ts":"1619698116.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id