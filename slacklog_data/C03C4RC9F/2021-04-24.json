m/entry/2017/09/07/084948","original_url":"https://yoshitia.hatenablog.com/entry/2017/09/07/084948"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4Q/"}]},{"client_msg_id":"E879BC48-6CEA-4FA2-8EC7-027A71C7CF69","type":"message","user":"U78A6ESHM","text":"そう思います。不満があるのならしなくていいわけで。","ts":"1619251829.040700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"6ip3s"}]},{"client_msg_id":"ce5b0985-dd42-445c-ab33-24d14fd89787","type":"message","user":"UAZ33BKV2","text":"まあ、そのあたりですよね、実際のところ","ts":"1619251604.040000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ZXy"}]},{"client_msg_id":"7ac8e9d2-1b3e-4b31-b47e-74710383cf54","type":"message","user":"U06BRP8VD","text":"ん〜ぼくはBramへの感謝のつもりで出してるから、彼がウガンダへって言ってるなら「りょ」の一言ですよ。","ts":"1619251431.039700","team":"T03C4RC8V","reactions":[{"name":"+1","count":3,"users":["U78A6ESHM","UL6CFN8NR","U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"6xA"}]},{"client_msg_id":"d7fc36c0-8353-41b5-b490-bc142c6603c0","type":"message","user":"UNJ2DANJC","text":"個人的にはクレジットカードのポイント還元分は正直全部寄付でもいい","ts":"1619251426.039600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"M=3K3"}]},{"client_msg_id":"ac6350c7-9f67-42c6-b896-081c06576126","type":"message","user":"UAZ33BKV2","text":"でもそろそろ自分のために使おうかなw(ってもbitflyerでbitcoin化してみようかな、だったりするけど)","ts":"1619251344.039500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ihW"}]},{"client_msg_id":"86cf4d24-5632-4cda-a737-9c8e5c2ecc39","type":"message","user":"UAZ33BKV2","text":"まー、どうしても特定目的も汎用目的もあるからねえ...\nとりあえず、Tポイントは溜るたびにYahooから汎用系の寄付(倍になる)してる","ts":"1619251323.039000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"