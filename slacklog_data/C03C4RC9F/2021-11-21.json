fc50afb2d7fdf2","original_url":"https://qiita.com/kaityo256/items/6f4744fc50afb2d7fdf2"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"cRE4"}]},{"client_msg_id":"f2861ad5-8b48-4f40-9ee0-e559804a92c8","type":"message","user":"U76GA7MFA","text":"\u003chttps://ja.wikipedia.org/wiki/Compiler\u003e :thinking_face:","ts":"1637503705.488700","attachments":[{"fallback":"wikipedia: Compiler","id":1,"author_name":"Wikipedia","author_link":"https://ja.wikipedia.org/","title":"Compiler","title_link":"https://ja.wikipedia.org/wiki/Compiler","text":"『Compiler』（コンパイラ）は、麻宮騎亜による日本の漫画。『月刊アフタヌーン』（講談社）に連載されていた。続編に、『アセンブラ0X』（アセンブラゼロエックス）と、読切の『Compiler FINAL（検討中）』があるほか、『ヤングキングアワーズ（少年画報社）にて『元祖コンパイラ』が2021年11月号から連載中。\n様々な漫画・アニメ・特撮のパロディを多用したコメディSF。キャラクターや技の名前など、全編を通じて電気・通信（主にコンピュータ）関連の用語が用いられている。\n巻末には50音順で用語解説が掲載され、元ネタについて触れられている（『アセンブラ0X』には解説はない）。\n『サイレントメビウス』などの麻宮騎亜の他の作品とのリンクが見られる。『メビウスクライン』では『Compiler』のキャラクターが登場するほか、『アセンブラ0X』にも『メビウスクライン』にまつわる話がある。また、『カラプリ』や『姫神ガジェット』も同一世界という設定で、『Compiler』のキャラクターが登場する。","image_url":"https://upload.wikimedia.org/wikipedia/commons/f/fa/Plume_ombre.png","blocks":null,"service_icon":"https://a.slack-edge.com/80588/img/unfurl_icons/wikipedia.png","from_url":"https://ja.wikipedia.org/wiki/Compiler","original_url":"https://ja.wikipedia.org/wiki/Compiler"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5jn"}]},{"client_msg_id":"7c6adf23-4f12-4573-9697-8467e9209efc","type":"message","user":"U06ECBRTJ","text":"つまり、コンパイラさんを強く蹴りつけても問題ない…？","ts":"1637503687.488400","team":"T03C4RC8V","reactions":[{"name":"warau","count":1,"users":["U9S4G0LJW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"uL/="}]},{"client_msg_id":"58e89412-6154-4fd0-a9c5-28da1663efd6","type":"message","user":"U9S4G0LJW","text":"コンパイラさんは友達","ts":"1637503519.487900","team":"T03C4RC8V","replace_original":false,"delete_original":fal