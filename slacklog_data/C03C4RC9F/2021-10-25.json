create_buf(v:false, v:true)\nlet s:win = v:null\n\ncall timer_start(1000, { -\u0026gt; s:open() }, { 'repeat': -1 })\nfunction! s:open() abort\n  if !empty(s:win)\n    call nvim_win_hide(s:win)\n  endif\n  let s:win = nvim_open_win(s:buf, v:false, {\n  \\   'relative': 'editor',\n  \\   'row': 1,\n  \\   'col': 1,\n  \\   'width': 5,\n  \\   'height': 5,\n  \\ })\nendfunction```\nこういうスクリプトを用意して、これを source してから編集作業をすると、普通に履歴が壊れるのが再現できました。","ts":"1635133618.183900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"oe/"}]},{"client_msg_id":"b33b5ec2-c450-4bbe-937e-34c07f01b26b","type":"message","user":"U8R597E9H","text":"こちらでもずっとこの件を追いかけていたのですが、少なくとも neovim の floating window が原因の一つとなっていた。というのがわかりました。（それで、vim-lsp の popup にも同様の事象がありうるのではないか。。。？と思って聞いてみた感じです。）","ts":"1635133580.183200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zBQ"}]},{"client_msg_id":"48497b4e-7c10-4f27-8f34-01d64166726a","type":"message","user":"U03C71D7H","text":"lexima.vim がよく破壊する印象です…","ts":"1635133548.182600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"K4w"}]},{"client_msg_id":"9d9b46db-ed8b-4b1d-b5cd-988d39d7ff2b","type":"message","user":"U8R597E9H","text":"\u003c@U03C71D7H\u003e そういえば、undo で戻れない壊れた履歴ができてしまう。というやつですが、vim-lsp を使い始めてから発生するようになった。みたいな時期感とかってあったりしますか？","ts":"1635133512.181500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/p5L"}]},{"client_msg_id":"77eb8987-52d0-40d5-8b20-f647f6e2eca9","type":"message","user":"U01AQ5BFNLX","text":"やっぱりfetchで死んでるっぽい","ts":"1635117749.180500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zn=="}]},{"client_msg_id":"a4f2ed1e-def4-4df5-9742-521ebe353a20","type":"message","user":"U01AQ5BFNLX","text":"ですね。なぜ自分はブラウザ上に表示されたのだろうか… :thinking_face: