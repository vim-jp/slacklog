d":"0PP"}]},{"client_msg_id":"c6f5d490-c811-475f-9629-96c4e63e6ec6","type":"message","user":"U03C6TEAZ","text":"費用の関係もあるから、実際完璧に TDD やれてるところって少なそう。","ts":"1633155271.309000","team":"T03C4RC8V","reactions":[{"name":"wakaru","count":1,"users":["UFHQ7TNT0"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"kD1Y"}]},{"client_msg_id":"8da60643-db86-4b60-a366-bbadf6c7e146","type":"message","user":"U03C6TEAZ","text":"TDD だと最初に axios-mock-adapter でモックを先に実装して、そのあとそのテストが通る様に実装してく感じ。参考にはなるかもだけど既に出来上がってるなら読み違いが起きないように気を付けるといいかも。","ts":"1633155208.307800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"h51"}]},{"client_msg_id":"caadad97-a9d8-4635-b2e5-16c3eeb6d966","type":"message","user":"UNJ2DANJC","text":"jestのmockはよくハマる...","ts":"1633155087.304300","team":"T03C4RC8V","reactions":[{"name":"wakaru","count":1,"users":["U78A6ESHM"]},{"name":"sorena","count":1,"users":["UFYACJ537"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zF3"}]},{"client_msg_id":"0493aa65-7990-4890-a398-7f5c2dc70a8d","type":"message","user":"U03C6TEAZ","text":"js はこういうモックの注入が楽で羨ましい。","ts":"1633155038.303000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"uR3ND"}]},{"client_msg_id":"3ed07425-1034-4cbb-866e-a7ac6bad1a2c","type":"message","user":"UNJ2DANJC","text":"実はモックが仕様を満たしていないみたいなことは往々にしてあるので注意が必要です","ts":"1633154956.301200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"66lTg"}]},{"client_msg_id":"352f6312-a772-440a-9ff8-47899cdc9989","type":"message","user":"U01AQ5BFNLX","text":"もういちどTDDのモックテスト部分を読みなおすか…","ts":"1633154944.301100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"E07i"}]},{"client_msg_id":"c6686bb4-93ba-45b5-893e-bf48127d8b92","type":"message","user":"U01AQ5BFNLX","text":"「モックテストがこれでいいか」ではなく「モックテストに使うモックはこれでいいか」か","ts":"1633154884.299500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Xd8"}]},{"client_msg_id":"c6c0a979-33a2-4f50-809c-d0eb033ac718","type":"message","user":"UNJ2DANJC","text":"テスト観点が整理できていない段階で方法論に言及するのはhasuさんの成長にとってはあまり良くないかもですが、おそらくaxios-mock-adapterつかうとやりたいことができると思います。","ts":"1633154869.299300","team":"T03C4RC8V","reactions":[{"name":"naruhodo","count":1,"users":["U01AQ5BFNLX"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"KGL"}]},{"client_msg_id":"a2542336-6d5e-4a90-9c3b-04fc3694c43d","type":"message","user":"U03C6TEAZ","text":"\u003chttps://techblog.istyle.co.jp/archives/1397|https://techblog.istyle.co.jp/archives/1397\u003e","ts":"1633154860.299000","attachments":[{"fallback":"istyle Tech Blog: Vuex内のaxiosをモックしてテストする - istyle Tech Blog","id":1,"title":"Vuex内のaxiosをモックしてテストする - istyle Tech Blog","title_link":"https://techblog.istyle.co.jp/archives/1397","text":"こんにちは、アイスタイルのVue.jsマン（自称）ことkubotakです。 今回はVue.jsにおける、Vuexのactionsでaxiosによる非同期通信取得をしている場合のテストと、クライアントのテストに関して紹介し...Continue reading","image_url":"https://techblog.istyle.co.jp/wp-content/uploads/2018/11/vue-unit-test.png","blocks":null,"ts":1541648136,"service_name":"istyle Tech Blog","service_icon":"https://techblog.istyle.co.jp/wp-content/uploads/2018/11/cropped-favicon-fixed-2-180x180.png","from_url":"https://techblog.istyle.co.jp/archives/1397","original_url":"https://techblog.istyle.co.jp/archives/1397"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"9=csj"}]},{"client_msg_id":"c328c580-b19b-48a3-83b3-d580fb4d9917","type":"message","user":"UKHUVMBJR","text":"モックはテスト対象ではないものを気にせずに済ませるための仕組み・・・ですかね","ts":"1633154857.298700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"UUH"}]},{"client_msg_id":"250c669e-3627-42e6-a1d6-39382de33452","type":"message","user":"U01AQ5BFNLX","text":"なので、これを作ったんですが…\n\u003chttps://vim-jp.slack.com/archives/C03C4RC9F/p1633153219261000\u003e","ts":"1633154812.297900","attachments":[{"fallback":"[October 1st, 2021 10:40 PM] syu8.0324: 質問です。モックテストってこんな感じでいいんでしょうか？\nモック元APIの挙動としてはJSONをPOSTした際に、正常なフォーマットなら201\nそれ以外は400を返すというAPIです\n```function mock(data) {\n    let expect_data = makeJson(raw_json);\n    if (expect_data === data) return 201;\n    return 400;\n}```","id":1,"author_id":"U01AQ5BFNLX","author_name":"Hasu","author_subname":"Hasu","author_link":"https://vim-jp.slack.com/team/U01AQ5BFNLX","author_icon":"https://avatars.slack-edge.com/2020-09-25/1387013984515_764ebc65576be33ac497_48.png","text":"質問です。モックテストってこんな感じでいいんでしょうか？\nモック元APIの挙動としてはJSONをPOSTした際に、正常なフォーマットなら201\nそれ以外は400を返すというAPIです\n```function mock(data) {\n    let expect_data = makeJson(raw_json);\n    if (expect_data === data) return 201;\n    return 400;\n}```","mrkdwn_in":["text"],"blocks":null,"footer":"Posted in #random","ts":1633153219.261000,"from_url":"https://vim-jp.slack.com/archives/C03C4RC9F/p1633153219261000","original_url":"https://vim-jp.slack.com/archives/C03C4RC9F/p1633153219261000"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"dtJng"}]},{"client_msg_id":"4b2deedd-b818-4472-89b2-4894999d67af","type":"message","user":"U01AQ5BFNLX","text":"個人的には「レスポンスを確実に返すダミーサーバ = モック」の認識なんですけど間違ってますか？","ts":"1633154774.296900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"beSr"}]},{"client_msg_id":"56870D04-2F00-4F13-B49C-8AE497858013","type":"message","user":"U8996GYBF","text":"HTTPクライアントのテストがしたいわけではなさそうですよね","ts":"1633154748.296200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Ltu+W"}]},{"client_msg_id":"c6980184-1f14-45d9-bf64-4791e2fee58c","type":"message","user":"U03C6TEAZ","text":"POST した後の処理もテストすべきですが、期待したレスポンスを確実に返すダミーサーバか、疑似クライアントを使った方がいいんじゃないですかね。","ts":"1633154713.294800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"la8e"}]},{"client_msg_id":"542b2e47-2578-4e52-adc8-7966dca0f202","type":"message","user":"UNJ2DANJC","text":"おそらくやろうとしてることはクライアント側のテストでのサーバーのモックだとは思うんですが、テスト観点をうまく整理できていない気がします。","ts":"1633154546.289400","team":"T03C4RC8V","reactions":[{"name":"desune","count":1,"users":["U01AQ5BFNLX"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ozw5k"}]},{"client_msg_id":"556a0ee1-1905-4399-9245-be2e5f6bafe9","type":"message","user":"U01AQ5BFNLX","text":"ではまず、大前提として「POSTした後の挙動をテストするべきではない」ということでしょうか？","ts":"1633154545.289300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"2nV"}]},{"client_msg_id":"abed0ec0-f0c7-437d-ac79-9501673a53d5","type":"message","user":"U03C6TEAZ","text":"やってもダミーサーバです。","ts":"1633154520.288400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fUB"}]},{"client_msg_id":"c7eec7f2-696c-4103-a5b0-c35020b21382","type":"message","user":"U03C6TEAZ","text":"通常、単体テストでは投げる所まで含んではやりません。","ts":"1633154495.287700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0V98"}]},{"client_msg_id":"d6c06c90-e0eb-4486-954c-e547376f119c","type":"message","user":"U01AQ5BFNLX","text":"何がわからないのか(やりたいのか)が、ごっちゃになってきた…","ts":"1633154491.287300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"9qxg"}]},{"client_msg_id":"e37a21fa-5614-42a1-bc8d-9097a8abf153","type":"message","user":"U01AQ5BFNLX","text":"CMS","ts":"1633154443.285100","edited":{"user":"U01AQ5BFNLX","ts":"1633154452.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Shsr3"}]},{"client_msg_id":"e3466b6d-a047-4b67-9c64-bc8b9fe67e7e","type":"message","user":"U01AQ5BFNLX","text":"サーバーは外部サービスです","ts":"1633154439.284800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Np+W"}]},{"client_msg_id":"e59d23a3-daf2-4cc0-90ec-2d9022e35491","type":"message","user":"U03C6TEAZ","text":"サーバが仕様になってませんか？","ts":"1633154415.284300","team":"T03C4RC8V","reactions":[{"name":"sorena","count":2,"users":["UNJ2DANJC","U8CC7MDCL"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ykVg"}]},{"client_msg_id":"13e719af-e000-463a-b4ab-911fe4d912ef","type":"message","user":"U01AQ5BFNLX","text":"POSTしてAPI側で正常に処理されると、status code 201が返るので、それをテストしたいです","ts":"1633154371.283400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"GjQ"}]},{"client_msg_id":"fd5d2ded-04ec-4872-aa7f-5df753347205","type":"message","user":"UNJ2DANJC","text":"勝手にエスパーするとテストしたいのは実は\n\u0026gt; POST先でデータが作成されるか\n\u0026gt; \nではなく\n\"POSTでデータを送信して返ってきた結果をjs側できちんと扱えているか\"\nでは？","ts":"1633154314.283000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"azXh"}]},{"client_msg_id":"c9ef1e32-17ba-4036-b21c-48bb18753cd1","type":"message","user":"U01AQ5BFNLX","text":"JSONであるかのテストと、POSTするテストにテストは分割しています。","ts":"1633154202.281200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4=1he"}]},{"client_msg_id":"470fcdaa-c8d1-47cd-b565-a16ac22a84e9","type":"message","user":"U03C6TEAZ","text":"サーバが正ではなく、仕様が正なので。","ts":"1633154157.280100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=vYTu"}]},{"client_msg_id":"1ddcd80b-c608-49b0-a155-caee69288982","type":"message","user":"U03C6TEAZ","text":"ですとデータを作る所と投げる所は別のテストすね。","ts":"1633154104.278000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"bGvpo"}]},{"client_msg_id":"48eca85a-f356-47a8-b326-72ad1c2f4462","type":"message","user":"U01AQ5BFNLX","text":"formの値をJSON化して、axiosを用いてPOSTする箇所です(Vueプロジェクト)","ts":"1633154043.275900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"os1"}]},{"client_msg_id":"b0bfa345-fbc4-4fb9-95f5-6d9af5163a86","type":"message","user":"U03C6TEAZ","text":"書かれた箇所はどの部分です？","ts":"1633153988.274300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"eJBnh"}]},{"client_msg_id":"1c5020cd-f50e-4f53-8eaf-d021cc8c3705","type":"message","user":"U03C6TEAZ","text":"どこを試験したいかによります。","ts":"1633153964.273400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"uPoM5"}]},{"client_msg_id":"cf33fdfe-97ba-4eb8-babb-8f59785a5e61","type":"message","user":"U01AQ5BFNLX","text":"なるほど。","ts":"1633153956.272900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"e49"}]},{"client_msg_id":"a23bb4b3-3888-45da-ba2d-37df3478f813","type":"message","user":"U03C6TEAZ","text":"クライアントからデータを送ってサーバがデータの登録をするのを確認するのは、単体テストでなく結合テストです。","ts":"1633153930.272300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"bK1f"}]},{"client_msg_id":"8a579f95-fb6f-481b-9960-e6b85283c2cf","type":"message","user":"U01AQ5BFNLX","text":"サーバーのテストというのがあまり理解できてないです","ts":"1633153899.271300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"xAxO"}]},{"client_msg_id":"85238918-91f3-45f3-8351-5eb7556a962e","type":"message","user":"U03C6TEAZ","text":"ですね。HTTP から切り離せる様に実装して、そこだけ単体で試験しましょう。","ts":"1633153826.269000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"1Akx"}]},{"client_msg_id":"d514fa1a-6c03-458c-9d13-3ee4646e0be7","type":"message","user":"UNJ2DANJC","text":"サーバーのテストっぽいですね\nそれならモックすると本末転倒では","ts":"1633153793.267400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"349A"}]},{"client_msg_id":"4b764813-eb15-4e1e-94ba-392d41047f93","type":"message","user":"U03C6TEAZ","text":"それはサーバのテストです？","ts":"1633153725.266100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"yA7a"}]},{"client_msg_id":"4c788d7a-5dbb-4ba2-a5c7-75677187442e","type":"message","user":"U01AQ5BFNLX","text":"JSONをAPIにPOSTした際にきちんと、POST先でデータが作成されるかをテストしたいです","ts":"1633153706.265600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"FlEAF"}]},{"client_msg_id":"0ad09777-9044-4aef-8351-97edfed564dc","type":"message","user":"U03C6TEAZ","text":"ですね。","ts":"1633153653.264700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"XgAZ"}]},{"client_msg_id":"89a050e2-90f2-4c4f-b548-5596009ccc3c","type":"message","user":"UNJ2DANJC","text":"どういうテストがしたいかによりますね","ts":"1633153644.264400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"L1A"}]},{"client_msg_id":"452f825d-8d47-4b09-b59b-e7877c554777","type":"message","user":"U8CC7MDCL","text":"テスト単位はプロジェクト毎に決まる(ほうがいい)ので一概にこれとは言えませんが基本的に\n単体: メソッド単位くらいの粒度こまかーいテスト\n結合: 機能間の連携テスト\n\nが一般的ですかねぇ。\n単体(ユニット)テストは多分そこまで範囲ブレる事無いかなーと思いますけど結合がややこしかったりはありますね。\n内部結合とか外部結合とか分けてたりまとめて結合って言ってたり。\nプロジェクト(会社)毎で結構違ったりします。","ts":"1633163776.397700","thread_ts":"1633162395.393800","parent_user_id":"U01AQ5BFNLX","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"L3=J"}]},{"client_msg_id":"0b38b6ff-a1af-4c03-81c1-ed309b1dbfac","type":"message","user":"U01AQ5BFNLX","text":"Vueで書いているのであればそれは全てフロントになりますよね？\n(フロントのクリックイベントなどをサーバーというのか定義が自分の中で曖昧になっている)","ts":"1633160910.387600","thread_ts":"1633160769.385900","parent_user_id":"U8996GYBF","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"gP8"}]},{"client_msg_id":"d74525b5-33ff-4c55-95dc-6b76ecda2358","type":"message","user":"U8996GYBF","text":"ん、外部サービスのAPIを叩いてその外部サービスの挙動を確認したいって話をしてるんだと思うんですが違います？","ts":"1633160958.387900","thread_ts":"1633160769.385900","parent_user_id":"U8996GYBF","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"kVEQ"}]},{"client_msg_id":"b20763dc-5018-40d4-a8ca-e7108fddce60","type":"message","user":"U01AQ5BFNLX","text":"まちがってないです！","ts":"1633160991.388100","thread_ts":"1633160769.385900","parent_user_id":"U8996GYBF","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+NE"}]},{"client_msg_id":"4f4f994b-3d44-4286-8307-b7ec0be0b1b7","type":"message","user":"U8996GYBF","text":"全てフロントというか、外部サービスのテストって基本的に必要ないと思っています\nそれを始めると導入したnpm packageの挙動が信用できるか分からないから全てテストを書くみたいな話と同義なので","ts":"1633161021.388300","thread_ts":"1633160769.385900","parent_user_id":"U8996GYBF","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"N54"}]},{"client_msg_id":"12c36b0f-45bf-4e7a-84b7-54f44ebc406b","type":"message","user":"U01AQ5BFNLX","text":"自分サーバーの明確な定義がわかってないのかも","ts":"1633161041.388500","thread_ts":"1633160769.385900","parent_user_id":"U8996GYBF","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"2pL"}]},{"client_msg_id":"969e492b-4575-41b4-b310-7432aba43bbe","type":"message","user":"U8996GYBF","text":"外部サービス ≒ サーバでいいと思います","ts":"1633161055.388700","thread_ts":"1633160769.385900","parent_user_id":"U8996GYBF","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"AjL"}]},{"client_msg_id":"9c4a1b69-f815-41d6-a07c-e7d03f388c5e","type":"message","user":"U8996GYBF","text":"今回の話の文脈ではですね","ts":"1633161066.388900","thread_ts":"1633160769.385900","parent_user_id":"U8996GYBF","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"GE8C"}]},{"client_msg_id":"4bfcbb13-3c5a-4021-b300-c54bc10d5ed6","type":"message","user":"U01AQ5BFNLX","text":"onClickで発火する関数はサーバー側の実装とは言わないですよね？","ts":"1633161084.389100","thread_ts":"1633160769.385900","parent_user_id":"U8996GYBF","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"BNnc5"}]},{"client_msg_id":"60f333dc-b467-4784-a481-470d16e3664b","type":"message","user":"U8996GYBF","text":"で、仕様が決まっている完全に外部のものについてテストを書く必要はない","ts":"1633161089.389300","thread_ts":"1633160769.385900","parent_user_id":"U8996GYBF","team":"T03C4RC8V","reactions":[{"name":"tips","count":1,"users":["U01AQ5BFNLX"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"BD+jv"}]},{"client_msg_id":"e152a0cd-fdc9-430e-b345-4a716c344189","type":"message","user":"U8996GYBF","text":"はい、その関数のテストはしていいんですけど、そこでサーバにデータが登録されてるか確認するのは結合テストです","ts":"1633161116.389500","thread_ts":"1633160769.385900","parent_user_id":"U8996GYBF","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ajd"}]},{"client_msg_id":"531b1157-0411-4e60-8b50-42a5f4701b24","type":"message","user":"U01AQ5BFNLX","text":"\u0026gt; 仕様が決まっている完全に外部のものについてテストを書く必要はない\nこれが知りたかった！ありがとうございます！","ts":"1633161138.389700","thread_ts":"1633160769.385900","parent_user_id":"U8996GYBF","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+Mr"}]},{"client_msg_id":"9c0a5ec9-8ba2-48e9-89f1-81bb7b2bebfe","type":"message","user":"U8996GYBF","text":"これで答えになってるならよかったです\nまぁバグが存在する可能性はあるんですが、それを疑ってテストを書き始めると全てのライブラリに対してテストを書くみたいな話になっていくので","ts":"1633161197.390000","thread_ts":"1633160769.385900","parent_user_id":"U8996GYBF","team":"T03C4RC8V","reactions":[{"name":"sorena","count":1,"users":["U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"6v=2t"}]},{"client_msg_id":"5805fda7-8550-4c10-81f5-c011b30c81dc","type":"message","user":"U8996GYBF","text":"例えば今回の話だと、自分は今言っているテストとは別にブラウザ操作を自動化して\nログイン \u0026gt; ページ移動 -\u0026gt; クリック -\u0026gt; データ登録 -\u0026gt; ブラウザレベルで追加されたDOMが存在するか確認\nみたいなE2Eテストを書くのはやってもいいと思います","ts":"1633161340.390200","thread_ts":"1633160769.385900","edited":{"user":"U8996GYBF","ts":"1633161360.000000"},"parent_user_id":"U8996GYBF","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"tFQP"}]},{"client_msg_id":"157262f2-9022-42ab-b084-ec00a283d20b","type":"message","user":"U01AQ5BFNLX","text":"ユーザーのお問い合わせページなので、送信後に送信完了ページに遷移するかはテストできそうですね！","ts":"1633161472.390600","thread_ts":"1633160769.385900","parent_user_id":"U8996GYBF","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Dir"}]},{"client_msg_id":"7dd4d259-fd4a-4b8e-b9d6-ed8720d07100","type":"message","user":"U8996GYBF","text":"あ、それであればそんな感じです\nただそれはJestのassertみたいなレベルで担保する話ではないです","ts":"1633161503.390800","thread_ts":"1633160769.385900","parent_user_id":"U8996GYBF","team":"T03C4RC8V","reactions":[{"name":"naruhodo","count":1,"users":["U01AQ5BFNLX"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"V7LF"}]},{"client_msg_id":"938fdf35-5c89-47b7-b8e7-51cb47b88556","type":"message","user":"U8996GYBF","text":"空のテキストで送信して、ブラウザ上で実際にエラーページに飛ぶ or バリデーションエラーが表示される、みたいなのを書くとか","ts":"1633161582.391500","thread_ts":"1633160769.385900","parent_user_id":"U8996GYBF","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"vlj"}]},{"client_msg_id":"53026CC7-D9D7-4F79-A977-4C0B38F96F8E","type":"message","user":"UFHQ7TNT0","text":"あとはそれをテストしていいのかという別の問題がありますね。サンドボックスが用意されていればもちろん問題ないですけど。","ts":"1633161642.392800","thread_ts":"1633160769.385900","parent_user_id":"U8996GYBF","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"LWWW6"}]},{"client_msg_id":"4aae29d7-b92c-479a-a343-eea7bbda082e","type":"message","user":"U8996GYBF","text":"ですね\n今言っている話は特に外部サービスに対して副作用を発生させるものなので、それ用の環境が用意できないならやっていいか結構微妙だと思います","ts":"1633161680.393000","thread_ts":"1633160769.385900","parent_user_id":"U8996GYBF","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"mT+S"}]},{"client_msg_id":"a66968a7-e8dd-4338-951d-47805a163493","type":"message","user":"U01AQ5BFNLX","text":"その勉強のとき使った記事とか共有可能なら教えていただきたいです！","ts":"1633160775.386000","thread_ts":"1633155828.325000","parent_user_id":"UNJ2DANJC","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ZLMt"}]},{"client_msg_id":"6780fb64-a2a9-4aab-b0e4-691e7132c6c3","type":"message","user":"U01AQ5BFNLX","text":"そういってもらえると安心します","ts":"1633160422.381400","thread_ts":"1633155569.317600","parent_user_id":"U03C6TEAZ","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Gbdw4"}]},{"client_msg_id":"d21518e0-9002-4c37-8c59-007497040c72","type":"message","user":"U03C6TEAZ","text":"Go とかだとテスターの中でサーバ建てたりします。","ts":"1633153634.264300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"HNswT"}]},{"client_msg_id":"449e8886-0a9c-47e7-a2ae-aaded0d92ede","type":"message","user":"U01AQ5BFNLX","text":"APIなら仮APIサーバーを書くということでしょうか?","ts":"1633153515.263000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"IIlla"}]},{"client_msg_id":"e89c4816-9f37-43ec-82bf-e9eec7772a36","type":"message","user":"U03C6TEAZ","text":"透過的にやるために http クライアントを偽装するなどしますね。またはサーバを偽装する。","ts":"1633153470.262800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Y5tPl"}]},{"client_msg_id":"291a120b-5724-4f2f-8421-7c1ca2b13f20","type":"message","user":"U9S4G0LJW","text":"要件満たしてるなら何でもよさそう(ド素人並感)","ts":"1633153380.261700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"68E"}]},{"client_msg_id":"8c02e992-c1ee-40e1-b769-a18a1e49c2f8","type":"message","user":"U01AQ5BFNLX","text":"質問です。モックテストってこんな感じでいいんでしょうか？\nモック元APIの挙動としてはJSONをPOSTした際に、正常なフォーマットなら201\nそれ以外は400を返すというAPIです\n```function mock(data) {\n    let expect_data = makeJson(raw_json);\n    if (expect_data === data) return 201;\n    return 400;\n}```","ts":"1633153219.261000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ZMP"}]},{"client_msg_id":"fcc73406-7587-4fef-a585-653191f4af88","type":"message","user":"U01AQ5BFNLX","text":"ありがとうございます！w","ts":"1633147305.260700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"WWyvw"}]},{"client_msg_id":"827487eb-4098-460f-a5f4-c73667d75476","type":"message","user":"U01AQ5BFNLX","text":"?!","ts":"1633147259.260000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"1WGS"}]},{"client_msg_id":"866ef006-b491-40e7-8c8a-65d269261f92","type":"message","user":"U03C6TEAZ","text":"掩護射撃しておいた。","ts":"1633141569.258600","team":"T03C4RC8V","reactions":[{"name":"sasumatsu","count":6,"users":["U06ECBRTJ","UD1FQV38V","U017BU3UZBQ","U9S4G0LJW","U02G79NJMLY","U01BY3SDBRS"]},{"name":"mattn_yoshi","count":1,"users":["U01J8RHFH3P"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"DDpdP"}]},{"client_msg_id":"25700e84-6bc7-415c-898e-085b65c0537c","type":"message","user":"U01AQ5BFNLX","text":"skkeletonのツイート100いいねいったん