cb2-0e2a898e740e","type":"message","user":"U8996GYBF","text":"あぁなるほど、この場合 `/` でやっちゃってるから死ぬのか","ts":"1633576354.135600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"6Mct"}]},{"client_msg_id":"7a6b2b1d-4f7f-4f1c-bd2a-4f0fc127b36f","type":"message","user":"U03C71D7H","text":"Windows ではディレクトリの区切りは `\\` になる。多くの場合は `/` 使ってもまあ動くのだけど、動かないケースもたまーにある","ts":"1633576331.135300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Bln0Q"}]},{"client_msg_id":"c53292f3-af48-48e3-a3f4-bc46dd657363","type":"message","user":"U9S4G0LJW","text":"まあ、キャッシュが必要なレベルで呼ばれるとは思わないなw","ts":"1633576329.135100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fS3"}]},{"client_msg_id":"905def2f-14b2-4504-b195-c0d1285cbeab","type":"message","user":"U8996GYBF","text":"utilに入れて複数回呼ぶこととか考えて真面目にやるなら多分こう","ts":"1633576272.133400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"x=tpM"}]},{"client_msg_id":"6ba57d62-a750-4251-96a0-9b52f16c2d75","type":"message","user":"U8996GYBF","text":"```let HOME: string;\n\nexport const expandHome = async (\n  denops: Denops,\n  path: string,\n): Promise\u0026lt;string\u0026gt; =\u0026gt; {\n  if (HOME == null) {\n    HOME = await denops.call(\"expand\", \"~\") as string;\n  }\n\n  if (path.startsWith(\"~\")) {\n    return `${HOME}/${path.slice(1)}`;\n  } else {\n    return path;\n  }\n};```","ts":"1633576199.132900","edited":{"user":"U8996GYBF","ts":"1633576304.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"KVOw"}]},{"client_msg_id":"10ec8008-d54c-4db1-8ed5-9f007a2f426d","type":"message","user":"U01AQ5BFNLX","text":"あw","ts":"1633576175.132500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"qeK"}]},{"client_msg_id":"32116359-28d7-492c-8515-fa285d535a6e","type":"message","user":"U03C71D7H","text":"Vim script の `expand()` は `~` だけではなくあれこれ展開する。ユーザーが直接 `expand()` を使う場合は当然それも承知の上だけど、`~` を展開するために内部で `expand()` を使ってユーザーがそれを知らないとトラブルになる可能性が一応ある。若干ではあると思うけど","ts":"1633576174.132400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"owkJ"}]},{"client_msg_id":"ce532eec-3bb4-49ff-9f41-535b140b77b2","type":"message","user":"U9S4G0LJW","text":"s/cmd/eval/","ts":"1633576164.132200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zkDZO"}]},{"client_msg_id":"a7f20c39-c691-4537-b69f-de53694dd438","type":"message","user":"U8996GYBF","text":"あ、callが違う","ts":"1633576162.131900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"613vD"}]},{"client_msg_id":"13913e15-f7b3-4eb4-a85c-e9d945ed0eec","type":"message","user":"U01AQ5BFNLX","text":"こんなかんじか","ts":"1633576144.131100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"KELC9"}]},{"client_msg_id":"56dab16e-4605-44c9-87ee-aa682f0e508d","type":"message","user":"U01AQ5BFNLX","text":"```denops.cmd(`expand(${globalJisyo})`);```","ts":"1633576140.130900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"3hxjm"}]},{"client_msg_id":"62aa622c-70e0-4e50-99ef-d1b3f3420d5c","type":"message","user":"U8996GYBF","text":"自分がutilとして真面目に書くなら多分こう\n```let HOME: string;\n\nexport const expandHome = async (denops: Denops, path: string): Promise\u0026lt;string\u0026gt; =\u0026gt; {\n  if (HOME == null) {\n    HOME = await denops.call(\"~\") as string;\n  }\n\n  if (path.startsWith(\"~\")) {\n    return `${HOME}/${path.slice(1)}`;\n  } else {\n    return path;\n  }\n};```","ts":"1633576130.130500","edited":{"user":"U8996GYBF","ts":"1633576149.000000"},"tea