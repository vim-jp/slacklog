":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jLUih"}]},{"client_msg_id":"d1f0e543-8f81-47c0-b5e6-a640fe295633","type":"message","user":"U8996GYBF","text":"（昔N予備校開発していました）","ts":"1617172906.465100","team":"T03C4RC8V","reactions":[{"name":"sasu","count":1,"users":["U012MBD7MFZ"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"yqK4"}]},{"client_msg_id":"dd1327fb-9e6a-4704-b0c3-b89cd75ff2b1","type":"message","user":"U017BU3UZBQ","text":"いつかおっしゃてましたよね","ts":"1617172902.465000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"UJ9=L"}]},{"client_msg_id":"67151a76-6ba2-477f-ad3f-98498e77c121","type":"message","user":"U7JL1UKKL","text":"N高の人いたとは","ts":"1617172875.464400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/j4XJ"}]},{"client_msg_id":"5a76f7f0-5eb5-4095-91f1-b3bcea40fc3a","type":"message","user":"UDDCM376D","text":"HasuさんN高だったのか","ts":"1617170879.464300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"tO8e"}]},{"client_msg_id":"f23a1acf-81d4-41bd-9e9d-9c014e278717","type":"message","user":"U03C6TEAZ","text":"進学率だけじゃなく就職率もみたいですね。","ts":"1617170841.464100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"vyX"}]},{"client_msg_id":"1d3139be-c603-4fad-b95a-ad68e9a416a0","type":"message","user":"U01AQ5BFNLX","text":"自分としても、N高は結構居心地がいいと思ってるので、こういうことで評判を落とさないでほしい","ts":"1617170711.463600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"xt4U"}]},{"client_msg_id":"2f36978a-2140-4de0-944c-4edd023c550f","type":"message","user":"U03C6TEAZ","text":"わかる。","ts":"1617170625.462400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"N1br"}]},{"clien