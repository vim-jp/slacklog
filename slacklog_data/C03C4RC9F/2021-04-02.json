i/apple-touch.png","from_url":"https://mainichi.jp/articles/20210402/k00/00m/010/173000c","original_url":"https://mainichi.jp/articles/20210402/k00/00m/010/173000c"}],"team":"T03C4RC8V","reactions":[{"name":"manbou","count":8,"users":["UNJ2DANJC","U9S4G0LJW","U8CC7MDCL","UFP0GQZ4K","U017BU3UZBQ","U776661HA","U01J7703PFT","UL6CFN8NR"]},{"name":"wakaru","count":1,"users":["UL6CFN8NR"]},{"name":"sasu_manbou","count":1,"users":["UNJ2DANJC"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"eSm"}]},{"client_msg_id":"0D5C8664-9EB7-412B-A840-15D229089B32","type":"message","user":"U80CX6XDZ","text":"ですね。なので運動しない人が動機付けのためにやるのはすごくいいと思います。ただ純粋に筋トレをやるためのものとしてみると物足りないといったところですね。","ts":"1617362115.096900","team":"T03C4RC8V","reactions":[{"name":"wakaru","count":1,"users":["U7B4ZD49X"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zSu"}]},{"client_msg_id":"38a4dbb5-a045-4614-92fa-1f309d3f1685","type":"message","user":"UAZ33BKV2","text":"まあその分は、ちゃんとやったりや気分がのることで嫌にならないためのフレーバーだからなあw","ts":"1617362036.094700","edited":{"user":"UAZ33BKV2","ts":"1617362062.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"YcAcC"}]},{"client_msg_id":"3531043A-C8CE-487A-8EF7-7BE9777C1EC8","type":"message","user":"U80CX6XDZ","text":"なので隙間に差し込みづらいのが難点。","ts":"1617362006.094300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Rdz"}]},{"client_msg_id":"6D124465-57D0-47AA-B7BA-22F518BFDEEA","type":"message","user":"U80CX6XDZ","text":"個人的にはリングフィットは筋トレちゃんと出来るものの、純粋な筋トレと比較するとゲーム分の時間は余分にかかってしまうと思ってます。大体一時間プレイして実筋トレ時間が20分とか。","ts":"1617361984.093800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Jjx1"}]},{"client_msg_id":"0e29e38d-b153-4128-98ec-6c165cb76b64","type":"message","user":"U03C71D7H","text":"リングフィットは筋トレ。しっかり汗かく","ts":"16173