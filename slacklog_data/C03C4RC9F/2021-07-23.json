e.com/80588/img/services/twitter_pixel_snapped_32.png","ts":1627001508,"service_name":"twitter","from_url":"https://twitter.com/KawarimiDoll/status/1418373243522621446","original_url":"https://twitter.com/KawarimiDoll/status/1418373243522621446"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"yHc1"}]},{"client_msg_id":"24e0397a-062e-4830-91a6-be2fc6197991","type":"message","user":"U0238G3KV8D","text":"Googleのトップがゲームになってます どんどんクオリティたかくなっているような","ts":"1627002439.157800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zKM"}]},{"client_msg_id":"c972a305-6edb-40f4-aed6-fbba0163ba65","type":"message","user":"U782D5DF1","text":"ちなみに最近大腸が酸素取り込む機能あるのわかったらしいな","ts":"1627002360.157000","team":"T03C4RC8V","reactions":[{"name":"hee","count":2,"users":["U013QL1RAPN","U76V658V6"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"X4D"}]},{"client_msg_id":"17e8ac59-4a29-4ca4-b6af-49ca394a4fb6","type":"message","user":"U782D5DF1","text":"その範囲が増えてくると息頑張って吸っても酸素が取り込めなくなってくる・・・","ts":"1627002268.156000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"N1U"}]},{"client_msg_id":"f655ccff-d136-4bf4-b607-88b941651cc4","type":"message","user":"U782D5DF1","text":"ああうん、酸素を取り入れる肺胞が線維化して戻らなくなるらしい","ts":"1627002170.155100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Pb/g"}]},{"client_msg_id":"4773b3af-a29e-4132-9e49-636ebe42d00e","type":"message","user":"U76V658V6","text":"コロナは呼吸ができなくなって死んでいくので、死に方としてはかなり苦しいと思いますよ。重症化する場合の経過を医療従事者用のサイトで読みましたけど、肺水腫を起こすのとなんら変わらんので悲惨な死に方をすることになります。死ななくても呼吸がまともにできなくなるので悲惨な体験をすることになります。","ts":"1627000738.153300","edited":{"user":"U76V658V6","ts":"1627000873.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+sC"}]},{"client_msg_id":"8cf44a55-cc18-4c41-b117-e8f5d07baff8","type":"message","user":"U01D9BALEKU","text":"（医者以外の判断による情報は全部無視したほうが良いと思いますね）","ts":"1626992937.150600","team":"T03C4RC8V","reactions":[{"name":"sorena","count":10,"users":["U01AQ5BFNLX","UAZ33BKV2","U021YCLHK5L","U81LLJ340","UL6CFN8NR","UFBGUPDP0","U9S4G0LJW","U01BY3SDBRS","U022T2S7NGL","U01ATUT6PL3"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"l9qg"}]},{"client_msg_id":"aa434eb4-4967-4101-8945-6333591b31fe","type":"message","user":"UFBGUPDP0","text":"祝日は一生寝て過ごしたかったのに、何故か二度寝とかできなくなってて哀しい　眠気ほどコントロールできないものはないな","ts":"1626992090.149300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"7olow"}]},{"client_msg_id":"c4e39771-e66e-4720-a29b-2dfdd94f66d3","type":"message","user":"UFBGUPDP0","text":"コロナって2日くらい猛烈な症状が出て、2日で収まることもあるんですかね？\nなんか、40度で味覚なくなったけど2日で収まったからコロナでない的な話を見つけて、そうなのか？って気になっちゃって","ts":"1626991983.148500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"SrDwD"}]},{"client_msg_id":"67c0b826-80bf-4dd9-bc48-0e6acc214080","type":"message","user":"UFBGUPDP0","text":"ひえ","ts":"1626991876.147200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zd6Rh"}]},{"client_msg_id":"3cf2179a-3efd-40fa-b2b7-00f2964b0bef","type":"message","user":"U022PB40WAF","text":"コロナだけにコロっと死ぬ訳じゃないんですよ。高熱出て意識が朦朧としながら呼吸できなくなり、真綿で首を絞められるような感覚のまま死んでいくんですよ。\nこれじゃ首吊り○殺した方がよっぽどマシですわ。経験者が言うんですから。","ts":"1626991447.147000","team":"T03C4RC8V","reactions":[{"name":"dajare","count":1,"users":["U9S4G0LJW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"WlJeK"}]},{"client_msg_id":"27c9368e-dd36-4f07-89a9-5affcd208121","type":"message","user":"U022PB40WAF","text":"出ない方がいいですよ。感染源になりそうな阿呆共が昼間っから酒呑んでフラフラしていたりしますし。","ts":"1626991134.144500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"M8LG2"}]},{"client_msg_id":"b4c984f2-d574-4070-9776-0e51f7074c5b","type":"message","user":"UFBGUPDP0","text":"一歩も外に出ないサンプルがここに","ts":"1626990274.143400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jHI"}]},{"client_msg_id":"1d1c0908-5a30-4924-a412-f8eada26da5b","type":"message","user":"U022PB40WAF","text":"都市部住みだと余計にという感じですし…。","ts":"1626988698.143000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"pIM"}]},{"client_msg_id":"97d2e6c0-7a8a-417b-b5b9-083fcde9bc5b","type":"message","user":"U022PB40WAF","text":"祝日を満喫というより、在宅で溜まっていたタスクでやれることをやろうと消化している感じだと思いますよ。コロナウイルス怖いですし。","ts":"1626988632.142600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"n1a"}]},{"client_msg_id":"61dc2120-2870-45a6-8b33-9e12ca6b2040","type":"message","user":"U80GYUYCS","text":"iina~","ts":"1626986294.141600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"qkZ"}]},{"client_msg_id":"e8a78262-838d-4ade-a55e-01f3bfbb4cf0","type":"message","user":"U03C4RC8X","text":"ですね :goodpoem:","ts":"1626986245.141400","team":"T03C4RC8V","reactions":[{"name":"wakaru","count":2,"users":["U01BY3SDBRS","U020JPQGHED"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"nvs"}]},{"client_msg_id":"775201bb-fc32-4498-b3b9-b237057e5a4f","type":"message","user":"U9S4G0LJW","text":"今日はここが比較的静かだったな、みんな祝日を満喫しているのか","ts":"1626973568.141000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"cEgZn"}]},{"client_msg_id":"95567363-18d5-456f-9187-0de1d32eb3f0","type":"message","user":"U9S4G0LJW","text":"出掛けてる時間以外のほぼ全てがvimrcいじりに消えてしまった…","ts":"1626973554.140600","team":"T03C4RC8V","replace_original":false,"delete_ori