.co.jp/books/images/picture_large978-4-87311-963-2.jpeg","blocks":null,"service_name":"oreilly.co.jp","service_icon":"https://www.oreilly.co.jp/favicon.ico","thumb_width":457,"thumb_height":660,"from_url":"https://www.oreilly.co.jp/books/9784873119632/","original_url":"https://www.oreilly.co.jp/books/9784873119632/"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"7aV"}]},{"client_msg_id":"c903c051-3501-4a6e-9404-93f461dc1a27","type":"message","user":"U0238G3KV8D","text":"オライリーさん！？\n\u003chttps://www.oreilly.co.jp/books/9784873119649/\u003e","ts":"1631103842.209400","attachments":[{"fallback":"段ボールで作る！ 動く、飛ぶ、遊ぶ工作","id":1,"title":"段ボールで作る！ 動く、飛ぶ、遊ぶ工作","title_link":"https://www.oreilly.co.jp/books/9784873119649/","text":"本書は、子どもはみんな大好きで、しかもどんどん家に増えていく段ボールを中心に、紙箱や紙管（トイレットペーパーの芯など）を材料にして、実際に動かして遊べるおもちゃやゲームなどを作るための楽しい書籍です。紹介している作例は、マジックハンド、潜望鏡、ブーメラン、足踏みロケット発射装置、ゴムで飛ばすヘリコプター、パドルで進むボート、ビー玉ローラーコースター、風力トラクター、ストローで吹くサッカーゲーム、チェーンリアクションマシン、的当てゲーム、など。試行錯誤しながら改良を重ねることで、自然にエンジニアの考え方を身に付けることもできる、未来のエンジニアやプロダクトデザイナーにおすすめの一冊です。","thumb_url":"https://www.oreilly.co.jp/books/images/picture_large978-4-87311-964-9.jpeg","blocks":null,"service_name":"oreilly.co.jp","service_icon":"https://www.oreilly.co.jp/favicon.ico","thumb_width":516,"thumb_height":660,"from_url":"https://www.oreilly.co.jp/books/9784873119649/","original_url":"https://www.oreilly.co.jp/books/9784873119649/"}],"team":"T03C4RC8V","reactions":[{"name":"majika","count":1,"users":["U01J8RHFH3P"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"1iTp"}]},{"client_msg_id":"d01eba76-1e09-4279-a077-ba5dabe75166","type":"message","user":"U03C6TEAZ","text":"vim9 ならパースした op をファイルに吐けばできそうな気もするけど、Bram は AST にポインタ持ったりしてそう。","ts":"1631096742.208700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+6Qs"}]},{"client_msg_id":"da1536dd-5532-4d09-9954-ea27bd2aa285","type":"m