utocmd/mod.ts\u003e\";\nimport { ensureString } from \"\u003chttps://deno.land/x/unknownutil@v0.1.1/mod.ts\u003e\";\n\n// Export `main` function which is executed from denops.vim\nexport async function main(denops: Denops) {\n  denops.dispatcher = {\n    async say(): Promise\u0026lt;void\u0026gt; {\n      await denops.eval(\"input('test')\");\n    },\n    async ho(): Promise\u0026lt;string\u0026gt; {\n      return \"hoge\";\n    }\n  };\n\n  // Use 'execute()' to execute multiline Vim script\n  await execute(\n    denops,\n    `\n    command! Test call denops#request(\"${denops.name}\", \"say\", [])\n    cnoremap \u0026lt;expr\u0026gt; Q denops#request(\"${denops.name}\", \"ho\", [])\n    `,\n  );\n}\n```\n\n3. Run Vim and execute `:Test` command.\n4. Repeat press `Q`\n\n*Problem*\n\n1. Temporalily freeze and inserted `0` to buffer.\n2. Then an below error occurs at escape from input.\n\n```\nError detected while processing function denops#request[1]..denops#server#channel#request[4]..\u0026lt;SNR\u0026gt;103_request[3]..function denops#request[1]..denops#server#channel#request[4]..\u0026lt;SNR\u0026gt;103_request:\nline    3:\nE605: Exception not caught: Error: Failed to call 'say' with []: Error: Failed to call 'call' with [\"denops#api#eval\",\"input('test')\",{}]: Error: Failed to call 'denops#api#eval(input('test'), [object Object])': dispatch^@    at Vim.callForDebug (file:///tmp/dein/cache/vim/.cache/vimrc/.dein/denops/@denops-private/service/host/vim.ts:49:13)^@    at async Vim.call (file:///tmp/dein/cache/vim/.cache/vimrc/.dein/denops/@denops-private/service/host/vim.ts:70:8)^@    at async Service.call (file:///tmp/dein/cache/vim/.cache/vimrc/.dein/denops/@denops-private/service/service.ts:86:65)^@    at async Session.call (file:///tmp/dein/cache/vim/.cache/vimrc/.dein/denops/@denops-private/service/service.ts:60:25)^@    at async Session.dispatch (\u003chttps://deno.land/x/msgpack_rpc@v3.1.0/session.ts:98:6\u003e)^@    at async \u003chttps://deno.land/x/msgpack_rpc@v3.1.0/session.ts:108:15^@\u003e    at async Session.handleRequest (\u003chttps://deno.land/x/msgpack_rpc@v3.1.0/session.ts:104:25\u003e)^@    at Session.call (\u003chttps://deno.land/x/msgpack_rpc@v3.1.0/session.t\u003e\n\n``` \n*Environment*\n\nVim 8.2.3206  \ndenops.vim \u003chttps://github.com/vim-denops/denops.vim/commit/89195f3f8dc91226766dcaf54c748200ac6e31d4|vim-denops/denops.vim@89195f3\u003e","fields":[{"title":"Labels","value":"bug, help wanted","short":true},{"title":"Comments","value":"1","short":true}],"mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/vim-denops/denops.vim|vim-denops/denops.vim\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png","ts":1627229497}],"reply_count":41,"team":"T03C4RC8V","reactions":[{"name":"bow","count":1,"users":["U9S4G0LJW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"r7zq"}]},{"client_msg_id":"A16B3AE2-C359-4C0F-A87A-144A6CE95654","type":"message","user":"U776661HA","text":"これVimのバグっぽいなぁ...callだと起こってevalだと起こらない。だれかdenopsを介さない最小再現スクリプト作ってVimに報告して欲しい","ts":"1627725532.008100","thread_ts":"1627715424.003800","parent_user_id":"U776661HA","team":"T03C4RC8V","reactions":[{"name":"hiee","count":1,"users":["U9S4G0LJW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"VdsVH"}]},{"client_msg_id":"e352ecd1-f738-4087-9174-747f42579f12","type":"message","user":"U9S4G0LJW","text":"自分もなんとか調査を始めて、callのレスポンスに入ってはいけない物が入っている所まで突き止めたんですが、これVimのバグかぁ…","ts":"1627746333.008400","thread_ts":"1627715424.003800","edited":{"user":"U9S4G0LJW","ts":"1627746621.000000"},"parent_user_id":"U776661HA","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"2gy5C"}]},{"client_msg_id":"d07e4cde-9ea5-4049-abd3-4f4b697f0dd5","type":"message","user":"U9S4G0LJW","text":"一応出したしログ貼っておこう\n```\" 正常\n[ 17, [ 0, \"\" ] ]\n\" 異常\n[ 18, [ \"invoke\", \"dispatch\", 