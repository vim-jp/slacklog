defined` でぶった切る（`null` では切らない）ようにしました","ts":"1626141265.326300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"uDf7"}]},{"client_msg_id":"17c1a744-680a-478e-b61f-61dd2751e783","type":"message","user":"U776661HA","text":"```test({\n  mode: \"all\",\n  name:\n    \"denops.call() drop arguments after `undefined` (but `null`) for convenience\",\n  fn: async (denops) =\u0026gt; {\n    assertEquals(\n      await denops.call(\"denops#api#id\", 0, 1, 2),\n      [0, 1, 2],\n    );\n    assertEquals(\n      await denops.call(\"denops#api#id\", 0, 1, undefined, 2),\n      [0, 1],\n    );\n    assertEquals(\n      await denops.call(\"denops#api#id\", 0, undefined, 1, 2),\n      [0],\n    );\n    assertEquals(\n      await denops.call(\"denops#api#id\", 0, 1, null, 2),\n      [0, 1, null, 2],\n    );\n    assertEquals(\n      await denops.call(\"denops#api#id\", 0, null, 1, 2),\n      [0, null, 1, 2],\n    );\n  },\n});```","ts":"1626141249.325900","team":"T03C4RC8V","reactions":[{"name":"ultrafastparrot","count":3,"users":["UDDCM376D","U9S4G0LJW","U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Bb65F"}]},{"client_msg_id":"555fdfc0-ef98-47e8-9588-96493a38a336","type":"message","user":"UDDCM376D","text":"おお、対応速い","ts":"1626140791.325600","team":"T03C4RC8V","reactions":[{"name":"muscle","count":1,"users":["U776661HA"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"RmZjQ"}]},{"client_msg_id":"3b838574-7248-4cbc-930e-3530fcfc8ebd","type":"message","user":"U776661HA","text":"1. でいいかな感があります","ts":"1626140500.325300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"u55s"}]},{"client_msg_id":"a435c294-209b-4059-aef3-842723d33fc1","type":"message","user":"U9S4G0LJW","text":"お、これやってもらえるのなら気にしなくてもよさそうですね","ts":"1626140358.324900","team":"T03C4RC8V","replace_origina