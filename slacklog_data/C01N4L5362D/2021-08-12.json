td)\");\n  await mapping.unmap(denops, \"\u0026lt;Plug\u0026gt;(test-denops-std)\", {\n    mode: \"i\",\n  });\n}\n```\n\nClose #57","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/vim-denops/deno-denops-std|vim-denops/deno-denops-std\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png","ts":1628763583}],"team":"T03C4RC8V","reactions":[{"name":"tada","count":4,"users":["U9S4G0LJW","UDDCM376D","UL6CFN8NR","U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"t82"}]},{"client_msg_id":"0e10ba8b-14b2-4e3c-92cd-69a8902b6cc9","type":"message","user":"U9S4G0LJW","text":"あ、feedkeysとbatchでいけるか","ts":"1628774178.182200","thread_ts":"1628773981.182100","parent_user_id":"U9S4G0LJW","team":"T03C4RC8V","reactions":[{"name":"naruhodo","count":1,"users":["U776661HA"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"LbH"}]}]
