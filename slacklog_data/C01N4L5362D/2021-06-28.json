624840146.432600","thread_ts":"1624839732.431100","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"y0US"}]},{"client_msg_id":"a1002a12-ee08-467a-8d54-9473a3d802d1","type":"message","user":"U7JL1UKKL","text":"これです","ts":"1624841266.433600","thread_ts":"1624839732.431100","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"rrXmQ"}]},{"client_msg_id":"29f51794-301d-449e-bd37-e49c49953bb3","type":"message","user":"U7JL1UKKL","text":"\u003chttps://github.com/Shougo/ddc.vim/pull/1|https://github.com/Shougo/ddc.vim/pull/1\u003e","ts":"1624841268.433800","thread_ts":"1624839732.431100","attachments":[{"color":"6f42c1","fallback":"\u003chttps://github.com/Shougo/ddc.vim/pull/1|#1 些細な型修正\u003e","id":1,"title":"\u003chttps://github.com/Shougo/ddc.vim/pull/1|#1 些細な型修正\u003e","text":"deno lintにもdeno test --no-runにもなにも表示されないがなぜかdenoのlintだけ表示されていた  \nたぶん直さなくても動く?\n\nHint: 'await' has no effect on the type of this expression.  \nError: Class 'Source' incorrectly implements class 'BaseSource'. Did you mean to extend 'BaseSource' and inherit its members as a subclass?  \nError: The return type of an async function or method must be the global Promise type. Did you mean to write 'Promise\u0026lt;Candidate[]\u0026gt;'?  \nError: Cannot find name 'stirng'.  \nError: Object is of type 'unknown'.","fields":[{"title":"Comments","value":"4","short":true}],"mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/Shougo/ddc.vim|Shougo/ddc.vim\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png","ts":1624805188}],"parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"9qMhS"}]},{"client_msg_id":"ac15013f-e771-4711-8d4a-998c12afb0b2","type":"message","user":"U776661HA","text":"lsp では `--unstable` が有効じゃなかったとか？","ts":"1624842631.434800","thread_ts":"1624839732.431100","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"qzLY0"}]},{"client_msg_id":"62b3083b-bc0d-4c15-8d60-ade17f721f73","type":"message","user":"U01D44KSY9Z","text":"cocだと `coc-settings.json`  内に\n```{\n  \"deno.unstable\": true\n}```\nって入れればunstableで動くはずですね","ts":"1624844857.439300","thread_ts":"1624839732.431100","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"v/9t"}]},{"client_msg_id":"b306f9c6-71f8-4f8f-95ef-a9eb565bea28","type":"message","user":"U01D44KSY9Z","text":"他のlspクライアントだとlspを起動する時の引数に追加とかになりそう","ts":"1624844902.439500","thread_ts":"1624839732.431100","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"xx="}]},{"client_msg_id":"b6e3cb24-a18f-40df-9fdc-b33ccfd1d105","type":"message","user":"U7JL1UKKL","text":"私はlsp使ってないのでlsp使ってなくても同じ警告でるようにしてほしいところです","ts":"1624845076.439700","thread_ts":"1624839732.431100","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"u3hO"}]},{"client_msg_id":"cdcb38e5-00ca-42f6-9c2c-708fcc61fa6e","type":"message","user":"U776661HA","text":"`--unstable`  な Lint を行うかどうかは Shougo さん次第では？","ts":"1624845397.440000","thread_ts":"1624839732.431100","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"PjfB"}]},{"client_msg_id":"da557dbd-e944-4cd0-86bc-469b360df0d5","type":"message","user":"U776661HA","text":"（`--unstable` が原因かはわからんですが）","ts":"1624845427.440200","thread_ts":"1624839732.431100","edited":{"user":"U776661HA","ts":"1624845433.000000"},"parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4Aqum"}]},{"client_msg_id":"dfac7a02-5f33-4361-a3c1-84b2fa7c529a","type":"message","user":"U7JL1UKKL","text":"ああ、--unstableはセットしていたのでこれが原因ではない木偶ね","ts":"1624845497.440500","thread_ts":"1624839732.431100","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"LcR"}]},{"client_msg_id":"c3803081-a969-408c-bc55-5479421913ca","type":"message","user":"U776661HA","text":"僕の *想像の話* ですが\n\nLint: `--unstable` が有効\nLSP: `--unstable` が無効\n\nという状態で、本来は警告にならないはずのものが LSP でのみ警告になっていた","ts":"1624845573.440700","thread_ts":"1624839732.431100","edited":{"user":"U776661HA","ts":"1624845583.000000"},"parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"mIgLP"}]},{"client_msg_id":"ec4b0391-9c4a-4bb0-a2b6-cf081a0f140c","type":"message","user":"U01D44KSY9Z","text":"警告というかdiagnostic的にはHint扱いですねこれ\nPromiseオブジェクトじゃない関数にawaitかけた時に出るやつか","ts":"1624845662.441000","thread_ts":"1624839732.431100","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+vyqz"}]},{"client_msg_id":"fb4be9cc-b417-44df-b4a8-4292a58c3721","type":"message","user":"U776661HA","text":"なるほど Hint","ts":"1624845725.441200","thread_ts":"1624839732.431100","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"JMqC"}]},{"client_msg_id":"93d7e99e-f03f-43fd-8946-09734406e326","type":"message","user":"U01TQP86UM6","text":"nvimのlspconfigいじらずそのまま使っていてunstableついてないんですど\nそのcmdに\"--unstable\"を追加しinit_options.unstableをtrueに変更してもlspでエラーとヒントが得られます。\n```  default_config = {\n    cmd = {\"deno\", \"lsp\", \"--unstable\"};\n    filetypes = {\"javascript\", \"javascriptreact\", \"javascript.jsx\", \"typescript\", \"typescriptreact\", \"typescript.tsx\"};\n    root_dir = util.root_pattern(\"package.json\", \"tsconfig.json\", \".git\");\n    init_options = {\n      enable = true;\n      lint = false;\n      unstable = true;```\nエラーについては`deno test --unstable --no-run denops/**/*.ts`に`--allow-all`でlspと同じエラーが得られました。\n\nヒント: 'await' has no effect on the type of this expression\n\u003chttps://github.com/denoland/deno/blob/844a1317ec63e5ed5019e36a52dc3e7d3abfab8b/cli/lsp/diagnostics.rs\u003e を見ると\n`DiagnosticSource`は`Deno`, `DenoLint`, `TypeScript`を持ちます\n同ファイル`generate_ts_diagnostics`を見るとdeon内蔵のTS runtimeが吐いているようにみえます\nlintかtestかで同様のことやってくれたらいいんですけど","ts":"1624846024.441400","thread_ts":"1624839732.431100","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"O4xe5"}]},{"client_msg_id":"25d1b0c1-a4d9-4e2b-b36d-20889dfaf392","type":"message","user":"U776661HA","text":"なるほど","ts":"1624846087.441800","thread_ts":"1624839732.431100","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"6/B"}]},{"client_msg_id":"64905a52-3d70-4cb6-a2fc-8a2aa3cfcd9e","type":"message","user":"U776661HA","text":"ヒントとはいえ `deno lint` で検出してほしいですね","ts":"1624846105.442000","thread_ts":"1624839732.431100","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+y9"}]},{"client_msg_id":"79df863e-2495-4732-9c3d-4de11f51d9b8","type":"message","user":"U7JL1UKKL","text":"はい","ts":"1624846145.442200","thread_ts":"1624839732.431100","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"pwxJ"}]},{"client_msg_id":"3e4eab43-45e1-4d15-8015-5b61094a90ab","type":"message","user":"U7JL1UKKL","text":"このあたりdenoの専門家に聞くと分かったりするのかな","ts":"1624846165.442400","thread_ts":"1624839732.431100","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"OMZ+"}]},{"client_msg_id":"d69d60cd-01d2-48c5-afbd-22467d7b2350","type":"message","user":"U776661HA","text":"\u003chttps://github.com/denoland/deno_lint/issues/556\u003e","ts":"1624846246.442600","thread_ts":"1624839732.431100","attachments":[{"color":"36a64f","fallback":"\u003chttps://github.com/denoland/deno_lint/issues/556|#556 missing recommended rules\u003e","id":1,"title":"\u003chttps://github.com/denoland/deno_lint/issues/556|#556 missing recommended rules\u003e","text":"The description says \"Supports recommended set of rules from ESLint and \u003chttps://github.com/typescript-eslint|@typescript-eslint\u003e out of the box with no config.\"  \nIt seems it does implement all the `eslint:recommended` rules, but only some of the `plugin:@typescript-eslint/recommended` rules.  \nFor example, I think the following rules are missing:\n\nawait-thenable, explicit-module-boundary-types, no-floating-promises, no-for-in-array, no-non-null-asserted-optional-chain, no-non-null-assertion, no-unnecessary-type-assertion, no-unsafe-assignment, no-unsafe-call, no-unsafe-member-access, no-unsafe-return, no-var-requires, prefer-regexp-exec, restrict-plus-operands, restrict-template-expressions, triple-slash-reference, unbound-method, no-empty-function, no-implied-eval, and no-unused-vars.\n\nMaybe the description should be changed to say that it implements \"many\" of the typescript-eslint/recommended rules.","fields":[{"title":"Comments","value":"3","short":true}],"mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/denoland/deno_lint|denoland/deno_lint\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png","ts":1607084950}],"parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Ul8WY"}]},{"client_msg_id":"98dcb419-11a9-48ce-b1ac-47ce6322dd80","type":"message","user":"U776661HA","text":"このへんかな","ts":"1624846249.442900","thread_ts":"1624839732.431100","edited":{"user":"U776661HA","ts":"1624846255.000000"},"parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ujVd"}]},{"client_msg_id":"fefedc64-f6e0-494a-a75f-2e265f9edbbd","type":"message","user":"U776661HA","text":"それこそ一時的でもいいので LSP を CI 的に走らせられると便利そう","ts":"1624846339.443200","thread_ts":"1624839732.431100","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"75At"}]},{"client_msg_id":"c8de1482-dba0-4a98-a23b-5e443b987bb6","type":"message","user":"U7JL1UKKL","text":"ほう、","ts":"1624846373.443400","thread_ts":"1624839732.431100","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"m8gO"}]},{"client_msg_id":"d777a5d4-c4d9-415f-a1ca-e55a5f45dcec","type":"message","user":"U7JL1UKKL","text":"それはわかる","ts":"1624846378.443600","thread_ts":"1624839732.431100","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Qmpi"}]},{"client_msg_id":"3ba96ee7-c83b-4c98-9dad-2cc8a98ef7d4","type":"message","user":"U7JL1UKKL","text":"deno lspだとCIで実行できないのも問題やねん","ts":"1624846394.443800","thread_ts":"1624839732.431100","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"q9/"}]},{"client_msg_id":"f8f9251f-ce9f-4025-9d50-588b7913cd8f","type":"message","user":"U776661HA","text":"LSP を CI 的に動かすツールとか無いのかな","ts":"1624846430.444000","thread_ts":"1624839732.431100","parent_user_id":"U7JL1UKKL","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"HXRP"}]},{"client_msg_id":"346b50ca-1a54-4cb2-9741-f7180e6dc222","type":"message","user":"U776661HA","text":"原理的に