n2. The mode string in the echoarea is redrawn when the popup window is displayed in both Vim8 and neovim.\n\nMinimal vimrc\n\n```\nif \u0026amp;compatible\n  set nocompatible\nendif\n\nset runtimepath^=~/work/ddc.vim\nset runtimepath^=~/work/ddc-around\nset runtimepath^=~/work/ddc-matcher_head\nset runtimepath^=~/work/ddc-sorter_rank\nset runtimepath+=~/src/denops.vim\n\nfiletype plugin indent on\nsyntax enable\n\ncall ddc#custom#patch_global('sources', ['around'])\n\"call ddc#custom#patch_global('completionMode', 'inline')\n\"call ddc#custom#patch_global('completionMode', 'manual')\ncall ddc#custom#patch_global('sourceOptions', {\n      \\ '_': {\n      \\   'ignoreCase': v:true,\n      \\   'matchers': ['matcher_head'],\n      \\   'sorters': ['sorter_rank'],\n      \\ },\n      \\ 'around': {'mark': 'A'},\n      \\ })\ncall ddc#enable()\n```","fields":[{"title":"Comments","value":"2","short":true}],"mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/vim-denops/denops.vim|vim-denops/denops.vim\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png","ts":1628059419}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"p6+m8"}]},{"client_msg_id":"9c7598a4-03d2-42bf-97ec-cde0bfce3ac0","type":"message","user":"U7JL1UKKL","text":"報告しました","ts":"1628059724.090700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Aas5"}]},{"client_msg_id":"829dfc68-597d-432d-ac22-94071a028f7e","type":"message","user":"U9S4G0LJW","text":"(再現してるっぽいので大丈夫そうな気もするけど)","ts":"1628052442.090000","thread_ts":"1628052442.090000","reply_count":6,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"kuZqD"}]},{"type":"message","user":"U029JKC88BZ","text":"\u003c@U029JKC88BZ\u003e has joined the channel","ts":"1628052430.089500","subtype":"channel_join","replace_original":false,"delete_ori