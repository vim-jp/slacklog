nitialized) {\n      this.value = this.initializer();\n      this.initialized = true;\n    }\n    return this.value;\n  }\n\n  set(value: T) {\n    this.value = value;\n    this.initialized = true;\n  }\n}\n\n/**\n * Undo point string of Vim\n */\nexport const undoPoint = \"\\x07u\";\n\n```","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/kuuote/denops-skkeleton.vim|kuuote/denops-skkeleton.vim\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0pOK"}]},{"client_msg_id":"4f246727-90a3-4e45-a38d-ca1c1000cbb9","type":"message","user":"U9S4G0LJW","text":"遅延評価しないとモジュールロードのタイミングで死ぬことがある","ts":"1630910803.311800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"RNz"}]},{"client_msg_id":"a4b5c375-395e-4f5e-bd52-08ee9f273374","type":"message","user":"U776661HA","text":"\u003chttps://github.com/vim-denops/denops.vim/pull/111\u003e\n\n動作確認してないので誰かしてくれるとｗ","ts":"1630910789.311200","thread_ts":"1630910789.311200","attachments":[{"color":"36a64f","fallback":"\u003chttps://github.com/vim-denops/denops.vim/pull/111|#111 :+1: Add plugin helper functions\u003e","id":1,"title":"\u003chttps://github.com/vim-denops/denops.vim/pull/111|#111 :+1: Add plugin helper functions\u003e","text":"```\n\t\t\t\t\t\t*denops#plugin#is_loaded()*\ndenops#plugin#is_loaded({name})\n\tReturn 1 if a {name} plugin is already loaded. Otherwise return 0.\n\n\t\t\t\t\t\t*denops#plugin#wait()*\ndenops#plugin#wait({name}[, {options}])\n\tWait synchronously until a {name} plugin is loaded. It returns\n\timmediately when the {name} plugin is already loaded.\n\tThe following attributes are available on {options}.\n\n\t\"interval\"\tInterval in milliseconds for |sleep| in internal loop.\n\t\t\tDefault: |g:denops#plugin#wait_interval|\n\n\t\t\t\t\t\t*denops#plugin#wait_async()*\ndenops#plugin#wait_async({name}, {callback})\n\tWait asynchronously until a {name} plugin is loaded and invoke a\n\t{callback}. It invokes the {callback} immediately when the {name}\n\tplugin is already loaded. If this function is called multiple times\n\tfor same {name} plugin, callbacks registered for the plugin are called\n\tin order of registration.\n\n```","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/vim-denops/denops.vim|vim-denops/denops.vim\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png","ts":1630910768}],"reply_count":2,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=pT"}]},{"client_msg_id":"3ff6594b-e74a-41af-93b0-433044c9e997","type":"message","user":"U9S4G0LJW","text":"特にライブラリ使いたいわけでもなかったので遅延評価するグローバル変数の入れ物を使ってる","ts":"1630910785.310900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"aoUaY"}]},{"client_msg_id":"58C43B16-4F8A-4CFF-86FE-0FC20450BDFF","type":"message","user":"U8996GYBF","text":"Redux、ただのクソでかグローバルステートなんだけど","ts":"1630910776.310300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"tAFb"}]},{"client_msg_id":"409C3B68-A409-4BC5-8992-50CE88B66422","type":"message","user":"U8996GYBF","text":"あぁ、そういう意味ではRedux使って回避してるところはあった","ts":"1630910745.309100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=Q="}]},{"client_msg_id":"8d71f5c0-8378-4392-9dac-c06185f2fa34","type":"message","user":"U9S4G0LJW","text":"内部にOptionalでdenops instance埋め込めるのがアレ(アサーションしてるので下手にテスト書くと落ちる)","ts":"1630910687.308500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"EOkJ"}]},{"client_msg_id":"c9f49842-6ba3-45b6-aa4f-8c4c5facc363","type":"message","user":"U9S4G0LJW","text":"skkeletonはContextバケツリレーしてるけど他の方法は無かったと思ってる","ts":"1630910651.307