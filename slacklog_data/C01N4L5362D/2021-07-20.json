ent_user_id":"UL6CFN8NR","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"bGI"}]},{"client_msg_id":"05684745-7c13-4aaa-aa14-3da15ad1d5c5","type":"message","user":"UL6CFN8NR","text":"PR 出しました。\n\u003chttps://github.com/lambdalisue/deno-unknownutil/pull/2\u003e","ts":"1626784339.155500","thread_ts":"1626780413.152800","attachments":[{"color":"36a64f","fallback":"\u003chttps://github.com/lambdalisue/deno-unknownutil/pull/2|#2 Support for comparing objects with boolean type in `isLike` function\u003e","id":1,"title":"\u003chttps://github.com/lambdalisue/deno-unknownutil/pull/2|#2 Support for comparing objects with boolean type in `isLike` function\u003e","text":"Added the ability to compare objects/arrays containing bool types with isLike.\n\nTo achieve this, I have added two functions and their corresponding tests.\n\n• `isBoolean(x: unknown): x is boolean` : returns true if and only if `x` is boolean\n• `ensureBoolean(x: unknown): asserts x is boolean` : ensures `x` is boolean","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/lambdalisue/deno-unknownutil|lambdalisue/deno-unknownutil\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png","ts":1626784306}],"edited":{"user":"UL6CFN8NR","ts":"1626784349.000000"},"parent_user_id":"UL6CFN8NR","team":"T03C4RC8V","reactions":[{"name":"+1","count":1,"users":["U776661HA"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"mCw"}]}]
