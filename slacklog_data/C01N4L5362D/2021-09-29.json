[{"client_msg_id":"ddb234af-96b0-4b37-b501-dc519d95733c","type":"message","user":"U01G63H9VN3","text":"\u003c@U01D44KSY9Z\u003e \u003chttps://github.com/gamoutatsumi/dps-ghosttext.vim/pull/2\u003e\nghost-textにPRを出しているので何卒... :man-bowing:","ts":"1632923526.470400","attachments":[{"color":"36a64f","fallback":"\u003chttps://github.com/gamoutatsumi/dps-ghosttext.vim/pull/2|#2 Call onClose() on BufDelete instead of BufLeave\u003e","id":1,"title":"\u003chttps://github.com/gamoutatsumi/dps-ghosttext.vim/pull/2|#2 Call onClose() on BufDelete instead of BufLeave\u003e","text":"This PR includes following changes.\n\n• Don't close ghost text buffer on `BufLeave` because this event happens so frequently.  \n    It's inconvenient that users cannot move around buffers to yank text and go to temporary buffers such as denite, telescope and so on.\n• Don't remove autocmd on closing because the autocmd is automatically removed when the buffer is wiped out.  \n    Instead, I added `bufexists()` check to ensure that the buffer to be deleted exists.","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/gamoutatsumi/dps-ghosttext.vim|gamoutatsumi/dps-ghosttext.vim\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png","ts":1632487646}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jL8ag"}]},{"client_msg_id":"687e59b8-75e7-43e4-aa42-e86473d7afb2","type":"message","user":"UDDMEDNNP","text":"\u003chttps://github.com/neovim/neovim/issues/15837\u003e\n再現したのでissue化しました。\noptだとよくてstartだとダメそうです。","ts":"1632914490.469100","thread_ts":"1632841249.464500","subtype":"thread_broadcast","reactions":[{"name":"goodjob","count":4,"users":["U9S4G0LJW","U7JL1UKKL","U776661HA","U013QL1RAPN"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"UtYpp"}],"root":{"client_msg_id":"ff8989b4-ed00-4270-92b3-bbd524978a9a","type":"message","user":"UDDCM376D","text":"NVIM v0