03d4c4cc7bf","type":"message","user":"U776661HA","text":"なので\n\n```nnoremap \u0026lt;Plug\u0026gt;(fern-action-my-super-action) :echo \"Hello human.\"```","ts":"1626879375.181600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"yJT4"}]},{"client_msg_id":"f5c33a79-ce08-474c-9b4b-c8eb7c95e0d9","type":"message","user":"U8R597E9H","text":"個人的には `\u0026lt;Plug\u0026gt;` よりも関数で提供のほうが好みだったりはしますが、一般的には `\u0026lt;Plug\u0026gt;` で提供な気はしますね。","ts":"1626879374.181500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hsY"}]},{"client_msg_id":"6e3ba970-4001-4985-ba5c-a5ac248024d6","type":"message","user":"UDDCM376D","text":":naruhodo:","ts":"1626879354.180700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5BO7l"}]},{"client_msg_id":"42010550-4c88-4021-93ce-6faa1bf3ca15","type":"message","user":"U776661HA","text":"action とは `\u0026lt;Plug\u0026gt;(fern-action-xxxxx)` というマッピングの総称です","ts":"1626879341.180200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4uw0"}]},{"client_msg_id":"0c761c74-874f-4e74-af10-c480a085066c","type":"message","user":"U776661HA","text":"できますよー","ts":"1626879318.179500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"vSOU+"}]},{"client_msg_id":"19c50cfa-b703-4aa5-8941-b1e8167f1305","type":"message","user":"U8R597E9H","text":"```autocmd FileType docker-containers call s:on_docker_containers()\nfunction! s:on_docker_containers() abort\n  nnoremap \u0026lt;buffer\u0026gt;\u0026lt;expr\u0026gt; T docker#command('docker inspect {0}')\nendfunction```\n自分ならこういう感じにするかもしれません。先程も書いてはいますが、一般的にはこうしますよ〜くらいの話なので、ゴリラさんの方式もありっちゃありだとは思います。","ts":"1626879311.179300","edited":{"user":"U8R597E9H","ts":"1626879326.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jdfA"}]},{"client_msg_id":"74f7db0e-72d7-48ad-85ac-b18fb51e5817","type":"message","user":"UDDCM376D","text":"fernってaction拡張できるんですか？","ts":"1626879308.179200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+AF"}]},{"client_msg_id":"fc6d18ad-c524-4056-9b13-def344dae930","type":"message","user":"U776661HA","text":"（それ action がいいのでは）","ts":"1626879286.178700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Z=sxC"}]},{"client_msg_id":"fc1b9ddb-6f55-4b1f-b1dc-f313987e3391","type":"message","user":"UDDCM376D","text":"fernをもとに例えると、actionをユーザが好きに定義できて、そのactionを実行できる\nというようなイメージです","ts":"1626879272.178300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"xAO"}]},{"client_msg_id":"65be4b44-f151-4f8a-ae39-0e0ac8daf5a3","type":"message","user":"UDDCM376D","text":"目的は「プラグイン側を拡張せず、ユーザが自由にconfigで機能を拡張できる」って考えています","ts":"1626879196.177100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Lz2"}]},{"client_msg_id":"0ba580dd-a1f6-40fa-ab4d-6a8b1a3a2d89","type":"message","user":"UDDCM376D","text":"```\u0026lt;Plug\u0026gt;(xxx)```\n↑こういうのはデフォルトで用意しています\nただ、docker cliのすべてのコマンドをdenops-docker.vimで提供したくない → ユーザが自由に、特定のコンテナに対して定義したコマンドを実行できるようにすれば、自由度が上がるし、カバーできる\nというふうに考えた結果、バッファに対してユーザ定義のキーマップを提供する機能を用意するのが良いかなと思った次第です","ts":"1626879127.176100","edited":{"user":"UDDCM376D","ts":"1626879142.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+9G"}]},{"client_msg_id":"18712d61-3831-40a5-8a4f-d72ab913c262","type":"message","user":"U8R597E9H","text":"デフォルトキーマッピングを定義している。はよくある気がします。\n例えば、fern とかでもカスタムする場合は、ユーザに autocmd でキーマッピングを追加/上書きさせる。という形になっています。\n\u003chttps://github.com/lambdalisue/fern.vim#customize\u003e","ts":"1626878919.172900","attachments":[{"color":"24292f","fallback":"lambdalisue/fern.vim","id":1,"title":"lambdalisue/fern.vim","text":":herb: General purpose asynchronous tree viewer written in Pure Vim script","fields":[{"title":"Stars","value":"654","short":true},{"title":"Language","value":"Vim script","short":true}],"blocks":null}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hkXyZ"}]},{"client_msg_id":"1316373b-f8d2-4eb8-9d71-c9a75fb8afe5","type":"message","user":"UDDCM376D","text":"そういうニーズ、普通にないでしょうか","ts":"1626878891.172500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"QFe"}]},{"client_msg_id":"79fc2558-8368-44ec-a26a-407410e94e9c","type":"message","user":"UDDCM376D","text":":naruhodo:\nプラグインが提供しているバッファに対して、ユーザ定義のキーマップを適用するのは普通によくあるイメージでした","ts":"1626878847.171600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"KHfa="}]},{"client_msg_id":"dc8f5c21-658d-4a22-9ae9-ec53e5432631","type":"message","user":"U8R597E9H","text":"「特定のバッファにキーマッピングを自動で設定してあげる機能」というのがあまり一般的ではないんですよね。（ただ、そういうのがあってもいいとは思いますが、ただ一般的じゃないだけではあるので）","ts":"1626878786.171000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"dgZ28"}]},{"client_msg_id":"08f7ef85-9d60-4cc2-a612-d334c7cb6856","type":"message","user":"UDDCM376D","text":"ft or bufname、どちらが良いでしょうか","ts":"1626878757.170400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jMt"}]},{"client_msg_id":"1f4cb599-c9d8-4ceb-b230-55da6928966d","type":"message","user":"UDDCM376D","text":"```    config.customCommand.forEach((config) =\u0026gt; {\n      helper.define(\n        \"BufReadCmd\",\n        config.buffer,\n        `${config.map.mode} \u0026lt;buffer\u0026gt; \u0026lt;silent\u0026gt; ${config.map.rhs} :call denops#notify(\"${denops.name}\", \"executeCustomCommand\", [\"${config.buffer}\", \"${config.command}\"])\u0026lt;CR\u0026gt;`,\n      );\n    });```","ts":"1626878732.169600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"dgL4"}]},{"client_msg_id":"13818040-ee2e-4d45-a4bf-323cc1fdb2ed","type":"message","user":"UDDCM376D","text":"キーマップの適用に関しては、ftではなくバッファ名を指定していますね","ts":"1626878715.169300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hI3"}]},{"client_msg_id":"b9be5cab-b376-4bed-803d-06470e96fb6b","type":"message","user":"U8R597E9H","text":"```autocmd FileType docker-containers call s:on_docker_containers()\nfunction! s:on_docker_containers() abort\n  nnoremap \u0026lt;buffer\u0026gt; T …\nendfunction```","ts":"1626878680.168800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"h5=5"}]},{"client_msg_id":"ba1b2968-c553-47a6-9e22-37059981e7e1","type":"message","user":"U8R597E9H","text":"buffer に filetype を与えて、ユーザ側が autocmd でキーマッピングをバッファローカルに設定するのが一般的だと思います。","ts":"1626878600.167200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Mcje"}]},{"client_msg_id":"48e94f6a-2f92-4a34-9b7d-86824887d474","type":"message","user":"UDDCM376D","text":"↑のconfigの場合、 コンテナ一覧で `T` を押すと `docker inspect 70586698897d`が実行されるイメージです","ts":"1626878556.166300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"43GOJ"}]},{"client_msg_id":"25ee1a5e-8206-4ce2-b2b7-007e82e022c9","type":"message","user":"UDDCM376D","text":"ちょっとプラグインのカスタムについてアドバイスを頂きたいです\ndenops-docker.vim でコマンドをユーザでカスタムできる機能を導入しようと思っています\nたとえば、container一覧のバッファで、コンテナに対してconfigで定義したマッピングで、定義したコマンドを実行できるようにしたら便利かなと思って\n```ID           NAME                     IMAGE                   STATUS                  CREATED             PORTS                                               \n70586698897d sad_jemison              golang:1.14.4           Up 8 hours              2021/07/21 15:17:42 0.0.0.0:8084-\u0026gt;80/tcp, :::8084-\u0026gt;80/tcp               ```\n試しにconfigはこういう形にしてみたけど、もっとこういう形にすると便利だよ、とかありますか？\n```let g:docker#config = {\n  \\ 'customCommand': [\n    \\ {\n      \\ 'buffer': '\u003cdocker://containers\u003e',\n      \\ 'map': {\n        \\ 'mode': 'nnoremap',\n        \\ 'rhs': 'T',\n      \\ },\n      \\ 'command': 'docker inspect {0}', \" 0番目はID、1番目は NAME…\n    \\ },\n  \\ ]\n\\ }```\n","ts":"1626878252.165500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"d9+Yo"}]},{"type":"message","user":"U012MBD7MFZ","text":"\u003c@U012MBD7MFZ\u003e has joined the channel","ts":"1626857558.160500","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null},{"client_msg_id":"D5274478-118D-45D0-991D-CAF9ED1FFE57","type":"message","user":"UDDCM376D","text":":goodpoem: ","ts":"1626825777.160300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"llS"}]},{"type":"message","user":"U776661HA","text":"\u003chttps://star-history.t9t.io/#vim-denops/denops.vim\u003e\n\nv1.0.0 リリースでニョキッと伸びましたね","ts":"1626798257.159800","files":[{"id":"F028N7QJ0EP","created":1626798220,"timestamp":1626798220,"name":"CleanShot 2021-07-21 at 01.23.30.png","title":"CleanShot 2021-07-21 at 01.23.30.png","mimetype":"image/png","image_exif_rotation":0,"filetype":"png","pretty_type":"PNG","user":"U776661HA","mode":"hosted","editable":false,"is_external":false,"external_type":"","size":52750,"url":"","url_download":"","url_private":"https://files.slack.com/files-pri/T03C4RC8V-F028N7QJ0EP/cleanshot_2021-07-21_at_01.23.30.png","url_private_download":"https://files.slack.com/files-pri/T03C4RC8V-F028N7QJ0EP/download/cleanshot_2021-07-21_at_01.23.30.png","original_h":696,"original_w":975,"thumb_64":"https://files.slack.com/f