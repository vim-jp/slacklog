\u003chttps://deno.land/x/denops_core@v2.0.3/mod.ts\u003e\"),\n    import(\"\u003chttps://deno.land/x/denops_core@v2.0.3/mod.ts\u003e\"),\n    import(\"\u003chttps://deno.land/x/denops_core@v2.0.3/mod.ts\u003e\"),\n    import(\"\u003chttps://deno.land/x/denops_core@v2.0.3/mod.ts\u003e\"),\n    import(\"\u003chttps://deno.land/x/denops_core@v2.0.3/mod.ts\u003e\"),\n    import(\"\u003chttps://deno.land/x/denops_core@v2.0.3/mod.ts\u003e\"),\n    import(\"\u003chttps://deno.land/x/denops_core@v2.0.3/mod.ts\u003e\"),\n    import(\"\u003chttps://deno.land/x/denops_core@v2.0.3/mod.ts\u003e\"),\n  ]);\n}\nawait main();\n```\n\n`$ cp test.ts test.ts2`\n\n`test2.ts`\n\n```\nimport { toFileUrl } from \"\u003chttps://deno.land/std@0.115.1/path/mod.ts\u003e\";\n\nasync function main() {\n  const t = performance.now();\n  await Promise.all([\n    import(toFileUrl(Deno.cwd() + \"/test.ts\").href),\n    import(toFileUrl(Deno.cwd() + \"/test.ts2\").href),\n  ]);\n  console.log(performance.now() - t);\n}\nawait main();\n```\n\n```\n% deno --version\ndeno 1.16.2 (release, x86_64-unknown-linux-gnu)\nv8 9.7.106.2\ntypescript 4.4.2\n% deno run -A --no-check ./test2.ts\n151.510647\n[~/work]\n% deno run -A --no-check ./test2.ts\n154.57850399999998\n[~/work]\n% deno run -A --no-check ./test2.ts\n153.059971\n\n```\n\nAfter #12604, remote URL dynamic loading is very fast! But it is not same with dynamic local file import :-(  \nSimple dynamic import takes almost 80ms and it seems not cached. It is really slow for me.  \nBecause dynamic remote import is less than 2.0ms.","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/denoland/deno|denoland/deno\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png","ts":1637212997}],"team":"T03C4RC8V","reactions":[{"name":"+1","count":2,"users":["U9S4G0LJW","U776661HA"]},{"name":"goodjob","count":1,"users":["U0238G3KV8D"]},{"name":"eyes","count":1,"users":["U013QL1RAPN"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"tsu5d"}]},{"client_msg_id":"7621a891-c3fa-4aba-b39a-51de8be3590f","type":"message","user":"U7JL1UKKL","text":"そして一度実行すると次はキャッシュされますが次の実行時にはキャッシュが無効になるのでまた時間がかかります","ts":"1637212496.247100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=A="}]},{"client_msg_id":"04613bf7-183f-430e-a110-c161516d5b2c","type":"message","user":"U7JL1UKKL","text":"ddc sourceだと150から200ミリ秒はかかります","ts":"1637212460.246100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fITz"}]},{"client_msg_id":"a76f799b-9f3a-49c9-beb6-a097925d9ac3","type":"message","user":"U7JL1UKKL","text":"確認したところ、ローカルファイルのdynamic importは最低80ミリ秒","ts":"1637212440.245500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"CiR7"}]},{"client_msg_id":"61f5aace-26ae-49c0-af40-dd439d524922","type":"message","user":"U01D44KSY9Z","text":"TS側で弄り回してどうこうするよりはたぶんシンプル","ts":"1637203837.244700","team":"T03C4RC8V","reactions":[{"name":"sorena","count":1,"users":["U776661HA"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"rNK"}]},{"client_msg_id":"09afe670-f295-4ccf-ba29-aa1150d07662","type":"message","user":"U01D44KSY9Z","text":"まあそれが一番ですよね\nうまく行けば次のpatch versionで入れてもらえるかもしれない","ts":"1637203807.244200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"NmCES"}]},{"client_msg_id":"b4eec9bc-4c06-496d-8b0f-061a79405e41","type":"message","user":"U776661HA","text":"関連 Issue としてあげると対応されるかも？","ts":"1637203743.243600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ChL"}]},{"client_msg_id":"890f1efd-5dec-4a3e-bc14-28b64e1f78f0","type":"message","user":"U7JL1UKKL","text":"補完時間のほとんどがsource filterのロード時間なので泣ける","ts":"1637202509.242800","team":"T03C4RC8V",