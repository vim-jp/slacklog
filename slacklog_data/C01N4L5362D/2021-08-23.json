io from \"\u003chttps://deno.land/std@0.100.0/io/mod.ts\u003e\";\nimport { default as JSONparser} from \"\u003chttps://deno.land/x/streamparser_json@v0.0.5/jsonparse.ts\u003e\";\n\nconst parser = new JSONparser();\nparser.onValue = (value, _a, _b, stack) =\u0026gt; {\n  if (stack.length) {\n    return;\n  }\n  console.log(value);\n};\nfor await (const chunk of io.iter(Deno.stdin)) {\n  console.log(chunk);\n  parser.write(chunk);\n}```","ts":"1629653932.032500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"r=Z"}]},{"client_msg_id":"e8631819-9311-4ae4-91ae-9f7d3b2a9f1c","type":"message","user":"U776661HA","text":"使ってなさそう...","ts":"1629653327.032100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"mIPwZ"}]},{"client_msg_id":"555b9b82-2015-4105-9bda-af10822321db","type":"message","user":"U776661HA","text":"\u003chttps://deno.land/x/streamparser_json@v0.0.5\u003e","ts":"1629653140.031900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"DsDh9"}]},{"client_msg_id":"ac921b4b-7191-4dff-be42-24c7502f0a02","type":"message","user":"U776661HA","text":"内部で使ってるのかな","ts":"1629653105.031700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"gM6n5"}]},{"client_msg_id":"f81c5eac-aec6-4967-a720-8b1f0a0292f6","type":"message","user":"U776661HA","text":"さて、ただ `io.readLine` を使わない実装にしても起こったんだよな...","ts":"1629653081.031500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"DPMOT"}]},{"client_msg_id":"a593fdd1-07dc-4ec6-a2d7-4d34230e777c","type":"message","user":"U776661HA","text":"\u003chttps://github.com/denoland/deno_std/issues/1150\u003e","ts":"1629652737.031100","attachments":[{"color":"36a64f","fallback":"\u003chttps://github.com/denoland/deno_std/issues/1150|#1150 `io.readLines` yield incomplete lines\u003e","id":1,"title":"\u003chttps://github.com/denoland/deno_std/issues/1150|#1150 `io.readLines` yield incomplete lines\u003e","text":"*Describe the bug*\n\nIt seems `io.readLines` yield incomplete lines in some cases.\n\n*To Reproduce*\n\nAdd `gen.ts` as\n\n```\nimport { parse } from \"\u003chttps://deno.land/std@0.105.0/flags/mod.ts\u003e\";\n\nconst opts = parse(Deno.args)\nconst size = opts.size || 128;\nconst v = \"x\".repeat(1024 * size);\nconst b = new TextEncoder().encode(`[\"${v}\"]`);\n\nawait Deno.stdout.write(b);\nconsole.log(\"\");\n```\n\nAnd add `test.ts` as\n\n```\nimport * as io from \"\u003chttps://deno.land/std@0.100.0/io/mod.ts\u003e\";\n\nfor await (const line of io.readLines(Deno.stdin)) {\n  console.log(`Recv ${line.length}`);\n  if (!line) {\n    continue;\n  }\n  JSON.parse(line);\n}\n```\n\nWhen the buffer size is small enough, it process successfully.\n\n```\ndeno run gen.ts --size=1 | deno run test.ts\nCheck file:///Users/alisue/ghq/github.com/lambdalisue/deno-io-test/gen.ts\nCheck file:///Users/alisue/ghq/github.com/lambdalisue/deno-io-test/test.ts\nRecv 1028\nRecv 0\n\n```\n\nBut when the buffer size is big, `io.readLines` yield incomplete lines like\n\n```\ndeno run gen.ts --size=100 | deno run test.ts\nCheck file:///Users/alisue/ghq/github.com/lambdalisue/deno-io-test/gen.ts\nCheck file:///Users/alisue/ghq/github.com/lambdalisue/deno-io-test/test.ts\nRecv 16384\nerror: Uncaught (in promise) SyntaxError: Unexpected end of JSON input\n  JSON.parse(line);\n       ^\n    at JSON.parse (\u0026lt;anonymous\u0026gt;)\n    at file:///Users/alisue/ghq/github.com/lambdalisue/deno-io-test/test.ts:8:8\n\n```\n\n*Expected behavior*\n\n`io.readLines` waits for a complete line.\n\n*Desktop (please complete the following information):*\n\n• OS: macOS 11.5\n• Version\n\n```\ndeno 1.13.0 (release, x86_64-apple-darwin)\nv8 9.3.345.11\ntypescript 4.3.5\n\n```\n\n*Additional context* Add any other context about the problem here.","fields":[{"title":"Labels","value":"bug, needs triage","short":true}],"mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/denoland/deno_std|denoland/deno_std\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png","ts":1629652729}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Dv0"}]},{"client_msg_id":"26c934ca-8986-48fd-9b83-2c9dc95d9608","type":"message","user":"U776661HA","text":"再現できました deno 側に報告します","ts":"1629652581.030900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"pH6L8"}]},{"client_msg_id":"b5a95095-7404-4ec3-bf46-67ce84ab2e7a","type":"message","user":"U776661HA","text":"なるほど、そっちですか...","ts":"1629651115.030500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"I=5"}]}]
