...args);\n      } catch (e) {\n        // NOTE:\n        // Vim/Neovim does not handle JavaScript Error instance thus use string instead\n        throw `${e.stack ?? e.toString()}`;\n      }\n    }```","ts":"1628548967.041700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"8CFWH"}]},{"client_msg_id":"d0bfd191-fec0-4639-a2a4-b23db051f28a","type":"message","user":"U776661HA","text":"\u003chttps://github.com/vim-denops/denops.vim/pull/92\u003e\n\nCIがなかなか通らない（ビルド失敗とかダウンロード失敗とか...","ts":"1628529570.037400","attachments":[{"color":"36a64f","fallback":"\u003chttps://github.com/vim-denops/denops.vim/pull/92|#92 Fix behavior of `denops.call()` when called concurrently on Vim prior to v8.2.3080\u003e","id":1,"title":"\u003chttps://github.com/vim-denops/denops.vim/pull/92|#92 Fix behavior of `denops.call()` when called concurrently on Vim prior to v8.2.3080\u003e","text":"SSIA","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/vim-denops/denops.vim|vim-denops/denops.vim\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png","ts":1628528829}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"G+x="}]},{"client_msg_id":"c7373958-7e74-4c02-b937-116d8011dbbf","type":"message","user":"U776661HA","text":"deno-async って形で Lock とか作っといてよかった...","ts":"1628528707.036800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Jng0"}]},{"client_msg_id":"aa282322-46c6-4963-8457-5b0c5af73ff5","type":"message","user":"U776661HA","text":"Lock 取ったら治った","ts":"1628528237.036500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+GA"}]},{"client_msg_id":"2147c695-7168-4deb-a4bd-075fc03e61ca","type":"message","user":"U776661HA","text":"ビンゴっぽい","ts":"1628528233.036300","team":"T03C4RC8V","replace_original":false,"delete_ori