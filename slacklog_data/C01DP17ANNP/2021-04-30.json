.com/thinca/vim-ref/blob/c452d2ce084a972c5af03827519aada799fd0b06/autoload/ref.vim#L437"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"O+s4"}]},{"client_msg_id":"816b12ce-d06a-4ed7-8026-6253dab70dda","type":"message","user":"UGXMRNBUM","text":"マッチした部分文字列を取るには結局matchstrposかなんかで取り直すよりほかなさそうだし","ts":"1619739419.017500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"MQ8"}]},{"client_msg_id":"ef2cb27e-f6a8-400d-a256-b4f1c78f5571","type":"message","user":"UGXMRNBUM","text":"汎用的にはいかんですね","ts":"1619739396.016900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"PV4y"}]},{"client_msg_id":"b2f7dd13-0d31-410a-8a40-a2ab8da59243","type":"message","user":"UAZ33BKV2","text":"あと、都合 abc を探すに\na | c みたいなルールになっちゃうから abc | abc でもヒット、みたいなことになるので、うまく2段目でexact だけどpatternなマッチさせないと誤判定はしそう","ts":"1619739349.016000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"chXeJ"}]},{"client_msg_id":"39c2e5ac-b4de-47f4-9925-210a1ed163eb","type":"message","user":"UGXMRNBUM","text":"Markdownのimage（htmlタグはどうでもいい）を抽出したいケースもあるので、そこで適用できそう","ts":"1619739229.014100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"pIhTo"}]},{"client_msg_id":"e2a1da14-87df-46bb-b76a-b73d60924578","type":"message","user":"UGXMRNBUM","text":"都合のいいことに定義できるので、ありかもしれないですね","ts":"1619739203.013500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"QRJw"}]},{"client_msg_id":"1585af03-d510-4fa6-87c3-bded723fc59b","type":"message","user":"UAZ33BKV2","text":"まあ、期待するパターンに開始マーカーや終了マーカーになるものが定義できるかは場合によるだろうから、汎用じゃないですけど...","ts":"1619739148.013000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5PO"}]},{"client_msg_id":"2bf25455-29ed-4239-9f77-d172a1673aaf","type":"message","user":"UGXMRNBUM","text":"searchpair路線","ts":"1619738998.012400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5l6YL"}]},{"client_msg_id":"9013b351-5ee7-4e0c-a7cd-029375ac22f6","type":"message","user":"UGXMRNBUM","text":"なるほど","ts":"1619738985.011800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Jj7"}]},{"client_msg_id":"c72a47c9-ecbd-4c51-ab90-5e1965abdc35","type":"message","user":"UAZ33BKV2","text":"あくまでバッファがあって意味があるから、まず\n開始マーカー カーソル 終了マーカー でヒットするか見る\nヒットしたら期待のパターンにマッチするか見る\nとする?","ts":"1619738972.011600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Oe9xg"}]},{"client_msg_id":"10a241a5-ca18-4a84-ac73-5ff1e5d0f568","type":"message","user":"UGXMRNBUM","text":"あーでもこれ `search()` では機能しないのか","ts":"1619738910.010400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ZD4y"}]},{"client_msg_id":"8e1bf41f-49b1-423a-8684-cdbfdb0ba430","type":"message","user":"UGXMRNBUM","text":"まさにそれですね…","ts":"1619738879.009700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"VlK3"}]},{"client_msg_id":"62b84e80-8ddf-49ee-bad7-d7f72b7f5127","type":"message","user":"UAZ33BKV2","text":"カーソル以降か以前は取れそうだけど、includeカーソルなpattern作るのが死ぬほど難しそうだな","ts":"1619738829.009200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"XyNk"}]},{"type":"message","user":"UPZHKAM7W","text":"```\n                                                */\\%#* *cursor-position*\n\\%#     カーソルの位置にマッチします。ウィンドウに表示されているバッファ内で\n        マッチングする場合のみ機能します。\n        警告: パターンが使われた後で、カーソルを移動した場合、マッチの結果は正\n        確ではなくなってしまいます。マッチの結果は自動的に更新されません。これ\n        は特に、構文強調と 'hlsearch' に関係します。\n        カーソルが移動しても、表示は自動的に更新されません。表示が更新されるの\n        は、行を変更したため行全体が更新されたときや、|CTRL-L| コマンドを使っ\n        てスクリーン全体を更新したときです。カーソル位置の単語を強調表示するに\n        は次のようにします:\n```","ts":"1619738794.008500","bot_id":"BPM858KEE","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":null},{"client_msg_id":"509eab28-e231-439f-843f-cf45857e1358","type":"message","user":"UAZ33BKV2","text":":h /\\%#","ts":"1619738794.008400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zF6p"}]},{"client_msg_id":"CA72D53E-F9A6-4A1D-9D14-804EDDE0EB76","type":"message","user":"UL6CFN8NR","text":"含むかどうかの判定に使えるかなあ","ts":"1619738563.008000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ywe"}]},{"client_msg_id":"4f9f6e70-7d7c-4fb3-b4ac-c6c29911a723","type":"message","user":"UAZ33BKV2","text":"えーっと `abcdef|ghfgfg` で fg で検索してヒットしたとき、カーソル位置がある場合だけヒットさせたい?","ts":"1619738558.007800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"TXkJ3"}]},{"client_msg_id":"92CEDD76-02B1-45B2-93BA-9E2AE90372C4","type":"message","user":"UL6CFN8NR","text":"カーソル位置を表す正規表現はありますけどねー","ts":"1619738535.007000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"X2Sd"}]},{"client_msg_id":"6d511617-5156-4b46-adc1-4de653d28910","type":"message","user":"UGXMRNBUM","text":"\u003c#CJMV3MSLR|question\u003e で別の質問が進行中なのでこちらで。\n\nvimscriptで、特定の正規表現にマッチするテキストとその位置を\n*マッチの中にカーソル位置を含む* という条件の元で抽出するのってどうすればいいでしょう？\nsearchposで探って、matchlistして、マッチの位置と長さでカーソル位置がその中に収まるかチェックする、っていう泥臭い方法しかないですかね…？","ts":"1619737179.005700","edited":{"user":"UGXMRNBUM","ts":"1619737207.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Kp="}]}]
