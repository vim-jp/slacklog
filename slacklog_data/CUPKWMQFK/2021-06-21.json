   \\'first': min([\n                                \\col('v')-1,\n                                \\col('.')-1\n                                \\]),\n                    \\'last' : max([\n                                \\col('v')-2+len_of_char_of_v,\n                                \\col('.')-2+len_of_char_of_dot\n                                \\])\n                    \\}\n        let s:visual_match_id = matchadd('Search', getline('.')[selected_column_idx['first']:selected_column_idx['last']])\n    endif\nendfunction```","ts":"1624280720.112900","edited":{"user":"U025UTETFDJ","ts":"1624285526.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"GW8"}]},{"client_msg_id":"7b0b8733-a54f-446d-895b-84058d36eccf","type":"message","user":"U025UTETFDJ","text":"visualモードで選択した領域を即座にハイライト検索したいんですけど、そういう機能ってあるんですかね？（inc-hlsearchのvisualモード版みたいなの）","ts":"1624280709.112600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"OLUMQ"}]},{"type":"message","user":"U025UTETFDJ","text":"\u003c@U025UTETFDJ\u003e has joined the channel","ts":"1624275967.111500","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null}]
