/favicon-neutral.png","ts":1634246036}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"yUq"}]},{"client_msg_id":"53a7d450-b306-4132-86b9-f569b013d736","type":"message","user":"U03C6TEAZ","text":"なんで最初からこうじゃなかったんや、と思えるほどに。。。","ts":"1634647623.190800","team":"T03C4RC8V","reactions":[{"name":"doushite-mattn","count":1,"users":["U01H161HVPS"]},{"name":"wakaru","count":1,"users":["U01H161HVPS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hw8"}]},{"client_msg_id":"fe39af66-a89c-4cd6-9133-20eb1ece3bf9","type":"message","user":"U01H161HVPS","text":"最近 mode 関連アツいですよね","ts":"1634647601.190200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"YF/lQ"}]},{"client_msg_id":"c6eb42ce-c633-4038-8460-475e6c0575cc","type":"message","user":"U03C6TEAZ","text":"mode() のやつとかプラグインで使ったらめっちゃ便利なんだよなぁ。","ts":"1634647131.189800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ERb"}]},{"client_msg_id":"3b004114-8bcc-4ff6-bc26-156b20c1d108","type":"message","user":"U9S4G0LJW","text":"ネコ","ts":"1634647013.188800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"9mK"}]},{"client_msg_id":"e462202d-a3a6-455b-abf8-0186dcd2e58d","type":"message","user":"U7JL1UKKL","text":"半端に使ってるneco-vimで問題になっておりそろそろ整理する","ts":"1634646992.188600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"6yURb"}]},{"client_msg_id":"9e897071-e5f6-44cd-ba23-c02f9d244be8","type":"message","user":"U7JL1UKKL","text":"古いプラグインが問題なのよな、そろそろ古いVim切り捨てたいんだけど。","ts":"1634646967.187800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"1tEL6"}]},{"client_msg_id":"8f71a981-4fcb-486f-bd8e-e4935141b8a4","type":"message","user":"U7JL1UKK