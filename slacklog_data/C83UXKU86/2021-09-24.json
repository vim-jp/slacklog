uce*  \nDetailed steps to reproduce the behavior:\n\n1. Run `vim --clean` (or `gvim --clean`, etc.)\n2. Execute following Vim script\n\n```\ncall setreg('=', '1+1')\nif 0\n  put =1\nendif\necho string(getreg('=', 1))\n```\n\n3. Displays `''`\n\n*Expected behavior*  \nDisplays `'1+1'`","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/vim/vim|vim/vim\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png","ts":1632422742}],"team":"T03C4RC8V","reactions":[{"name":"erai","count":3,"users":["U03C71D7H","UEACRCY0Z","UD73ZNZAP"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"xVc"}]},{"client_msg_id":"baa5d95e-70f4-4e0a-9031-167ea8879e26","type":"message","user":"U03C71D7H","text":":gobold:","ts":"1632422299.081400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"REX"}]},{"client_msg_id":"d32b40af-e0e5-4789-9479-34b20253dcce","type":"message","user":"U9S4G0LJW","text":"Test_not_break_expression_registerで行く","ts":"1632422286.081200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"49NA"}]},{"client_msg_id":"930473f0-b8b6-4a97-bd0c-5ea6af00538e","type":"message","user":"U9S4G0LJW","text":"長さ","ts":"1632422224.080700","files":[{"id":"F02FUGESB3K","created":1632422220,"timestamp":1632422220,"name":"2021-09-24_03-37.png","title":"2021-09-24_03-37.png","mimetype":"image/png","image_exif_rotation":0,"filetype":"png","pretty_type":"PNG","user":"U9S4G0LJW","mode":"hosted","editable":false,"is_external":false,"external_type":"","size":44281,"url":"","url_download":"","url_private":"https://files.slack.com/files-pri/T03C4RC8V-F02FUGESB3K/2021-09-24_03-37.png","url_private_download":"https://files.slack.com/files-pri/T03C4RC8V-F02FUGESB3K/download/2021-09-24_03-37.png","original_h":58,"original_w":612,"thumb_64":"https://files.slack.com/files-tmb/T03C4RC8V-F02FUGESB3K-e9e2f230