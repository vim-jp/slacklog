les-tmb/T03C4RC8V-F02FR4M181X-fb6cec5709/image_from_ios_720.jpg","thumb_720_w":720,"thumb_720_h":540,"thumb_960":"https://files.slack.com/files-tmb/T03C4RC8V-F02FR4M181X-fb6cec5709/image_from_ios_960.jpg","thumb_960_w":960,"thumb_960_h":720,"thumb_1024":"https://files.slack.com/files-tmb/T03C4RC8V-F02FR4M181X-fb6cec5709/image_from_ios_1024.jpg","thumb_1024_w":1024,"thumb_1024_h":768,"permalink":"https://vim-jp.slack.com/files/UFHQ7TNT0/F02FR4M181X/image_from_ios.jpg","permalink_public":"https://slack-files.com/T03C4RC8V-F02FR4M181X-b6d9cf85e5","edit_link":"","preview":"","preview_highlight":"","lines":0,"lines_more":0,"is_public":true,"public_url_shared":false,"channels":null,"groups":null,"ims":null,"initial_comment":{},"comments_count":0,"num_stars":0,"is_starred":false,"shares":{"public":null,"private":null},"display_as_bot":false,"has_rich_preview":false,"thumb_800":"https://files.slack.com/files-tmb/T03C4RC8V-F02FR4M181X-fb6cec5709/image_from_ios_800.jpg","thumb_800_h":600,"thumb_800_w":800,"thumb_tiny":"AwAkADCtBZtJ8x4T1Peri28SYGCfc1O3IHNM7Y60rjECLzhV/Kgxxk4ZB+ApwIzik780gIZbQdYjyOx61Es8iHDfNj161bB54ps8Qm5Xhx+tMQW774sHkjinkHrj8qp2821+Rj1FXhhhweDQxkbdKdnjrigjsKQAlaQB/DxzR9RQOnrQzKFLOcKOtAFKVQG4qVHZGAB4PamTfeNL/Gv4UxF0c9aABg44oWlHQ0MYyT5ImYDJAzzWaZGnbdIc+3YVpT/8e7/SsuLpQI//2Q==","username":""}],"reactions":[{"name":"goodpoem","count":2,"users":["U022XK5866Q","U843L486L"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"esR"}]},{"client_msg_id":"32f3aebd-48f8-4f59-9bce-0ca20015747c","type":"message","user":"U03C4RC8X","text":"つまり、平均すると2.7年ごとに、50年に一度の出来またはそれよりも良いものができる、ということがわかる。","ts":"1632356354.161500","thread_ts":"1632356354.161500","reply_count":1,"team":"T03C4RC8V","reactions":[{"name":"fuita","count":2,"users":["UP6PA1UBE","UD1FQV38V"]},{"name":"warau","count":1,"users":["UGHD6GP16"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"6gkY"}]},{"client_msg_id":"e45c4c1a-ecfb-436f-ab49-296365fce861","type":"message","user":"U03C4RC8X","text":"50年に一度以上の出来になったのは、上記16年のうち2003, 2005, 2009, 2010, 2011, 2015","ts":"1632356305.160700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"oN8lp"}]},{"client_msg_id":"7e3136e4-9d86-4103-97b0-ed4120dab5f7","type":"message","user":"U03C4RC8X","text":"--\n2000年「今世紀最後の新酒ワインは色鮮やか、甘みがある味」\n2001年「ここ10年で最もいい出来栄え」\n2002年「過去10年で最高と言われた01年を上回る出来栄えで1995年以来の出来」\n2003年「110年ぶりの当たり年」\n2004年「香りが強く中々の出来栄え」\n2005年「タフな03年とはまた違い、本来の軽さを備え、これぞ『ザ・ヌーボー』」\n2006年「今も語り継がれる76年や05年に近い出来」\n2007年「柔らかく果実味豊かで上質な味わい」\n2008年「豊かな果実味と程よい酸味が調和した味」\n2009年「過去最高と言われた05年に匹敵する50年に一度の出来」\n2010年「2009年と同等の出来」\n2011年「100年に1度の出来とされた03年を超す21世紀最高の出来栄え」\n2012年「偉大な繊細さと複雑な香りを持ち合わせ、心地よく、よく熟すことができて健全」\n2013年「みずみずしさが感じられる素晴らしい品質」\n2014年「太陽に恵まれ、グラスに注ぐとラズベリーのような香りがあふれる、果実味豊かな味わい」\n2015年「過去にグレートヴィンテージと言われた2009年を思い起こさせます」\n--","ts":"1632356230.159500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"y3="}]},{"client_msg_id":"e50f80a6-8466-4f3f-b93f-ec90885267e5","type":"message","user":"U03C4RC8X","text":"\u003chttps://ja.wikipedia.org/wiki/%E3%83%9C%E3%82%B8%E3%83%A7%E3%83%AC%E3%83%BC%E3%83%AF%E3%82%A4%E3%83%B3\u003e","ts":"1632356220.159200","attachments":[{"fallback":"wikipedia: ボジョレーワイン","id":1,"author_name":"Wikipedia","author_link":"https://ja.wikipedia.org/","title":"ボジョレーワイン","title_link":"https://ja.wikipedia.org/wiki/%E3%83%9C%E3%82%B8%E3%83%A7%E3%83%AC%E3%83%BC%E3%83%AF%E3%82%A4%E3%83%B3","text":"ボジョレーワイン （フランス語: Vins du Beaujolais）とは、フランスワインの1つ。ローヌ県北部、ソーヌ＝エ＝ロワール県の数箇所のコミューンで生産されている。ブルゴーニュワインの1種類とされている。生産地域は、マコンとリヨンの間、ボジョレー地方の山のふもとである。\n毎年11月第3木曜日（日付が変わった午前0時）に解禁される、特産品の新酒をボジョレー・ヌヴォー （仏: Beaujolais nouveau） という。以前はその年のブドウの出来栄えをチェックすることを主な目的としたもので、ワイン業者が主な顧客であったが、その後、解禁日をイベントとして、新酒として大々的に売る販売戦略や販売手法が確立され、現在はフランスでも、日本と同じ目的で一般の消費者向けに売られている（ブルゴーニュ地域圏のマコネー （Maconnais） 地区に隣接する地のワインはブルゴーニュ・ワインに分類される）。","image_url":"https://upload.wikimedia.org/wikipedia/commons/9/9e/Beaujolais_Nouveau_wine.jpg","blocks":null,"service_icon":"https://a.slack-edge.com/80588/img/unfurl_icons/wikipedia.png","from_url":"https://ja.wikipedia.org/wiki/%E3%83%9C%E3%82%B8%E3%83%A7%E3%83%AC%E3%83%BC%E3%83%AF%E3%82%A4%E3%83%B3","original_url":"https://ja.wikipedia.org/wiki/%E3%83%9C%E3%82%B8%E3%83%A7%E3%83%AC%E3%83%BC%E3%83%AF%E3%82%A4%E3%83%B3"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"6gu"}]},{"client_msg_id":"8AEE2009-A592-435D-86DC-8DFD3CF80F9E","type":"message","user":"U843L486L","text":"私が一番好きな焼き魚だ。:fish:\n海魚なのに川魚っぽい感じで最高です。","ts":"1632373623.167600","thread_ts":"1632370022.162800","parent_user_id":"U022XK5866Q","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Enn"}]},{"client_msg_id":"40b8a1d3-2dcb-4b35-9086-3af373c54e82","type":"message","user":"U022XK5866Q","text":"ですよね！この手の細身の魚は骨が面倒だからとツレは嫌がるんですけど、私が好きでちょいちょい買ってしまいます。","ts":"1632396070.194200","thread_ts":"1632370022.162800","edited":{"user":"U022XK5866Q","ts":"1632396082.000000"},"parent_user_id":"U022XK5866Q","team":"T03C4RC8V","reactions":[{"name":"aruaru","count":1,"users":["U843L486L"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"e71"}]}]
