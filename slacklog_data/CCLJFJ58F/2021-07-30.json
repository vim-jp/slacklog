e":"sorena","count":7,"users":["UD1FQV38V","UDDCM376D","U01BY3SDBRS","U06ECBRTJ","U023040U953","U76GA7MFA","UNJ2DANJC"]},{"name":"bow","count":1,"users":["U027UKB8YTW"]},{"name":"ari","count":1,"users":["U027UKB8YTW"]},{"name":"ga","count":1,"users":["U027UKB8YTW"]},{"name":"-to","count":1,"users":["U027UKB8YTW"]},{"name":"gozaimasu","count":1,"users":["U027UKB8YTW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"a7g"}]},{"client_msg_id":"F5E2169F-5C11-45B3-961E-2A5E514EB52E","type":"message","user":"U011FTGJ3SN","text":"私も「いいぞ、もっとやれ」って感じで見てました笑\u0026gt;hit and away","ts":"1627633220.017300","team":"T03C4RC8V","reactions":[{"name":"wakaru","count":10,"users":["UAZ33BKV2","U81LLJ340","UDPT2BZ6E","UFHQ7TNT0","UD1FQV38V","ULPLDSYV8","UDDCM376D","U01BY3SDBRS","U023040U953","U01PMN2BVJQ"]},{"name":"naruhodo","count":1,"users":["U027UKB8YTW"]},{"name":"bow","count":1,"users":["U027UKB8YTW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"XIVyE"}]},{"client_msg_id":"f7a91d65-d48d-4094-9e8f-a599fd2b4083","type":"message","user":"U027UKB8YTW","text":"peacockさんありがとうございます。\n無思慮で失礼と思われてたら土下座しようもない・・・と思ってました、楽になりました。\npeacockさんも大変ですね。ある程度自己管理しつつ無理なく皆さんの飯テロ見て生きがい吸収していきます。","ts":"1627632323.015900","team":"T03C4RC8V","reactions":[{"name":"+1","count":2,"users":["UD1FQV38V","UFHQ7TNT0"]},{"name":"goodpoem","count":1,"users":["U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"lM7dv"}]},{"client_msg_id":"bf7062d1-647a-4dfb-ba40-1dd90e00622f","type":"message","user":"UD1FQV38V","text":"わたしも多動気味なのでわかります…\u0026lt;疲れる\nhit and awayも別にアレだとは思ってないのでいいと思いますよww","ts":"1627632087.013600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fhs"}]},{"client_msg_id":"a6dfb3fb-2806-4bcf-964d-257d379ba291","type":"message","user":"U027UKB8YTW","text":"見る専としてチャンネルに入らないまま皆さんの投稿は全部見てました\n先日のpeacockさんやohbaryeさんが投稿してた御徒町のビストロなど初めて知ったので今度行こうと思ってます","ts":"1627631939.011600","team":"T03C4RC8V","reactions":[{"name":"+1","count":2,"users":["UCL78DG68","U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"BYi"}]},{"client_msg_id":"f28f014f-7f9e-423c-86f5-fd4d82efb673","type":"message","user":"U027UKB8YTW","text":"失礼しました、私は会話に全部反応したり考えすぎてしまう癖があり、そして疲れやすくて衝動的にぷつっと人間関係を断捨離して後悔する事が多くて、最近は会話にあまりのめり込まないよう発言するときだけ入るようにしてました。\n\n2chやIRCみたいな全体チャット文化になれてて何も考えず頻繁に抜け入りしてしまってました。\nmuteだけして抜けないようにします。","ts":"1627631845.009900","thread_ts":"1627624684.006000","subtype":"thread_broadcast","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"GPPO"}],"root":{"client_msg_id":"a3c78307-18e7-4945-b58e-25df466efd68","type":"message","user":"U06BRP8VD","text":"ずっと入っていればよいのに…って自分がメシテロされないための自衛策なのか?w","ts":"1627624684.006000","thread_ts":"1627624684.006000","reply_count":1,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"7To4"}]}},{"type":"message","user":"U027UKB8YTW","text":"\u003c@U027UKB8YTW\u003e has joined the channel","ts":"1627630950.009700","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null},{"type":"message","user":"U01NKCTP7B4","text":"\u003c@U01NKCTP7B4\u003e has joined the channel","ts":"1627629769.009400","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null},{"type":"message","user":"U02265B2PB9","text":"\u003c@U02265B2PB9\u003e has joined the channel","ts":"1627629394.009100","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null},{"type":"message","user":"UH4HCS30U","text":"\u003c@UH4HCS30U\u003e has joined the channel","ts":"1627627826.008700","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null},{"type":"message","user":"U776661HA","ts":"1627627508.008100","files":[{"id":"F029L6232RK","c