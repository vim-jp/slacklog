elog.com/kanagawa/A1401/A140103/14000638/"}],"edited":{"user":"U843L486L","ts":"1619054217.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"VUxh"}]},{"client_msg_id":"a4897594-546f-4e75-89cf-1cca4bfed7d4","type":"message","user":"U03C71D7H","text":"そんなこんなでみなとみらいに到着","ts":"1619053946.397800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"vPRW"}]},{"client_msg_id":"8C580B1D-2128-4AF3-BAE2-A49A59CB64E3","type":"message","user":"U843L486L","text":"蕎麦もハンバーグもどっちも超オススメでどっちも食べて欲しい！","ts":"1619053731.394300","team":"T03C4RC8V","reactions":[{"name":"so","count":1,"users":["U03C4RC8X"]},{"name":"ba","count":1,"users":["U03C4RC8X"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"bOHw9"}]},{"client_msg_id":"a45a3c79-3060-4187-ba48-96ed155bb551","type":"message","user":"U03C71D7H","text":"ハンバーグか竜田揚げよさそう！","ts":"1619053633.392100","team":"T03C4RC8V","reactions":[{"name":"flag-vancouver","count":1,"users":["U03C4RC8X"]},{"name":"dragon","count":1,"users":["U03C4RC8X"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"R7P5"}]},{"client_msg_id":"36DB0F40-9E5B-42B9-8946-73E1451603FB","type":"message","user":"U843L486L","text":"私も是非会ってご飯ご一緒したいんですけど、家族的なアレもあってワクチン接種するまでは控えているというつらさ。","ts":"1619053517.391600","team":"T03C4RC8V","reactions":[{"name":"daiji","count":2,"users":["U03C4RC8X","U01BY3SDBRS"]},{"name":"wa","count":1,"users":["U03C4RC8X"]},{"name":"ku","count":1,"users":["U03C4RC8X"]},{"name":"chi","count":1,"users":["U03C4RC8X"]},{"name":"nri","count":1,"users":["U03C4RC8X"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Igy"}]},{"client_msg_id":"61F2D38E-973B-4AFD-AFB6-7142AE5CB48B","type":"message","user":"U843L486L","text":"みなとみらい駅周辺だと\n• ちょっと歩いて竜田揚げがうまい蕎麦屋(からあげセイロ蕎麦)\n• ハンマーヘッドのハングリータイガーでハンバーグ\n• さらにちょっと歩いて横浜駅アソビルの寿司屋と煮干しラーメン屋\n• ケークサレのお店「パブロフ」の小洒落たカフェ(山下公園のガンダムファクトリー周辺)\n• 喜助の牛タン(みなとみらい駅すぐ近く)\n• ハードロックカフェ(みなとみらい駅すぐ近く)\n\nこんなものでどうでしょう","ts":"1619053233.386600","pinned_to":["CCLJFJ58F"],"team":"T03C4RC8V","reactions":[{"name":"puro","count":7,"users":["U03C4RC8X","U03C71D7H","UG6DF6W87","U81LLJ340","UEACRCY0Z","UD1FQV38V","ULPLDSYV8"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ifW"}]},{"client_msg_id":"05b4494e-8839-41fa-8257-081b742c5be6","type":"message","user":"U03C71D7H","text":"予定が終わってランチする時間が未確定なんですが、ワンチャン guyon さんとランチもアリ? 昨今のアレもあるし難しいかな…","ts":"1619052989.383600","team":"T03C4RC8V","reactions":[{"name":"ofukai","count":1,"users":["U03C4RC8X"]},{"name":"wakaru","count":1,"users":["U843L486L"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"aY235"}]},{"client_msg_id":"a6d50cff-e834-4373-8cc9-40f60f8c679f","type":"message","user":"U03C71D7H","text":"時間は余裕あります。ジャンルはあまり考えてない…","ts":"1619051690.376600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"k=T"}]},{"client_msg_id":"A93E9664-3448-4CBD-996A-8579FB308DB6","type":"message","user":"U843L486L","text":"バッチこいです。\nお店滞在時間に余裕があったりしますか？\n今日食べたいジャンルはあります？","ts":"1619050528.376500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"RBX"}]},{"client_msg_id":"96c6089a-56aa-4058-846d-3d59f608f80d","type":"message","user":"U03C71D7H","text":"\u003c@U843L486L\u003eさんが詳しい?","ts":"1619050282.374000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"N9Re"}]},{"client_msg_id":"b22bdefe-8172-4fd1-bbc0-e3a9501019af","type":"message","user":"U03C71D7H","text":"今日はみなとみらいでランチを食べることになりそうなのだけど、オススメのお店とかってありますか?","ts":"1619050261.373900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zKTn"}]}]
