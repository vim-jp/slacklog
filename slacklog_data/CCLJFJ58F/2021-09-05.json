[{"client_msg_id":"c20e81e8-02df-44c3-9492-ee953237a982","type":"message","user":"UAZ33BKV2","text":"\u003chttps://www.hotpepper.jp/mesitsu/entry/otoko-nakamura/2021-00332\u003e\n一度やってみたいはある","ts":"1630838390.207200","attachments":[{"fallback":"メシ通 | ホットペッパーグルメ: 【お酢と牛乳】1時間ちょっとで「ストリングチーズ」を自作する方法【オトコ中村】 - メシ通 | ホットペッパーグルメ","id":1,"title":"【お酢と牛乳】1時間ちょっとで「ストリングチーズ」を自作する方法【オトコ中村】 - メシ通 | ホットペッパーグルメ","title_link":"https://www.hotpepper.jp/mesitsu/entry/otoko-nakamura/2021-00332","text":"ども、料理ブロガー＆ユーチューバーのオトコ中村です。 さきながら食べるのが楽しい「ストリングチーズ」。今回は、酒の肴からおやつまで食べ始めたら止まらない美味しさのストリングチーズを、オトコ中村流に自作してみます。 やることとしては、モッツァレラチーズを伸ばしては折り畳み、伸ばしては折り畳みを繰り返します。これでチーズが繊維状になって、引きさけるようになります。 市販のモッツァレラチーズを利用して作ることもできますが、ここではモッツァレラチーズから手作りして、さらにプレーンタイプと、カレー粉で風味を付けたものと2種類、食べ比べてみました。 材料は、超シンプルに牛乳と普通の穀物酢（と塩、風味付けの…","image_url":"https://cdn-ak.f.st-hatena.com/images/fotolife/o/otokonakamura/20210419/20210419100647.jpg","blocks":null,"ts":1630648800,"service_name":"メシ通 | ホットペッパーグルメ","service_icon":"https://www.hotpepper.jp/mesitsu/icon/touch","from_url":"https://www.hotpepper.jp/mesitsu/entry/otoko-nakamura/2021-00332","original_url":"https://www.hotpepper.jp/mesitsu/entry/otoko-nakamura/2021-00332"}],"team":"T03C4RC8V","reactions":[{"name":"eyes","count":1,"users":["U81LLJ340"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"M=Gwu"}]},{"client_msg_id":"3f7dc4c8-c6f0-469c-a8c1-d58b1179fa59","type":"message","user":"UAZ33BKV2","text":"作業の手間が0なので実質0Kcal、は無理がありますね","ts":"1630836019.206900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hC4n"}]},{"client_msg_id":"ED290FF3-244F-46E8-8DAE-9961846DDBDF","type":"message","user":"UFHQ7TNT0","text":"今日の晩御飯は惣菜になりました。ただし、カロリーがやばそうな惣菜……","ts":"1630835983.206300","files":[{"id":"F02DFCD7MU2","created":1630835977,"timestamp":1630835977,"name":"Image from iOS.jpg","title":"Image from iOS","mimetype":"image/jpeg","image_exif_rotation":0,"filetype":"jpg","pretty_typ