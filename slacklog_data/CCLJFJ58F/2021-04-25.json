960_h":960,"thumb_1024":"https://files.slack.com/files-tmb/T03C4RC8V-F01V9JT50UV-d12b815e3a/img_20210425_213104_438_1024.jpg","thumb_1024_w":1024,"thumb_1024_h":1024,"permalink":"https://vim-jp.slack.com/files/U01D9BALEKU/F01V9JT50UV/img_20210425_213104_438.jpg","permalink_public":"https://slack-files.com/T03C4RC8V-F01V9JT50UV-3f9c2c2123","edit_link":"","preview":"","preview_highlight":"","lines":0,"lines_more":0,"is_public":true,"public_url_shared":false,"channels":null,"groups":null,"ims":null,"initial_comment":{},"comments_count":0,"num_stars":0,"is_starred":false,"shares":{"public":null,"private":null},"display_as_bot":false,"has_rich_preview":false,"thumb_800":"https://files.slack.com/files-tmb/T03C4RC8V-F01V9JT50UV-d12b815e3a/img_20210425_213104_438_800.jpg","thumb_800_h":800,"thumb_800_w":800,"thumb_tiny":"","username":""}],"reactions":[{"name":"wakaru","count":2,"users":["UFHQ7TNT0","U81LLJ340"]},{"name":"umasou","count":2,"users":["UD1FQV38V","U81LLJ340"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"x4DA"}]},{"client_msg_id":"64853db6-c524-4add-8ad9-113f5ac0dd6b","type":"message","user":"UD1FQV38V","text":"そういえばCooking for Geeks買わねばと思いつつ買ってない...","ts":"1619352555.447400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ykasn"}]},{"client_msg_id":"36a42fb2-d5bf-426c-9059-77a0276e4114","type":"message","user":"UD1FQV38V","text":"\u003chttps://www.oreilly.co.jp/books/9784873119489/\u003e\n:eyes:","ts":"1619352504.446700","attachments":[{"fallback":"分子調理の日本食","id":1,"title":"分子調理の日本食","title_link":"https://www.oreilly.co.jp/books/9784873119489/","text":"新たな調理方法と料理を分子レベルから開発する「分子調理法」を、身近な日本食に応用した世界で初めての書籍です。「ゲル化」「熱ゲル化」「泡化、炭酸化」「架橋化」「乳化」「実験器具利用化」といった技術を使って作り出したレシピと、その背景にある「分子調理学」の解説が掲載されています。紹介する料理は、きれいなスノードームに入ったふろふき大根、温めると固まって冷やすと溶けるけんちん汁、アサリと三つ葉が美しいお吸い物球体、甘辛いイナゴのハンバーグ、かつお節でできた酒器、液体窒素で冷やした冷やし中華、“脳天に突き刺さる”ほどのうま味が濃縮した煮汁ソースなど。読むと未来の料理を空想してしまいたくなるような一冊です。英文併記。","thumb_url":"https://www.oreilly.co.jp/books/images/picture_large978-4-87311-948-9.jpeg","blocks":null,"service_name":"oreilly.co.jp","service_icon":"https://www.oreilly.co.jp/favicon.ico","thumb_width":516,"thumb_height":660,"from_url":"https://www.oreilly.co.jp/books/9784873119489/","original_url":"https://www.oreilly.co.jp/books/9784873119489/"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"KB9"}]},{"client_msg_id":"1c52bb9f-c50b-4e1a-be93-eaa0e49ceb52","type":"message","user":"U06BRP8VD","text":"分子調理の日本食、今朝届いた。","ts":"1619352451.446300","team":"T03C4RC8V","reactions":[{"name":"sokudo","count":1,"users":["U843L486L"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"UQzql"}]},{"client_msg_id":"C1874B7D-3265-49FE-BE73-D52865E51CE5","type":"message","user":"U843L486L","text":"「よーしアクアラインで行っちゃうぞー」(ますますダメ)","ts":"1619352315.445900","edited":{"user":"U843L486L","ts":"1619352343.000000"},"team":"T03C4RC8V","reactions":[{"name":"warau","count":2,"users":["UD1FQV38V","U06BRP8VD"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"iXZZq"}]},{"client_msg_id":"57b17e83-2100-425f-9fce-dcbd787c70c0","type":"message","user":"UD1FQV38V","text":"ハンマーヘッド行きたいんですが、千葉県民なので遠くて:totemoturai:","ts":"1619352160.443500","team":"T03C4RC8V","reactions":[{"name":"naruhodo","count":1,"users":["U843L486L"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"M/JQ"}]},{"client_msg_id":"CBCB9A0F-F844-4604-A81D-3A576293D3C8","type":"message","user":"U843L486L","text":"そういえば、先週みなとみらいの話の流れであった「ハンマーヘッドのビール充実のセブンイレブン」はよく前を通るので、見に行った事あるんですけど品揃えは噂通り充実すぎでした。ぜひ行って数本をその場でプシュッ！と開けて欲しいです。","ts":"1619352041.442700","team":"T03C4RC8V","reactions":[{"name":"eyes","count":1,"users":["UD1FQV38V"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"gEdf"}]},{"client_msg_id":"b28975f5-6145-449f-a5e2-eac106005b76","type":"message","user":"UD1FQV38V","text":"Spring Valleyもいいけどヱビスのプレミアムホワイトも好きです(サッポロ党","ts":"1619351606.435000","team":"T03C4RC8V","reactions":[{"name":"beer","count":1,"users":["U843L486L"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"haOpL"}]},{"client_msg_id":"3B5DD0A5-059C-4D23-9C23-A6CD22B8FFE3","type":"message","user":"U843L486L","text":"ビールはいつも身近に売っている同じ銘柄買うことがいいのですが、少し目を惹かれてキリンのクラフトビールに手を出したんだけど、ふつうに美味しいなと思いました。\n輸入ビールだと安いなと感じて、国産のしっかりとした作りのものを高いと感じてしまう私の心はバイアスかかり過ぎだなぁと反省してます。\n\u003chttps://www.springvalleybrewery.jp|https://www.springvalleybrewery.jp\u003e","ts":"1619351306.433400","attachments":[{"fallback":"SPRING VALLEY（スプリングバレー）","id":1,"title":"SPRING VALLEY（スプリングバレー）","title_link":"https://www.springvalleybrewery.jp/","text":"「SPRING VALLEY （スプリングバレー）」のブランドサイトです。1870年、日本のビール産業の礎を築いた横浜の醸造所「SPRING VALLEY BREWERY（スプリングバレー・ブルワリー）」。その志を受け継ぐキリンビールが、渾身のクラフトビールをお届けします。","image_url":"https://springvalleybrewery.jp/assets/images/ogp_logo.jpg","blocks":null,"service_name":"springvalleybrewery.jp","from_url":"https://www.springvalleybrewery.jp/","original_url":"https://www.springvalleybrewery.jp"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Ye/"}]},{"client_msg_id":"97839216-E47F-4173-9D2F-12DCAC0125CA","type":"message","user":"U843L486L","text":"ですね。\nセールで298円だったので思わず手を出してしまいました。\n好きなIPAとは違うタイプですが、これはこれで好みだったので買い増すかもしれないです！\n\u003chttps://www.jetlc.co.jp/wine/30775/|https://www.jetlc.co.jp/wine/30775/\u003e","ts":"1619350426.425800","team":"T03C4RC8V","reactions":[{"name":"goodpoem","count":2,"users":["UD1FQV38V","U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"GeOq"}]},{"client_msg_id":"910df3e8-eded-47ca-8814-d15cfb6ec933","type":"message","user":"UD1FQV38V","text":"\u003chttps://untappd.com/b/g-menabrea-and-figli-birra-del-150-anniversario-bionda-lager/58397