s-tmb/T03C4RC8V-F02KTDRNRDK-c97a6c3736/ios___________64.jpg","thumb_80":"https://files.slack.com/files-tmb/T03C4RC8V-F02KTDRNRDK-c97a6c3736/ios___________80.jpg","thumb_160":"https://files.slack.com/files-tmb/T03C4RC8V-F02KTDRNRDK-c97a6c3736/ios___________160.jpg","thumb_360":"https://files.slack.com/files-tmb/T03C4RC8V-F02KTDRNRDK-c97a6c3736/ios___________360.jpg","thumb_360_gif":"","thumb_360_w":360,"thumb_360_h":270,"thumb_480":"https://files.slack.com/files-tmb/T03C4RC8V-F02KTDRNRDK-c97a6c3736/ios___________480.jpg","thumb_480_w":480,"thumb_480_h":360,"thumb_720":"https://files.slack.com/files-tmb/T03C4RC8V-F02KTDRNRDK-c97a6c3736/ios___________720.jpg","thumb_720_w":720,"thumb_720_h":540,"thumb_960":"https://files.slack.com/files-tmb/T03C4RC8V-F02KTDRNRDK-c97a6c3736/ios___________960.jpg","thumb_960_w":960,"thumb_960_h":720,"thumb_1024":"https://files.slack.com/files-tmb/T03C4RC8V-F02KTDRNRDK-c97a6c3736/ios___________1024.jpg","thumb_1024_w":1024,"thumb_1024_h":768,"permalink":"https://vim-jp.slack.com/files/U843L486L/F02KTDRNRDK/ios__________.jpg","permalink_public":"https://slack-files.com/T03C4RC8V-F02KTDRNRDK-9bb5462764","edit_link":"","preview":"","preview_highlight":"","lines":0,"lines_more":0,"is_public":true,"public_url_shared":false,"channels":null,"groups":null,"ims":null,"initial_comment":{},"comments_count":0,"num_stars":0,"is_starred":false,"shares":{"public":null,"private":null},"display_as_bot":false,"has_rich_preview":false,"thumb_800":"https://files.slack.com/files-tmb/T03C4RC8V-F02KTDRNRDK-c97a6c3736/ios___________800.jpg","thumb_800_h":600,"thumb_800_w":800,"thumb_tiny":"","username":""}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fKG"}]},{"client_msg_id":"6920174d-a6dd-4b87-b676-6a81ddeb1588","type":"message","user":"U76GA7MFA","text":"竹も良いですが、黒檀とか紫檀が好きです。音が良い気がします。","ts":"1635851520.419700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"HEiqh"}]},{"client_msg_id":"cd6de148-38f6-4c06-9159-eda053b80960","type":"message","user":"U9S4G0LJW","text":"竹はいいですよね","ts":"1635851369.418800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"AIb"}]},{"client_msg_id":"a429cbd6-21ac-4399-9e99-caa1eda5d627","type":"message","user":"U76GA7MFA","text":"コンビニの割りばしは竹製が多いので比較的マシですね。きっと折れないです。","ts":"1635851346.418500","team":"T03C4RC8V","reactions":[{"name":"wakaru","count":1,"users":["U9S4G0LJW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"9vYQ"}]},{"client_msg_id":"a0e84f7b-1016-4b61-9cb3-47e6b2b9525a","type":"message","user":"U9S4G0LJW","text":"長い棒は利便性が高いので食器以外の用途として使うことも割とあるか","ts":"1635851279.417800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"DxpYT"}]},{"client_msg_id":"764de7a4-a5f1-4db4-8a00-3307fdd92ee3","type":"message","user":"U9S4G0LJW","text":"怠惰極めてるので割り箸はよく使うけど質が低いのでささくれ立ってるしたまに折れる","ts":"1635851222.416900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"8TE"}]},{"client_msg_id":"080aa087-ac02-4c5b-b833-62cd6575daa3","type":"message","user":"U76GA7MFA","text":"わかります。極力もらわないようにしてます。\n食器、箸、カトラリーは好みのものを使いたい。","ts":"1635850982.416300","team":"T03C4RC8V","reactions":[{"name":"desune","count":1,"users":["UFHQ7TNT0"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Ft4"}]},{"client_msg_id":"EB9057DA-7F15-443B-B929-49DE5DF0E455","type":"message","user":"UFHQ7TNT0","text":"ちなみに、刺身パックについてるワサビとか、コンビニの割り箸みたいなタダでついてくるものは、数年前から迷わずすぐに捨てるようになりました。","ts":"1635850860.415200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"B0/k"}]},{"client_msg_id":"63D517DE-5C8B-42A7-887F-FAA94C4D75E2","type":"message","user":"UFHQ7TNT0","text":"使うのをためらって使えず、でもなんかもったいなくて捨てられずみたいなのを引っ越しまで続けていました。","ts":"1635850786.413500","team":"T03C4RC8V","reactions":[{"name":"wakaru","count":1,"users":["U76GA7MFA"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"m/T/"}]},{"client_msg_id":"80f01b4e-7221-4488-babf-e42a17218766","type":"message","user":"U76GA7MFA","text":"あ、使い続けるわけではないんですすね。","ts":"1635850729.412300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"E4dm4"}]},{"client_msg_id":"cc6148b3-a275-4e4b-9167-983f006091ca","type":"message","user":"U76GA7MFA","text":"確かに。でも、微妙なのをわかりつつ使い続けるのも微妙な気持ちになります。\n家族がいての人たちが気付かないならいいかも。","ts":"1635850699.411900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hQum"}]},{"client_msg_id":"BC736CB7-79D3-4364-B6B7-F0D1D1A28974","type":"message","user":"UFHQ7TNT0","text":"とはいえ、引っ越しのタイミングで結局捨てるので、早めに捨てたほうが楽なのは間違いないですね","ts":"1635850695.411700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"wX/"}]},{"client_msg_id":"0E3DD83A-1835-4617-90AF-6922C28F816E","type":"message","user":"UFHQ7TNT0","text":"買値がそれなりに高いとつい捨てるのを躊躇ってしまいます……","ts":"1635850512.409700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"kuCO"}]},{"client_msg_id":"68636da2-be75-402c-85e0-bef0ac81783b","type":"message","user":"U76GA7MFA","text":"スカスカだってわかっても残しちゃいます？","ts":"1635850462.408400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Vbz4s"}]},{"client_msg_id":"67024C48-AFD5-41DB-86CC-5072DF9E7167","type":"message","user":"UFHQ7TNT0","text":"トリュフオイルとかも、香り抜けて微妙になるんですよね","ts":"1635850449.408100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"mlKYX"}]},{"client_msg_id":"1416be03-a7a6-430a-9502-81edff6bb0b6","type":"message","user":"U01D9BALEKU","text":"三年前に買った乾燥バジルまだ残ってる（流石に香りがスカスカ）","ts":"1635850410.407400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0rh"}]},{"client_msg_id":"26b0fb89-3ea9-4e6c-b628-573b710cada0","type":"message","user":"U76GA7MFA","text":"引っ越しをして3年も過ぎると調味料の賞味期限が色々と切れている。","ts":"1635849537.406300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"6qs"}]},{"client_msg_id":"70e2ca9d-7afa-4e57-9ba0-9186ed3e9fb1","type":"message","user":"U06ECBRTJ","text":"なるほど、ラーメン付き","ts":"1635778875.406000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"MsgB"}]}]
