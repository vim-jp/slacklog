.jpg","thumb_480_w":480,"thumb_480_h":360,"thumb_720":"https://files.slack.com/files-tmb/T03C4RC8V-F025SQ4H0AY-16f4be8bb8/image_from_ios_720.jpg","thumb_720_w":720,"thumb_720_h":540,"thumb_960":"https://files.slack.com/files-tmb/T03C4RC8V-F025SQ4H0AY-16f4be8bb8/image_from_ios_960.jpg","thumb_960_w":960,"thumb_960_h":720,"thumb_1024":"https://files.slack.com/files-tmb/T03C4RC8V-F025SQ4H0AY-16f4be8bb8/image_from_ios_1024.jpg","thumb_1024_w":1024,"thumb_1024_h":768,"permalink":"https://vim-jp.slack.com/files/UFHQ7TNT0/F025SQ4H0AY/image_from_ios.jpg","permalink_public":"https://slack-files.com/T03C4RC8V-F025SQ4H0AY-63763cfc52","edit_link":"","preview":"","preview_highlight":"","lines":0,"lines_more":0,"is_public":true,"public_url_shared":false,"channels":null,"groups":null,"ims":null,"initial_comment":{},"comments_count":0,"num_stars":0,"is_starred":false,"shares":{"public":null,"private":null},"display_as_bot":false,"has_rich_preview":false,"thumb_800":"https://files.slack.com/files-tmb/T03C4RC8V-F025SQ4H0AY-16f4be8bb8/image_from_ios_800.jpg","thumb_800_h":600,"thumb_800_w":800,"thumb_tiny":"","username":""}],"reactions":[{"name":"umasou","count":4,"users":["U9S4G0LJW","U01PMN2BVJQ","UD1FQV38V","U776661HA"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"w+G"}]},{"client_msg_id":"7d4a1fcd-e7ef-4a87-a09a-ef0eaa704b81","type":"message","user":"U76GA7MFA","text":"今日は涼しいので、ビールの次は赤ワイン（カベルネ・ソーヴィニョン）","ts":"1624180138.351000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ZcW/J"}]},{"client_msg_id":"400dd3f5-bd7b-4aed-b09a-3124b5f9dfaa","type":"message","user":"U76GA7MFA","text":"ほう。 \u003chttps://mangashokudo.net/blog-entry-370.html\u003e","ts":"1624180104.350400","attachments":[{"fallback":"マンガ食堂 - 漫画の料理、レシピ（漫画飯）を再現 Powered by ライブドアブログ: 「ハクメイとミコチ」（樫木祐人）の自家製リモンチェッロ : マンガ食堂 - 漫画の料理、レシピ（漫画飯）を再現 Powered by ライブドアブログ","id":1,"title":"「ハクメイとミコチ」（樫木祐人）の自家製リモンチェッロ : マンガ食堂 - 漫画の料理、レシピ（漫画飯）を再現 Powered by ライブドアブログ","title_link":"https://mangashokudo.net/blog-entry-370.html","text":"ちょっと前に作ったブドウパンに続き、「ハクメイとミコチ」2巻に登場するリモンチェッロです。※【コマ引用】「ハクメイとミコチ」（樫木祐人/エンターブレイン）2巻よりハクメイがたまたま見つけた、森の中の小さな卵型美容室。この店の主人は、ベリーショートのちょ","image_url":"https://livedoor.blogimg.jp/mangashokudo/imgs/9/4/941222f0.jpg","blocks":null,"service_name":"マンガ食堂 - 漫画の料理、レシピ（漫画飯）を再現 Powered by ライブドアブログ","service_icon":"https://livedoor.blogimg.jp/mangashokudo/imgs/b/e/favicon.ico","from_url":"https://mangashokudo.net/blog-entry-370.html","original_url":"https://mangashokudo.net/blog-entry-370.html"}],"team":"T03C4RC8V","reactions":[{"name":"+1","count":1,"users":["UAZ33BKV2"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"z4uI"}]},{"client_msg_id":"b45a6f53-9582-4294-bb16-ea8dab2a43bf","type":"message","user":"UAZ33BKV2","text":"ジュダさんがレモンチェッロを作るのに失敗してふて寝してたときのミコチの説明にあります(があってるかは不明w)","ts":"1624179687.350200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"pX4F"}]},{"client_msg_id":"f302d1a8-25f7-4084-bb33-8701c6dfd575","type":"message","user":"U76GA7MFA","text":"ハクメイとミコチ は読んでるはずなのにまったく記憶にない…雰囲気だけを楽しんでいるみたい","ts":"1624179640.349400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"nKWP"}]},{"client_msg_id":"c9b5b3f9-ab80-4e5d-b1bc-6146ef2136fe","type":"message","user":"UAZ33BKV2","text":"レモンチェッロは、むしろ皮だけで白い綿は入れないと美味いらしいけど....まあいろいろ試してみてください\n出展 くーねるまるた \u0026amp; ハクメイとミコチ","ts":"1624179410.348700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"EK6x"}]},{"client_msg_id":"6567addd-470c-46f1-9c67-d77ae213a7d3","type":"message","user":"U76GA7MFA","text":"なるほど。しっかり皮を取り除いたレモンで試してみたい。","ts":"1624179278.347600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"KJ=X0"}]},{"client_msg_id":"70f9cc2c-465a-4824-b573-826f16afd4b5","type":"message","user":"UAZ33BKV2","text":"まあ、ピール(皮)からの香り抽出とかしてると、けっこう苦みやら臭みやらの成分ありますしね....","ts":"1624179095.347200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"WtbCi"}]},{"client_msg_id":"713a20f5-2971-4dc4-ab8d-e2410ff0c29c","type":"message","user":"U76GA7MFA","text":"レモンサワーは何回か飲んではいるものの独特の癖があって苦手なんですが、使っている酒によるものなんでしょうか。（「癖」を文字にできないのでわからんと言われそう）","ts":"1624179012.346200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"gOe"}]},{"client_msg_id":"05d745cc-c47e-4ee1-a879-2406da8114e6","type":"message","user":"UAZ33BKV2","text":"なんか成分的にそうなんですかね?、まあ自分は平気なので文句はない","ts":"1624178199.344600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Te+0"}]},{"client_msg_id":"8A735CF9-57EC-4D57-A936-FB3295F615EF","type":"message","user":"UFHQ7TNT0","text":"柑橘系、たまにそういう香りがするやつありますよね。匂いが近いのかも","ts":"1624178129.344200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fi1"}]},{"client_msg_id":"82a222d3-6b9e-4160-8d61-1170e9c50ec8","type":"message","user":"UAZ33BKV2","text":"キリン 発酵レモンサワー、ちょっとだけ墨汁の香りがする...?","ts":"1624176663.343100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"MWw"}]},{"client_msg_id":"8926d883-6a62-4089-8511-ef89b77f2fa7","type":"message","user":"U01D9BALEKU","text":"料理真面目にやり始めてからちょうど1年くらいだ","ts":"1624162611.342200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"9o2"}]},{"client_msg_id":"d2f90e67-a7df-459a-86e7-12db9a98eec0","type":"message","user":"U01D9BALEKU","text":"鉄フライパン買ってちょうど1年経ったらしい","ts":"1624162595.342100","team":"T03C4RC8V","reactions":[{"name":"goodpoem","count":2,"users":["U01BY3SDBRS","U022XK5866Q"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"8ervU"}]}]
