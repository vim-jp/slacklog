k.com/files/U843L486L/F01T51RBLUV/ios__________.jpg","permalink_public":"https://slack-files.com/T03C4RC8V-F01T51RBLUV-70c66ca183","edit_link":"","preview":"","preview_highlight":"","lines":0,"lines_more":0,"is_public":true,"public_url_shared":false,"channels":null,"groups":null,"ims":null,"initial_comment":{},"comments_count":0,"num_stars":0,"is_starred":false,"shares":{"public":null,"private":null},"display_as_bot":false,"has_rich_preview":false,"thumb_800":"https://files.slack.com/files-tmb/T03C4RC8V-F01T51RBLUV-b39c20fa2e/ios___________800.jpg","thumb_800_h":600,"thumb_800_w":800,"thumb_tiny":"","username":""}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"I+xlQ"}]},{"client_msg_id":"A43ACFEC-7A49-48E2-B7D1-E173A55D8E79","type":"message","user":"U843L486L","text":"さっそく近所のいつも利用しているお米屋さんに行ってできたて米糠を譲ってもらいました。\n\n米糠は賞味期限が5日程で油分も凄いそうで、米糠での処理の仕方を教えてもらいました。\n\n• 日を越すくらい長時間ゆっくりお湯で茹でる\n• 今回の筍の大きさなら一握り程度でよく入れ過ぎないこと\n• 入れ過ぎるとこびりついて奥さんに怒られますよ\n• 筍は収穫してすぐに処理しないと味が落ちる\n今回は筍は堀たてじゃないから、道楽のようなような感じで試してみます！筍の素焼きも美味そうだから追加で買いにいくか...\n","ts":"1617510285.119800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"UJtNp"}]},{"client_msg_id":"ace95a0c-8c7e-4328-b518-6d341c0670dc","type":"message","user":"U03C4RC8X","text":"実際のところは比較実験してみないとわからないので僕はちょっとわからない","ts":"1617509273.108000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"QLP"}]},{"client_msg_id":"9a252e93-97ec-46ae-a3e4-1c7e2f5d5ed7","type":"message","user":"U03C4RC8X","text":"どんな水でもよかったから単に伝統的に米を研いだ水が余ってたから使ってたという説とか","ts":"1617509262.107600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"iOixi"}]},{"client_msg_id":"d56a804f-d306-4ba9-9f81-fa36482ead46","type":"message","user":"U03C4RC8X","text":"ちなみに米糠自体に効果はそれほどないみたいな研究もあるみたいです (出典見つからず引用できない)","ts":"1617509239.107000","team":"T03C4RC8V","reactions":[{"name":"naruhodo","count":1,"users":["U843L486L"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hTpc"}]},{"client_msg_id":"7b7f1483-4ae2-4712-a2d4-c09e860092d6","type":"message","user":"U03C4RC8X","text":"すごい","ts":"1617509222.106600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"XmAV"}]},{"client_msg_id":"4BC07E23-93DB-4030-B79A-D693BBA8B107","type":"message","user":"U843L486L","text":"近所のハナマサで福岡産のタケノコが298円で山盛り売っていたので買ってみました。\nアク抜きをしようと思っているんですけど、幾つかやり方があるみたいでどれにしようか悩んでます。\n実家ではコンクリート放置でアク抜きしていたんけど、米糠でチャレンジしてみるのも面白そう。\n\u003chttps://tabetarou.com/food/yasai/takenoko/takenoko_2.html|https://tabetarou.com/food/yasai/takenoko/takenoko_2.html\u003e","ts":"1617508078.106100","files":[{"id":"F01TXT3HF2L","created":1617508073,"timestamp":1617508073,"name":"iOS の画像.jpg","title":"iOS の画像","mimetype":"image/jpeg","image_exif_rotation":0,"filetype":"jpg","pretty_type":"JPEG","user":"U843L486L","mode":"hosted","editable":false,"is_external":false,"external_type":"","size":818080,"url":"","url_download":"","url_private":"https://files.slack.com/files-pri/T03C4RC8V-F01TXT3HF2L/ios__________.jpg","url_private_download":"https://files.slack.com/files-pri/T03C4RC8V-F01TXT3HF2L/download/ios__________.jpg","original_h":3024,"original_w":4032,"thumb_64":"https://files.slack.com/files-tmb/T03C4RC8V-F01TXT3HF2L-350471bf38/ios___________64.jpg","thumb_80":"https://files.slack.com/files-tmb/T03C4RC8V-F01TXT3HF2L-350471bf38/ios___________80.jpg","thumb_160":"https://files.slack.com/files-tmb/T03C4RC8V-F01TXT3HF2L-350471bf38/ios___________160.jpg","thumb_360":"https://files.slack.com/files-tmb/T03C4RC8V-F01TXT3HF2L-350471bf38/ios___________360.jpg","thumb_360_gif":"","thumb_360_w":360,"thumb_360_h":270,"thumb_480":"https://files.slack.com/files-tmb/T03C4RC8V-F01TXT3HF2L-350471bf38/ios___________480.jpg","thumb_480_w":480,"thumb_480_h":360,"thumb_720":"https://files.slack.com/fil