les.com/T03C4RC8V-F02ERF6M7MF-9a422bac28","edit_link":"","preview":"","preview_highlight":"","lines":0,"lines_more":0,"is_public":true,"public_url_shared":false,"channels":null,"groups":null,"ims":null,"initial_comment":{},"comments_count":0,"num_stars":0,"is_starred":false,"shares":{"public":null,"private":null},"display_as_bot":false,"has_rich_preview":false,"thumb_800":"https://files.slack.com/files-tmb/T03C4RC8V-F02ERF6M7MF-42c6ae12cd/20210914_221214_800.jpg","thumb_800_h":600,"thumb_800_w":800,"thumb_tiny":"","username":""}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"wo8i"}]},{"client_msg_id":"D7D586FF-2FD2-4CB7-8C6F-98CAD67EC562","type":"message","user":"U011FTGJ3SN","text":"\u003chttps://agri.mynavi.jp/2017_09_25_6164/|https://agri.mynavi.jp/2017_09_25_6164/\u003e\n冷蔵庫に入れない方が良い野菜もありますね。主に切ってない夏野菜","ts":"1631619619.442900","attachments":[{"fallback":"マイナビ農業-就農、農業ニュースなどが集まる農業情報総合サイト: 冷蔵庫に入れないほうがいい野菜とは？","id":1,"title":"冷蔵庫に入れないほうがいい野菜とは？","title_link":"https://agri.mynavi.jp/2017_09_25_6164/","text":"野菜の貯蔵に適した場所として冷蔵庫が一番多く使われていると思います。野菜によっては、冷蔵庫に入れる事でかえってダメになってしまう事もあります。低温で保存する事の意味と、適さない理由はなぜかを考えてみたいと思います。","image_url":"https://agri.mynavi.jp/wp-content/uploads/2017/08/a11b4bb3ba448d1fa402ac3dc62cc91f-11.jpg","blocks":null,"service_name":"マイナビ農業-就農、農業ニュースなどが集まる農業情報総合サイト","service_icon":"https://agri.mynavi.jp/wp-content/themes/agri/images/ios.png","from_url":"https://agri.mynavi.jp/2017_09_25_6164/","original_url":"https://agri.mynavi.jp/2017_09_25_6164/"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"qBAV"}]},{"client_msg_id":"b3c527c0-7684-4010-a097-220a84f21b81","type":"message","user":"U9S4G0LJW","text":"冷暗所大事","ts":"1631618774.442200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"h0g/"}]},{"client_msg_id":"0EE5EE63-A7F4-4E00-B076-D51A664212E2","type":"message","user":"U843L486L","text":"いいところですね。\nゲヴェルツが主とはなかなか貴重。気候変動も相まってカナダもカルフォルニアのように百花繚乱になってくるかもしれないですね！\n\nビクトリア島も景観が綺麗ですし、あのラッコがいる水族館もあるから行ってみたいです。","ts":"1631618577.441800","thread_ts":"1631599903.426800","subtype":"thread_broadcast","reactions":[{"name":"goodpoem","count":1,"users":["U03C4RC8X"]},{"name":"seal","count":1,"users":["U03C4RC8X"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Af/"}],"root":{"client_msg_id":"49175e80-5389-4759-8f01-c7930f6a346f","type":"message","user":"U03C4RC8X","text":"BCのワインについていろいろ勉強してました。BCのワインは気候的にドイツ系のワインが中心なのかなと思いきや、むしろメインは思い切りアルザス系でした。どおりでGewurztraminerが充実していて最高なわけだ :goodpoem:\nいわゆるフランスとドイツの国境系","ts":"1631599903.426800","thread_ts":"1631599903.426800","edited":{"user":"U03C4RC8X","ts":"1631635899.000000"},"reply_count":1,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"YoB6"}]}},{"client_msg_id":"1a39120a-d34c-4520-a0bc-51585a801d30","type":"message","user":"UAZ33BKV2","text":"温度というよりは、乾燥のために外にタマネギはよくある気がします。\n冷蔵するというよりは冷暗所(通気がよく)ってところ?","ts":"1631617762.436300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"2ODjM"}]},{"client_msg_id":"37943717-d2c4-4dcb-b6aa-e1ca13663d3b","type":"message","user":"UDPT2BZ6E","text":"田舎≒実家","ts":"1631617001.435500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=OJE/"}]},{"client_msg_id":"03456a57-d2ce-4d26-a54e-b1f9e1a0e788","type":"message","user":"UDPT2BZ6E","text":"田舎だと外に干してるの結構見ますね。\nただスーパーで買ってきたものは全部冷蔵庫に入れる頭になってました。。","ts":"1631616983.435300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"SCYQ3"}]},{"client_msg_id":"5caf968f-b87e-435c-b023-c150451c80c2","type":"message","user":"UD1FQV38V","text":"北海道だけど、ジャガイモとタマネギは外の物置でした","ts":"1631616571.434600","team":"T03C4RC8V","reactions":[{"name":"sorena","count":1,"users":["U06ECBR