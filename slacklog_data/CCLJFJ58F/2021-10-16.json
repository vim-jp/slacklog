8V-F02JD2EQP2M-a0d5a3b268","edit_link":"","preview":"","preview_highlight":"","lines":0,"lines_more":0,"is_public":true,"public_url_shared":false,"channels":null,"groups":null,"ims":null,"initial_comment":{},"comments_count":0,"num_stars":0,"is_starred":false,"shares":{"public":null,"private":null},"display_as_bot":false,"has_rich_preview":false,"thumb_800":"https://files.slack.com/files-tmb/T03C4RC8V-F02JD2EQP2M-b950e4b77f/image_from_ios_800.jpg","thumb_800_h":600,"thumb_800_w":800,"thumb_tiny":"","username":""}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"E9Gb"}]},{"client_msg_id":"1e937439-4522-4a0c-8b65-b2b2bd59f5d1","type":"message","user":"UAZ33BKV2","text":"ぴーにゃー","ts":"1634368054.173300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5=ziv"}]},{"client_msg_id":"0df1f2aa-f4b6-40a3-adf9-3f497c4a2085","type":"message","user":"U03C4RC8X","text":"\u003chttps://ja.wikipedia.org/wiki/%E3%83%94%E3%83%8B%E3%83%A3%E3%83%BB%E3%82%B3%E3%83%A9%E3%83%BC%E3%83%80\u003e","ts":"1634367922.173000","attachments":[{"fallback":"wikipedia: ピニャ・コラーダ","id":1,"author_name":"Wikipedia","author_link":"https://ja.wikipedia.org/","title":"ピニャ・コラーダ","title_link":"https://ja.wikipedia.org/wiki/%E3%83%94%E3%83%8B%E3%83%A3%E3%83%BB%E3%82%B3%E3%83%A9%E3%83%BC%E3%83%80","text":"ピニャ・コラーダ（スペイン語: Piña Colada）はカクテルの1種。ラムをベースに、パイナップルジュースとココナッツミルクを砕いた氷と一緒にシェイクして作るロングドリンク。黄白色で甘みが強い。\nPiña Coladaは、スペイン語で「うらごししたパイナップル」の意味。材料として、パイナップルの果肉をよくすりつぶし、裏漉ししたジュースを材料とすることに由来する。\n日本語のカタカナ表記としては、「・」（中黒）抜きや「ピニャ・カラーダ」というのも見受けられる。","image_url":"https://upload.wikimedia.org/wikipedia/commons/b/b2/Pi%C3%B1a_Colada.jpg","blocks":null,"service_icon":"https://a.slack-edge.com/80588/img/unfurl_icons/wikipedia.png","from_url":"https://ja.wikipedia.org/wiki/%E3%83%94%E3%83%8B%E3%83%A3%E3%83%BB%E3%82%B3%E3%83%A9%E3%83%BC%E3%83%80","original_url":"https://ja.wikipedia.org/wiki/%E3%83%94%E3%83%8B%E3%83%A3%E3%83%BB%E3%82%B3%E3%83%A9%E3%83%BC%E3%83%80"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"p/JKG"}]},{"client_msg_id":"c4a471ba-233a-4aa3-8548-ae7fb81d53d7","type":"message","user":"U03C4RC8X","text":"pina coladaというカクテルがすきなので、それを作るのに使えそうだけど、未経験","ts":"1634367902.172800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"vATl"}]},{"client_msg_id":"89115ccf-e643-4032-815e-c4fe068ebe02","type":"message","user":"U03C4RC8X","text":"実はmetoo","ts":"1634367875.172200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"GEJg"}]},{"client_msg_id":"ABBD9E0E-A1E2-49D5-AE76-E514BA28FF4C","type":"message","user":"UFHQ7TNT0","text":"タイカレー以外でココナッツミルク使ったことないな","ts":"1634367854.172000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"t4fbO"}]},{"client_msg_id":"66af6b6d-8186-4d75-9181-6adc9687f8f5","type":"message","user":"U03C4RC8X","text":"ちょうどこないだタイグリーンカレー作ったのでそれ以外縛りで","ts":"1634367447.171600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"D/Wv3"}]},{"client_msg_id":"02ff88f6-9dd9-442c-b367-aef467e958ad","type":"message","user":"U03C4RC8X","text":"あとココナッツミルクもあるからこれもレシピ考えとこう","ts":"1634367437.171100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"6VDKS"}]},{"client_msg_id":"9861611c-d094-4229-822a-d3c3ea5f903a","type":"message","user":"U9S4G0LJW","text":"あっさりな味噌汁にするんですねわかります","ts":"1634367313.170700","team":"T03C4RC8V","reactions":[{"name":"dajare","count":1,"users":["UFHQ7TNT0"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"wTN6"}]},{"client_msg_id":"5AEB2D32-0CF8-4031-B3F2-2B8B2C5BD0FE","type":"message","user":"UFHQ7TNT0","text":"おっ、うちも今晩はあさりの味噌汁の予定だ","ts":"1634367113.170100","team