.jp/docs/news/1325704.html"}],"team":"T03C4RC8V","reactions":[{"name":"pray","count":1,"users":["UEACRCY0Z"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ooxgR"}]},{"client_msg_id":"e7ed7878-3646-4378-aeb5-e04071479cd0","type":"message","user":"U01D44KSY9Z","text":"なおFLoCは入らなかった模様","ts":"1621473692.009800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zcOP"}]},{"client_msg_id":"430accef-5393-4386-a372-0ac44b025d29","type":"message","user":"U01U44T1FK2","text":"Chromeに入るということはもはやBrave、Vivaldiに入るといってもいい\nあとは待つのみ (feedly使ってるけどRSSそんなに見ない","ts":"1621470961.009400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"B/01w"}]},{"client_msg_id":"0664C7F8-9854-4957-A430-1326AF9DDFEE","type":"message","user":"UFHQ7TNT0","text":"\u003chttps://www.itmedia.co.jp/news/spv/2105/20/news051_0.html|https://www.itmedia.co.jp/news/spv/2105/20/news051_0.html\u003e\n現代版RSSリーダー","ts":"1621470751.008000","attachments":[{"fallback":"ITmedia NEWS: Chromeブラウザでお気に入りサイトを「フォロー」する機能のテスト開始（RSSベース）（要約）","id":1,"title":"Chromeブラウザでお気に入りサイトを「フォロー」する機能のテスト開始（RSSベース）（要約）","title_link":"https://www.itmedia.co.jp/news/spv/2105/20/news051_0.html","text":"Googleは、Android版ChromeブラウザのCanary版で、お気に入りのWebサイトの更新を確認できる「Follow」機能のテストを米国で開始した。フォローしたWebサイトが更新されると、「新規タブ」に表示される。RSSベースのサービスだ。","thumb_url":"https://image.itmedia.co.jp/news/articles/2105/20/yu_chrome.jpg","blocks":null,"ts":1621524000,"service_name":"ITmedia NEWS","service_icon":"http://image.itmedia.co.jp/nac/spv/news_apple-touch-icon-152x152.png","thumb_width":590,"thumb_height":512,"from_url":"https://www.itmedia.co.jp/news/spv/2105/20/news051_0.html","original_url":"https://www.itmedia.co.jp/news/spv/2105/20/news051_0.html"}],"team":"T03C4RC8V","reactions":[{"name":"hee","count":1,"users":["U7B4ZD49X"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","