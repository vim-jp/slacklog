NADScelIWNO2tnof++aTY3ofyoAbRTtjeh/Kk2N/dP5UAf//Z","username":""}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"yRFaL"}]},{"client_msg_id":"04d83ef6-1421-4ae5-9acb-bd5a81bf4093","type":"message","user":"U03C71D7H","text":"`--build-arg 'VIM_ENABLE_ALL=yes'` でビルドします","ts":"1637208363.056400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"lFHw"}]},{"client_msg_id":"d4e09330-ea59-45b1-a95d-7897cdec773a","type":"message","user":"U03C71D7H","text":"\u003chttps://github.com/thinca/dockerfile-vim/blob/fix-alpine/alpine/Dockerfile\u003e 仮で今はこうです","ts":"1637208334.056000","attachments":[{"color":"24292f","fallback":"\u003chttps://github.com/thinca/dockerfile-vim/blob/fix-alpine/alpine/Dockerfile | Dockerfile\u003e","id":1,"title":"\u003chttps://github.com/thinca/dockerfile-vim/blob/fix-alpine/alpine/Dockerfile | Dockerfile\u003e","text":"```\nFROM alpine:edge AS iconv\n\nRUN apk add --no-cache g++ make\nRUN wget --quiet --output-document - \u003chttp://ftp.gnu.org/pub/gnu/libiconv/libiconv-1.16.tar.gz\u003e | \\\n        tar -xz --strip-components=1\nRUN ./configure\nRUN make\nRUN make install\n\n\nFROM alpine:edge AS base\n\nARG VIM_ENABLE_ALL=\"\"\nARG VIM_ENABLE_GUI=\"${VIM_ENABLE_ALL}\"\nARG VIM_ENABLE_SOUND=\"${VIM_ENABLE_ALL}\"\nARG VIM_ENABLE_PERL=\"${VIM_ENABLE_ALL}\"\nARG VIM_ENABLE_PYTHON=\"${VIM_ENABLE_ALL}\"\nARG VIM_ENABLE_PYTHON3=\"${VIM_ENABLE_ALL}\"\nARG VIM_ENABLE_RUBY=\"${VIM_ENABLE_ALL}\"\nARG VIM_ENABLE_LUA=\"${VIM_ENABLE_ALL}\"\nARG VIM_ENABLE_TCL=\"${VIM_ENABLE_ALL}\"\nARG VIM_ENABLE_MZSCHEME=\"${VIM_ENABLE_ALL}\"\nARG LUA_VERSION=\"5.3\"\nARG PYTHON3_VERSION=\"\"\n\nRUN { [ -z \"${VIM_ENABLE_MZSCHEME}\" ] || \\\n      echo \"\u003chttp://dl-cdn.alpinelinux.org/alpine/edge/testing\u003e\" \u0026gt;\u0026gt; /etc/apk/repositories; } \\\n \u0026amp;\u0026amp; { [ -z \"${VIM_ENABLE_PYTHON3}\" -o \"v${PYTHON3_VERSION}\" != \"v3.7\" ] || \\\n      { echo \"\u003chttp://dl-cdn.alpinelinux.org/alpine/v3.10/main\u003e\" \u0026gt;\u0026gt; /etc/apk/repositories; \\\n      PYTHON3_VERSION_DETAIL=\"=3.7.5-r1\"; }; } \\\n \u0026amp;\u0026amp; apk add --no-cache \\\n        ncurses \\\n        acl \\\n        diffutils \\\n        gettext \\\n        ${VIM_ENABLE_GUI:+gtk+3.0 libxmu libxpm} \\\n        ${VIM_ENABLE_SOUND:+libcanberra} \\\n        ${VIM_ENABLE_PERL:+perl} \\\n        ${VIM_ENABLE_PYTHON:+python2} \\\n        ${VIM_ENABLE_PYTHON3:+python3${PYTHON3_VERSION_DETAIL}} \\\n        ${VIM_ENABLE_RUBY:+ruby} \\\n        ${VIM_ENABLE_LUA:+lua${LUA_VERSION} luajit} \\\n        ${VIM_ENABLE_TCL:+tcl} \\\n        ${VIM_ENABLE_MZSCHEME:+racket}\n\n\nFROM base AS prepare\n\nRUN apk add \\\n        gcc \\\n        libc-dev \\\n        make \\\n        gettext-dev \\\n        ncurses-dev \\\n        acl-dev \\\n        ${VIM_ENABLE_GUI:+gtk+3.0-dev libxmu-dev libxpm-dev} \\\n        ${VIM_ENABLE_SOUND:+libcanberra-dev} \\\n        ${VIM_ENABLE_PERL:+perl-dev} \\\n        ${VIM_ENABLE_PYTHON:+python2-dev} \\\n        ${VIM_ENABLE_PYTHON3:+python3-dev} \\\n        ${VIM_ENABLE_RUBY:+ruby-dev} \\\n        ${VIM_ENABLE_LUA:+lua${LUA_VERSION}-dev luajit-dev} \\\n        ${VIM_ENABLE_TCL:+tcl-dev} \\\n        ${VIM_ENABLE_MZSCHEME:+racket-dev}\nRUN [ -z \"${VIM_ENABLE_MZSCHEME}\" ] || raco pkg install --batch --auto cext-lib\n\n\nFROM prepare AS build\n\nARG VIM_VERSION=master\nARG VIM_COMPILEDBY=\"\"\n\nRUN mkdir -p /usr/src/vim\nRUN wget --quiet --output-document - \\\n        \"\u003chttps://github.com/vim/vim/archive/${VIM_VERSION}.tar.gz\u003e\" | \\\n        tar xz --directory=/usr/src/vim --strip-components=1\nWORKDIR /usr/src/vim\nRUN ./configure \\\n        --with-features=huge \\\n        ${VIM_COMPILEDBY:+--with-compiledby=\"${VIM_COMPILEDBY}\"} \\\n        ${VIM_ENABLE_GUI:+--enable-gui=gtk3} \\\n        ${VIM_ENABLE_PERL:+--enable-perlinterp} \\\n        ${VIM_ENABLE_PYTHON:+--enable-pythoninterp} \\\n        ${VIM_ENABLE_PYTHON3:+--enable-python3interp} \\\n        ${VIM_ENABLE_RUBY:+--enable-rubyinterp} \\\n        ${VIM_ENABLE_LUA:+--enable-luainterp --with-luajit} \\\n        ${VIM_ENABLE_TCL:+--enable-tclinterp} \\\n        ${VIM_ENABLE_MZSCHEME:+--enable-mzschemeinterp --with-plthome=/usr} \\\n        --enable-fail-if-missing\nRUN make\nRUN mv /usr/local /usr/local_bak\nRUN make install\n\n\nFROM base AS release\n\nLABEL maintainer=\"thinca \u0026lt;thinca+vim@gmail.com\u0026gt;\"\nLABEL org.opencontainers.image.source=\"\u003chttps://github.com/thinca/dockerfile-vim\u003e\"\n\nCOPY --from=build /usr/local /usr/local/\nCOPY --from=iconv /usr/local/include /usr/local/include/\nCOPY --from=iconv /usr/local/lib /usr/local/lib/\n\nWORKDIR /root\n\nENTRYPOINT [\"/usr/local/bin/vim\"]\n\n```","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/thinca/dockerfile-vim|thinca/dockerfile-vim\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"IZff"}]},{"client_msg_id":"bfe863ff-340b-4e0d-a592-22f22a58b946","type":"message","user":"U06BRP8VD","text":"Dockerfile、どうなってます?","ts":"1637208187.055700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"mXq"}]},{"client_msg_id":"7d1752f5-66ff-4f47-ac9d-b547cc6b2acf","type":"message","user":"U03C71D7H","text":"同じだった… edge だとそもそも動かないっぽい…?","ts":"1637208174.055300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"VFsZ"}]},{"client_msg_id":"907db972-c885-4fd0-992d-66310e5bf6e4","type":"message","user":"U03C71D7H","text":"`FROM alpine:adge` にして再ビルド中…","ts":"1637207380.054800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"j78i"}]},{"client_msg_id":"37a9cc77-ac88-4cfd-8678-7aa3fc7b7071","type":"message","user":"