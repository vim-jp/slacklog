":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"rV8+Z"}]},{"client_msg_id":"63010ea5-0638-4e76-8b08-d1a67e0d2221","type":"message","user":"U03C6TEAZ","text":"Alpine のイメージは Ubuntu のより 50% 遅いってさ。","ts":"1615183491.060400","team":"T03C4RC8V","reactions":[{"name":"majika","count":1,"users":["U7B4ZD49X"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"q8zv"}]},{"client_msg_id":"061c1445-9d34-457c-b566-81863b6e4bb0","type":"message","user":"U03C6TEAZ","text":"\u003chttps://superuser.com/questions/1219609/why-is-the-alpine-docker-image-over-50-slower-than-the-ubuntu-image\u003e","ts":"1615183473.059900","attachments":[{"fallback":"Super User: Why is the Alpine Docker image over 50% slower than the Ubuntu image?","id":1,"title":"Why is the Alpine Docker image over 50% slower than the Ubuntu image?","title_link":"https://superuser.com/questions/1219609/why-is-the-alpine-docker-image-over-50-slower-than-the-ubuntu-image","text":"I noticed that my Python application is much slower when running it on python:2-alpine3.6 than running it without Docker on Ubuntu. I came up with two small benchmark commands and there's a huge","thumb_url":"https://cdn.sstatic.net/Sites/superuser/Img/apple-touch-icon@2.png?v=e869e4459439","blocks":null,"service_name":"Super User","service_icon":"https://cdn.sstatic.net/Sites/superuser/Img/apple-touch-icon.png?v=0ad5b7a83e49","thumb_width":316,"thumb_height":316,"from_url":"https://superuser.com/questions/1219609/why-is-the-alpine-docker-image-over-50-slower-than-the-ubuntu-image","original_url":"https://superuser.com/questions/1219609/why-is-the-alpine-docker-image-over-50-slower-than-the-ubuntu-image"}],"team":"T03C4RC8V","reactions":[{"name":"eyes","count":1,"users":["UEACRCY0Z"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"yI382"}]},{"type":"message","user":"U01ATUT6PL3","text":"\u003c@U01ATUT6PL3\u003e has joined the channel","t