[{"client_msg_id":"5525de04-176b-4d33-8094-e07b755b3f58","type":"message","user":"U9S4G0LJW","text":"どうも、その道の人が制定に関わっていたっぽいですね\n参照実装はOCamlだったり\n\u003chttps://github.com/WebAssembly/spec/tree/main/interpreter\u003e","ts":"1637762013.050100","team":"T03C4RC8V","reactions":[{"name":"naruhodo","count":1,"users":["UDPT2BZ6E"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+4G"}]},{"client_msg_id":"d3602ad5-94a4-457a-80d2-f71094380205","type":"message","user":"UDPT2BZ6E","text":":goodpoem:","ts":"1637761957.049700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Awa"}]},{"client_msg_id":"802226dc-ce11-4c65-b24b-c75b24694951","type":"message","user":"U9S4G0LJW","text":"こんな具合です \u003chttps://developer.mozilla.org/ja/docs/WebAssembly/Understanding_the_text_format\u003e","ts":"1637761919.049200","attachments":[{"fallback":"WebAssembly テキストフォーマットを理解する - WebAssembly | MDN","id":1,"title":"WebAssembly テキストフォーマットを理解する - WebAssembly | MDN","title_link":"https://developer.mozilla.org/ja/docs/WebAssembly/Understanding_the_text_format","text":"人間が WebAssembly を読んだり編集するための wasm バイナリ形式のテキスト表現が存在します。これはテキストエディター、ブラウザーの開発者ツールなどで見せるために設計された中間表現です。この記事では、テキスト形式のしくみ、生の構文、および元のバイトコードの表現との関係 (と JavaScript で wasm を表現したラッパーオブジェクト) について説明します。","image_url":"https://developer.mozilla.org/mdn-social-share.0ca9dbda.png","blocks":null,"service_name":"developer.mozilla.org","service_icon":"https://developer.mozilla.org/apple-touch-icon.0ea0fa02.png","from_url":"https://developer.mozilla.org/ja/docs/WebAssembly/Understanding_the_text_format","original_url":"https://developer.mozilla.org/ja/docs/WebAssembly/Understanding_the_text_format"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"VelP"}]},{"client_msg_id":"e143b04e-5798-4f25-9b0f-f2fe18ca46f3","type":"message","user":"UDPT2BZ6E","text":"へー。wasm未履修でした。なるほど","ts":"1637761893.049000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"EN0"}]},{"client_msg_id":"e587c20b-372b-45fc-8963-fd909f60f4d4","type":"message","user":"U9S4G0LJW","text":"そういえばwasmのテキスト表現もS式ですね","ts":"1637761863.048500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ew5i"}]},{"client_msg_id":"b46b20ab-0153-4697-9c66-001dd669c9fa","type":"message","user":"UDPT2BZ6E","text":"NotationとしてはS式が最高なんだけどLispで気軽に書けるかというと。。むむむ。","ts":"1637761822.048100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zXh"}]},{"client_msg_id":"3ea08b63-4bc9-4af9-8164-989abf14d994","type":"message","user":"UDPT2BZ6E","text":"やっぱS式なんだよなー\nThe s-expression syntax is both easy to parse and easy to generate.","ts":"1637761691.047500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"89LF"}]},{"client_msg_id":"0ebf8bb2-d2c9-49ed-b950-aba0c90c8bc9","type":"message","user":"U9S4G0LJW","text":"よい","ts":"1637761691.047400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"RtSm"}]},{"client_msg_id":"93686d54-c4e4-4e60-a403-754585d65f4d","type":"message","user":"UDPT2BZ6E","text":"\u003chttps://github.com/minad/chasm\u003e\nminadさん謎プロジェクト作ってて草","ts":"1637761648.047000","attachments":[{"color":"24292f","fallback":"minad/chasm","id":1,"title":"minad/chasm","text":"Java Bytecode Assembler and Disassembler which uses S-expressions","fields":[{"title":"Stars","value":"19","short":true},{"title":"Language","value":"Java","short":true}],"blocks":null}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"88lwA"}]},{"client_msg_id":"33077e1f-ab8c-4a08-afcf-d8ae1103a311","type":"message","user":"U023FDA0AKC","text":"\u003chttps://vim-jp.slack.com/archives/C01PA2W76TV/p16