c6a93c601","type":"message","user":"U8996GYBF","text":"あぁ多分理解した","ts":"1632707699.096200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"sVgS"}]},{"client_msg_id":"eec90f9d-2427-4e11-900f-5f9e71d31d35","type":"message","user":"U01D44KSY9Z","text":"パースの挙動としては\nでもそれで解決するかはちょっと自信がない","ts":"1632707050.095300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=KDrT"}]},{"client_msg_id":"bc93a3a0-f2a9-4744-8071-c32aef3b55d4","type":"message","user":"U01D44KSY9Z","text":"たぶん `--zeno-mode` だけを特別扱いしてそれ以外をただの文字列として解釈させるのが正しそう","ts":"1632707028.094900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"XO/+"}]},{"client_msg_id":"579c1cbd-ff65-400a-9915-22094fa91041","type":"message","user":"U8996GYBF","text":"入れます","ts":"1632706968.094300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"svdIo"}]},{"client_msg_id":"7d00cc4e-d01e-413f-b91c-90fe1f822616","type":"message","user":"U01D44KSY9Z","text":"まあソケットはこれで固まった感じでいいと思います","ts":"1632706960.094100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"FJFO"}]},{"client_msg_id":"9648f0b8-9062-4570-b9d7-9c60cb2efca3","type":"message","user":"U01D44KSY9Z","text":"ちょっと分からないので検証が必要そう","ts":"1632706949.093800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"yYlX"}]},{"client_msg_id":"427b2254-8df8-412c-b8e3-fae99c5bcf35","type":"message","user":"U8996GYBF","text":"sockの方とは独立している","ts":"1632706944.093700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ix=Sw"}]},{"client_msg_id":"b580d552-d7f8-45b0-9d37-56ad3e829659","type":"message","user":"U01D44KSY9Z","text":"いや、でもそれはそれで動く気はするな","ts":"1632706934.093400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Gfco"}]},{"client_msg_id":"3517c23d-7871-4ab5-b99e-804032f41b1b","type":"message","user":"U8996GYBF","text":"これ別で直しましょう","ts":"1632706932.093200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"o8Kd"}]},{"client_msg_id":"19b700b9-1aae-43ac-a96d-54f57249bf7c","type":"message","user":"U8996GYBF","text":"あー、parse側の問題があるのか","ts":"1632706927.092900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"xXr5"}]},{"client_msg_id":"af40aa90-bb62-4c90-8533-30dae58f03dd","type":"message","user":"U01D44KSY9Z","text":"あ、なるほど理解した\nたぶんパースした時にハイフン付きの文字列が `_` に入ってない","ts":"1632706909.092500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"l04"}]},{"client_msg_id":"05611db5-8b64-41bb-b995-14b42e9628af","type":"message","user":"U8996GYBF","text":"`ls src null\u0026lt;Space\u0026gt;` だといけますね","ts":"1632706868.091800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4tly"}]},{"client_msg_id":"e2e01bf9-7c1b-4f04-afc1-521f6782dcb5","type":"message","user":"U8996GYBF","text":"単純に正規表現渡しているだけのはず","ts":"1632706843.091500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"HfN/6"}]},{"client_msg_id":"d88d8148-42e3-4659-b89f-0b15f2e6ce31","type":"message","user":"U8996GYBF","text":"なんでだこれ","ts":"1632706834.091200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"63P"}]},{"client_msg_id":"b126ec04-30ae-412f-bee7-09af77bafdbc","type":"message","user":"U01D44KSY9Z","text":"ですよね、それの話でした","ts":"1632706829.090900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"kMlg"}]},{"client_msg_id":"f32100cd-5159-4a46-8839-ca3878ded642","type":"message","user":"U8996GYBF","text":"あれ、オプションがあると動かないかも","ts":"1632706813.090500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"xbrN"}]},{"client_msg_id":"fe67776c-30cf-4ed3-84db-6a94bdf6f4ab","type":"message","user":"U8996GYBF","text":"あ、いやそれだと\n```- name: \"null\"\n  keyword: \"null\"\n  snippet: \"\u0026gt;/dev/null 2\u0026gt;\u0026amp;1\"\n  context:\n    lbuffer: '.+\\s+'```\nかな","ts":"1632706770.090200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zTGI"}]},{"client_msg_id":"f677d07e-d9d3-4ded-a43b-17cc039f1b1d","type":"message","user":"U01D44KSY9Z","text":"なんかパースの仕方を間違えてる気がする","ts":"1632706759.089900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"d8i"}]},{"client_msg_id":"e02ec5dd-d96e-498a-8700-56ade57ab0e8","type":"message","user":"U8996GYBF","text":"えっ","ts":"1632706703.089500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"R+oa8"}]},{"client_msg_id":"47b69768-04dd-40f6-bc22-4da275c25a90","type":"message","user":"U01D44KSY9Z","text":"```  - name: \"null\"\n    keyword: \"null\"\n    snippet: \"\u0026gt; /dev/null 2\u0026gt;\u0026amp;1\"\n    context:\n      lbuffer: '^\\s*'```\nで `ls -a null\u0026lt;space\u0026gt;` しても展開されないですね","ts":"1632706692.089300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Z9U"}]},{"client_msg_id":"a1682898-eae8-4a37-b65c-05093f19e372","type":"message","user":"U8996GYBF","text":"```context:\n  global: true```","ts":"1632706660.088800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"IhB"}]},{"client_msg_id":"7b20f247-3e03-4526-bcd1-79816bfece40","type":"message","user":"U8996GYBF","text":"contextにglobal単体指定あった方がいいですかね","ts":"1632706652.088200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"I1yX"}]},{"client_msg_id":"6cc2769c-fe95-46b6-93a8-bb288b72c6df","type":"message","user":"U8996GYBF","text":"`^\\s*` か","ts":"1632706622.087800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"C6O"}]},{"client_msg_id":"619181e9-26e0-44a2-acf1-c826008a5cd7","type":"message","user":"U8996GYBF","text":"じゃあOKで、contextって `'\\s*'` とかにしたら動きません？","ts":"1632706588.087200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"T0H7v"}]},{"client_msg_id":"55636bce-884b-401a-ba3b-80972360dfd9","type":"message","user":"U01D44KSY9Z","text":"`kill -9 $ZENO_PID` してもちゃんとフォールバックされてそう","ts":"1632706516.086000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"WZT"}]},{"client_msg_id":"2d00792a-fcd5-4867-9e38-9f4516bfc5a3","type":"message","user":"U01D44KSY9Z","text":"contextを指定してる時にLBUFFERにスペースがあると展開されないのが気になるぐらいですかね\nソケットは残ってても動作そのものに支障はなさそうです（確認済み）","ts":"1632706483.085600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"3yI"}]},{"client_msg_id":"a698fb00-e7ca-4011-bb48-f61281938e06","type":"message","user":"U8996GYBF","text":"それ以前に絶対にぶつからないようにするなら\n```ZENO_SOCK_DIR=\"/tmp/zeno-${$}\"\nZENO_SOCK=\"${ZENO_SOCK_DIR}/zeno-${random}.sock\"```\nとかもありかもしれない","ts":"1632706477.085500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ZLSN"}]},{"client_msg_id":"d514fa04-a615-4cd5-9502-5fea3fab7922","type":"message","user":"U8996GYBF","text":"強いて言うならsockファイルが万が一残ってる場合を考えて初期化処理中にrmを走らせてもいいくらい","ts":"1632706354.083700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/bK5"}]},{"client_msg_id":"e7990fd6-7eae-42be-a086-bb235873f8cc","type":"message","user":"U8996GYBF","text":"\u003c@U01D44KSY9Z\u003e もうこれマージしちゃいます？","ts":"1632705970.082600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"eYOn0"}]},{"type":"message","user":"U02G79NJMLY","text":"\u003c@U02G79NJMLY\u003e has joined the channel","ts":"1632703491.082300","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null},{"client_msg_id":"87103b3a-a315-4a96-ad38-8274b8b38e42","type":"message","user":"U8996GYBF","text":"ゴミ消しときました","ts":"1632699282.081900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"7Pite"}]}]
