":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ak/Y"}]},{"client_msg_id":"b953c837-e4a2-4f4c-8e98-5ae1b9c2a189","type":"message","user":"UKHUVMBJR","text":"自前で、cd履歴保存\u0026amp;fuzzy findするスクリプト作ってそれで満たされてるな","ts":"1631888331.248000","team":"T03C4RC8V","reactions":[{"name":"me-too","count":1,"users":["U9S4G0LJW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hJ8=A"}]},{"client_msg_id":"2bcbf494-1b3a-4967-8633-5672ad758b61","type":"message","user":"U9S4G0LJW","text":"作業の最適化をしたら変わるのかもしれない、結構雑なので","ts":"1631888304.246700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"MaHUy"}]},{"client_msg_id":"d6b2e0ab-5a0f-4841-9cbf-f226b772695d","type":"message","user":"U03C71D7H","text":"`cd -` してしまうので popd は使ってないな","ts":"1631888301.246500","team":"T03C4RC8V","reactions":[{"name":"wakaru","count":1,"users":["U8CC7MDCL"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"yty"}]},{"client_msg_id":"22c05b56-9de9-4bf2-96f3-2cf84c301806","type":"message","user":"U9S4G0LJW","text":"cdしまくる","ts":"1631888259.246000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"LRxA"}]},{"client_msg_id":"3cbe75b0-c9f6-48dc-9de7-adc029d91604","type":"message","user":"U8996GYBF","text":"`alias p=popd`","ts":"1631888245.245800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jeQ"}]},{"client_msg_id":"19da3854-a42e-42b3-86a8-4cf9b7e839ae","type":"message","user":"U8996GYBF","text":"cdすることが全然ないのでpopdで足りてしまっている","ts":"1631888221.245600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"KxgN"}]},{"client_msg_id":"c567f335-ea31-4ce8-b4c5-6f6e9dc07095","type":"message","user":"U022XK5866Q","text":"つかってます。いいですよねー","ts":"1631888200.245200","team":"T03C4RC8V","reactions":[{"name":"wakarite","count":1,"users":["U9S4G0LJW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fAkM5"}]},{"client_msg_id":"ca15fd23-ed1d-46ee-822d-97ed2de3cd89","type":"message","user":"U9S4G0LJW","text":"随分前はpushd/popd使っていたけど確実に狙った場所に飛べる方が嬉しかったですね","ts":"1631887944.244900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"rL+"}]},{"client_msg_id":"e021d6d7-48c9-48ae-baaf-0002fb7c2689","type":"message","user":"U9S4G0LJW","text":"脳内スタックの容量が少なすぎて…","ts":"1631887914.244300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"pWTe"}]},{"client_msg_id":"94464770-4e89-4f4a-9c16-0e9333be4710","type":"message","user":"U8996GYBF","text":"popdでは不足です？","ts":"1631887872.243900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"HaHll"}]},{"client_msg_id":"eaba3ec6-6490-43be-ac11-a636f9e462dc","type":"message","user":"U9S4G0LJW","text":"ついったーでこれ聞いたけど便利だ\n\u003chttps://github.com/mollifier/cd-gitroot\u003e","ts":"1631886623.243600","attachments":[{"color":"24292f","fallback":"mollifier/cd-gitroot","id":1,"title":"mollifier/cd-gitroot","text":"zsh plugin to cd to git repository root directory.","fields":[{"title":"Stars","value":"60","short":true},{"title":"Language","value":"Shell","short":true}],"blocks":null}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"GHdrE"}]},{"client_msg_id":"f3c140c3-f3b5-4ccc-9bfe-d2e6a2cb3030","type":"message","user":"UAZ33BKV2","text":"```-- alias\n-- git outer function\nif nyagos.which(\"git.exe\") then\n  nyagos.alias.gitop = function(args)\n    if nyagos.eval('git rev-parse --is-inside-work-tree 2\u0026gt; nul') == 'true' then\n      nyagos.chdir(nyagos.eval('git rev-parse --show-toplevel'))\n    else\n      print(\"not in git repo.\")\n    end\n  end\nend```\nと\n```# git: to top\n# function gitop\ngitop () {\n  if [ \"$(git rev-parse --is-inside-work-tree 2\u0026gt; /dev/null)\" ]; then\n    cd \"$(git rev-parse --show-toplevel)\" || return\n  else\n    echo not in git repo.\n  fi\n}```","ts":"1631888484.251800","thread_ts":"1631888343.248400","parent_user_id":"UAZ33BKV2","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"aT/"}]}]
