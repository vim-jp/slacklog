ce_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"pFOmQ"}]},{"client_msg_id":"729f8fda-e920-41c0-a175-4dcd893fe29f","type":"message","user":"U022XK5866Q","text":"これでワンライナー?\n```fg nvim 2\u0026gt; /dev/null || nvim```","ts":"1631344888.200200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"h72Ol"}]},{"client_msg_id":"f2ff210f-fef1-4e63-812b-a4a64166e051","type":"message","user":"U01AQ5BFNLX","text":"なるほど","ts":"1631316881.199600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"bhca6"}]},{"client_msg_id":"d4ed9fbe-5cd6-4050-9b5c-06ae88799e7f","type":"message","user":"U022XK5866Q","text":"`grep -q` 使うと `dev/null`に捨てなくてよくて良さげです。\n`if jobs | grep -E -q \"\\svim$\"`","ts":"1631316781.199400","team":"T03C4RC8V","reactions":[{"name":"hee","count":1,"users":["U9S4G0LJW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"2amP"}]},{"client_msg_id":"ff789222-e351-4b5a-86fd-1450cc5ddbd3","type":"message","user":"U01AQ5BFNLX","text":"```function startVim(){\n  jobs | grep \"vim\" \u0026gt; /dev/null\n\n  if [ $? = 0 ]; then\n    fg vim\n  else\n    vim\n  fi\n}```","ts":"1631313361.197400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"KDqo="}]},{"client_msg_id":"d87b89c5-358d-4a72-9309-dab068e6bc5b","type":"message","user":"U01AQ5BFNLX","text":"超雑ですが、サスペンドしているvimプロセスがあったときに、そのプロセスを使うようにする関数のラフを作りました","ts":"1631313355.196900","edited":{"user":"U01AQ5BFNLX","ts":"1631313811.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"mceD"}]}]
