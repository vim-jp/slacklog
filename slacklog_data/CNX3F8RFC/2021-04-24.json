238017.112300","thread_ts":"1619238017.112300","last_read":"1619276717.137100","subscribed":true,"reply_count":9,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Il9ft"}]}},{"client_msg_id":"f6a784d9-ab7b-4e7b-b267-7d71e9f416c8","type":"message","user":"UFHQ7TNT0","text":"```export ASDF_CONFIG_FILE=$XDG_CONFIG_HOME/asdf/config\nexport ASDF_DIR=$XDG_DATA_HOME/asdf\nexport ASDF_DATA_DIR=$XDG_DATA_HOME/asdf```\nひとまず、これでいってみます","ts":"1619238731.118200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"p1nC"}]},{"client_msg_id":"c1d75620-2172-4c05-9f1e-7a2670da9253","type":"message","user":"U01AQ5BFNLX","text":"ASDF_DATA_DIR はシェルの設定ファイルにかくかんじか","ts":"1619238670.117300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4=h"}]},{"client_msg_id":"4662e704-e446-447d-9573-034a4ed54068","type":"message","user":"UFHQ7TNT0","text":"僕はそうしてみようかなと思っていま設定しています","ts":"1619238618.116700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"k8="}]},{"client_msg_id":"7dddeb6f-f947-42e8-8a20-95b5a2f9658e","type":"message","user":"U01D44KSY9Z","text":"言われてみれば `$HOME/.asdf` ディレクトリになってる\n`$HOME/.local/share/asdf` 以下に移すのが筋がいいかな","ts":"1619238141.116100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"eujYw"}]},{"client_msg_id":"35a5a8d0-a652-4a48-a381-b7df7f03a6c5","type":"message","user":"UFHQ7TNT0","text":"asdf だと`ASDF_CONFIG_FILE`と `ASDF_DIR` と `ASDF_DATA_DIR`を変更すれば大丈夫かなと思いました。","ts":"1619238119.115600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ejq"}]},{"client_msg_id":"c7ad64cb-db10-4378-8b4f-8ab97ecf3b4c","type":"message","user":"UFHQ7TNT0","text":"config ファイルとかを HOMEディレクトリ直下に置かず、XDG で定義されているディレクトリに配置できるかどうかって感じですね。","ts":"16