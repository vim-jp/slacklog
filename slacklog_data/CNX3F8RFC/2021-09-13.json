":"U022XK5866Q","text":"`export` と `bash -c`を駆使すると、スクリプト内部の関数を呼べることが分かりました\n```function preview() {\n  local FILE=\"$(\n    command echo \"$1\" \\\n      | command sed -E -e \"s/:.*//\" -e \"s/^'//\"\n  )\"\n  command cat $FILE\n}\n\nexport -f preview\nrg test | fzf --preview 'bash -c \"preview \\\"{}\\\"\"'```","ts":"1631532568.229900","thread_ts":"1631497224.211900","subtype":"thread_broadcast","reactions":[{"name":"sugoi","count":1,"users":["U9S4G0LJW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"lWMA1"}],"root":{"client_msg_id":"e7c60ef5-45ea-4ade-a85e-150af39557e4","type":"message","user":"U8996GYBF","text":"zenoで内部で生成してfzfに渡しているワンライナーです\n```--bind=\"ctrl-b:reload(git for-each-ref refs/heads refs/remotes --color=always --format='%(color:green)[branch]%09%(color:reset)%(color:magenta)%(refname:short)%(color:reset) %(color:yellow)%(authordate:short) %(color:reset) %(color:blue)[%(authorname)]%(color:reset)%09' 2\u0026gt; /dev/null | column -t),ctrl-c:reload(git log --decorate --color=always --format='%C(green)[commit]  %Creset%C(magenta)%h%Creset %C(yellow)%cr %x09%Creset [%C(blue)%an%Creset] %x09%C(auto)%s %d'),ctrl-t:reload(git for-each-ref refs/tags --color=always --format='%(color:green)[tag]%09%(color:reset)%(color:magenta)%(refname:short)%(color:reset) %(color:yellow)%(authordate:short) %(color:reset) %(color:blue)[%(authorname)]%(color:reset)%09' 2\u0026gt; /dev/null | column -t),ctrl-r:reload(git reflog --decorate --color=always --format='%C(green)[reflog]  %Creset%C(magenta)%h%Creset %C(yellow)%cr %x09%Creset [%C(blue)%an%Creset] %x09%C(auto)%s %d' 2\u0026gt; /dev/null)\" --expect=\"alt-enter\" --preview=\"[[ '{1}' == '[branch]' ]] \u0026amp;\u0026amp; git log {2} --decorate --pretty='format:%C(yellow)%h %C(green)%cd %C(reset)%s %C(red)%d %C(cyan)[%an]' --date=iso --graph --color=always || [[ '{1}' == '[tag]' ]] \u0026amp;\u0026amp; git log {2} --pretty='format:%C(yellow)%h %C(green)%cd %C(reset)%s %C(red)