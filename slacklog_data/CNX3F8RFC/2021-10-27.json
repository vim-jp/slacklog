container%3Afirst-of-type%2C%20div%5Bitemtype%3D%22http%3A%2F%2Fschema.org%2FSoftwareSourceCode%22%5D%20main%3Afirst-of-type%2C%20%5Bdata-pjax-container%5D%3Afirst-of-type#L181-L182|https://github.com/yuki-yano/zeno.zsh/blob/b49600b899fa771d8a3ca8d75eb19ae3bb41964[…]%3Afirst-of-type%2C%20%5Bdata-pjax-container%5D%3Afirst-of-type\u003e","ts":"1635294359.083700","attachments":[{"color":"24292f","fallback":"\u003chttps://github.com/yuki-yano/zeno.zsh/blob/b49600b899fa771d8a3ca8d75eb19ae3bb419645/src/app.ts | app.ts\u003e","id":1,"title":"\u003chttps://github.com/yuki-yano/zeno.zsh/blob/b49600b899fa771d8a3ca8d75eb19ae3bb419645/src/app.ts | app.ts\u003e","text":"```\n    const args = command.split(/ +/);\n    const parsedArgs = argsParser(args, argsParseOption);\n```","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/yuki-yano/zeno.zsh|yuki-yano/zeno.zsh\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"WzK"}]},{"client_msg_id":"05902dcd-0476-4bc6-bd5e-4d7bed03a439","type":"message","user":"U8996GYBF","text":"ここかなぁ\n\u003chttps://github.com/yuki-yano/zeno.zsh/blob/b49600b899fa771d8a3ca8d75eb19ae3bb419645/src/app.ts?_pjax=%23js-repo-pjax-container%3Afirst-of-type%2C%20div%5Bitemtype%3D%22http%3A%2F%2Fschema.org%2FSoftwareSourceCode%22%5D%20main%3Afirst-of-type%2C%20%5Bdata-pjax-container%5D%3Afirst-of-type#L118-L135|https://github.com/yuki-yano/zeno.zsh/blob/b49600b899fa771d8a3ca8d75eb19ae3bb41964[…]%3Afirst-of-type%2C%20%5Bdata-pjax-container%5D%3Afirst-of-type\u003e","ts":"1635294246.083200","attachments":[{"color":"24292f","fallback":"\u003chttps://github.com/yuki-yano/zeno.zsh/blob/b49600b899fa771d8a3ca8d75eb19ae3bb419645/src/app.ts | app.ts\u003e","id":1,"title":"\u003chttps://github.com/yuki-yano/zeno.zsh/blob/b49600b899fa771d8a3ca8d75eb19ae3bb419645/src/app.ts | app.ts\u003e","text":"```\n    case \"completion\": {\n      const buffer = input.replace(/\\n$/, \"\");\n      const source = completion(buffer);\n\n      if (source != null) {\n        await write({ format: \"%s\\n\", text: \"success\" });\n        await write({ format: \"%s\\n\", text: source.sourceCommand });\n        await write({\n          format: \"%s\\n\",\n          text: fzfOptionsToString(source.options),\n        });\n        await write({ format: \"%s\\n\", text: source.callback });\n      } else {\n        await write({ format: \"%s\\n\", text: \"failure\" });\n      }\n\n      break;\n    }\n```","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/yuki-yano/zeno.zsh|yuki-yano/zeno.zsh\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"JW1Z"}]},{"client_msg_id":"2b120c32-58fd-4b36-87e1-4bf9b4262292","type":"message","user":"U022XK5866Q","text":"そうですね","ts":"1635294161.082900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"02Nh"}]},{"client_msg_id":"2802f1eb-ae0c-4c00-9954-064473570943","type":"message","user":"U8996GYBF","text":"補完ですよね","ts":"1635294152.082700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"RO/qw"}]},{"client_msg_id":"2b4476af-b7ea-4d41-9cf5-75a89a2e16c4","type":"message","user":"U8996GYBF","text":"あ、違うかも","ts":"1635294149.082500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"YXkH"}]},{"client_msg_id":"07e7b303-5e82-40f1-800f-ada4c279ad59","type":"message","user":"U022XK5866Q","text":"ありがとうございます。見てみます！JS/TSでテスト書いたことないので挑戦したいが、まずは機能修正のPRから……。","ts":"1635294110.082300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0zWa7"}]},{"client_msg_id":"3a420704-19d0-4964-aa6c-1de5326013c6","type":"message","user":"U8996GYBF","text":"ファイルとしてはここと思います（テスト書きたい）\n\u003chttps://github.com/yuki-yano/zeno.zsh/blob/main/src/snippet/auto-snippet.ts\u003e","ts":"1635294024.081200","attachments":[{"color":"24292f","fallback":"\u003chttps://github.com/yuki-yano/zeno.zsh/blob/main/src/snippet/auto-snippet.ts | auto-snippet.ts\u003e","id":1,"title":"\u003chttps://github.com/yuki-yano/zeno.zsh/blob/main/src/snippet/auto-snippet.ts | auto-snippet.ts\u003e","text":"```\nimport { loadSnippets } from \"./settings.ts\";\nimport { exec, OutputMode } from \"../deps.ts\";\nimport { Snippet } from \"../type/settings.ts\";\n\ntype AutoSnippetData = {\n  status: \"success\";\n  buffer: string;\n  cursor: number;\n} | {\n  status: \"failure\";\n  buffer?: undefined;\n  cursor?: undefined;\n};\n\nconst isStartLine = (lbuffer: string, keyword: string) =\u0026gt; {\n  const regexp = new RegExp(`^${keyword}\\s*$`);\n  if (regexp.exec(lbuffer) == null) {\n    return false;\n  }\n\n  return true;\n};\n\nconst matchContext = (buffer: string, context: string): boolean =\u0026gt; {\n  const bufferRegex = new RegExp(context);\n  if (bufferRegex.exec(buffer) == null) {\n    return false;\n  }\n\n  return true;\n};\n\nexport const autoSnippet = async (input: string): Promise\u0026lt;AutoSnippetData\u0026gt; =\u0026gt; {\n  const buffer = input.split(\"\\n\").join(\" \");\n  const [lbuffer, ..._rbuffer] = input.split(\"\\n\");\n  const tokens = lbuffer.split(\" \");\n\n  let lbufferWithoutLastWord: string | undefined;\n  if (tokens.length === 1) {\n    lbufferWithoutLastWord = undefined;\n  } else {\n    lbufferWithoutLastWord = `${tokens.slice(0, -1).join(\" \")} `;\n  }\n\n  const lastWord = lbuffer.trim().split(\" \").at(-1);\n  const rbuffer = _rbuffer.join(\"\\n\");\n\n  if (/(^$|^\\s)/.exec(rbuffer) == null) {\n    return { status: \"failure\" };\n  }\n\n  const placeholderRegex = /\\{\\{\\S*\\}\\}/;\n\n  const snippets = loadSnippets();\n  for (let { snippet, keyword, context, evaluate } of snippets) {\n    if (keyword == null) {\n      continue;\n    }\n\n    if (context == null) {\n      if (!isStartLine(lbuffer, keyword)) {\n        continue;\n      }\n    } else if (context != null \u0026amp;\u0026amp; context.global !== true) {\n      const {\n        buffer: bufferContext,\n        lbuffer: lbufferContext,\n        rbuffer: rbufferContext,\n      } = context;\n\n      if (bufferContext != null \u0026amp;\u0026amp; !matchContext(buffer, bufferContext)) {\n        continue;\n      }\n      if (lbufferContext != null \u0026amp;\u0026amp; !matchContext(lbuffer, lbufferContext)) {\n        continue;\n      }\n      if (rbufferContext != null \u0026amp;\u0026amp; !matchContext(rbuffer, rbufferContext)) {\n        continue;\n      }\n    }\n\n    if (keyword === lastWord) {\n      const placeholderMatch = placeholderRegex.exec(snippet);\n\n      let cursor: number;\n      if (placeholderMatch == null) {\n        cursor = (lbufferWithoutLastWord?.length ?? 0) + snippet.length + 1;\n      } else {\n        snippet = snippet.replace(placeholderRegex, \"\");\n        cursor = (lbufferWithoutLastWord?.length ?? 0) + placeholderMatch.index;\n      }\n\n      const snipText = evaluate === true\n        ? (await exec(snippet, { output: OutputMode.Capture })).output.trimEnd()\n        : snippet;\n\n      return {\n        status: \"success\",\n        buffer: `${lbufferWithoutLastWord ?? \"\"}${snipText}${rbuffer}`.trim(),\n        cursor,\n      };\n    }\n  }\n\n  return { status: \"failure\" };\n};\n\n```","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/yuki-yano/zeno.zsh|yuki-yano/zeno.zsh\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0sZt"}]},{"client_msg_id":"63803b8e-d900-488f-a817-a82339501eff","type":"message","user":"U8996GYBF","text":"bufferの取得がバグってるのかな","ts":"1635293921.080900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5ijJ"}]},{"client_msg_id":"8258cf70-527c-4bf3-be12-7d5072937721","type":"message","user":"U8996GYBF","text":"お、今気付きました","ts":"1635293888.080600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"heyNg"}]},{"client_msg_id":"0ffd6c33-f94a-44f3-9bc8-02955e049735","type":"message","user":"U022XK5866Q","text":"`console.warn`してみたところ、`buffer`から末尾の `--`が削られてるっぽいですね","ts":"1635293212.080400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"qzLiD"}]},{"client_msg_id":"84b29062-a8d1-4866-9199-4a5756a735f5","type":"message","user":"U022XK5866Q","text":"\u003c@U8996GYBF\u003e zeno.zshで`git diff --` した時、git diff fileじゃなくてgit diffが開いてしまうので修正しようとしてます。元の`(-|--)\\S+` が `-\\S+`で `--`にマッチするのが問題だと思うのですが、なぜかそこを修正してもうまくいきません。なんなら以下のようにしてもなぜか `git diff --`をマッチしてしまいます……。なぜかわかりますか？\n```{\n  name: \"git diff\",\n  patterns: [\n    /^git diff $/\n  ],\n  ...\n}```\n\u003chttps://github.com/atusy/zeno.zsh/commit/84915adfbf7df30c76fde73b4539a2811dffb1c9\u003e","ts":"1635267827.079100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"NnNn"}]}]
