id":"k7Tk"}]},{"client_msg_id":"5b394adc-813c-4c75-ac24-01799209295c","type":"message","user":"U8996GYBF","text":"```diff --git a/src/app.ts b/src/app.ts\nindex 23449e9..7010aa3 100644\n--- a/src/app.ts\n+++ b/src/app.ts\n@@ -17,6 +17,7 @@ const argsParseOption = {\n   string: [\"zeno-mode\"],\n   configuration: {\n     \"unknown-options-as-args\": true,\n+    \"populate--\": true,\n   },\n };\n \n@@ -180,7 +181,9 @@ export const exec = async ({ zenoMode }: { zenoMode: \"cli\" | \"server\" }) =\u0026gt; {\n     const mode = (argsParser(Deno.args) as Args)[\"zeno-mode\"];\n     const args = command.split(/ +/);\n     const parsedArgs = argsParser(args, argsParseOption);\n-    const input = parsedArgs._.join(\" \");\n+    const input = `${parsedArgs._.join(\" \")} ${\n+      parsedArgs[\"--\"]?.join(\" \") ? `-- ${parsedArgs[\"--\"]?.join(\" \")}` : \"\"\n+    }`;\n \n     await execCommand({ mode, input });\n     Deno.exit(0);```\nこうですね","ts":"1635295138.090300","team":"T03C4RC8V","reactions":[{"name":"+1","count":1,"users":["U022XK5866Q"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"iGP"}]},{"client_msg_id":"4bc3d0f0-20f5-4050-b531-41bc6f52985b","type":"message","user":"U8996GYBF","text":"```$ echo \"git diff -- \" | zeno --zeno-mode=completion\ngit diff --\n\n\n$ echo \"git diff -- a b\" | zeno --zeno-mode=completion\ngit diff -- a b```","ts":"1635295101.089900","team":"T03C4RC8V","reactions":[{"name":"party-parrot","count":1,"users":["U022XK5866Q"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"TpR"}]},{"client_msg_id":"17f2bb43-9c18-4261-a160-e7d045f54267","type":"message","user":"U8996GYBF","text":"あー、いやいけそう","ts":"1635294847.089400","team":"T03C4RC8V","reactions":[{"name":"otxu","count":1,"users":["U022XK5866Q"]},{"name":"oxtu","count":1,"users":["U022XK5866Q"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"i0G"}]},{"client