8RFC\u003e","ts":"1632017575.260500","attachments":[{"fallback":"[September 17th, 2021 7:21 AM] tsuyoshi_cho: ```-- alias\n-- git outer function\nif nyagos.which(\"git.exe\") then\n  nyagos.alias.gitop = function(args)\n    if nyagos.eval('git rev-parse --is-inside-work-tree 2\u0026gt; nul') == 'true' then\n      nyagos.chdir(nyagos.eval('git rev-parse --show-toplevel'))\n    else\n      print(\"not in git repo.\")\n    end\n  end\nend```\nと\n```# git: to top\n# function gitop\ngitop () {\n  if [ \"$(git rev-parse --is-inside-work-tree 2\u0026gt; /dev/null)\" ]; then\n    cd \"$(git rev-parse --show-toplevel)\" || return\n  else\n    echo not in git repo.\n  fi\n}```","id":1,"author_id":"UAZ33BKV2","author_name":"Tsuyoshi CHO","author_subname":"Tsuyoshi CHO","author_link":"https://vim-jp.slack.com/team/UAZ33BKV2","author_icon":"https://avatars.slack-edge.com/2018-05-31/373472791093_ed16847a152da533e013_48.png","text":"```-- alias\n-- git outer function\nif nyagos.which(\"git.exe\") then\n  nyagos.alias.gitop = function(args)\n    if nyagos.eval('git rev-parse --is-inside-work-tree 2\u0026gt; nul') == 'true' then\n      nyagos.chdir(nyagos.eval('git rev-parse --show-toplevel'))\n    else\n      print(\"not in git repo.\")\n    end\n  end\nend```\nと\n```# git: to top\n# function gitop\ngitop () {\n  if [ \"$(git rev-parse --is-inside-work-tree 2\u0026gt; /dev/null)\" ]; then\n    cd \"$(git rev-parse --show-toplevel)\" || return\n  else\n    echo not in git repo.\n  fi\n}```","mrkdwn_in":["text"],"blocks":null,"footer":"From a thread in #tech-cli","ts":1631888484.251800,"from_url":"https://vim-jp.slack.com/archives/CNX3F8RFC/p1631888484251800?thread_ts=1631888343.248400\u0026amp;cid=CNX3F8RFC","original_url":"https://vim-jp.slack.com/archives/CNX3F8RFC/p1631888484251800?thread_ts=1631888343.248400\u0026amp;cid=CNX3F8RFC"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Z0AR"}]},{"client_msg_id":"5835f525-ee09-482c-82a1-04978fe2547d","type":"message","user":"U9S4G0LJW","text":"rev-parse色々できるっぽいので把握しておきたい","ts":"1632017558.260300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"VBV"}]},{"client_msg_id":"550a0e4c-2ff9-4807-a0c5-b02c623b92e5","type":"message","user":"URNBMPJ4C","text":"execはどちらかというとcdせずにrootで実行するときに、rootを知るだけなら `git rev-parse --show-toplevel` でも。","ts":"1632017446.259700","edited":{"user":"URNBMPJ4C","ts":"1632017456.000000"},"team":"T03C4RC8V","reactions":[{"name":"tips","count":1,"users":["U9S4G0LJW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"O4Dq"}]},{"client_msg_id":"3f8dd021-bef7-45e5-8c62-24d79abc044e","type":"message","user":"URNBMPJ4C","text":"aliasに↓設定すると `cd \"$(git exec pwd)\"` でrootに移動できる。\n```[alias]\n\texec = \"!exec \"```","ts":"1632012788.258400","team":"T03C4RC8V","reactions":[{"name":"tips","count":3,"users":["UAZ33BKV2","U01J8RHFH3P","U9S4G0LJW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"gcL"}]},{"type":"message","user":"U02EUQX77L3","text":"\u003c@U02EUQX77L3\u003e has joined the channel","ts":"1632008553.256800","subtype":"channel_join","replace_original":false,"delete_original":false,"blocks":null},{"client_msg_id":"fbd984c9-9b04-44ed-8b0e-6efa8486fc26","type":"message","user":"U03C71D7H","text":"それだ","ts":"1632026408.276200","thread_ts":"1632023621.265200","parent_user_id":"U03C71D7H","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0vWr"}]}]
