ial/01/bk/0001","original_url":"https://gihyo.jp/dev/serial/01/bk/0001"}],"team":"T03C4RC8V","reactions":[{"name":"eyes","count":2,"users":["U022TD5GGKE","U013QL1RAPN"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Do2"}]},{"client_msg_id":"508E45AE-6ACF-47CD-B549-DA3EC4D3D906","type":"message","user":"U022TD5GGKE","text":"奥が深い症候群とヤクの毛刈り症の合併症により瀕死","ts":"1624851275.452500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"h2C"}]},{"client_msg_id":"2a359374-ea64-4ae5-afd7-705b76550af9","type":"message","user":"UAZ33BKV2","text":"闇なことが多い (くっくっくの絵文字がわからない)","ts":"1624851123.450400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"6WJ"}]},{"client_msg_id":"c270e445-c124-4447-b4cc-5a9ea818a6fb","type":"message","user":"U01D44KSY9Z","text":"本当に深いのは奥なのか\n実は沼ではないのか","ts":"1624850940.449600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fMRTI"}]},{"client_msg_id":"0920c255-5c91-4fda-abbd-226bfb3d37a3","type":"message","user":"U9S4G0LJW","text":"シェルスクリプト無限につらいのでDenoに倒すことにした","ts":"1624850887.449000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jLL2"}]},{"client_msg_id":"7279652c-2b69-4cc8-a94a-5f49f954f570","type":"message","user":"UKHUVMBJR","text":"\u003chttp://0xcc.net/misc/bad-knowhow.html|http://0xcc.net/misc/bad-knowhow.html\u003e\n奥が深い症候群、なるほどな","ts":"1624850723.448900","team":"T03C4RC8V","reactions":[{"name":"eyes","count":1,"users":["U022TD5GGKE"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"vIj="}]},{"client_msg_id":"d1ceceb5-692c-4511-8551-843d57903339","type":"message","user":"UAZ33BKV2","text":"\u003chttps://qiita.com/ko1nksm/items/5018649160820006bdf6\u003e\nを見たりした","ts":"1624849610.448300","attachments":[{"fallback":"Qiita: なぜシェルスクリプトはPOSIXに準拠しても環境依存が激しいのか？ 〜POSIXの問題点とその解決策の案〜 - Qiita","id":1,"title":"なぜシェルスクリプトはPOSIXに準拠しても環境依存が激しいのか？ 〜POSIXの問題点とその解決策の案〜 - Qiita","title_link":"https://qiita.com/ko1nksm/items/5018649160820006bdf6","text":"まえがき この記事は「シェルスクリプトで高い移植性と生産性を両立させるシリーズ」の第一弾です。移植性と生産性を両立させるための前提知識として POSIX コマンドの問題点について解説します。第二弾では高い移植性と互換性を実現させ...","image_url":"https://qiita-user-contents.imgix.net/https%3A%2F%2Fcdn.qiita.com%2Fassets%2Fpublic%2Farticle-ogp-background-1150d8b18a7c15795b701a55ae908f94.png?ixlib=rb-4.0.0\u0026w=1200\u0026mark=https%3A%2F%2Fqiita-user-contents.imgix.net%2F~text%3Fixlib%3Drb-4.0.0%26w%3D840%26h%3D380%26txt%3D%25E3%2581%25AA%25E3%2581%259C%25E3%2582%25B7%25E3%2582%25A7%25E3%2583%25AB%25E3%2582%25B9%25E3%2582%25AF%25E3%2583%25AA%25E3%2583%2597%25E3%2583%2588%25E3%2581%25AFPOSIX%25E3%2581%25AB%25E6%25BA%2596%25E6%258B%25A0%25E3%2581%2597%25E3%2581%25A6%25E3%2582%2582%25E7%2592%25B0%25E5%25A2%2583%25E4%25BE%259D%25E5%25AD%2598%25E3%2581%258C%25E6%25BF%2580%25E3%2581%2597%25E3%2581%2584%25E3%2581%25AE%25E3%2581%258B%25EF%25BC%259F%2520%25E3%2580%259CPOSIX%25E3%2581%25AE%25E5%2595%258F%25E9%25A1%258C%25E7%2582%25B9%25E3%2581%25A8%25E3%2581%259D%25E3%2581%25AE%25E8%25A7%25A3%25E6%25B1%25BA%25E7%25AD%2596%25E3%2581%25AE%25E6%25A1%2588%25E3%2580%259C%26txt-color%3D%2523333%26txt-font%3DHiragino%2520Sans%2520W6%26txt-size%3D54%26txt-clip%3Dellipsis%26txt-align%3Dcenter%252Cmiddle%26s%3D5af1b0cdde3dff2dbb8c4d0541df26d1\u0026mark-align=center%2Cmiddle\u0026blend=https%3A%2F%2Fqiita-user-contents.imgix.net%2F~text%3Fixlib%3Drb-4.0.0%26w%3D840%26h%3D500%26txt%3D%2540ko1nksm%26txt-color%3D%2523333%26txt-font%3DHiragino%2520Sans%2520W6%26txt-size%3D45%26txt-align%3Dright%252Cbottom%26s%3Dfcfeb18598402cb05b3bfb89f6e4de55\u0026blend-align=center%2Cmiddle\u0026blend-mode=normal\u0026s=9eb5853ea11f12307e00d968a55318f7","blocks":null,"service_name":"Qiita","service_icon":"https://cdn.qiita.com/assets/favicons/public/apple-touch-icon-ec5ba42a24ae923f16825592efdc356f.png","from_url":"https://qiita.com/ko1nksm/items/5018649160820006bdf6","original_url":"https://qiita.com/ko1nksm/items/5018649160820006bdf6"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"UrV7"}]},{"client_msg_id":"69adc819-9f47-49da-bb3a-faca45fd2920","type":"message","user":"UDPT2BZ6E","text":"ベン図が。。とりあえずAWSのレポジトリにはあまり細かいこと書かずに、さっきのsuperuserの回答みたいにPOSIX saysって書こうと思います。\nありがとうございます!","ts":"1624848969.448000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Ed4"}]},{"client_msg_id":"50c44548-2474-4d98-9966-c55adc977158","type":"message","user":"U06ECBRTJ","text":"んー \u003chttps://pubs.opengroup.org/onlinepubs/9699919799/basedefs/contents.html\u003e\nを見ると、 `The Open Group Base Specifications Issue 7, 2018 edition` の中に、`Base Definitions: Detailed ToC` がありますね","ts":"1624848839.447700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"QeH1M"}]},{"client_msg_id":"d2288488-597f-4480-b944-fe0abf23e648","type":"message","user":"U022XK5866Q","text":"\u0026gt; *Guideline 13:*\n\u0026gt; For utilities that use operands to represent files to be opened for either reading or writing, the '-' operand should be used to mean only standard input (or standard output when it is clear from context that an output file is being specified) or a file named *-*.\n\u003chttps://pubs.opengroup.org/onlinepubs/9699919799/basedefs/V1_chap12.html#tag_12_02\u003e","ts":"1624848792.446800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Vldo0"}]},{"client_msg_id":"2e9b965b-801a-4e1f-ba08-668d0a430a13","type":"message","user":"U06ECBRTJ","text":"IEEE から 仕様書買おうとすると、$324 かかる…","ts":"1624848744.446300","team":"T03C4RC8V","reactions":[{"name":"gunnyari","count":1,"users":["UDPT2BZ6E"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"yJ0"}]},{"client_msg_id":"e603937f-c263-4678-a104-897d559e5ee4","type":"message","user":"U06ECBRTJ","text":"English でも Base Definitions って書いてますね…","ts":"1624848666.445600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4326"}]},{"client_msg_id":"a5f736b6-6922-49fb-8b94-84776dd0694e","type":"message","user":"UDPT2BZ6E","text":"Base DefinitionsじゃなくてBase Specificationsなんですよね。ja版の誤植?","ts":"1624848621.445200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"TNVK"}]},{"client_msg_id":"534dd340-8206-4c19-8bcf-e07a2ff3d041","type":"message","user":"U06ECBRTJ","text":"```2008年12月、Austin Group は新たな大幅修正版 POSIX:2008（正式名称は IEEE Std 1003.1-2008）を公表した[8][9][10]。これが Single UNIX Specification, Version 4 (SUSv4) の中核となっている[11]。この仕様は以下の部分から構成されている。\n\n    Base Definitions, Issue 7\n    System Interfaces and Headers, Issue 7\n    Commands and Utilities, Issue 7```","ts":"1624848564.444800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"2+L/"}]},{"client_msg_id":"3bcb4087-8c33-463c-858d-dbdadc60e097","type":"message","user":"UDPT2BZ6E","text":"The Single UNIX Specification, Version 3に示してもらったGuideline 13が書いてあればPOSIXに書いてあるということになりそうですが、本文がウェブから見れなさそう。。","ts":"1624848522.444600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"FqF"}]},{"client_msg_id":"f2efe2ec-9fe1-4083-a59b-b200b38922df","type":"message","user":"UDPT2BZ6E","text":"あまり英語が得意でなく、、つまりPOSIXは「ISO/IEC 9945」と「IEEE Std 1003.1」と「Single Unix Specification, Version 3のCore」ということになってそうで、結局「The Open Group Base Specifications Issue 7」の位置付けはよく分からないです。。","ts":"1624848431.443900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Pj6"}]},{"client_msg_id":"89060d07-1ab8-4be5-868b-199500a1051f","type":"message","user":"U06ECBRTJ","text":"\u003chttps://standards.ieee.org/standard/1003_1-2008.html\u003e\nここかな","ts":"1624847473.443400","attachments":[{"fallback":"IEEE 1003.1-2008 - IEEE Standard for Information Technology - Portable Operating System Interface (POSIX(TM))","id":1,"title":"IEEE 1003.1-2008 - IEEE Standard for Information Technology - Portable Operating System Interface (POSIX(TM))","title_link":"https://standards.ieee.org/standard/1003_1-2008.html","text":"This standard is simultaneously ISO/IEC 9945, IEEE Std 1003.1, and forms the core of the Single Unix Specification, Version 3. This 2004 edition includes IEEE Std 1003.1-2001/Cor 1-2002 and IEEE Std 1003.1-2001/Cor 2-2004 incorporated into IEEE Std 1003.1-2001 (the base document). The two Corrigenda address problems discovered since the approval of IEEE Std 1003.1-2001. These changes are mainly due to resolving integration issues raised by the merger of the base documents that were incorporated into the IEEE Std 1003.1-2001, which is the single common revision to IEEE Std 1003.1-1996, IEEE Std 1003.2-1992, ISO/IEC 9945-1:1996, ISO/IEC 9945-2:1993, and the Base Specifications of The Open Group Single UNIX? Specification, Version 2.","blocks":null,"service_name":"standards.ieee.org","service_icon":"https://standards.ieee.org/etc/designs/ieee-standards/apple_favicon.png","from_url":"https://standards.ieee.org/standard/1003_1-2008.html","original_url":"https://standards.ieee.org/standard/1003_1-2008.html"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Xfp"}]},{"client_msg_id":"2273691a-fab4-438b-a04b-abeb63c8f68f","type":"message","user":"U06ECBRTJ","text":"\u003chttps://superuser.com/questions/1388584/what-does-the-last-hyphen-mean-in-options-of-bash\u003e\nここに、POSIX says って書いてあったからPOSIX って書いたけど、どこに載ってるかな…","ts":"1624847354.442200","attachments":[{"fallback":"Super User: What does the last \"-\" (hyphen) mean in options of `bash`?","id":1,"title":"What does the last \"-\" (hyphen) mean in options of `bash`?","title_link":"https://superuser.com/questions/1388584/what-does-the-last-hyphen-mean-in-options-of-bash","text":"In this tutorial we need to execute the following command: # curl -sL \u003chttps://rpm.nodesource.com/setup_6.x\u003e | sudo -E bash - What does the last - (hyphen) after bash mean? I've seen a lot of comm...","thumb_url":"https://cdn.sstatic.net/Sites/superuser/Img/apple-touch-icon@2.png?v=e869e4459439","blocks":null,"service_name":"Super User","service_icon":"https://cdn.sstatic.net/Sites/superuser/Img/apple-touch-icon.png?v=0ad5b7a83e49","thumb_width":316,"thumb_height":316,"from_url":"https://superuser.com/questions/1388584/what-does-the-last-hyphen-mean-in-options-of-bash","original_url":"https://superuser.com/questions/1388584/what-does-the-last-hyphen-mean-in-options-of-bash"}],"edited":{"user":"U06ECBRTJ","ts":"1624847367.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"QDDnh"}]},{"client_msg_id":"3517dc2e-5525-4cca-8c0e-d8087d19287b","type":"message","user":"UDPT2BZ6E","text":"「The Open Group Base Specifications Issue 7」の位置付けを調べているのですが、「The Open Group Base Specifications Issue 7」=「POSIX」っていうのはどこを見たら分かるでしょうか？","ts":"1624847036.441700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"tj0A/"}]},{"client_msg_id":"cadb01b3-dd71-469d-b144-f4ed26ec0a60","type":"message","user":"U06ECBRTJ","text":"\u003chttps://ja.wikipedia.org/wiki/The_Open_Group\u003e","ts":"1624846536.441300","attachments":[{"fallback":"wikipedia: The Open Group","id":1,"author_name":"Wikipedia","author_link":"https://ja.wikipedia.org/","title":"The Open Group","title_link":"https://ja.wikipedia.org/wiki/The_Open_Group","text":"The Open Group とは、「UNIX戦争」の終結により、X/OpenとOpen Software Foundation (OSF) が合併して生まれた、プロプライエタリUNIX系の「公式」業界団体である。商標「UNIX」の管理、デジュリ標準であるPOSIXを元に策定されている仕様のSingle UNIX Specificationの維持などをしている。オープンでベンダーに依存しないIT標準と認証の開発を多様な分野で進め、IT標準を通じたビジネス目標の達成を可能にするためのグローバルコンソーシアムであるとうたわれているが、最初に述べた発足の経緯の通り、UNIXと全く無関係にはそのような活動をする理由は無く、そのような活動はしていない。","blocks":null,"service_icon":"https://a.slack-edge.com/80588/img/unfurl_icons/wikipedia.png","from_url":"https://ja.wikipedia.org/wiki/The_Open_Group","original_url":"https://ja.wikipedia.org/wiki/The_Open_Group"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"GszKt"}]},{"client_msg_id":"06d0b412-7165-43ae-99a5-8cd0f8dd42b8","type":"message","user":"UDPT2BZ6E","text":"「The Open Group Base Specifications Issue 7」って何のスペックなんだろう。。と思ったらPOSIXなんですね! これは権威ある","ts":"1624846430.441100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"rXU7"}]},{"client_msg_id":"82c3d4b6-9c87-4ae8-9704-5b3f4f4eb3e5","type":"message","user":"U7H4TJEG0","text":"stdoutはwgetとか","ts":"1624846423.440900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4oRd"}]},{"client_msg_id":"8c0e12f9-2593-4059-8f64-0886e20b5e3b","type":"message","user":"U06ECBRTJ","text":"↑ の URL は POSIX の文章なので、一次ソースですね","ts":"1624846390.440400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"aMA"}]},{"client_msg_id":"915fef39-1989-4b6a-978c-c51cd3a2274d","type":"message","user":"UKHUVMBJR","text":"それがあっtarか","ts":"1624846384.440100","team":"T03C4RC8V","reactions":[{"name":"dajare","count":4,"users":["U06ECBRTJ","URNBMPJ4C","U8CC7MDCL","U9S4G0LJW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"sh=r/"}]},{"client_msg_id":"265c6cd8-7fc0-4557-a526-ee0b47fda99a","type":"message","user":"U7H4TJEG0","text":"tarがあったな","ts":"1624846358.439600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Lpvsq"}]},{"client_msg_id":"0dccd082-bace-4c5d-930b-308658641b9c","type":"message","user":"UDPT2BZ6E","text":"あーなるほど。hyphen!","ts":"1624846303.439400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"KyEG"}]},{"client_msg_id":"7dd6ada9-0372-4fc0-a574-224722e8a59f","type":"message","user":"U7H4TJEG0","text":"かぶった","ts":"1624846293.439100","team":"T03C4RC8V","reactions":[{"name":"+1","count":1,"users":["U06ECBRTJ"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"QnD"}]},{"client_msg_id":"92ab719a-f26c-4d1e-864f-b8b460fe36ad","type":"message","user":"U7H4TJEG0","text":"stdin hyphenでぐぐったら色々出てきますね","ts":"1624846286.438900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"XZG3m"}]},{"client_msg_id":"04ea3c59-6d68-4cb0-b30d-ec5964064778","type":"message","user":"U06ECBRTJ","text":"stdin ハイフンでググって見つけました","ts":"1624846286.438800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"bnC/"}]},{"client_msg_id":"b59d6e6f-c8de-471a-8847-45075a0f5509","type":"message","user":"U06ECBRTJ","text":"```Guideline 13:\n    For utilities that use operands to represent files to be opened for either reading or writing, the '-' operand should be used to mean only standard input (or standard output when it is clear from context that an output file is being specified) or a file named -.```\nこれかな？","ts":"1624846248.438300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ZBF6S"}]},{"client_msg_id":"2798138c-6952-4b5c-857d-af44d65f9073","type":"message","user":"U06ECBRTJ","text":"\u003chttps://pubs.opengroup.org/onlinepubs/9699919799/basedefs/V1_chap12.html#tag_12_02\u003e","ts":"1624846215.438000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"w5Oh"}]},{"client_msg_id":"f326bdd0-94d2-41c7-8349-2c5d853390e6","type":"message","user":"UDPT2BZ6E","text":"(ググラビリティが低すぎて探せないんですよね。。)","ts":"1624846177.437700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"PDtm0"}]},{"client_msg_id":"46f6f9ea-7cdb-427b-9284-37a1b9adb63b","type":"message","user":"UDPT2BZ6E","text":"```$ diff -u template2.yml template4.yml \n--- template2.yml\t2021-06-24 12:29:44.070759320 +0000\n+++ template4.yml\t2021-06-28 02:07:38.240041358 +0000\n@@ -1,6 +1,6 @@\n AWSTemplateFormatVersion: '2010-09-09'\n \n-Transform: AWS::Serverless-2016-10-31\n+Transform: AWS::Serverless-2016-10-30\n \n Parameters:\n   Prefix:\n\n$ cat template2.yml | diff -u - template4.yml \n--- -\t2021-06-28 02:07:58.970289760 +0000\n+++ template4.yml\t2021-06-28 02:07:38.240041358 +0000\n@@ -1,6 +1,6 @@\n AWSTemplateFormatVersion: '2010-09-09'\n \n-Transform: AWS::Serverless-2016-10-31\n+Transform: AWS::Serverless-2016-10-30\n \n Parameters:\n   Prefix:```\nとりあえずdiffではサポートされてるのは知ってます。あとcatもサポートされてるよってのが前話に出てましたよね。あとは。。","ts":"1624846146.437500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ihR"}]},{"client_msg_id":"97a2e8a1-4a8f-4ec4-a5a8-9001a8a51647","type":"message","user":"UAZ33BKV2","text":"むずかしいですね...GNU系にも多いから、GNUのcoreutil/fileutilあたりの例を参考にするとか?\n「もっとも使われているOSS実装の..でもこれだけの利用があります」とか?","ts":"1624846057.437100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ueAo"}]},{"client_msg_id":"16350c63-582b-434f-bc38-3b9facd355b5","type":"message","user":"UDPT2BZ6E","text":"`-`が標準入力を示すって慣例だと思うんですが、それを説明している公的っぽい (権威があるっぽい) ソースってありますでしょうか？\nそれか、 `-` をサポートしているコマンドの例ってどれくらいありますでしょうか？\n\n(AWSのSAMっていうツールで、 `-` をサポートして欲しくて、その主張のサポートとして使いたい感じです。)","ts":"1624845990.436200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"8zt"}]}]
