96GYBF","text":"ここまでやってAlacrittyの透過試したのはいいけどfzf-previewのウィンドウだけどう頑張っても透過できなくて死んでます","ts":"1633422162.188400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"O+B+v"}]},{"client_msg_id":"c195bf29-055b-4dab-853b-19a7a317d22d","type":"message","user":"U01D44KSY9Z","text":"macのサードパーティアプリやっぱり強い\nここまでできるものなんですね","ts":"1633422065.187900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"NhbvG"}]},{"client_msg_id":"fae4bab7-0e26-4917-96f8-3e6115a0f954","type":"message","user":"U8996GYBF","text":"lua書かないといけないの辛い","ts":"1633421894.187100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"68r"}]},{"client_msg_id":"47e4edec-ed45-4034-b59f-bccf191f0207","type":"message","user":"U8996GYBF","text":"Mac限定ですけどほぼ完璧にhammerspoonで模倣できました","ts":"1633421865.186800","edited":{"user":"U8996GYBF","ts":"1633421877.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"v3h"}]},{"client_msg_id":"cefd0c94-44d9-41e8-b9e4-d96643b889e7","type":"message","user":"U8996GYBF","text":"\u003c@U01D44KSY9Z\u003e 一応\n```-- \u003chttps://github.com/asmagill/hs._asm.undocumented.spaces\u003e\nlocal spaces = require('hs._asm.undocumented.spaces') \n\nlocal APP_NAME = 'Alacritty'\n\n-- Switch alacritty\nhs.hotkey.bind({'ctrl'}, 'tab', function ()\n  function moveWindow(alacritty, space, mainScreen)\n    local win = nil\n    while win == nil do\n      win = alacritty:mainWindow()\n    end\n    win:spacesMoveTo(space)\n    win:focus()\n  end\n  local alacritty = hs.application.get(APP_NAME)\n  if alacritty ~= nil and alacritty:isFrontmost() then\n    alacritty:hide()\n  else\n    local space = spaces.activeSpace()\n    local mainScreen = hs.screen.find(spaces.mainScreenUUID())\n    if alacritty == nil and hs.application.launchOrFocus(APP_NAME) then\n      local appWatcher = nil\n      appWatcher = hs.application.watcher.new(function(name, event, app)\n        if event == hs.application.watcher.launched and name == APP_NAME then\n          app:hide()\n          moveWindow(app, space, mainScreen)\n          appWatcher:stop()\n        end\n      end)\n      appWatcher:start()\n    end\n    if alacritty ~= nil then\n      moveWindow(alacritty, space, mainScreen)\n    end\n  end\nend)\n\n-- Hide alacritty if not in focus\nhs.window.filter.default:subscribe(hs.window.filter.windowFocused, function(window, appName)\n  local alacritty = hs.application.get(APP_NAME)\n  if alacritty ~= nil then\n     alacritty:hide()\n  end\nend)```","ts":"1633421848.186400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"BDDJ"}]},{"client_msg_id":"e09d5f8f-62b1-4178-ad07-917c08d30f28","type":"message","user":"U8996GYBF","text":"強いて言うなら透過の恩恵が受けれないとかじゃないですかね","ts":"1633414511.184700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"W2T"}]},{"client_msg_id":"819d7f46-d9b3-4413-a4b7-09311ca9489f","type":"message","user":"U8996GYBF","text":"iTermから移行したときにそういう使い方にしました","ts":"1633414501.184300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"WqI2l"}]},{"client_msg_id":"3df43921-a923-4215-9443-ee001b195e33","type":"message","user":"U01D44KSY9Z","text":"そのレベルで操作できるなら確かに使い心地は変わらないか","ts":"1633414485.184000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"KSZTQ"}]},{"client_msg_id":"5dea821a-f240-444c-8870-e62617258e2a","type":"message","user":"U8996GYBF","text":"仮想デスクトップで責務切って手癖で移動してるので","ts":"1633414465.183600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"SGik"}]},{"client_msg_id":"d754a70b-14ad-4559-a3bf-0f88fe22fdbc","type":"message","user":"U8996GYBF","text":