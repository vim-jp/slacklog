":"rich_text","block_id":"2Ad"}]},{"client_msg_id":"fc3ff15d-affa-4847-864f-e596f04946b8","type":"message","user":"U022XK5866Q","text":"(ちょっとシェルスクリプトに慣れてきて、なんでもワンライナーにしてみたくなるお年頃です)\n```editor_or_fg() [[ $# -eq 0 ]] \u0026amp;\u0026amp; fg ${EDITOR_PROG:=${EDITOR:-nvim}} 2\u0026gt; /dev/null || command ${EDITOR_PROG} \"$@\"```","ts":"1631374468.205700","team":"T03C4RC8V","reactions":[{"name":"wakaru","count":2,"users":["U01D9BALEKU","U8CC7MDCL"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5op"}]}]
