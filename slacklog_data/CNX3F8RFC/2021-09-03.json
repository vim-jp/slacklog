["text"],"blocks":null,"footer":"\u003chttps://github.com/cli/cli|cli/cli\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png","ts":1630063531}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"lHB1X"}]},{"client_msg_id":"14f41802-a682-4fe7-951c-d867edb8b6d6","type":"message","user":"U022XK5866Q","text":"push前にregression見つけたので無事に修正してmerge","ts":"1630674684.108000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"W9oM"}]},{"client_msg_id":"2b18afd9-6ce7-4c5d-aa23-97a20d6e985e","type":"message","user":"U022XK5866Q","text":"みなさんありがとうございました~。あとはNEWS.md書いてマージだ。","ts":"1630672760.107600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"GvvI"}]},{"client_msg_id":"6039667f-1441-47e9-b847-801aeba847fc","type":"message","user":"U022XK5866Q","text":"やった無事にextension動作させました。ついでにaliasにも対応。","ts":"1630672705.106800","team":"T03C4RC8V","reactions":[{"name":"tada","count":5,"users":["U9S4G0LJW","U8CC7MDCL","U81LLJ340","U06ECBRTJ","U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"nZfs"}]},{"client_msg_id":"c4e38f07-5fd2-4f78-a8e2-a67ab7190efc","type":"message","user":"UAZ33BKV2","text":"gittとかもそうですね、というかそうじゃないと一貫性の管理が厳しいだろうし","ts":"1630669992.106300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"6z7"}]},{"client_msg_id":"ada3f3fc-1bf1-4136-a8b3-25ea094a3bbb","type":"message","user":"U06ECBRTJ","text":"`gh-` をトリムしたファイル名か","ts":"1630669970.105800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"3BXg"}]},{"client_msg_id":"a892852d-532c-4b71-9bb9-edbc92a267e1","type":"message","user":"U022XK5866Q","text":"はい、ファイル名だと思います","ts":"1630669968.105700","team":"T03C4RC8V","replace_original":false,"delete_origi