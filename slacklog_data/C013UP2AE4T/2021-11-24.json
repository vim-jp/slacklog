み進めてほしい。","image_url":"https://www.4gamer.net/games/999/G999905/20151225009/TN/050.jpg","blocks":null,"service_name":"4gamer.net","service_icon":"https://www.4gamer.net/favicon.ico","from_url":"https://www.4gamer.net/games/999/G999905/20151225009/","original_url":"https://www.4gamer.net/games/999/G999905/20151225009/"}],"subtype":"thread_broadcast","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Nbhzs"}],"root":{"client_msg_id":"a739c469-da21-4149-af52-6960c3a33f30","type":"message","user":"U06ECBRTJ","text":"SFCってC使えてたのかな？","ts":"1637747620.121000","thread_ts":"1637747620.121000","reply_count":2,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"7rxHn"}]}},{"client_msg_id":"c923a911-c97b-4fd7-a917-2ca55e5fe21a","type":"message","user":"U06BRP8VD","text":"MOTHER2はCだったんじゃないかな。","ts":"1637761946.124900","thread_ts":"1637747620.121000","subtype":"thread_broadcast","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jYCy"}],"root":{"client_msg_id":"a739c469-da21-4149-af52-6960c3a33f30","type":"message","user":"U06ECBRTJ","text":"SFCってC使えてたのかな？","ts":"1637747620.121000","thread_ts":"1637747620.121000","reply_count":2,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"7rxHn"}]}},{"client_msg_id":"1cdd8b2d-2d54-4552-8bf9-a3febd82650b","type":"message","user":"U01D44KSY9Z","text":"これに入ってるのを抜き出したやつっぽい\n\u003chttps://github.com/optixx/snes-sdk\u003e","ts":"1637748008.124400","attachments":[{"color":"24292f","fallback":"optixx/snes-sdk","id":1,"title":"optixx/snes-sdk","text":"Super NES / Super Famicom Software Development Kit","fields":[{"title":"Website","value":"\u003chttp://code.google.com/p/snes-sdk\u003e","short":true},{"title":"Stars","value":"78","short":true}],"blocks":null}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text"