fcb1daa7c7cbbe04f9173/mopp/smartnumber.vim","blocks":null,"service_name":"GitHub","service_icon":"https://a.slack-edge.com/80588/img/unfurl_icons/github.png","from_url":"https://github.com/mopp/smartnumber.vim","original_url":"https://github.com/mopp/smartnumber.vim"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"kWpDJ"}]},{"client_msg_id":"9b78f435-6945-4a57-80fe-8397dd80ae9a","type":"message","user":"U01D44KSY9Z","text":"確かに\n人に見せる時は絶対番号のほうがよさそう","ts":"1621824410.078400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Jld"}]},{"client_msg_id":"a1ed9a63-ef87-4bd3-8634-87bf382360cd","type":"message","user":"U8996GYBF","text":"ペアプロ用にトグルするコマンド置いとくといいですよ","ts":"1621824332.077800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5yH"}]},{"client_msg_id":"2eddedb3-4ce1-4ee6-90cf-12df4ebfdbbd","type":"message","user":"U01D44KSY9Z","text":"numberとrelativenumber両方使うのがたぶん一番自分に合ってるな\ncursorline切るか","ts":"1621823649.077300","team":"T03C4RC8V","reactions":[{"name":"+1","count":1,"users":["U022XK5866Q"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"JrXun"}]},{"client_msg_id":"5EFFCC52-1A6E-46E4-AC85-D16C484426C0","type":"message","user":"U80CX6XDZ","text":"cursorlineは自分もかなり遅く感じますね。ありなしなら体感で1.2倍くらい違う。","ts":"1621823599.076200","edited":{"user":"U80CX6XDZ","ts":"1621823612.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"QtDA"}]},{"client_msg_id":"afaadd57-fb77-4a91-b276-ac4840b995bf","type":"message","user":"U022XK5866Q","text":"現在行が `0` になりますね。 `set number`と一緒につかうと、0の変わりに絶対行番号が表示されるっぽいです。","ts":"1621823576.075600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"2EO4K"}]},{"client_msg_id":"5c9110d8-ad34-4ee0-92fc-1288d65665cd","type":"message","user":"U01D44KSY9Z","text":"あれ、nuとrnu両方セットしないとダメなのか\nよく分からない","ts":"1621823483.073800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"UzT2"}]},{"client_msg_id":"70add9a3-7aa1-4c82-b801-6266cfb5b4c4","type":"message","user":"U01D44KSY9Z","text":"relative numberってちゃんと現在行の番号分かるのか、知らなかった","ts":"1621823419.073000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"XY6p3"}]},{"client_msg_id":"dd9084e9-ed1e-4a86-9782-6445a84011c9","type":"message","user":"U7B4ZD49X","text":"cursorcolumnの方は遅いイメージありますね。なんでかは知らないけど","ts":"1621823302.072400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"1j3"}]},{"client_msg_id":"ed5211c3-cac2-417a-a881-e9649f29481e","type":"message","user":"UL6CFN8NR","text":"cursorline と cursorcolumn 両方オンにしてると、普通の人でも分かるくらいパフォーマンス下がる気がしますね。大きいファイルで j 連打したりすると変わる","ts":"1621823127.071900","team":"T03C4RC8V","reactions":[{"name":"hee","count":1,"users":["U022XK5866Q"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0ZohS"}]},{"client_msg_id":"2c055b0c-14d6-47b3-b6bd-f1d808ee6d9d","type":"message","user":"U7B4ZD49X","text":"まあShougoさんはかなり敏感なんで普通の人が気にするほどじゃないと思いますけどね","ts":"1621823058.071700","team":"T03C4RC8V","reactions":[{"name":"rolling_on_the_floor_laughing","count":1,"users":["U022XK5866Q"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"i63"}]},{"client_msg_id":"43bb39ff-f46e-468b-aa25-c4c65afbda6f","type":"message","user":"U022XK5866Q","text":"あんまり気になってなかったけど、そうなんですね。","ts":"1621822986.070400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"rK1"}]},{"client_msg_id":"7b8386c1-a621-41b1-8a4a-d3ccda3087da","type":"message","user":"U7JL1UKKL","text":"cursorline遅いからなぁ","ts":"1621822941.070000","team":"T03C4RC8V","reactions":[{"name":"wakaru","count":3,"users":["U7B4ZD49X","U80CX6XDZ","U9S4G0LJW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"T7B"}]},{"client_msg_id":"50a78b60-bbe4-40ad-a11b-18035b042b83","type":"message","user":"U7B4ZD49X","text":"私もcursorlineは入れてないですね。","ts":"1621822782.069800","team":"T03C4RC8V","reactions":[{"name":"grinning","count":1,"users":["U022XK5866Q"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"mflJE"}]},{"client_msg_id":"b8fd9bee-dbbb-4eab-ab52-14f95d714d5c","type":"message","user":"U022XK5866Q","text":"`set cursorline`してると `.` と `,`を識別できなくてツラかったんですが、 `set relative number` してるので、行番号見れば現在行一発なので、`set cursorline`はいらない気がしました。","ts":"1621822535.069500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+qOpH"}]}]
