-java'\n      \\ ]```","ts":"1621439300.016500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"akF"}]},{"client_msg_id":"5eb2208c-2564-4beb-8ed8-8293137c4400","type":"message","user":"UDDCM376D","text":"乗り換えを検討","ts":"1621438910.015000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"J8ov"}]},{"client_msg_id":"ad730f67-68dc-44f0-9509-2ee0d2ef4e1b","type":"message","user":"UDDCM376D","text":"coc.nvimを入れてみた\n良さげだな","ts":"1621438903.014800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"pDk"}]}]
