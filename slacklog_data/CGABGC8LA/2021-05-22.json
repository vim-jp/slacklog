84caa","type":"message","user":"U06BRP8VD","text":"というかLinuxでスレッド切替が1msec超えるのをまだみたことない。","ts":"1621666749.022800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"mj9x"}]},{"client_msg_id":"9455ad9e-58a2-4c2b-ab81-bce9d6144055","type":"message","user":"U06BRP8VD","text":"一方でLinuxはほぼサブミリ","ts":"1621666723.022200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"C8qHB"}]},{"client_msg_id":"0f860778-7b3b-49f2-bda3-978990b1da95","type":"message","user":"UERCTTT8B","text":"ひぃ","ts":"1621666710.021800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"kDjC"}]},{"client_msg_id":"26349c72-4d24-4e2b-aaa9-c45cee1d5478","type":"message","user":"U06BRP8VD","text":"1msec以上とか平気でありうる。","ts":"1621666692.021300","edited":{"user":"U06BRP8VD","ts":"1621666711.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"OifY"}]},{"client_msg_id":"6b0cf53b-9bbf-4436-910d-76f86abdcf36","type":"message","user":"U06BRP8VD","text":"Windowsはスレッド切替の粒度が悪いんですよ。","ts":"1621666679.020900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"SoP"}]},{"client_msg_id":"702f42a1-c12f-45de-ba52-d5654e845956","type":"message","user":"UERCTTT8B","text":"goroutine が増えるとこの現象が発生しやすくなるというのが今の所の仮説","ts":"1621665951.020100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"MBo"}]},{"client_msg_id":"775709b5-1af9-4820-acf6-1605c0f6747f","type":"message","user":"UAZ33BKV2","text":"むーん、速度保証goroutineがほしいねw","ts":"1621665930.019600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"2Dv6"}]},{"client_msg_id":"4691ac09-742c-468c-acd0-caa0846b5a0c","type":"message","user":"UERCTTT8B","text":"goroutine をへらす努力