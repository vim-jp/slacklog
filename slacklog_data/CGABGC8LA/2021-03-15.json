56-827d-14a7fa5e7711","type":"message","user":"U03C6TEAZ","text":"\u003chttps://gist.github.com/mattn/af0ef25ea77066ae450518696d700e01\u003e","ts":"1615773258.462600","team":"T03C4RC8V","reactions":[{"name":"cat-dogeza-mike","count":1,"users":["U06BRP8VD"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"i5US"}]},{"client_msg_id":"e3095315-ab41-4a14-93d0-fe9d76d6b1c6","type":"message","user":"U06BRP8VD","text":"文字列switch、これどんなコードに展開されてるんだろう?","ts":"1615773046.462400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"FUbQ"}]},{"client_msg_id":"a642c256-6780-40d0-8d09-c6e0ce6f7319","type":"message","user":"U03C6TEAZ","text":"\u003chttps://gist.github.com/mattn/a6c94912bcfee668ed84ad430e2b7a97\u003e","ts":"1615772548.461900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"VI8v1"}]},{"client_msg_id":"7a5b14d0-df42-485b-8981-350e92e89b41","type":"message","user":"U03C6TEAZ","text":"キーが int だと switch の方が速くなりますね。キーが string だと map の方が速くなります。まぁ当然か。","ts":"1615772340.461700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ErR"}]},{"client_msg_id":"a5d8a035-d8e2-4688-afeb-383ae7c95c5e","type":"message","user":"U03C6TEAZ","text":"んー、調べるたびに map が弱弱しい感じがする。","ts":"1615772063.461200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"kcm"}]},{"client_msg_id":"d0c65838-615a-42ba-9450-f763f6b57861","type":"message","user":"U06BRP8VD","text":"あーヒットする速度じゃなくて、ヒットしない速度を比べるとmapのほうが比較的簡単に速くなるかもしれない。","ts":"1615771513.460400","edited":{"user":"U06BRP8VD","ts":"1615771533.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"V04j"}]},{"client_msg_id":"02dbb255-7a3d-4ae3-94af-cc121d04dcc0","type":"message","user":"U06BRP8VD","text":"理論上mapはO(1)だけども、定数がそれなりに大きいからなぁ…","ts":"1615771452.459900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"H/=Y4"}]},{"client_msg_id":"fa703f3b-206f-4cd1-ab37-394cd4499526","type":"message","user":"U06BRP8VD","text":"mapに勝たせる方法、すぐには思いつかないな。","ts":"1615771421.459500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"8Hmaf"}]},{"client_msg_id":"12bf54dd-b611-4aa3-bd1a-09f35c76ceaa","type":"message","user":"U06BRP8VD","text":"二分探査のコードに展開されてるからかなり速いよ。","ts":"1615771363.459100","edited":{"user":"U06BRP8VD","ts":"1615771381.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"tWWG"}]},{"client_msg_id":"527aeaaa-315a-4d72-9692-a57a45e5350c","type":"message","user":"U06BRP8VD","text":"switch数字のケースだと","ts":"1615771350.458800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Ip0I"}]},{"client_msg_id":"3d4239f6-b1df-4582-94cc-722f91f3b80d","type":"message","user":"U03C6TEAZ","text":"遅いというのは、なんか Go の map が弱いという意味で。","ts":"1615771288.458400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"qd/qQ"}]},{"client_msg_id":"7a4c8543-de3c-489a-b9f2-475eb67126df","type":"message","user":"U03C6TEAZ","text":"map の方が遅い気がするなぁ。","ts":"1615771265.458000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"8=jTA"}]},{"client_msg_id":"c5070615-5b09-445c-b849-b48ae5952621","type":"message","user":"UDDCM376D","text":"むしろ差が開いているな","ts":"1615770030.457500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"YLt"}]},{"client_msg_id":"ebbb3b63-5fc6-4b8e-9c48-2cd5f53fb407","type":"message","user":"UDDCM376D","text":"記事のやつから+100個","ts":"1615770005.457300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"nB5Fu"}]},{"client_msg_id":"cb66805d-5145-4406-a20a-5d0707621f23","type":"message","user":"UDDCM376D","text":"雑に増やしてみたけど\n思ったよりも近づかなかった\n```goos: darwin\ngoarch: arm64\npkg: \u003chttp://github.com/skanehira/compomize|github.com/skanehira/compomize\u003e\nBenchmarkSwitch-8       181671594                6.465 ns/op\nBenchmarkMap-8          61022120                19.51 ns/op```","ts":"1615769985.457000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"1OWL"}]},{"client_msg_id":"c804150f-5e6e-4385-83ca-8d1c1dc5b76b","type":"message","user":"U03C6TEAZ","text":"あと\n```swtich {\ncase i == 200:\ncase i == 400:\n}```\nの書き方の switch はさらに遅くなるかも。","ts":"1615769912.456700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"FFKj"}]},{"client_msg_id":"1ecf3301-6ebb-420a-b5f5-0717bba06cd0","type":"message","user":"UDDCM376D","text":"なるほど","ts":"1615769889.456300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zSx"}]},{"client_msg_id":"21d2bb34-b872-454e-941c-3036449dd88d","type":"message","user":"U03C6TEAZ","text":"そのはずです。","ts":"1615769868.455700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5Rk"}]},{"client_msg_id":"a904f588-8c35-4865-bcbe-656fc8f86ace","type":"message","user":"UDDCM376D","text":"アセンブリ読めないけど、数増やせば差分が減ってくる感じすかね","ts":"1615769845.455400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"S4G"}]},{"client_msg_id":"e371e5c9-0022-4aa3-a723-92c7b244c945","type":"message","user":"U03C6TEAZ","text":"CMPQ  が２個しかないですからね。","ts":"1615769825.455000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Mrd1b"}]},{"client_msg_id":"483f3cca-3042-4daa-ad85-80f06ffff1ad","type":"message","user":"U03C6TEAZ","text":"case の数次第な気がします。","ts":"1615769765.454600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=gC"}]},{"client_msg_id":"6af64031-bbf9-4a8e-9ab2-492e4d6b38eb","type":"message","user":"UDDCM376D","text":"そうなのかって気持ち","ts":"1615769566.454400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Ijj"}]},{"client_msg_id":"fbe54e9f-b47d-489a-b580-44c966527809","type":"message","user":"UDDCM376D","text":"\u003chttps://adayinthelifeof.nl/2021/03/04/go-map-vs-switch.html\u003e","ts":"1615769561.454200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"8xNo"}]},{"client_msg_id":"f4726442-8697-4956-b537-380469278a1a","type":"message","user":"U03C6TEAZ","text":"こっちゃにも。\n\n\u003chttps://vim-jp.slack.com/archives/CGZTGR6E6/p1615766402044400\u003e","ts":"1615766416.453700","attachments":[{"fallback":"[March 14th, 2021 5:00 PM] mattn: 書きました。\n\n\u003chttps://zenn.dev/mattn/articles/1c4eb193d81a3a\u003e","id":1,"author_id":"U03C6TEAZ","author_name":"mattn","author_subname":"mattn","author_link":"https://vim-jp.slack.com/team/U03C6TEAZ","author_icon":"https://avatars.slack-edge.com/2018-07-31/407982080133_30e238cd92e6c88883f9_48.png","text":"書きました。\n\n\u003chttps://zenn.dev/mattn/articles/1c4eb193d81a3a\u003e","mrkdwn_in":["text"],"blocks":null,"footer":"Posted in #lang-javascript","ts":1615766402.044400,"from_url":"https://vim-jp.slack.com/archives/CGZTGR6E6/p1615766402044400","original_url":"https://vim-jp.slack.com/archives/CGZTGR6E6/p1615766402044400"}],"team":"T03C4RC8V","reactions":[{"name":"+1::skin-tone-5","count":1,"users":["UAZ33BKV2"]},{"name":"+1","count":2,"users":["U7JL1UKKL","U06BRP8VD"]},{"name":"+1::skin-tone-2","count":1,"users":["U017BU3UZBQ"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":