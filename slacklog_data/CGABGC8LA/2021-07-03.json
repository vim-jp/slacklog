.net/2021/04/24/go-conference-2021-spring/","original_url":"https://blog.matsuyoshi30.net/2021/04/24/go-conference-2021-spring/"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"CkwNR"}]},{"client_msg_id":"04fda323-9792-4824-967a-c00c1eec6f17","type":"message","user":"UDDCM376D","text":"自作ツールは卒業だな…","ts":"1625239622.093600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"nR9J"}]},{"client_msg_id":"10ce2d10-5e8d-459a-83ea-87e7066c2845","type":"message","user":"UDDCM376D","text":"ほしかったやつ","ts":"1625239611.093300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"8sdJR"}]},{"client_msg_id":"f693a0be-fede-43f2-9552-6da6e344b719","type":"message","user":"UDDCM376D","text":"\u003chttps://github.com/matsuyoshi30/germanium\u003e","ts":"1625239607.093000","attachments":[{"color":"24292f","fallback":"matsuyoshi30/germanium","id":1,"title":"matsuyoshi30/germanium","text":"Generate image from source code","fields":[{"title":"Stars","value":"135","short":true},{"title":"Language","value":"Go","short":true}],"blocks":null}],"team":"T03C4RC8V","reactions":[{"name":"eyes","count":1,"users":["U9S4G0LJW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"yrVJw"}]},{"client_msg_id":"34e6e231-3109-4e49-8bdf-ec3f8e0d9c36","type":"message","user":"U06BRP8VD","text":"xorm ってDBのタイムゾーンっていう概念があるのね。","ts":"1625274494.095700","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"wSHO6"}]},{"client_msg_id":"f7a3f429-1454-412f-8f98-7eb8c1c09b11","type":"message","user":"U06BRP8VD","text":"で、だいたいの時間はこのタイムゾーンに変換されて送られるの。","ts":"1625274516.095900","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"sg5"}]},{"client_msg_id":"b3ccbb59-6f1c-4a0e-8133-e2cc48023975","type":"message","user":"U06BRP8VD","text":"ただこの変換には罠が2つある。","ts":"1625274552.096100","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"gx2f"}]},{"client_msg_id":"b1738d82-1d25-487a-9823-e04db7a0eb48","type":"message","user":"U06BRP8VD","text":"1つはDBのタイムゾーンの初期値と例外。初期値はGo側のローカルのタイムゾーンになる。ただし例外的にSQLite3だけはUTCなのよ。","ts":"1625274609.096300","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=KA0"}]},{"client_msg_id":"ea880d9c-fdc4-4299-84ef-df790eada149","type":"message","user":"UDDCM376D","text":"マジか","ts":"1625274754.096500","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"iKUyu"}]},{"client_msg_id":"c00f3a48-2363-46bf-a1e2-a4791e73c3a2","type":"message","user":"U06BRP8VD","text":"タイムゾーンがローカルとDBで違っちゃうと困るケースってのはTIMESTAMP (without zone) 使ってるとき。TIMESTAMP使う時ってユーザーはだいたいローカル時刻で保存されることを期待しているんだけど、SQLite3+xormではUTCになったうえでタイムゾーン情報は落ちちゃうのね。で、これはあとで説明する事象で頭を悩ませることになる。","ts":"1625274794.096700","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"85RT"}]},{"client_msg_id":"e47e308f-06e3-4c2c-a6c6-2f7db0f0a44f","type":"message","user":"U06BRP8VD","text":"先に2つ目の罠の説明。bean(struct)内の `time.Time \"xrom:timestamp\"` はちゃんとそのDBタイムゾーンを考慮して変換してくれるの。でもね… `Where()` に渡した `time.Time` や `map[string]interafce{}` に `Get()` する `time.Time` は変換がされない。","ts":"1625274930.096900","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"gqSt/"}]},{"client_msg_id":"0c08ce3e-5ea0-45d4-b43e-98927e7a1c18","type":"message","user":"U06BRP8VD","text":"しかもそいつらのタイムゾーンが何になるかは最終的にDBドライバ依存になる。ちなみにPostgreSQLだと `+0000` (UTCと同じ) になる。","ts":"1625274987.097100","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ArG"}]},{"client_msg_id":"2751efe2-3c72-41ea-9f3a-ad1b3c3ccc41","type":"message","user":"U06BRP8VD","text":"で、こうなっちゃうとタイムゾーンを変換(?)するのはとにかく面倒。できるけど面倒。","ts":"1625275088.097300","thread_ts":"1625274441.095600","edited":{"user":"U06BRP8VD","ts":"1625275098.000000"},"parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"MdX"}]},{"client_msg_id":"70de0d39-3e41-40ae-b6d9-786d80670bc5","type":"message","user":"UDDCM376D","text":"罠過ぎますね","ts":"1625275146.097600","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"rjB"}]},{"client_msg_id":"3bee9180-c8fb-46f4-9c41-085f7a9d1a2b","type":"message","user":"UDDCM376D","text":"んー","ts":"1625275151.097800","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/h6X"}]},{"client_msg_id":"a00da5e8-89f6-490b-b690-588cd0324d46","type":"message","user":"UDDCM376D","text":"やはりxormを採用したのは良くなかったのかな…","ts":"1625275163.098000","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"d1nW9"}]},{"client_msg_id":"4606adea-848d-42bd-9d6b-928d78387d57","type":"message","user":"UDDCM376D","text":"teimstampだけ影響ウケるのは知っていたけど、まさかsqlie3だとutcになると","ts":"1625275198.098200","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Wo6Lv"}]},{"client_msg_id":"3b83646c-58a6-46ae-9b29-01f7f41a8708","type":"message","user":"U06BRP8VD","text":"こんな些細なことで採用の成否を論じるのは間違ってるよ。","ts":"1625275255.098400","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"k4I"}]},{"client_msg_id":"152cecdf-75c8-4886-991e-1b119f31ffe4","type":"message","user":"U06BRP8VD","text":"つまり xorm を使う上でのベストプラクティスとしては…「ローカルとDBのタイムゾーンは必ず一致させる」あと可能な限り「TIMESTAMPじゃなくてTIMESTAMPZを使う」この2点。","ts":"1625275387.098600","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"FjKZ"}]},{"client_msg_id":"2cb13cb4-d237-487b-b7e4-36ee4be6fd06","type":"message","user":"U06BRP8VD","text":"xormがSQLite3使う時にDBタイムゾーンをUTCにしている理由がわからないんだよなぁ。","ts":"1625275425.098800","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zdq"}]},{"client_msg_id":"547de1ca-a90a-4592-b7bb-b97d579e2ec3","type":"message","user":"UDDCM376D","text":"\u0026gt; こんな些細なことで採用の成否を論じるのは間違ってるよ。\nたしかに","ts":"1625275480.099000","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"LKGPP"}]},{"client_msg_id":"ba8b3db7-5c49-42e0-a2cb-04981aa4c411","type":"message","user":"U06BRP8VD","text":"SQLite3の時だけUTCにしてるのはココね \u003chttps://gitea.com/xorm/xorm/src/tag/v1.1.0/engine.go#L85-L86\u003e","ts":"1625275547.099200","thread_ts":"1625274441.095600","attachments":[{"fallback":"Gitea: Git with a cup of tea: xorm","id":1,"title":"xorm","title_link":"https://gitea.com/xorm/xorm/src/tag/v1.1.0/engine.go#L85-L86","text":"Simple and Powerful ORM for Go, support mysql,postgres,tidb,sqlite3,sqlite,mssql,oracle,cockroach","image_url":"https://gitea.com/repo-avatars/2038-b100c96af96c9c8134f5c9a44db55ec1","blocks":null,"service_name":"Gitea: Git with a cup of tea","from_url":"https://gitea.com/xorm/xorm/src/tag/v1.1.0/engine.go#L85-L86","original_url":"https://gitea.com/xorm/xorm/src/tag/v1.1.0/engine.go#L85-L86"}],"parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"lIHU"}]},{"client_msg_id":"7835c7ab-8ebd-4b47-b163-8dffcfc14d3e","type":"message","user":"UDDCM376D","text":"思いっきりUTCにしているな","ts":"1625275596.099500","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ONIvG"}]},{"client_msg_id":"45f200fe-0dae-4604-bfab-4ac839deb8ec","type":"message","user":"U06BRP8VD","text":"そのコードの元になった変更、たぶんコレで導入されたんだな。ここから位置とかモロモロ変わっても引き継がれてる。\n\n\u003chttps://gitea.com/xorm/xorm/commit/7222d6d7b340c0c1f02117ee0c33bb1293f59f0f\u003e","ts":"1625276159.099700","thread_ts":"1625274441.095600","attachments":[{"fallback":"Gitea: Git with a cup of tea: xorm","id":1,"title":"xorm","title_link":"https://gitea.com/xorm/xorm/commit/7222d6d7b340c0c1f02117ee0c33bb1293f59f0f","text":"Simple and Powerful ORM for Go, support mysql,postgres,tidb,sqlite3,sqlite,mssql,oracle,cockroach","image_url":"https://gitea.com/repo-avatars/2038-b100c96af96c9c8134f5c9a44db55ec1","blocks":null,"service_name":"Gitea: Git with a cup of tea","from_url":"https://gitea.com/xorm/xorm/commit/7222d6d7b340c0c1f02117ee0c33bb1293f59f0f","original_url":"https://gitea.com/xorm/xorm/commit/7222d6d7b340c0c1f02117ee0c33bb1293f59f0f"}],"parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"s1tqb"}]},{"client_msg_id":"7FA53B0D-78C1-47E6-8479-A86D288B5927","type":"message","user":"UFHQ7TNT0","text":"とりあえず、ローカル、アプリケーション、DBの3つのタイムゾーンを揃えるのは、過去に色々経験した人の基本プラクティスですよね","ts":"1625279174.102200","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"m6Bf"}]},{"client_msg_id":"7b48d9eb-0dd1-49a4-8671-f384d5aa0c8f","type":"message","user":"U06BRP8VD","text":":honsore:","ts":"1625279191.102400","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+zE"}]},{"client_msg_id":"cb931f46-1286-4c3b-b279-baad67ccf724","type":"message","user":"U06BRP8VD","text":"ほんとそうなんだけど、xormにおいてはSQLite3を選択すると勝手にズレるってあたりがミソw","ts":"1625279219.102600","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"YdPK"}]},{"client_msg_id":"C7084DB9-54D0-4ABA-9E5F-E96D8BCD877F","type":"message","user":"UFHQ7TNT0","text":"まさに罠","ts":"1625279256.103000","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"eTFJP"}]},{"client_msg_id":"3E3DD5AD-0E39-4269-B693-64D433029C83","type":"message","user":"UFHQ7TNT0","text":"でも、一回でもグローバルタイムゾーン対応へのマイグレーションを経験すると、タイムゾーンはUTC一択、他は認めんになるから、この罠も踏まないようになりますね。","ts":"1625280347.106400","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"F6pU"}]},{"client_msg_id":"a124af43-9583-4a33-8210-22f60712f70a","type":"message","user":"U06BRP8VD","text":"いやー本番ではそう(UTC運用安定)なんですけども、ローカル開発では気が付かんですよこれは。しかもPostgreSQLだと問題ないから。","ts":"1625280508.106600","thread_ts":"1625274441.095600","edited":{"user":"U06BRP8VD","ts":"1625280552.000000"},"parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"B3h"}]},{"client_msg_id":"0946AD42-173F-475C-8E10-13BC5E123B77","type":"message","user":"UFHQ7TNT0","text":"ローカル開発環境はどうしましょうかね。仮にCIのテストでうまく気づけたとしても、ローカルでテストが通らないと結局つらいですしね。","ts":"1625280975.108700","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"GjuH"}]},{"client_msg_id":"072cf3a7-bef6-448e-b7d9-7a076070ef22","type":"message","user":"U06BRP8VD","text":"そうそう。まぁ今回は原因わかって直せるので良いんですが。","ts":"1625281025.108900","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"TSpNx"}]},{"client_msg_id":"f6ad29b6-3e26-4573-85fd-2beeaa222b39","type":"message","user":"UDDCM376D","text":"\u0026gt; でも、一回でもグローバルタイムゾーン対応へのマイグレーションを経験すると、タイムゾーンはUTC一択、他は認めんになるから、この罠も踏まないようになりますね。\n最近TZ色々考えた結果、UTCが良いなって結論になりました\n他のみんなも同じ考えで一安心しました","ts":"1625281366.109100","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"9lhd"}]},{"client_msg_id":"3a742c83-907e-40bd-a49d-abf1d9e451df","type":"message","user":"U03C6TEAZ","text":"current_timestamp が合わなくなるからでは。","ts":"1625281484.109300","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"EMi"}]},{"client_msg_id":"ec19f626-bb88-4beb-917f-cc5b7adc2a0a","type":"message","user":"U03C6TEAZ","text":"SQLite3 には日付型がないので xorm でタイムゾーンを変換する事もできない。","ts":"1625281550.109500","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ER09M"}]},{"client_msg_id":"67184d9f-8090-413d-a9e0-b3370ce7ba6b","type":"message","user":"U03C6TEAZ","text":"ユーザに正しく使って貰う為には xorm が UTC に決めうちするしかない。","ts":"1625281614.109700","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"TgciX"}]},{"client_msg_id":"bbf0ebbe-0159-4279-b35e-fe8482ea7804","type":"message","user":"U06BRP8VD","text":"xorm的にはDB関係なく決め打ちすることになってて、それがローカルなんですが、SQLiteだけUTCなのが謎なんですよ。","ts":"1625281677.109900","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0c+"}]},{"client_msg_id":"7ead027a-6967-4504-afaf-7c5ea93e1da2","type":"message","user":"U03C6TEAZ","text":"sqlite3 って日付型ないけど、日付関数が UTC 前提なので UTC 使ってねってスタンスだった気がする。","ts":"1625282071.110100","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","reactions":[{"name":"hee","count":1,"users":["UFHQ7TNT0"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"rGFS"}]},{"client_msg_id":"76a53903-3de3-46f8-8e8a-befcbc9a5690","type":"message","user":"U06BRP8VD","text":"へぇなるほど","ts":"1625282527.110300","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"3jqnr"}]},{"client_msg_id":"9cc94fa5-d183-40e4-986f-361f4af56a73","type":"message","user":"U06BRP8VD","text":"日付名数がUTC前提って…どういう違いがあるんだろう?","ts":"1625282555.110500","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"5TRsd"}]},{"client_msg_id":"52d2b1c2-4d97-4c26-95dd-e7b961f29cbb","type":"message","user":"U06BRP8VD","text":"タイムゾーンを考慮する必要がある日付関数にはどんなものがあるんだろうか?","ts":"1625282569.110700","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"tPY5"}]},{"client_msg_id":"a1088f45-7811-4ce7-b4b6-9f864e705451","type":"message","user":"U06BRP8VD","text":"\u003chttps://sqlite.org/lang_datefunc.html\u003e みてる","ts":"1625282710.110900","thread_ts":"1625274441.095600","edited":{"user":"U06BRP8VD","ts":"1625282715.000000"},"parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"gEm"}]},{"client_msg_id":"1b911692-d1be-4c61-b510-5dcd48f5e18b","type":"message","user":"U06BRP8VD","text":"一応タイムゾーン表記は受け付けるけど内部的にはUTCで保存するっぽいことは書いてある。\n\nあとローカルタイムの計算は使ってる localtime_r の制限で通常は1970～2037でしか機能しないとも。","ts":"1625283026.111200","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fJ9a"}]},{"client_msg_id":"5f7680ec-1f8c-4946-8976-7c8164bbb1ed","type":"message","user":"U06BRP8VD","text":"なるほど合わせ技でUTCしか使い物にならないという感じか。","ts":"1625283043.111400","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"DwU"}]},{"client_msg_id":"de74e540-3429-421a-a7d0-c8d148b38792","type":"message","user":"U03C6TEAZ","text":"あ、ですです。","ts":"1625285418.111600","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"crcT"}]},{"client_msg_id":"d83e3a9b-37c0-4870-aac3-2c3b4c8583cf","type":"message","user":"U03C6TEAZ","text":"とはいえ日付型ないのでユーザがテキストフィールドに何入れようが勝手なんですけどね。","ts":"1625285481.111800","thread_ts":"1625274441.095600","parent_user_id":"U06BRP8VD","team":"T03C4RC8V","reactions":[{"name":"sorena","count":1,"users":["U06BRP8VD"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"SCGR"}]}]
