s8c7444fg0chird9erqef2vkhb8","thumb_width":1280,"thumb_height":640,"from_url":"https://pub.dev/packages/artemis","original_url":"https://pub.dev/packages/artemis"},{"color":"24292f","fallback":"99designs/gqlgen","id":3,"title":"99designs/gqlgen","text":"go generate based graphql server library","fields":[{"title":"Website","value":"\u003chttps://gqlgen.com\u003e","short":true},{"title":"Stars","value":"6787","short":true}],"blocks":null}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"7gl52"}]},{"client_msg_id":"49ceef76-ac71-4326-8836-5519cac84f59","type":"message","user":"U03C6TEAZ","text":"swagger-editor が出力するコード、swagger というディレクトリに、struct wrapping されてない関数で CRUD なコードが吐かれるので、ORM のクライアントを持てないし、まさか swagger ディレクトリにグローバル変数作りたくないしで、ちょっとモヤモヤする。","ts":"1637732948.048000","team":"T03C4RC8V","reactions":[{"name":"eyes","count":2,"users":["UL5G6QL5U","UEACRCY0Z"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"b9A"}]},{"client_msg_id":"62d5c507-ef5f-469a-9ab9-514fd4818979","type":"message","user":"U06BRP8VD","text":"(ちなみに同じプロジェクトではGraphQLも使ってて、そっちではスキーマをGoのコードから生成するのを試してる）","ts":"1637732845.046400","edited":{"user":"U06BRP8VD","ts":"1637732871.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"3qD4"}]},{"client_msg_id":"cb22fc44-67b2-49bd-a92f-88205541b02e","type":"message","user":"U06BRP8VD","text":"僕はgo-swaggerですね。swaggerだけ先行させてサー場とクライアントが同時に進めるので。","ts":"1637732829.046100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jKw"}]},{"client_msg_id":"216bfb60-61b6-4d42-99e6-4d76a831e2ae","type":"message","user":"UDDCM376D","text":"こういう自動生成されたコードをカスタマイズしていくのが一般的ですかね\n自分は自動生成しないでいつもやっていますが、普段みんなどうやっているのかが気になります","ts":"1637732747.045400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"KuEa/"}]},{"client_msg_id":"7e6c7b4e-7716-42b3-8884-847d8e985910","type":"message","user":"U03C6TEAZ","text":"なんかこう、こういう出力されたスケルトンサーバに、ORM なんかのコードを埋め込む作業してると、JSON 色付け感がでますよね。","ts":"1637732544.044400","team":"T03C4RC8V","reactions":[{"name":"sorena","count":2,"users":["UFYACJ537","UDDCM376D"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"dicS"}]},{"client_msg_id":"d21ec146-cede-44cc-ae24-15b4a4926759","type":"message","user":"UFYACJ537","text":"\u003chttps://future-architect.github.io/articles/20200701/\u003e oapi-codegenだとechoかchiのコード出力できますね","ts":"1637732384.043400","attachments":[{"fallback":"フューチャー技術ブログ: Go の Open API 3.0 のジェネレータ oapi-codegen を試してみた | フューチャー技術ブログ","id":1,"title":"Go の Open API 3.0 のジェネレータ oapi-codegen を試してみた | フューチャー技術ブログ","title_link":"https://future-architect.github.io/articles/20200701/","text":"The Gopher character is based on the Go mascot designed by Renée French. 概要TIG DXチーム所属の多賀です。最近はフロントのコードを書いたりすることも増えましたが、引き続き Go も触っています。Go で OpenAPI(Swagger) からコード生成する際には、 go-swagger をよく利用しています。go-s","thumb_url":"https://future-architect.github.io/images/20200701/top.png","blocks":null,"ts":1593564040,"service_name":"フューチャー技術ブログ","service_icon":"https://future-architect.github.io/apple-touch-icon.png","thumb_width":431,"thumb_height":242,"from_url":"https://future-architect.github.io/articles/20200701/","original_url":"https://future-architect.github.io/articles/20200701/"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"aTyW"}]},{"client_msg_id":"a259e925-e7da-43c6-bb4b-b3a967eb598f","type":"message","user":"U06ECBRTJ","text":"\u003chttps://future-architect.github.io/articles/20200630/\u003e\ngo-swagger の方が多いんじゃないですかね","ts":"1637732112.042800","attachments":[{"fallback":"フューチャー技術ブログ: go-swaggerを用いたWebアプリケーション開発Tips19選 | フューチャー技術ブログ","id":1,"title":"go-swaggerを用いたWebアプリケーション開発Tips19選 | フューチャー技術ブログ","title_link":"https://future-architect.github.io/articles/20200630/","text":"はじめにTIG DXユニット 1の真野です。echo → 生net/http → gorilla/mux → go-swagger, gqlgenの経歴でGoのHTTP APIを実装してきました。本記事では最近業務でヘビーユーズしているgo-swaggerについての開発Tipsをまとめました。 背景フューチャーではGoを採用する案件が増えて来ており、その際にgo-swagger というツールを利用","thumb_url":"https://future-architect.github.io/images/20200630/photo_20200630_01.png","blocks":null,"ts":1593479175,"service_name":"フューチャー技術ブログ","service_icon":"https://future-architect.github.io/apple-touch-icon.png","thumb_width":771,"thumb_height":450,"from_url":"https://future-architect.github.io/articles/20200630/","original_url":"https://future-architect.github.io/articles/20200630/"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Fhh7"}]},{"client_msg_id":"676c5d93-eac7-446f-8c98-6a8ccecf37e0","type":"message","user":"U03C6TEAZ","text":"gorilla/mux の router で書かれていた。","ts":"1637731499.042300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Rt6K"}]},{"client_msg_id":"e290ad46-f64a-4335-9070-6a835cb5a89d","type":"message","user":"U03C6TEAZ","text":"これを昨日やっていて、swagger-editor が出力したサーバを弄ってみたんだけど、みなさんあのコードをベースにしてるんかな？","ts":"1637731474.041900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"V2Q"}]},{"client_msg_id":"2e147eac-de6d-47f7-9b56-6507ffe107c2","type":"message","user":"U03C6TEAZ","text":"\u003chttps://twitter.com/mattn_jp/status/1463037433105108994\u003e","ts":"1637731443.041100","attachments":[{"fallback":"\u003chttps://twitter.com/mattn_jp|@mattn_jp\u003e: これを試してるけど良いね。\n\n\u003chttps://entgo.io/blog/2021/09/10/openapi-generator/\u003e","id":1,"author_name":"mattn","author_subname":"@mattn_jp","author_link":"https://twitter.com/mattn_jp/status/1463037433105108994","author_icon":"https://pbs.twimg.com/profile_images/1361128357698572292/61_qdnll_normal.jpg","text":"これを試してるけど良いね。\n\n\u003chttps://entgo.io/blog/2021/09/10/openapi-generator/\u00