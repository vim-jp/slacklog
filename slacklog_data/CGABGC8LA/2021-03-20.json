9cd-4128e33beff4","type":"message","user":"UAZ33BKV2","text":"\u003chttps://sue445.hatenablog.com/entry/2021/03/20/075551\u003e\n大概はGitHub版使ってるかもだけど","ts":"1616235094.094700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"pjU"}]},{"client_msg_id":"51870683-5e14-4d09-bb35-51e0dfadd061","type":"message","user":"U06BRP8VD","text":"標準入出力のファイルディスクリプタ(fd)が tty=端末ファイルにつながってるか一般のファイルにつながってるかはプログラム起動時点すなわちシェルがfdを作った時点で決まっちゃってるから変えられないんじゃないかな。なので仮に標準出力のfdをioctlでtty属性に変えられても意味がない(というか変えられない)\n\nWindowsならAttachConsoleでつなぐこともできるかもだけど、むかしやったときは新しいコンソールが開いた気もする。\n\nUNIX (Linux) なら /proc 下か /dev 下に今繋がってる tty があるだろうからそれを tcell に教えてあげられればできそうなものだけども。","ts":"1616199605.085600","thread_ts":"1616198016.083200","subtype":"thread_broadcast","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"47NR"}],"root":{"client_msg_id":"1fff6ee6-aa87-4afa-9059-6bf0018374ed","type":"message","user":"UDDCM376D","text":"Goで標準入力からデータを読み取った後に tcell で stdin を使おうとすると\ninappropriate ioctl for device ってになるんですが、stdin が tty じゃないからだと思いますが、データを読み取ったあとに stdin を tty にする方法ってあるんでしょうか？","ts":"1616198016.083200","thread_ts":"1616198016.083200","reply_count":36,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Ir8"}]}},{"client_msg_id":"b41ae6a5-83fb-4e8e-a18c-31826d0474a2","type":"message","user":"UNJ2DANJC","text":"わかりみ \u003chttps://github.com/golang/go/issues/45108\u003e","ts":"1616198460.083600","attachments":[{"fallback":"GitHub: proposal: cmd/vet: checker to warn when marshaling an exported error field · Issue #45108 · golang/go","id":1,"title":"proposal: cmd/vet: checker to warn when marshaling an exported error field · Issue #45108 · golang/go","title_link":"https://github.com/golang/go/issues/45108","text":"This proposal is to add a new vet checker that warns when an exported error field of a struct is marshaled. Currently what will happen is that as error is an interface this will use the marshaling ...","thumb_url":"https://avatars.githubusercontent.com/u/4314092?s=400\u0026v=4","blocks":null,"service_name":"GitHub","service_icon":"https://a.slack-edge.com/80588/img/unfurl_icons/github.png","thumb_width":400,"thumb_height":400,"from_url":"https://github.com/golang/go/issues/45108","original_url":"https://github.com/golang/go/issues/45108"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"aCCLt"}]},{"client_msg_id":"1fff6ee6-aa87-4afa-9059-6bf0018374ed","type":"message","user":"UDDCM376D","text":"Goで標準入力からデータを読み取った後に tcell で stdin を使おうとすると\ninappropriate ioctl for device ってになるんですが、stdin が tty じゃないからだと思いますが、データを読み取ったあとに stdin を tty にする方法ってあるんでしょうか？","ts":"1616198016.083200","thread_ts":"1616198016.083200","reply_count":36,"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Ir8"}]},{"client_msg_id":"1709C853-EE0B-4ECA-A968-D2AD7C913C73","type":"message","user":"UDDCM376D","text":"なるほど…","ts":"1616199690.086000","thread_ts":"1616198016.083200","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"dsqlC"}]},{"client_msg_id":"ABD4545A-64E8-4558-8828-0C90F74D184B","type":"message","user":"UDDCM376D","text":"Linuxは/dev/ttyありますね","ts":"1616199715.086800","thread_ts":"1616198016.083200","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"LHtL5"}]},{"client_msg_id":"18E7E99C-0898-4691-BAD2-67BB3903D970","type":"message","user":"UDDCM376D","text":"Windowsは諦めるか…","ts":"1616199728.087300","thread_ts":"1616198016.083200","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"R4rw"}]},{"client_msg_id":"30af533e-c32b-4d66-9f57-997060cc4af6","type":"message","user":"U06BRP8VD","text":"っていうかそもそもtcellにtty指定して始める方法あるの? ってところから調べないと。","ts":"1616199893.087500","thread_ts":"1616198016.083200","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hb12N"}]},{"client_msg_id":"a291aa8b-a669-45f8-bd91-a5862fac1711","type":"message","user":"U06BRP8VD","text":"Windowsはココで救われそうな気もする。\n\n\u003chttps://github.com/gdamore/tcell/blob/fcaa20f283682d6bbe19ceae067b37df3dc699d7/console_win.go#L158\u003e","ts":"1616200031.087700","thread_ts":"1616198016.083200","attachments":[{"fallback":"GitHub: gdamore/tcell","id":1,"title":"gdamore/tcell","title_link":"https://github.com/gdamore/tcell/blob/fcaa20f283682d6bbe19ceae067b37df3dc699d7/console_win.go#L158","text":"Tcell is an alternate terminal package, similar in some ways to termbox, but better in others. - gdamore/tcell","thumb_url":"https://avatars.githubusercontent.com/u/1295229?s=400\u0026v=4","blocks":null,"service_name":"GitHub","service_icon":"https://a.slack-edge.com/80588/img/unfurl_icons/github.png","thumb_width":400,"thumb_height":400,"from_url":"https://github.com/gdamore/tcell/blob/fcaa20f283682d6bbe19ceae067b37df3dc699d7/console_win.go#L158","original_url":"https://github.com/gdamore/tcell/blob/fcaa20f283682d6bbe19ceae067b37df3dc699d7/console_win.go#L158"}],"parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"D8qdj"}]},{"client_msg_id":"896a4854-5188-41e3-a200-c79759324dd1","type":"message","user":"U06BRP8VD","text":"UNIXのほうはココが問題そう。\n\n\u003chttps://github.com/gdamore/tcell/blob/f4d402906fa3d330545365abbf970c048e677b35/tscreen_unix.go#L98-L100\u003e","ts":"1616200239.088000","thread_ts":"1616198016.083200","attachments":[{"fallback":"GitHub: gdamore/tcell","id":1,"title":"gdamore/tcell","title_link":"https://github.com/gdamore/tcell/blob/f4d402906fa3d330545365abbf970c048e677b35/tscreen_unix.go#L98-L100","text":"Tcell is an alternate terminal package, similar in some ways to termbox, but better in others. - gdamore/tcell","thumb_url":"https://avatars.githubusercontent.com/u/1295229?s=400\u0026v=4","blocks":null,"service_name":"GitHub","service_icon":"https://a.slack-edge.com/80588/img/unfurl_icons/github.png","thumb_width":400,"thumb_height":400,"from_url":"https://github.com/gdamore/tcell/blob/f4d402906fa3d330545365abbf970c048e677b35/tscreen_unix.go#L98-L100","original_url":"https://github.com/gdamore/tcell/blob/f4d402906fa3d330545365abbf970c048e677b35/tscreen_unix.go#L98-L100"}],"edited":{"user":"U06BRP8VD","ts":"1616200271.000000"},"parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"tqeL"}]},{"client_msg_id":"62435206-03e4-4586-bbf8-773bf9c27734","type":"message","user":"U06BRP8VD","text":"tScreenの入出力を os.Stdxx に決め打ちしたうえで GetStateをos.Stdin.Fd() にしてるでしょ。たぶんココで失敗してる。","ts":"1616200330.088500","thread_ts":"1616198016.083200","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"MBP"}]},{"client_msg_id":"c4f584ad-19f8-4a45-88e5-06b53613f83d","type":"message","user":"U06BRP8VD","text":"とりあえずココを tty につなぐように変えたらいけるんじゃないかなぁ。","ts":"1616200368.088700","thread_ts":"1616198016.083200","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"QTym="}]},{"client_msg_id":"e399db85-d58a-4fb3-b5e5-1af5037c61e1","type":"message","user":"U06BRP8VD","text":"Windowsはさっき見た通りすでに救われてる。","ts":"1616200381.088900","thread_ts":"1616198016.083200","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"B64"}]},{"client_msg_id":"fe959c04-6d9a-4827-b75b-133eab59ac6a","type":"message","user":"U06BRP8VD","text":"ああそうか。WindowsはそもそもCONIN$とCONOUT$以外にコンソールファイルを得る手段がないんだ。だから最初から正しい方法で取得している。\n\n一方でUNIXはSTDIN/OUTがコンソールが繋がってることがほとんどだからだいたいのケースで問題ない。そのせいでエッジケースにとっては正しくない。\n\nなるほどなぁ。","ts":"1616200542.089100","thread_ts":"1616198016.083200","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"v2mzh"}]},{"client_msg_id":"140e6353-d56a-42f9-9805-cacff7d5577a","type":"message","user":"UDDCM376D","text":"なるほど","ts":"1616200589.089300","thread_ts":"1616198016.083200","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"MYT"}]},{"client_msg_id":"085ca11e-142b-4c57-b193-938de21c8a3f","type":"message","user":"UDDCM376D","text":"ちょっとコード見てみます\nありがとうございます","ts":"1616200601.089500","thread_ts":"1616198016.083200","parent_user_id":"UDDCM376D","team":"T03C4RC8V","reactions":[{"name":"+1","count":1,"users":["U06BRP8VD"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"EtuwI"}]},{"client_msg_id":"ee505cda-e655-4ad1-bc68-19fadcce2d7d","type":"message","user":"UDDCM376D","text":"Linuxは以前は問題なく動いていたんすけど、どうやら↑の修正で動かくなったようです","ts":"1616200686.089800","thread_ts":"1616198016.083200","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"3g1H"}]},{"client_msg_id":"681e9080-50d2-4835-8464-b206b18cc319","type":"message","user":"U06BRP8VD","text":"お、そうなん?","ts":"1616200713.090000","thread_ts":"1616198016.083200","parent_user_id":"UDDCM376D","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+vh"}]},{"client_msg_id":"7b2ef9f6-037b-4f36-8c78-17ad8fbaf735","type":"message","user":"UDDCM376D","text":"はい、チョット前までのtcellは動いていたんですよね\n貼って頂いた箇所↓は原因のような気がします\n過去の実装もちょっと追ってみてます\n```term.GetState(int(os.Stdin.Fd()))```","ts":"1616200810.090200","thread_ts":"1616198016.083200","parent_user_id":"UDDCM376D","team":"T03C4RC8V","reacti