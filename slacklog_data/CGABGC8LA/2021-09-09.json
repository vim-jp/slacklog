R=\"/usr/local/go/pkg/tool/darwin_amd64\"\nGOVCS=\"\"\nGOVERSION=\"go1.17\"\nGCCGO=\"gccgo\"\nAR=\"ar\"\nCC=\"clang\"\nCXX=\"clang++\"\nCGO_ENABLED=\"1\"\nGOMOD=\"/Users/hajimehoshi/test/go.mod\"\nCGO_CFLAGS=\"-g -O2\"\nCGO_CPPFLAGS=\"\"\nCGO_CXXFLAGS=\"-g -O2\"\nCGO_FFLAGS=\"-g -O2\"\nCGO_LDFLAGS=\"-g -O2\"\nPKG_CONFIG=\"pkg-config\"\nGOGCCFLAGS=\"-fPIC -arch x86_64 -m64 -pthread -fno-caret-diagnostics -Qunused-arguments -fmessage-length=0 -fdebug-prefix-map=/var/folders/60/khbk2xqn1c5bml1byjn89dwc0000gn/T/go-build3631899530=/tmp/go-build -gno-record-gcc-switches -fno-common\" \n*What did you do?*\n\nRun this and see the memory usage (I saw \"Real Private Memory\" on Activity on macOS):\n\n```\npackage main\n\nimport (\n        \"time\"\n        \"runtime\"\n)\n\nvar f func()\n\nfunc foo(bs []byte) {\n        if f == nil {\n                copied := make([]byte, len(bs))\n                copy(copied, bs)\n                f = func() {\n                        foo(copied)\n                }\n                return\n        }\n\n        println(len(bs))\n}\n\nfunc main() {\n        bs := make([]byte, 100*1024*1024)\n        foo(bs)\n\n        f()\n        f = nil\n\n        for {\n                runtime.GC()\n                time.Sleep(time.Second)\n        }\n}\n```\n\n*What did you expect to see?*\n\nThe private memory usage should be the same as this program (less than 10[MB] maybe):\n\n```\nfunc main() {\n        for {\n                runtime.GC()\n                time.Sleep(time.Second)\n        }\n}\n```\n\n*What did you see instead?*\n\nThe private memory usage keeps about 200[MB]","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/golang/go|golang/go\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png","ts":1631119786}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"2o89"}]},{"client_msg_id":"8eea60a3-1dca-4a8e-9036-c2b8700486b0","type":"message","user