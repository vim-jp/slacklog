_id":"z2a"}]},{"client_msg_id":"1307b97f-aa35-4112-81dc-3199f5ed2509","type":"message","user":"U06BRP8VD","text":"んーこれはスキーマもデータもどっちも同時にバージョン管理の対象としちゃうの?","ts":"1615281565.423600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"LK4w"}]},{"client_msg_id":"c29b2dc2-933e-4e54-8e87-49637fe63272","type":"message","user":"UKHUVMBJR","text":"というよりバージョン管理機能をもったSQLデータベースかな","ts":"1615280412.423100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hYMp"}]},{"client_msg_id":"ac04e987-b43b-43dc-9b5d-adc58e415990","type":"message","user":"U06ECBRTJ","text":"SQL を git で管理するやつ","ts":"1615279554.422700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ckbiv"}]},{"client_msg_id":"a36a3265-6006-4b67-a864-cd66c8413396","type":"message","user":"U06ECBRTJ","text":"いや、逆ですね","ts":"1615279543.422300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hzW"}]},{"client_msg_id":"15234a27-9e2f-4219-a42a-30d44fa4f9de","type":"message","user":"UDDCM376D","text":"gitをsqlで操作できるやつ。。。？","ts":"1615279193.422100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"s70l"}]},{"client_msg_id":"29e139dc-ef76-4b20-b50b-3866a8d24ac8","type":"message","user":"UKHUVMBJR","text":"最近良くGitHub Trendsで見るやつだ","ts":"1615278579.421800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"YmNNq"}]},{"client_msg_id":"5404d9f6-580d-4ff3-8819-d0fc1e348802","type":"message","user":"U03C6TEAZ","text":"お陰で README に書いてある SQL をコピペすると `update ...` が `upate ...` になってエラーになる。","ts":"1615277887.421500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"wSLS"}]},{"client_msg_id":"9779ff92-7938-4ffe-bbb1-8fe4c67863d6","type":"message","user":"U03C6TEAZ","text":"Windows だと `d` がタイプできない。","ts":"1615277858.420900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/cI"}]},{"client_msg_id":"fa73523d-f7f4-4d70-b56f-0447df506ee0","type":"message","user":"U03C6TEAZ","text":"\u003chttps://github.com/dolthub/dolt\u003e","ts":"1615277848.420500","attachments":[{"fallback":"GitHub: dolthub/dolt","id":1,"title":"dolthub/dolt","title_link":"https://github.com/dolthub/dolt","text":"Dolt – It's Git for Data. Contribute to dolthub/dolt development by creating an account on GitHub.","thumb_url":"https://avatars.githubusercontent.com/u/42156961?s=400\u0026v=4","blocks":null,"service_name":"GitHub","service_icon":"https://a.slack-edge.com/80588/img/unfurl_icons/github.png","thumb_width":400,"thumb_height":400,"from_url":"https://github.com/dolthub/dolt","original_url":"https://github.com/dolthub/dolt"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"lgZb3"}]},{"client_msg_id":"f0745e06-84c3-42f1-90fd-a21affc3096c","type":"message","user":"UERCTTT8B","text":"context の意味は context 次第だという","ts":"1615264749.420100","team":"T03C4RC8V","reactions":[{"name":"nice-boke","count":1,"users":["UKHUVMBJR"]},{"name":"zabuton3","count":1,"users":["UKHUVMBJR"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"SAY"}]},{"client_msg_id":"fbb9ea1b-f6a5-40a9-a830-ce07f733061f","type":"message","user":"U03C6TEAZ","text":"単にリクエストレスポンスを束ねる意味で `echo.Context` という名前だったりするので。","ts":"1615264712.419800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"O+UP"}]},{"client_msg_id":"0750ac79-6c23-435e-9ad3-bad10ebe2eff","type":"message","user":"U03C6TEAZ","text":"フレームワークなんかが持ってる Context はまた少し意味合いが違うので間違えやすいですね。","ts":"1615264676.419300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"lYrQg"}]},{"client_msg_id":"8e07071a-e4e2-4b49-a6b5-d1f1e5e97ecc","type":"message","user":"U03C6TEAZ","text":"\u003chttps://github.com/golang/go/blob/618b66e16d5adedbeccb7e7ed35b26e439a9f86f/src/net/http/request.go#L333-L335\u003e","ts":"1615264530.418700","attachments":[{"fallback":"GitHub: golang/go","id":1,"title":"golang/go","title_link":"https://github.com/golang/go/blob/618b66e16d5adedbeccb7e7ed35b26e439a9f86f/src/net/http/request.go#L333-L335","text":"The Go programming language. Contribute to golang/go development by creating an account on GitHub.","thumb_url":"https://avatars.githubusercontent.com/u/4314092?s=400\u0026v=4","blocks":null,"service_name":"GitHub","service_icon":"https://a.slack-edge.com/80588/img/unfurl_icons/github.png","thumb_width":400,"thumb_height":400,"from_url":"https://github.com/golang/go/blob/618b66e16d5adedbeccb7e7ed35b26e439a9f86f/src/net/http/request.go#L333-L335","original_url":"https://github.com/golang/go/blob/618b66e16d5adedbeccb7e7ed35b26e439a9f86f/src/net/http/request.go#L333-L335"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"RdgYc"}]},{"client_msg_id":"0cc43482-0c3f-4140-ad9c-9751b7b93b7c","type":"message","user":"UEA8T80GY","text":"なるほど、ありがとうございます。net/httpのboxyところは知りませんでした。見てみます。","ts":"1615264422.418400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"rz3EK"}]},{"client_msg_id":"45a0ebcf-466e-4606-acc7-60dc531904e9","type":"message","user":"UNJ2DANJC","text":"cancelのスコープがわかりやすいですね","ts":"1615264276.417200","team":"T03C4RC8V","reactions":[{"name":"sorena","count":1,"users":["U03C6TEAZ"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"QTVLD"}]},{"client_msg_id":"28a429d6-fde5-41a3-97ec-50228a979db7","type":"message","user":"U03C6TEAZ","text":"双方向に見えてしまうし。","ts":"1615264245.416700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Pab"}]},{"client_msg_id":"d6a8c4d0-87fd-414a-ba03-6edf90327a05","type":"message","user":"U03C6TEAZ","text":"`ctx, cancel := context.WithCancel(ctx)` は一見不細工だけど、 `ctx.Cancel()` みたく足を生やさない設計にして偉いなと思う。 `Cancel` 生やしたら絶対に混乱する。","ts":"1615264225.416500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Qhea"}]},{"client_msg_id":"82920271-41a9-4adb-bf5e-461d962cf9da","type":"message","user":"UNJ2DANJC","text":"クライアントがぶちっと切ったりすると確かcancelが飛んでくるはず。\nこういう場合例えばDBへのINSERT前ならきちっとcancelしたいですね。","ts":"1615264149.415300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ZrR=Z"}]},{"client_msg_id":"046c43df-231f-483c-ae26-1a09b00b175d","type":"message","user":"U03C6TEAZ","text":"例えば HTTP リクエストは、body を含んでる場合もあり net/http はヘッダを読み取った時点でフレームワーク等に制御を移すんですが、そうなると body が途中で欠けてる場合もある。net/http が「おっと、body が途中で欠けたわ」ってフレームワーク側にキャンセルを通知する必要がある訳ですが、それを context 使ってやってるんですよね。なので net/http のキャンセルを検知したいなら、どこまででも context 引きまわしたらいいです。","ts":"1615263883.412200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"7OCc"}]},{"client_msg_id":"a8b52237-ee5e-4ff8-917a-9526aa0f898e","type":"message","user":"U03C6TEAZ","text":"何のために context が引き渡されるかですね。","ts":"1615263846.411400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"r3DBg"}]},{"client_msg_id":"9f348d5d-9904-402b-8916-548e966c6b63","type":"message","user":"UEA8T80GY","text":"ありがとうございます。","ts":"1615263416.409100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"znLA"}]},{"client_msg_id":"972e0cbc-b074-4a49-91f2-e7edd58d25fa","type":"message","user":"UEA8T80GY","text":"理解しました。","ts":"1615263396.408900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Wg="}]},{"client_msg_id":"56f3d1cf-3526-4f25-bcde-0b0d50bfeec7","type":"message","user":"UNJ2DANJC","text":":sorena: immutable","ts":"1615263370.408600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"lsu"}]},{"client_msg_id":"6d9f987a-86ea-43ac-b4d4-01fb9d9bce51","type":"message","user":"U06BRP8VD","text":"コンテキストは書き換えられないし、差し替えられないので。","ts":"1615263336.408400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Cyx8v"}]},{"client_msg_id":"32045f13-d337-4357-b714-818f5df00dab","type":"message","user":"U06BRP8VD","text":"です","ts":"1615263306.407500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ZsQp"}]},{"client_msg_id":"eb78e06e-1a29-4256-ac6f-4b9fa9ad446f","type":"message","user":"UNJ2DANJC","text":"req = req.WithContext(ctx)のことですかね","ts":"1615263154.407300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"DBy="}]},{"client_msg_id":"5b6133a8-4629-4750-bbb3-c7cb82c6f66b","type":"message","user":"UEA8T80GY","text":"ひょっとしてreq := req.Clone() しないと競合が発生するみたいな感じでしょうか。","ts":"1615263119.406700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"P0Q"}]},{"client_msg_id":"39cd520d-bd65-4d23-8f1e-96c10ca58f4f","type":"message","user":"U06BRP8VD","text":"あとリクエストのコンテキストに値を載せたいときはリクエストをクローンすることになるとか…細かい話はある。","ts":"1615262971.406000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"sQob"}]},{"client_msg_id":"ddf6fa25-5dde-4497-93de-31b019efb581","type":"message","user":"UEA8T80GY","text":"なるほど","ts":"1615262923.404800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ID7o"}]},{"client_msg_id":"6aafb6cf-c993-40f7-a1fa-cb052dadee42","type":"message","user":"UNJ2DANJC","text":"WithValueしまくると...","ts":"1615262892.404200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Kl+dZ"}]},{"client_msg_id":"3c620d64-2445-4933-8ff4-fb1007ee8643","type":"message","user":"U06BRP8VD","text":"コンテキストの値は便利なんですけど濫用は避けるべきものでもあります。値取り出すの線形検索なので多くなると遅いし。","ts":"1615262847.403800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"W4u3l"}]},{"client_msg_id":"dfe7743a-718c-4919-8437-d3acb30d6ecc","type":"message","user":"UNJ2DANJC","text":"バックグラウンド処理に上流からわたってくるtrace用のid類を渡したりするのに使えるかなとは思いました。これは公式ではないです。","ts":"1615262819.403300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"DYcE7"}]},{"client_msg_id":"bf3a60d6-3264-4731-82e2-804d381e85d3","type":"message","user":"U06BRP8VD","text":"インターナルだからそれは公式とは言い難いですね。","ts":"1615262768.401400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"PvE/"}]},{"client_msg_id":"950e8c31-ab1b-4cfb-bc4e-dadaba9687b0","type":"message","user":"UEA8T80GY","text":"ありがとうございます。","ts":"1615262746.400500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"tIap"}]},{"client_msg_id":"31516298-475a-4803-992f-1d0d8fc9eef5","type":"message","user":"UEA8T80GY","text":"cancelの伝播が役割かと思っていたので公式に値のみのcontextがいるのにびっくりしました。","ts":"1615262729.400200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"xxq"}]},{"client_msg_id":"0e31df05-d9be-42bc-a147-db04f9108889","type":"message","user":"UNJ2DANJC","text":"こういうcancelが伝搬しない値のみのcontextもありますね。実際に使ったことはないですが、koronさんが言及した特殊要件用かな。\n\u003chttps://github.com/golang/tools/blob/v0.1.0/internal/xcontext/xcontext.go\u003e","ts":"1615262639.398900","attachments":[{"fallback":"GitHub: golang/tools","id":1,"title":"golang/tools","title_link":"https://github.com/golang/tools/blob/v0.1.0/internal/xcontext/xcontext.go","text":"[mirror] Go Tools. Contribute to golang/tools development by creating an account on GitHub.","thumb_url":"https://avatars.githubusercontent.com/u/4314092?s=400\u0026v=4","blocks":null,"service_name":"GitHub","service_icon":"https://a.slack-edge.com/80588/img/unfurl_icons/github.png","thumb_width":400,"thumb_height":400,"from_url":"https://github.com/golang/tools/blob/v0.1.0/internal/xcontext/xcontext.go","original_url":"https://github.com/golang/tools/blob/v0.1.0/internal/xcontext/xcontext.go"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"BuAtX"}]},{"client_msg_id":"2a5023f1-26f4-4c61-8b05-37df9a91f0a1","type":"message","user":"U06BRP8VD","text":"こまかいtipsはありますけど大枠はそれで。","ts":"1615262607.398300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"VEM4K"}]},{"client_msg_id":"8d45daad-8fd4-4ddf-b034-b2872d123e03","type":"message","user":"U06BRP8VD","text":"あってます。","ts":"1615262583.397400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"XbYSz"}]},{"client_msg_id":"eb9acb90-2db4-45cf-9820-14e27472de99","type":"message","user":"UEA8T80GY","text":"なるほどありがとうございます。\nreq.Context() でそれを引き回す感じでしょうか。例えば、ginみたいなフレームワークが上にいた場合、func(g gin.Context) みたいに渡ってきたときは それを引き回すで合っていますでしょうか。","ts":"1615262536.396400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"L7pxx"}]},{"client_msg_id":"4b77ad5b-b0a3-489e-a21f-2a8f3010b8fe","type":"message","user":"U06BRP8VD","text":"特殊な要件がある場合はそこからラップしたり、はたまた別に作り直すということもあるけど…レアケース。","ts":"1615262488.395500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Nnt"}]},{"client_msg_id":"d414c6c4-fcc5-49f2-b458-7a4a1863ffb0","type":"message","user":"U06BRP8VD","text":"リクエストからコンテキストとりだしてひきまわします。","ts":"1615262398.392000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"lYW"}]},{"client_msg_id":"a38d9573-b933-4b45-a81a-4630510e0c6c","type":"message","user":"UNJ2DANJC","text":"そのまま引き回しますね。","ts":"1615262342.390600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Epsq"}]},{"client_msg_id":"ef17c793-c3f9-4495-bfe3-fa335b95044e","type":"message","user":"UDDCM376D","text":"ここらへん、みなさんの考えを聞きたいすね","ts":"1615262335.390300","edited":{"user":"UDDCM376D","ts":"1615262339.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"g+kG3"}]},{"client_msg_id":"5d70c0b0-b35f-422b-bdc7-a474e5903aad","type":"message","user":"UDDCM376D","text":"自分はそこらへんの知見全然ないので、わからないんすけど、\n文脈が変わるかどうか、すかね（よく分かっていない）","ts":"1615262320.389700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"BaNn"}]},{"client_msg_id":"53c4669c-207f-4cfd-90b1-07e0108e6346","type":"message","user":"UEA8T80GY","text":"goでweb開発してるとリクエスト単位でcontext発行してると思うんですが、呼び出されたhandlerから更にmethodを呼ぶ場合は新たにcontextを生成して渡すのか、そのまま引き回して良いのかよく分からないです。役割と公式を見てる感じそのまま引き回した方がいい気がするんですが。ここから先だけcancelしたいとか有った場合は WithCancelとかで渡すべきでそういうのがない場合はそのまま渡す方がいいんですかね。","ts":"1615262090.388400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"t20N"}]}]
