[{"client_msg_id":"59a22cb9-15a6-4580-812c-b1d8d9cca533","type":"message","user":"U016TGT4S3D","text":"We plan to do another virtual event this year, would be happy to have you all join / participate in whatever capacity you guys wish!","ts":"1617289007.017700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"g6A9"}]},{"client_msg_id":"99938d87-3526-4b01-8932-25d6e56a1322","type":"message","user":"U03C4RC8X","text":"and if you host vimconf.live 2021, I'd definitely like VimConf Jumbikai to advertise it :+1:","ts":"1617253417.016900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"a9+"}]},{"client_msg_id":"ee250430-8384-4870-be4e-53a9960afb9a","type":"message","user":"U03C4RC8X","text":"...That's my opinion. What do you think? (CC \u003c@U06BRP8VD\u003e \u003c@UCFEJF487\u003e \u003c@U1MLSLA87\u003e \u003c@U03C71D7H\u003e)","ts":"1617253299.014700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"6vmY"}]},{"client_msg_id":"53d4fe48-189f-42b6-8db1-640710cbee55","type":"message","user":"U03C4RC8X","text":"So VimConf Jumbikai shall declare that we postpone VimConf 2021 until 2022 again.","ts":"1617253278.014400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ju=Mo"}]},{"client_msg_id":"a25f86a7-8601-4dac-b424-52acad0727fc","type":"message","user":"U03C4RC8X","text":"(e.g. Here in British Columbia :flag--bc: , we entered another lockdown since yesterday due to the third wave)","ts":"1617253098.011600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=kfqB"}]},{"client_msg_id":"4946fd75-6c32-42b4-b1d5-5ff7abb9cd85","type":"message","user":"U03C4RC8X","text":"Due to the third wave at COVID-19, I think it's unrealistic to host even a hybrid plan in this year","ts":"1617253059.010600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"P3u+"}]},{"client_msg_id":"4e4743a3-cb4b-4f91-aaa1-11396c891eff","type":"message","user":"U03C4RC8X","text":"I think it's a good sign to give up and VimConf Jumbikai (VimConf Preparation Committee) should focus on smaller scale offline meetings, at least in this year.","ts":"1617253011.009600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"GL/8"}]},{"client_msg_id":"106a73b8-1210-4e14-9ca6-70a121c06ec3","type":"message","user":"U03C4RC8X","text":"I was feeling I got stuck","ts":"1617228510.008400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=ZGs"}]},{"client_msg_id":"e480dd33-ec24-4da0-9bb3-53f370a4b917","type":"message","user":"U03C4RC8X","text":"Thanks for heads up! I have been looking forward to getting feedbacks while thinking","ts":"1617228408.007800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"o7Ba"}]}]
