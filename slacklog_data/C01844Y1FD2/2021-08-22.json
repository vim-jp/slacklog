[{"client_msg_id":"334c5e0b-8cf1-46b6-9b56-e5da005b6470","type":"message","user":"U03C4RC8X","text":":yonkaiyuushoo:","ts":"1629584450.129400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"EYm"}]},{"client_msg_id":"0f0f98b6-3174-45f2-80f4-8f9ff41df293","type":"message","user":"U01D9BALEKU","text":"\u003chttps://gigazine.net/news/20210821-plant-human-protein/\u003e\nこないだのやつ、gigazineがまとめていた","ts":"1629584010.129000","attachments":[{"fallback":"GIGAZINE: 肥満の原因となる遺伝子が作物の成長を促進するという研究結果、米の収穫量は3倍に","id":1,"title":"肥満の原因となる遺伝子が作物の成長を促進するという研究結果、米の収穫量は3倍に","title_link":"https://gigazine.net/news/20210821-plant-human-protein/","text":"近年、新型コロナウイルスの感染拡大や気候変動などの影響で食糧不足に苦しむ国や地域が急増しており、食糧不足への対策として作物の品種改良や微生物の活用といった研究開発が行われています。そんな中、中国の研究チームが人間の肥満の原因となる遺伝子を作物に組み込むことで、作物の成長を促進することに成功しました。","image_url":"https://i.gzn.jp/img/2021/08/21/plant-human-protein/00.jpg","blocks":null,"service_name":"GIGAZINE","service_icon":"https://gigazine.net/apple-touch-icon.png","from_url":"https://gigazine.net/news/20210821-plant-human-protein/","original_url":"https://gigazine.net/news/20210821-plant-human-protein/"}],"team":"T03C4RC8V","reactions":[{"name":"eyes","count":1,"users":["UAZ33BKV2"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"HDUr"}]}]
