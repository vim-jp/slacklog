chments":[{"fallback":"wikipedia: アンスコムの例","id":1,"author_name":"Wikipedia","author_link":"https://ja.wikipedia.org/","title":"アンスコムの例","title_link":"https://ja.wikipedia.org/wiki/%E3%82%A2%E3%83%B3%E3%82%B9%E3%82%B3%E3%83%A0%E3%81%AE%E4%BE%8B","text":"アンスコムの例（アンスコムのれい、Anscombe's quartet）あるいはアンスコムの数値例（アンスコムのすうちれい）とは、回帰分析において、散布図はそれぞれ異なるのに回帰直線やその他の統計量が同じになってしまう現象について、統計学者のフランク・アンスコムが1973年に紹介した例である。回帰分析をする前に散布図を確認し傾向を把握することの重要性、そして外れ値が統計量に与える影響の大きさを示している。","blocks":null,"service_icon":"https://a.slack-edge.com/80588/img/unfurl_icons/wikipedia.png","from_url":"https://ja.wikipedia.org/wiki/%E3%82%A2%E3%83%B3%E3%82%B9%E3%82%B3%E3%83%A0%E3%81%AE%E4%BE%8B","original_url":"https://ja.wikipedia.org/wiki/%E3%82%A2%E3%83%B3%E3%82%B9%E3%82%B3%E3%83%A0%E3%81%AE%E4%BE%8B"}],"reply_count":1,"team":"T03C4RC8V","reactions":[{"name":"thinking_face","count":1,"users":["U01D9BALEKU"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Kcu4A"}]},{"client_msg_id":"268ef58c-bffe-45e6-a1f2-e312d15c59e5","type":"message","user":"UDPT2BZ6E","text":"コレステロール値の例が特に面白かったですね。たしかに全サンプルで相関係数出すと正になりそう。","ts":"1629778132.131200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"F3v"}]},{"client_msg_id":"14458210-1c0a-47ae-a6e6-80913a0f5ece","type":"message","user":"UDPT2BZ6E","text":"面白かった","ts":"1629778046.130300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Lzohq"}]},{"client_msg_id":"e2bc42a8-ec0e-4b2f-b711-422bb859dbf7","type":"message","user":"U01D9BALEKU","text":"面白いですね","ts":"1629777886.130000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"sX/"}]},{"client_msg_id":"03876ebf-9088-47e0-82e9-3e3e7e459580","type":"message","user":"U01D9BALEKU","text":"\u003chttps://tjo.hatenablog.com/entry/2021/08/23/220000|https://tjo.hatenablog.com/entry/2021/08/23/220000\u003e","ts":"