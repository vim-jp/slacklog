/pdcf10th/status/1380140070846390274"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"M7RLq"}]},{"client_msg_id":"d8d47816-9392-458b-b8b2-0c615b512d2a","type":"message","user":"UBRTB4N5C","text":"ここの Slack ではまだ話題に出てなさそうだった。 \u003chttps://ubgoe.com/projects/20\u003e","ts":"1617972482.342800","attachments":[{"fallback":"うぶごえ: 「輪るピングドラム」の10周年をみんなで祝いたい！","id":1,"title":"「輪るピングドラム」の10周年をみんなで祝いたい！","title_link":"https://ubgoe.com/projects/20","text":"「輪るピングドラム」のテレビ放送から今年で10年が経ちました。 作品の10周年を記念して幾原邦彦監督自らの手による劇場版の制作が決定しました。 タイトルは「RE:cycle of the PENGUINDRUM」です。 本プロジェクトは「輪るピングドラム」を応援し続けてくださったファンの皆様と一緒に10周年と劇場版を盛り上げるプロジェクトです。","image_url":"https://image-ichiba2.storage.googleapis.com/prod/auction_detail/image/45/aspect_ratio_3to2_PDCF_main0318.jpg","blocks":null,"service_name":"うぶごえ","service_icon":"https://ubgoe.com/assets/favicon72-5c75498792d1237c5bf5517de3efdefc5aa2fede6f2b35fdfe6ab1ae136138f8.png","from_url":"https://ubgoe.com/projects/20","original_url":"https://ubgoe.com/projects/20"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"deaBy"}]},{"client_msg_id":"03349a03-571a-484f-aaa8-386ab3c57336","type":"message","user":"U01AQ5BFNLX","text":"これ面白かった。スーパーカブも","ts":"1617954862.342400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"s=t"}]},{"client_msg_id":"3499d122-051b-438e-bc5a-faa74d429566","type":"message","user":"U06ECBRTJ","text":"\u003chttps://www.itmedia.co.jp/business/articles/2104/05/news071.html\u003e","ts":"1617951535.341900","attachments":[{"fallback":"ITmedia ビジネスオンライン: 多治見が舞台の陶芸アニメ『やくならマグカップも』、“原作者”は東京ディズニーランド生みの親！　仕掛け人が明かす観光戦略の裏側","id":1,"title":"多治見が舞台の陶芸アニメ『やくならマグカップも』、“原作者”は東京ディズニーランド生みの親！　仕掛け人が明かす観光戦略の裏側","title_link":"https://www.itmedia.co.jp/business/articles/2104/05/news071.html","text":"聖地巡礼の元となる地域住民がコンテンツを制作し、アニメ化となる原案を作る――そんな地方創生戦略のもとに動いていた作品がある。漫画『やくならマグカップも』だ。陶芸に打ち込む女子高生を描いた作品で、「美濃焼」で知られる岐阜県多治見市を舞台にしている。仕掛け人のIT企業「プラネット」の小池和人会長によると、その背景には東京ディズニーランドの生みの親である故・堀貞一郎さんとの切っても切り離せない関係があるという。東京ディズニーランドと『やくも』はどうつながっているのか。なぜ、コンテンツで地方創生を志そうと思ったのか。小池さんに聞いた。","image_url":"https://image.itmedia.co.jp/business/articles/2104/05/cover_news071.jpg","blocks":null,"service_name":"ITmedia ビジネスオンライン","service_icon":"https://www.itmedia.co.jp/favicon.ico","from_url":"https://www.itmedia.co.jp/business/articles/2104/05/news071.html","original_url":"https://www.itmedia.co.jp/business/articles/2104/05/news071.html"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=CRZ"}]},{"client_msg_id":"89f15277-0102-4877-a227-ea69f1568f26","type":"message","user":"U01J7703PFT","text":"感想言いたいけどしっかりとガマンせねば","ts":"1617899196.341600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"HmH8"}]},{"client_msg_id":"1fdedf14-2f98-4809-aea7-aff23cd81ef2","type":"message","user":"UFHQ7TNT0","text":"アニメしか見てないから、12月くらいまで我慢することになるのか","ts":"1617898151.341200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"dIQ"}]},{"client_msg_id":"cb9905ca-842d-4af8-a0c3-faa6f73f13b1","type":"message","user":"U01J7703PFT","text":"進撃最終話読みました。とりあえずネタバレの危険性無くなったので\nこれで安心してネットが出来る","ts":"1617896894.340600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"gCRx"}]},{"client_msg_id":"4fc10970-a81b-4b50-92a4-c934171670a4","type":"message","user":"U7B4ZD49X","text":"読んだ。・・・","ts":"1617894830.339700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"C1tUM"}]},{"client_msg_id":"9a70d05f-b079-418f-9f24-60a9813dde7c","type":"message","user":"U7B4ZD49X","text":"マガポケで進撃の巨人最終回読もうとしてるけどクソ重い・・・","ts":"1617894228.339100","team":"T03C4RC8V","reactions":[{"name":"warau","count":2,"users":["UFHQ7TNT0","U01J7703