/09/15/git-worksync-1-0-0/"}],"edited":{"user":"U022XK5866Q","ts":"1636465651.000000"},"team":"T03C4RC8V","reactions":[{"name":"eyes","count":4,"users":["UD1FQV38V","U9S4G0LJW","U81LLJ340","US5UW1UNB"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+2C"}]},{"client_msg_id":"e0d75f89-1839-4a01-8a64-76b899a72b8e","type":"message","user":"UD1FQV38V","text":"stash管理に嫌気がさしてきたのでworktree使ってみよ","ts":"1636462247.068600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zzoDS"}]},{"client_msg_id":"6013749f-21ba-4fad-af0c-a1c8aec44a74","type":"message","user":"U022XK5866Q","text":"ほんとわかる","ts":"1636461890.068200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"xaa"}]},{"client_msg_id":"0ff18fac-cafd-4b02-8ed5-ce96cd71a81e","type":"message","user":"UDDCM376D","text":":wakaru:","ts":"1636461769.068000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"HZ0"}]},{"client_msg_id":"55b22125-5023-43a6-ad36-304a9fafce40","type":"message","user":"U9S4G0LJW","text":"stashの管理は難しすぎる","ts":"1636461701.067700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"o9hG"}]},{"client_msg_id":"638422bd-358b-4a8f-bd2b-03e79b75053a","type":"message","user":"U9S4G0LJW","text":"わかる \u0026gt; stashしたくない","ts":"1636461676.067400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"/xyBP"}]},{"client_msg_id":"e3f15e97-fc3b-4e36-9a81-9459e40f8f80","type":"message","user":"UDDCM376D","text":"がっつり作業中にstashしたくないときに便利","ts":"1636461617.067100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"kISyb"}]},{"client_msg_id":"07847304-6c27-4c4e-ad4c-e7cdca8a4f22","type":"message","user":"UDDCM376D","text":"ですねえ","ts":"