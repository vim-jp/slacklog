ype":"rich_text","block_id":"T1F2r"}]},{"client_msg_id":"cc1d1100-7ffe-4763-a17b-3dd793fbcb60","type":"message","user":"U8996GYBF","text":"今探してScrapboxにメモっときます","ts":"1630649887.025900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zq3"}]},{"client_msg_id":"c7332372-5343-4b21-93eb-3079f865b24e","type":"message","user":"U8996GYBF","text":"検証する時間取れなくてどっかいってしまったすみません","ts":"1630649878.025500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"JuKe2"}]},{"client_msg_id":"38e5e268-375c-4f2b-ab5b-b97d29bd2d09","type":"message","user":"U8996GYBF","text":"あっ","ts":"1630649869.025100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"07c69"}]},{"client_msg_id":"904061cb-f4d0-4c47-8dee-8bb24f853e4f","type":"message","user":"U06ECBRTJ","text":"\u003chttps://github.com/yuki-yano/fzf-preview.vim/blob/cffcaecec6771b6fd531878b0037c235f94ca800/bin/preview_fzf_grep\u003e\nそういえば、これの js 版を私書き下ろした気がするんだけど、もうどっか行ってしまったな…","ts":"1630649857.024800","attachments":[{"color":"24292f","fallback":"\u003chttps://github.com/yuki-yano/fzf-preview.vim/blob/cffcaecec6771b6fd531878b0037c235f94ca800/bin/preview_fzf_grep | preview_fzf_grep\u003e","id":1,"title":"\u003chttps://github.com/yuki-yano/fzf-preview.vim/blob/cffcaecec6771b6fd531878b0037c235f94ca800/bin/preview_fzf_grep | preview_fzf_grep\u003e","text":"```\n#!/usr/bin/env python3\n\nimport sys\nimport subprocess\nimport shutil\nimport re\nimport os\n\nbat_theme = (os.environ.get('FZF_PREVIEW_PREVIEW_BAT_THEME', 'ansi'))\n\nGREP_OUTPUT_REGEX = re.compile(\n    r'^(\\s\\s\\s.+\\s)?(\\d+\\s)?(?P\u0026lt;dev_icon\u0026gt;.\\s\\s)?(?P\u0026lt;file_name\u0026gt;[^:]+):(?P\u0026lt;line_num\u0026gt;\\d+)(:(?P\u0026lt;col\u0026gt;\\d+))?(:(?P\u0026lt;match\u0026gt;.*))?'\n)\nCLEAN_LINE_REGEX = re.compile(r'\\x1B(?:[@-Z\\\\-_]|\\[[0-?]*[ -/]*[@-~])')\n\n\ndef is_installed(cmd):\n    return shutil.which(cmd.split(' ')[0])\n\n\nmatch = GREP_OUTPUT_REGEX.match(sys.argv[1])\nif not match:\n    print(\n        \"Cannot process the entry :(\\n\"\n        \"Please open an issue and describe what happened\\n\"\n        \"including information such as file name and g:fzf_preview_grep_cmd\"\n    )\n    sys.exit(1)\n\nfile_name = match.group('file_name')\nline_num = int(match.group('line_num'))\n\n# Set preview window offset. See: \u003chttps://github.com/junegunn/fzf/commit/0f9cb5590ec0a397143a7a4caf003a54885f4375\u003e\n# start = max(line_num - 10, 1)\n# last = line_num + 100\n\ncats = [\n    f'bat --highlight-line=\"{line_num}\" --color=always --style=grid --theme=\"{bat_theme}\" --plain',\n    'cat'\n]\ncat = list(filter(is_installed, cats))[0]\n\nseds = [\n    'gsed',\n    'sed'\n]\nsed = list(filter(is_installed, seds))[0]\n\nresult = subprocess.check_output(\n    f'{cat} {file_name}', shell=True)\n\nfor index, line in enumerate(result.decode().split(\"\\n\")):\n    if cat == 'cat' and int(line_num) - 1 == index:\n        line = CLEAN_LINE_REGEX.sub('', line)\n        print(f\"\\033[1m\\033[4m\\033[31m{line}\\033[0m\")\n    else:\n        print(line)\n\n```","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/yuki-yano/fzf-preview.vim|yuki-yano/fzf-preview.vim\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"3vl2n"}]},{"client_msg_id":"9a6b8e97-3dfe-4e7c-a74f-eb83e59fea20","type":"message","user":"U03C71D7H","text":"Perl","ts":"1630649777.024000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"v9k"}]},{"client_msg_id":"29ecd086-b668-4b69-8c5b-e4e875cdefa1","type":"message","user":"U8996GYBF","text":"コミットからPR辿るスクリプトありますね、拾いものだけど許可貰ってそのままVim pluginで使わせて貰ってる\n\u003chttps://github.com/yuki-yano/fzf-preview.vim/blob/cffcaecec6771b6fd531878b0037c235f94ca800/bin/git_blame_pr\u003e","ts":"1630649691.023700","attachments":[{"color":"24292f","fallback":"\u003chttps://github.com/yuki-yano/fzf-preview.vim/blob/cffcaecec6771b6fd531878b0037c235f94ca800/bin/git_blame_pr | git_blame_pr\u003e","id":1,"title":"\u003chttps://github.com/yuki-yano/fzf-preview.vim/blob/cffcaecec6771b6fd531878b0037c235f94ca800/bin/git_blame_pr | git_blame_pr\u003e","text":"```\n#! /usr/bin/perl\n#\n# Written in 2017 by Kazuho Oku\n#\n# To the extent possible under law, the author(s) have dedicated all copyright and related and neighboring rights to this software to the public domain worldwide. This software is distributed without any warranty.\n# You should have received a copy of the CC0 Public Domain Dedication along with this software. If not, see \u003chttp://creativecommons.org/publicdomain/zero/1.0/\u003e.\n\nuse strict;\nuse warnings;\n\nmy $git_blame_pid = open(my $fh, \"-|\", \"git\", \"blame\", \"--first-parent\", @ARGV)\n    or die \"failed to invoke git-blame:$!\";\n\nmy %cached; # commit-id -\u0026gt; substitution string\n\nwhile (my $line = \u0026lt;$fh\u0026gt;) {\n    my ($commit, $src) = split / .*?\\) /, $line, 2;\n    $cached{$commit} = lookup($commit)\n        unless $cached{$commit};\n    print $cached{$commit}, ' ', $src;\n}\n\nwhile (waitpid($git_blame_pid, 0) != $git_blame_pid) {}\nexit $?;\n\nsub lookup {\n    my $commit = shift;\n    my $message = `git show --oneline $commit`;\n    if ($message =~ /Merge\\s+(?:pull\\s+request|pr)\\s+\\#?(\\d+)\\s/i) {\n        return sprintf '%-9s', \"PR #$1\";\n    }\n    return $commit;\n}\n\n```","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/yuki-yano/fzf-preview.vim|yuki-yano/fzf-preview.vim\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png"}],"team":"T03C4RC8V","reactions":[{"name":"otxu","count":1,"users":["UDPT2BZ6E"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block