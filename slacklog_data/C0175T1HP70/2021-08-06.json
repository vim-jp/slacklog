mage.itmedia.co.jp/news/articles/0807/28/l_yuo_ps3_01.jpg","blocks":null,"service_name":"ITmedia NEWS","service_icon":"https://www.itmedia.co.jp/favicon.ico","thumb_width":788,"thumb_height":708,"from_url":"https://www.itmedia.co.jp/news/articles/0807/28/news016.html","original_url":"https://www.itmedia.co.jp/news/articles/0807/28/news016.html"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"16RBt"}]},{"client_msg_id":"7ea3a748-a1d6-40c7-af6c-8224f795b0bd","type":"message","user":"UERCTTT8B","text":"ブラウザ開発、あまりにも技術リソースを食うので、新規参入が著しく困難そう","ts":"1628226050.206700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"R63q"}]},{"client_msg_id":"38e4bf72-841a-4116-ad6e-e85cc5d1879f","type":"message","user":"U06ECBRTJ","text":"DS と DSi とWii は Opera\n3DS とWii U と Switch は NetFront","ts":"1628225969.205700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"tYgC9"}]},{"client_msg_id":"9965051c-4aa1-48d4-acb0-41ae61a8e360","type":"message","user":"U01D44KSY9Z","text":"携帯向け組み込みの技術を活かした感じですかね","ts":"1628225934.205000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"7H4"}]},{"client_msg_id":"51613243-f345-4bdb-91c1-838b22d0acea","type":"message","user":"UERCTTT8B","text":"ニッチだなぁ","ts":"1628225915.204500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"=GG"}]},{"client_msg_id":"b74c2c1a-7ae0-4708-a7b4-e0a25ccd5f6b","type":"message","user":"U06ECBRTJ","text":"\u0026gt; モバイル向け分野のほかにセットトップボックスやカーナビゲーションシステムなどの各種デバイス組み込み分野でもOperaの開発が行われている。中でも任天堂の携帯ゲーム機「ニンテンドーDS」向けに、Operaをベースとして独自の改良を加えた「ニンテンドーDSブラウザー」が2006年7月より発売されており、ニンテンドーDSiにはニンテンドーDSiブラウザー[45]、同じく任天堂の据え置きゲーム機「Wii」向けにもインターネットチャンネルの名でOperaが提供されている。また、東芝製液晶テレビ「CELL REGZA」でもWebブラウザとして使用されている。 ","ts":"1628225819.204100","team":"T03C4RC