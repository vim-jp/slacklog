CBRTJ","U01BY3SDBRS"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"wHnT"}]},{"client_msg_id":"b700cd84-f761-450c-9f26-ee9a3f439aec","type":"message","user":"UKHUVMBJR","text":"こんなふうに中央揃えテキストを描画できる\n```func (a *app) Draw(screen *ebiten.Image) {\n\ts := \"Hi,\\nWorld!\"\n\tlines := strings.Split(s, \"\\n\")\n\tmaxW := 0\n\tws := []int{}\n\tfor _, line := range lines {\n\t\t_, adv := font.BoundString(a.mplus72, line)\n\t\tw := adv.Round()\n\t\tif w \u0026gt; maxW {\n\t\t\tmaxW = w\n\t\t}\n\t\tws = append(ws, w)\n\t}\n\n\tmet := a.mplus72.Metrics()\n\tpos := \u003chttp://geom.Pt|geom.Pt\u003e(0, 0) // 全体の左上座標\n\tpos.Y += float64(met.Ascent.Round())\n\tfor i, line := range lines {\n\t\tw := ws[i]\n\t\tofsX := (maxW - w) / 2\n\t\ttext.Draw(screen, line, a.mplus72, int(pos.X)+ofsX, int(pos.Y), color.White)\n\t\tpos.Y += float64(met.Height.Round())\n\t}\n}```","ts":"1628539229.304900","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Bvr="}]},{"client_msg_id":"c2e8e764-d812-4af4-9873-d56855992864","type":"message","user":"UKHUVMBJR","text":"左上固定したいときはMetrics().Ascent分ずらすってのは何気に超重要情報っぽい","ts":"1628536220.304600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Yui"}]},{"client_msg_id":"048ed78a-24e2-4947-bd6d-8a25c17116ca","type":"message","user":"UKHUVMBJR","text":"左上からdotまでの距離がMetrics.Ascentで、二行目以降の各行の距離がMetrics.Heightだ","ts":"1628535841.304100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Mb2"}]},{"client_msg_id":"b9523425-746b-45c2-8f30-7b6ef32fe821","type":"message","user":"UKHUVMBJR","text":"いや違うなあ\nFace.Metrics()見るのが正解だ\nこの辺前に調べたけど忘れてたな・・・","ts":"1628535796.303600","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Si56H"}]},{"client_msg_id":"47756cd1-aa71-4074-89c6-b21edb5adef7",