sage","user":"U06ECBRTJ","text":"まさかの Promise でやるのか…？","ts":"1615903952.009500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"BDt4"}]},{"client_msg_id":"66ea348e-09a3-4f38-9753-8641dd07c46a","type":"message","user":"U06ECBRTJ","text":"大体コピペなんですよねー…","ts":"1615903940.009100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hJP"}]},{"client_msg_id":"9541b959-c83e-4f6a-aebe-823e3f3fa4bb","type":"message","user":"U03C71D7H","text":"どこかで typo とかしてないのであれば、使えなさそう","ts":"1615903877.008700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ALdk"}]},{"client_msg_id":"3b617ea8-a46b-4654-8d13-1f4c5c845a7e","type":"message","user":"U06ECBRTJ","text":"ちなみに `SyntaxError: Unexpected token function` らしいです","ts":"1615903610.008400","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"vOHzi"}]},{"client_msg_id":"4f26e189-3060-41d9-8178-3395c6cbe73c","type":"message","user":"U06ECBRTJ","text":"まぁ、プラグインなので、一度書いちゃえばそこまで手を入れないかなと","ts":"1615903551.008100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"ljev"}]},{"client_msg_id":"5949453e-2542-41c9-b6a9-7454e1233143","type":"message","user":"U9S4G0LJW","text":"ゲームスクリプト書くのにbabel導入するのは嫌やなぁ","ts":"1615903374.006000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"7I6"}]},{"client_msg_id":"39afd0c7-cc6b-4b17-ae82-ed71da430c61","type":"message","user":"UERCTTT8B","text":"`(function() {` は `(async function() {` ?","ts":"1615903363.005300","team":"T03C4RC8V","reactions":[{"name":"kzk","count":1,"users":["U9S4G0LJW"]}],"replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"tSrB"}]},{"client_msg_id":"ef85d219-86ea-4c13-b074-95f5fac168b9","type":"message","user":"U06ECBRTJ","text":"まさか、async/await 使えなかったりする…？","ts":"1615903116.004700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"zkj"}]},{"client_msg_id":"c150d8c5-ea5c-4d40-99d2-84323a2bed96","type":"message","user":"U06ECBRTJ","text":"```function fetchLocal(url) {\n  return new Promise(function(resolve, reject) {\n    var xhr = new XMLHttpRequest\n    xhr.onload = function() {\n      resolve(new Response(xhr.responseText, {status: xhr.status}))\n    }\n    xhr.onerror = function() {\n      reject(new TypeError('Local request failed'))\n    }\n    xhr.open('GET', url)\n    xhr.responseType = 'arraybuffer'\n    xhr.send(null)\n  })\n}\n\n(function() {\n      const go = new Go();\n      const response = await fetchLocal(\"plugin/tyrano-psd/main.wasm\");\n      const buffer = await response.arrayBuffer();\n      const result = await WebAssembly.instantiate(buffer, go.importObject);\n      go.run(result.instance);\n})();```\nTyranoScript のエンジンで、これがエラーになる…","ts":"1615903100.004300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"RXx"}]},{"client_msg_id":"967fda72-2832-4649-b4c8-afdc858ebf24","type":"message","user":"UAZ33BKV2","text":"誤字だと思った","ts":"1615899973.003500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"EMZ"}]},{"client_msg_id":"a326ed10-1e03-48f3-9332-d91243c2c9bf","type":"message","user":"U06ECBRTJ","text":"確かに割と近い","ts":"1615898988.003300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"LHfg"}]},{"client_msg_id":"36c95ee3-9451-4140-a343-396f22731bc6","type":"message","user":"U9S4G0LJW","text":"全然関係ないけど名前のTypeScriptとの一致率が高いのでいつも誤読しかけてしまう","ts":"1615898268.003100","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Xu38"}]},{"client_msg_id":"7dfe271a-663d-