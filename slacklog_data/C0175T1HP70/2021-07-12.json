ht_64.png","blocks":null,"service_name":"yro.srad.jp","service_icon":"https://srad.jp/static/favicon.ico","thumb_width":64,"thumb_height":64,"from_url":"https://yro.srad.jp/story/19/08/02/157225/","original_url":"https://yro.srad.jp/story/19/08/02/157225/"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4TLX"}]},{"client_msg_id":"b670ae03-b1e9-440a-9ae4-0ceabc90d318","type":"message","user":"UKHUVMBJR","text":"音楽はリミックスとかの文化もありその辺の権利関係もどうなってるか気になる","ts":"1626023952.047200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"+wLMV"}]},{"client_msg_id":"763d5301-eda9-43fe-ae00-3ead4748138b","type":"message","user":"UKHUVMBJR","text":"（無料とかいうとフリーソフトウェア方向から刺されそう）","ts":"1626023910.046800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"pur"}]},{"client_msg_id":"b5f2aeee-feaf-4e09-9515-9754b172f8f4","type":"message","user":"UKHUVMBJR","text":"その点プログラムはいまどきあらゆるものが無料で利用できるので便利すぎですね","ts":"1626023882.046300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"0MG"}]},{"client_msg_id":"548e2624-632f-41f2-a883-23f83097a790","type":"message","user":"UKHUVMBJR","text":"厳密にはどうなんすかねえ\nJASRAC管理楽曲をYouTubeで利用するときの契約とか、YouTube自体が整備してる楽曲を動画で使えるのはわかる\nそれ以外はどうなんだろう","ts":"1626023811.045800","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"vsV/q"}]},{"client_msg_id":"c587a16c-965e-465a-a507-fc6033405088","type":"message","user":"UERCTTT8B","text":"事実上は「黙認」されていることが多そう","ts":"1626023710.044700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"hjs"}]},{"client_msg_id":"12143b2e-1779-4fbb-96ab-3423ffd89db3","type":"message","user":"U06BRP8VD","text":"実現するのにかかる労力とは別の話として。","ts":"1626078870.082000","thread_ts":"1626078005.074800","edited