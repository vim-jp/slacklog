ashMapOf\u0026lt;Player, Long\u0026gt;()\n\n    @EventHandler\n    fun onPlayerToggleSneakEvent(event: PlayerToggleSneakEvent) {\n        val currentTime = event.player.world.fullTime\n\n        playerTimeList[event.player]?.let {\n            if (currentTime - it \u0026lt; 20) return\n        }\n        playerTimeList[event.player] = currentTime\n    }\n\n    @EventHandler\n    fun onEntityDamageEvent(event: EntityDamageEvent) {\n        if (event.entity !is Player || event.cause != EntityDamageEvent.DamageCause.FALL) return\n\n        val player = event.entity as Player\n        playerTimeList[player]?.let { sneakedTime -\u0026gt;\n            val timeDiff = event.entity.world.fullTime - sneakedTime\n            if (timeDiff \u0026gt; 3) return\n\n            // FIXME: Doesn't work\n            // event.isCancelled = true\n\n            event.damage -= 5\n            if (event.damage \u0026lt; 0) event.damage = 0.0\n\n            event.entity.location.playSound(Sound.ENTITY_CAT_AMBIENT, pitch = 1.2f)\n        }\n\n        playerTimeList[player] = 0\n    }\n\n}\n\n\n```","mrkdwn_in":["text"],"blocks":null,"footer":"\u003chttps://github.com/raa0121/spicat|raa0121/spicat\u003e","footer_icon":"https://slack.github.com/static/img/favicon-neutral.png"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"xTs8g"}]},{"client_msg_id":"e8ca912a-f394-4a23-8bc6-377d77ed6fb8","type":"message","user":"UERCTTT8B","text":"うーむ","ts":"1625650780.304700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"XHi"}]},{"client_msg_id":"0cc642f0-1742-4bea-b734-7d125a725180","type":"message","user":"U9S4G0LJW","text":"IDEでパッと追えないんだよな","ts":"1625650290.304300","edited":{"user":"U9S4G0LJW","ts":"1625650294.000000"},"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"aNVIL"}]},{"client_msg_id":"81876fb7-4840-4fa5-a8fa-0bc