list/1335/247/1.jpg","blocks":null,"ts":1625104856,"service_name":"PC Watch","service_icon":"https://pc.watch.impress.co.jp/favicon.ico","from_url":"https://pc.watch.impress.co.jp/docs/news/1335247.html","original_url":"https://pc.watch.impress.co.jp/docs/news/1335247.html"}],"team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"C3F49"}]},{"client_msg_id":"8c0f5145-47c2-40e0-a563-a9c17901e190","type":"message","user":"UAZ33BKV2","text":"次のarmのからx64が動くのと、その効率もよく....だっけ?","ts":"1629014986.149300","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"AdlrA"}]},{"client_msg_id":"7ef7f100-0f4c-45d6-9139-582186a76fd9","type":"message","user":"UERCTTT8B","text":"MinGW の新しいのを使わなきゃいけない早急な理由がないのが幸い","ts":"1629014848.148700","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"Mn9H"}]},{"client_msg_id":"bb93aaa8-c55e-4177-9aa5-7f25aa977d42","type":"message","user":"UERCTTT8B","text":"現実的なやり方としては 32bit 向けビルドだけ古い MinGW (8) 使うかしかなさそうですね","ts":"1629014802.148200","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"jpe"}]},{"client_msg_id":"1df60780-316b-47de-8405-e2f2aaaca7a1","type":"message","user":"UAZ33BKV2","text":"どうしたもんでしょうね、32bitでの動作自体は当分維持されるからなあ(in 64bit Windows)","ts":"1629014705.147500","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"fuAD"}]},{"client_msg_id":"21e4bfcd-f444-4a59-90c7-3790b420e8db","type":"message","user":"UERCTTT8B","text":"あと Arm 版 Windows 上で動かしたいという要望が無きにしもあらず (いまは x64 も動くようになったんでしたっけ?)","ts":"1629014508.145000","team":"T03C4RC8V","replace_original":false,"delete_original":false,"blocks":[{"type":"rich_text","block_id":"4gbEh"}]},{"client_msg_id":"abad89ab-fdc9-401b-97cb-a226e7e3942e","type":"message","user":"UERCTTT8B","text":"なので Windows も 7 からです","ts":"1629014292.