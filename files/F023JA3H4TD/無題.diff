diff --git a/autoload/fern_preview.vim b/autoload/fern_preview.vim
index 971a200..b3c95e7 100644
--- a/autoload/fern_preview.vim
+++ b/autoload/fern_preview.vim
@@ -19,6 +19,11 @@ function! fern_preview#smart_preview(preview, non_preview) abort
   endif
 endfunction
 
+function! fern_preview#buf_read() abort
+  call setline(1, readfile(substitute(bufname('%'), '^fern_preview://', '', 'g')))
+  filetype detect
+endfunction
+
 function! fern_preview#toggle_auto_preview() abort
   if g:fern_auto_preview
     let g:fern_auto_preview = v:false
@@ -98,7 +103,7 @@ function! fern_preview#height_default_func() abort
 endfunction
 
 function! s:open_preview(path) abort
-  call s:win.set_bufnr(bufnr(a:path, v:true))
+  call s:win.set_bufnr(bufnr('fern_preview://' . a:path, v:true))
   call setbufvar(s:win.get_bufnr(), '&bufhidden', 'wipe')
   call setbufvar(s:win.get_bufnr(), '&buflisted', 0)
   call setbufvar(s:win.get_bufnr(), '&buftype', 'nofile')
diff --git a/plugin/fern_preview.vim b/plugin/fern_preview.vim
