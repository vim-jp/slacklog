{
  "compilerOptions": {
    "outDir": "./dist",
    "module": "es2020",
    "moduleResolution": "node",
    "strict": true,
    "preserveConstEnums": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmitOnError": true,
    "strictNullChecks": true,
    "target": "es2020",
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["es2020", "dom"]
  },
  "include": [
    "src/**/*.ts"
  ]
}
